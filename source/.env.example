# Local development template. Never commit .env or put real credentials in a release.
# For the persistent Linux service, create /opt/shopeasy/.env separately and set
# NODE_ENV=production, TRUST_PROXY=1 and a public HTTPS BASE_URL. See DEPLOYMENT.md.
NODE_ENV=development
PORT=3000
BASE_URL=
TRUST_PROXY=0
DATABASE_URL=file:./data/shop.db
RATE_LIMIT_BACKEND=memory-single-instance
# Oracle/local Node runtime. Wrangler sets Worker mode for the optional platform.
CLOUDFLARE_WORKER=0

# Initial Manager bootstrap runs only when no Manager account exists.
# Fill both credentials for the first start; they never reset an existing account.
# They may both be cleared after a verified first login and MFA enrollment.
MANAGER_NAME=Store Manager
MANAGER_EMAIL=
MANAGER_PASSWORD=
# MFA key: 32 random bytes written as 64 hexadecimal characters. Keep recovery copy.
MFA_ENCRYPTION_KEY=
# At least 24 random characters; required for password-reset email.
RESET_CODE_SECRET=
# Optional 64-hex key: stable pseudonymous login identifiers across restarts.
# Without a valid key, identifiers use a fresh process-local key at each restart.
SECURITY_LOG_HMAC_KEY=
LOGIN_FAILURE_ALERT_THRESHOLD=5
LOGIN_FAILURE_ALERT_WINDOW_MS=900000

# Store defaults. Existing database settings can override initial defaults.
STORE_NAME=ShopEasy Store
STORE_CURRENCY=EUR
DEFAULT_LOCALE=en
STORE_TIMEZONE=UTC
PRICES_INCLUDE_TAX=true
SEED_DEMO_DATA=false
# 0 applies no additional configured day limit; review local consumer obligations.
RETURN_WINDOW_DAYS=0

# Optional AI. Enable only after approving a provider and its data handling.
AI_ENABLED=false
AI_BASE_URL=
# Comma-separated exact DNS names for custom production AI hosts.
# Official provider endpoints are pre-approved by the application.
AI_ALLOWED_HOSTS=
AI_MODEL=
AI_API_KEY=

# Optional email provider. Verify the sending domain and a private test first.
RESEND_API_KEY=
EMAIL_FROM=
# Blank follows request/order locale; supported overrides: en, nl, ckb, ar.
EMAIL_LOCALE=
ORDER_CONFIRMATION_EMAILS=0
ORDER_STATUS_EMAILS=0
ORDER_EMAIL_DAILY_LIMIT=10
# Required (32+ random characters) when Manager enables/sends a newsletter.
# Rotation invalidates existing unsubscribe links.
NEWSLETTER_UNSUBSCRIBE_SECRET=

# Encrypted logical backup. Generate a random 32-byte base64 key and retain a
# recovery copy separately from the backup. Never ship the key inside a ZIP.
BACKUP_ENCRYPTION_KEY=
BACKUP_MAX_BYTES=536870912
BACKUP_BATCH_SIZE=200
# Optional output override for the manual command. Prefer explicit --output.
BACKUP_OUTPUT=
# Set /opt/shopeasy/backups for the persistent Linux release layout.
OFFSITE_BACKUP_DIR=
# Host used only to print SCP download commands, e.g. ubuntu@your-vm-host.
OFFSITE_SSH_HOST=

# Optional Mollie hosted cards; COD remains available without these values.
MOLLIE_API_KEY=
# Dedicated non-production staging only; never enable for production.
MOLLIE_TEST_CHECKOUT_ENABLED=false
# Set true only after actual merchant/provider approval and staging verification.
MOLLIE_LIVE_CHECKOUT_APPROVED=false

# Optional Belgium B2B Peppol/Recommand. Credentials must belong to your verified
# account/team; a self-declared playground flag does not prove sandbox access.
PEPPOL_RECOMMAND_COMPANY_ID=
PEPPOL_RECOMMAND_API_KEY=
PEPPOL_RECOMMAND_API_SECRET=
PEPPOL_RECOMMAND_ENV=playground
PEPPOL_SEND_APPROVED=0
PEPPOL_PRODUCTION_SEND_APPROVED=0

# Optional display metadata only. These fields never establish ownership/resale
# rights or a verified entitlement; refer to LICENSE.txt and the rights register.
LICENSED_TO=
LICENSOR_NAME=
LICENSE_EMAIL=
LICENSE_KEY=
LICENSE_DATE=
LICENSE_TYPE=single-storefront

# Optional platform-specific database variables. Keep all blank for local SQLite.
# Set Worker secrets with Wrangler only when following CLOUDFLARE-DEPLOYMENT.md.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Legacy remote Node alias; do not combine with DATABASE_URL on this Linux route.
SHOP_DATABASE_URL=

# Operator command inputs, not persistent storefront settings. Uncomment/set only
# for one reviewed restore to a NEW EMPTY target; remove after the command.
# RESTORE_DATABASE_URL=
# RESTORE_DATABASE_AUTH_TOKEN=
# RESTORE_BACKUP=
# RESTORE_UPLOADS_DIR=

# Staging certification only: use a separate staging account/database and host.
# Do not copy these values into the production service environment.
# STAGING_BASE_URL=
# PRODUCTION_BASE_URL=   # Legacy certification URL fallback; prefer STAGING_BASE_URL.
# STAGING_MANAGER_EMAIL=
# STAGING_MANAGER_PASSWORD=
# STAGING_MANAGER_MFA_CODE=
# STAGING_ADMIN_EMAIL=   # Legacy certification alias; prefer STAGING_MANAGER_EMAIL.
# STAGING_ADMIN_PASSWORD= # Legacy certification alias; prefer STAGING_MANAGER_PASSWORD.

# Platform signals are supplied by their host, not configured for this VM.
# VERCEL and AWS_LAMBDA_FUNCTION_NAME identify unsupported deployment targets.
# USER, SUDO_USER and SSH_USER are OS audit-actor hints, not account credentials.
# Shell helpers read APP_DIR, BACKUP_DIR and CADDY_CONFIG_FILE from the invoking
# shell, not this dotenv file. See DEPLOYMENT.md for explicit command examples.

# Test/diagnostic-only inputs. Leave absent from the production service:
# TEST_IMAGE_STORAGE_IN_DATABASE, SHOPEASY_INTEGRATION_DATA_DIR,
# SHOPEASY_INTEGRATION_PARENT_CLEANUP, SHOPEASY_RELEASE_ARCHIVE,
# LOAD_CLIENTS, LOAD_ROUNDS and PASSWORD_BENCHMARK_ROUNDS.
