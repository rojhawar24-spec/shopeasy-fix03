-   sudo -u shopeasy env RESTORE_DATABASE_URL='file:/opt/shopeasy/data/restore-drill-2026-10-23.db' RESTORE_BACKUP='/opt/shopeasy/backups/shopeasy-offsite-NAAM.jsonl.gz.enc' node /opt/shopeasy/scripts/restore-database.mjs --backup '/opt/shopeasy/backups/shopeasy-offsite-NAAM.jsonl.gz.enc' --confirm-restore
