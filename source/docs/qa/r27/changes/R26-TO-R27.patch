tchpriority=\"high\" decoding=\"async\">\n        <span class=\"v17-image-caption\"><span class=\"v17-image-caption-dot\"></span><%= pageText(locale==='ar'?'اختيار من المتجر':locale==='ckb'?'هەڵبژاردەی فرۆشگا':'A selection from the store') %></span>\n      </div>\n    <% } else if(heroProduct){ %>\n      <a class=\"v17-spotlight-card\" href=\"/product/<%= encodeURIComponent(heroProduct.slug) %>\" aria-label=\"<%= heroProduct.name %>\">\n        <div class=\"v17-spotlight-image-wrap\">\n          <img class=\"v17-spotlight-image\" src=\"<%= safeImageUrl(heroProduct.image_url) %>\" data-fallback-src=\"/assets/product-placeholder.svg\" alt=\"<%= heroProduct.name %>\" width=\"1000\" height=\"1100\" fetchpriority=\"high\" decoding=\"async\">\n          <span class=\"v17-spotlight-label\"><span class=\"v17-image-caption-dot\"></span><%= pageText(locale==='ar'?'من منتجات المتجر':locale==='ckb'?'لە بەرهەمەکانی فرۆشگا':'From your catalogue') %></span>\n        </div>\n        <div class=\"v17-spotlight-details\">\n          <div class=\"v17-spotlight-copy\"><span class=\"v17-mini-label\" data-no-translate><%= heroProduct.category_name || pageText(locale==='ar'?'اختيار المتجر':locale==='ckb'?'بەرهەم':'Store pick') %></span><h2 data-no-translate><%= heroProduct.name %></h2><% if(heroProduct.short_description){ %><p data-no-translate><%= heroProduct.short_description %></p><% } %></div>\n          <div class=\"v17-spotlight-purchase\"><strong><%= formatPrice(effectivePrice(heroProduct),currency) %></strong><span class=\"v17-round-arrow\" aria-hidden=\"true\">↗</span></div>\n        </div>\n      </a>\n    <% } else { %>\n      <div class=\"v17-empty-spotlight\">\n        <div class=\"v17-empty-art\" aria-hidden=\"true\"><span class=\"v17-art-orbit\"></span><span class=\"v17-art-box v17-art-box-back\"></span><span class=\"v17-art-box v17-art-box-front\"></span><span class=\"v17-art-line\"></span></div>\n        <div class=\"v17-empty-copy\"><span class=\"v17-mini-label\"><%= pag