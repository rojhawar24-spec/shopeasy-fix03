artials/purchase-journey',{journeyStage:'confirmation'}) %>\n<% if(typeof securityNotice!=='undefined' && securityNotice){ %><section class=\"container\"><div class=\"alert\" role=\"status\"><%= customerText(locale==='nl'?'Je beveiligingscontrole is verlopen. Er is geen wijziging aan de bestelling verzonden. Controleer de huidige bestelstatus voordat je een nieuw verzoek indient.':'Your security check expired. No order update was submitted. Review the current order status before sending another request.') %></div></section><% } %>\n<section class=\"auth-wrap\"><div class=\"auth-card success-card success-card-v5\">\n  <div class=\"success-mark success-mark-v5\"><%= customerText(cancelled?'!':'✓') %></div>\n  <span class=\"eyebrow\"><%= cancelled?copy.cancelledEyebrow:copy.orderEyebrow+' #'+order.id %></span>\n  <h1><%= cancelled?copy.cancelledTitle:copy.receivedTitle %></h1>\n  <% if(cancelled&&order.payment_provider!=='mollie'){ %><p><%= copy.cancelledBody %></p>\n  <% } else if(order.payment_provider==='cash_on_delivery'){ %><p><%= order.status==='pending'?copy.cashPending:order.payment_reference?copy.cashRecorded:copy.cashStatus.replace('{status}',statusText) %></p><div class=\"success-summary success-summary-v5\"><span><%= copy.totalCash %></span><strong><%= formatPrice(order.total_cents,order.currency) %></strong></div>\n  <% } else if(order.payment_provider==='bank_transfer'){ %><div class=\"provider-payment-status\" role=\"status\"><strong><%= customerText(locale==='nl'?'Bankoverschrijving':locale==='ckb'?'گواستنەوەی بانکی':locale==='ar'?'تحويل مصرفي':'Bank transfer') %></strong><p><%= customerText(order.status==='pending'?(locale==='nl'?'Je bestelling is ontvangen, maar nog niet betaald. Maak het exacte bedrag over met de unieke referentie hieronder. De winkel bevestigt de betaling nadat de overschrijving op de bankrekening is ontvangen.':locale==='ckb'?'داواکارییەکەت وەرگیراوە، بەڵام هێشتا پارە نەدراوە. بڕی ورد بە ژمارەی تایبەتی خوارەوە بنێرە. فرۆشگا دوای وە