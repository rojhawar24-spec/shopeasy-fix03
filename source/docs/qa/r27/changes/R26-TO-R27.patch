ome-login.js?v=2027-r26\" defer></script><% } %>\n</body></html>\n","partials/header.ejs":"<%\n  const titleTranslations = {\n    fr: {'Home':'Accueil','Shop':'Boutique','Account':'Compte','Cart':'Panier','Checkout':'Paiement','Sign in':'Se connecter','Create account':'Créer un compte','Products':'Produits','Product not found':'Produit introuvable','Order not found':'Commande introuvable','Page not found':'Page introuvable','FAQ':'Questions fréquentes','Contact':'Contact','Terms':'Conditions générales','Privacy':'Confidentialité','Shipping & returns':'Livraison et retours','Business information':'Mentions légales','Withdrawal form':'Formulaire de rétractation','Store manager':'Gestion de la boutique','Store settings':'Paramètres de la boutique','Categories':'Catégories','Order status':'Statut de commande','Wishlist':'Favoris','Orders':'Commandes','Customers':'Clients','Product':'Produit','Account security':'Sécurité du compte'},\n    nl: {'Home':'Startpagina','Account security':'Accountbeveiliging','Account':'Account','Cart':'Winkelmandje','Checkout':'Afrekenen','Forgot your password?':'Wachtwoord vergeten?','Create account':'Account aanmaken','Sign in':'Inloggen','Information':'Informatie','Shop':'Winkel','Stories':'Verhalen','Checkout cancelled':'Afrekenen geannuleerd','Order status':'Bestelstatus','Wishlist':'Verlanglijst','Audit log':'Auditlogboek','Storefront branding':'Winkelpresentatie','Categories':'Categorieën','Coupons':'Kortingsbonnen','Customers':'Klanten','Store manager':'Winkelbeheer','Orders':'Bestellingen','Products':'Producten','Store settings':'Winkelinstellingen','Add product':'Product toevoegen','Edit product':'Product bewerken','Add story':'Verhaal toevoegen','Edit story':'Verhaal bewerken','Privacy':'Privacy','Terms':'Voorwaarden','Shipping & returns':'Verzending & retouren','FAQ':'Veelgestelde vragen','Contact':'Contact','Business information':'Bedrijfsgegevens','Withdrawal form':'Herroepingsformulier','Page not found':'Pagina niet gevonden','