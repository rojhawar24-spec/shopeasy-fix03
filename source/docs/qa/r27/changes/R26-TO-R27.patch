= locale==='fr'?'Choisir la langue':'Choose language' %>\"><input type=\"hidden\" name=\"_csrf\" value=\"<%= csrf %>\"><input type=\"hidden\" name=\"returnTo\" value=\"<%= returnTo||path||'/' %>\"><label class=\"sr-only\" for=\"site-language\"><%= locale==='fr'?'Langue':'Language' %></label><select id=\"site-language\" name=\"language\" data-language-select aria-label=\"Language\"><% if((availableUiLocales||['en','ckb','ar','nl','fr']).includes('en')){ %><option value=\"en\" <%= locale==='en'?'selected':'' %>>English</option><% } %><% if((availableUiLocales||['en','ckb','ar','nl','fr']).includes('ckb')){ %><option value=\"ckb\" <%= locale==='ckb'?'selected':'' %>>کوردی (سۆرانی)</option><% } %><% if((availableUiLocales||['en','ckb','ar','nl','fr']).includes('ar')){ %><option value=\"ar\" <%= locale==='ar'?'selected':'' %>>العربية</option><% } %><% if((availableUiLocales||['en','ckb','ar','nl','fr']).includes('nl')){ %><option value=\"nl\" <%= locale==='nl'?'selected':'' %>>Nederlands</option><% } %><% if((availableUiLocales||['en','ckb','ar','nl','fr']).includes('fr')){ %><option value=\"fr\" <%= locale==='fr'?'selected':'' %>>Français</option><% } %></select><noscript><button class=\"language-apply\" type=\"submit\"><%= locale==='fr'?'Appliquer':'Apply' %></button></noscript></form><% if(appearance.darkMode&&!isAdminRoute){ %><button type=\"button\" class=\"theme-toggle theme-toggle-inline\" data-theme-toggle data-no-translate aria-label=\"<%= themeModeLabel %>\" aria-pressed=\"false\" title=\"<%= themeModeLabel %>\"><span data-theme-icon aria-hidden=\"true\">☾</span><span class=\"sr-only\" data-theme-label><%= themeModeLabel %></span></button><% } %></div></div></div>\n<header class=\"site-header\">\n  <div class=\"container nav-row\">\n    <a class=\"brand\" href=\"/\" aria-label=\"<%= storeName %> home\"><img class=\"brand-logo\" src=\"<%= safeImageUrl(shopLogo) %>\" alt=\"\" width=\"38\" height=\"38\"><span class=\"brand-word\"><%= storeName %></span></a>\n    <