+  let currentEntry;
+  try{currentEntry=fs.lstatSync(current);}catch(error){if(error.code!=='ENOENT')throw error;}
+  if(currentEntry) {
+    if(!fs.lstatSync(current).isSymbolicLink())throw new Error('current must be a symbolic link.');
