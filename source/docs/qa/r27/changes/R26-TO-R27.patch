e %></code></p><% if(bankTransferInfo.instructions){ %><p><%= bankTransferInfo.instructions %></p><% } %><p class=\"field-note\"><%= customerText(locale==='nl'?'Vermeld uitsluitend deze referentie. De bestelling blijft onbetaald totdat de winkel de inkomende betaling handmatig heeft gecontroleerd.':'Use this reference exactly. The order remains unpaid until the store manually verifies the incoming payment.') %></p></div><% } else { %><div class=\"success-summary success-summary-v5\"><span><%= copy.total %></span><strong><%= formatPrice(order.total_cents,order.currency) %></strong></div><% } %>\n  <% } else if(order.payment_provider==='mollie'){ %><div class=\"provider-payment-status\" role=\"status\"><strong><%= (providerCopy[locale]||providerCopy.en).payment %></strong><p><%= providerMessage %></p></div><div class=\"success-summary success-summary-v5\"><span><%= (providerCopy[locale]||providerCopy.en).total %></span><strong><%= formatPrice(order.total_cents,order.currency) %></strong></div><% if(order.status==='pending'&&order.payment_url&&['pending','verification_unavailable'].includes(providerPaymentMessage)){ %><a class=\"btn btn-dark btn-wide provider-payment-retry\" href=\"<%= order.payment_url %>\" rel=\"nofollow noopener noreferrer\"><%= (providerCopy[locale]||providerCopy.en).retry %></a><% } %>\n  <% } else { %><p><%= copy.help %></p><div class=\"success-summary success-summary-v5\"><span><%= copy.total %></span><strong><%= formatPrice(order.total_cents,order.currency) %></strong></div><% } %>\n  <% if(!cancelled&&order.items?.length){ %><div class=\"success-items\"><h2><%= copy.items %></h2><% order.items.forEach(item=>{ %><div class=\"order-item\"><span><%= item.product_name %><% if(item.variant_value){ %><small class=\"order-variant\"><%= item.variant_name %>: <%= item.variant_value %><% if(item.variant_value_2){ %> · <%= item.variant_name_2 %>: <%= item.variant_value_2 %><% } %></small><% } %> × <%= item.quantity %></span><strong><%= formatPrice(item.total_cents,order.currency) %></strong></div><% }) %></div><% } %>\n  <% if(orderHistory?.length){ %><div class=\"success-items\"><h2><%= copy.progress %></h2><ol class=\"form-stack order-history-list\"><% orderHistory.forEach(event=>{ %><li><strong><%= (currentState[locale]||currentState.en)[event.to_status]||(currentState.en[event.to_status]||event.to_status) %></strong> <small class=\"muted\"><time datetime=\"<%= event.created_at %>\" title=\"<%= formatDateTimeDisplay(event.created_at,storeTimeZone) %>\"><%= formatDateTimeDisplay(event.created_at,storeTimeZone) %></time></small><% if(event.note){ %><p class=\"muted\"><%= event.note %></p><% } %></li><% }) %></ol><p class=\"muted\"><%= copy.latest %></p></div><% } %>\n  <% if(returns?.length){ %><div class=\"success-items\"><h2><%= copy.returns %></h2><% returns.forEach(r=>{ %><div class=\"order-item\"><span><strong>#<%= r.id %> · <%= r.request_type %></strong><small class=\"order-variant\"><%= r.product_name %> × <%= r.quantity %></small></span><span class=\"status status-<%= r.status %>\"><%= r.status %></span><% if(r.refund_recorded_at){ %><strong><%= formatPrice(r.refund_amount_cents,order.currency) %><%= customerText(\" recorded\") %></strong><% } %></div><% }) %></div><% } %>\n  <% if(typeof returnResult!=='undefined'&&returnResult==='requested'){ %><div class=\"success-alert\" role=\"status\"><%= copy.returnRequested %></div><% } else if(typeof returnResult!=='undefined'&&returnResult==='error'){ %><div class=\"alert\" role=\"alert\"><%= copy.returnError %></div><% } %>\n  <% if(!cancelled&&order.status==='completed'&&(isGuestOrder||isOwner)){ %>\n    <div class=\"success-items order-after-sales-form\"><h2><%= copy.returnRequestTitle %></h2><p class=\"muted\"><%= copy.returnIntro %></p><form class=\"form-stack\" method=\"post\" action=\"/checkout/success/returns\" data-confirm=\"<%= customerText(\"Send this after-sales request to the store for review?\") %>\"><input type=\"hidden\" name=\"_csrf\" value=\"<%= csrf %>\"><input type=\"hidden\" name=\"orderId\" value=\"<%= order.id %>\"><label><%= copy.returnItem %><select name=\"orderItemId\" required><option value=\"\"><%= copy.returnItem %></option><% order.items.forEach(item=>{ %><option value=\"<%= item.id %>\"><%= item.product_name %><% if(item.variant_value){ %> · <%= item.variant_name||'Option' %>: <%= item.variant_value %><% if(item.variant_value_2){ %> · <%= item.variant_name_2||'Option 2' %>: <%= item.variant_value_2 %><% } %><% } %> · × <%= item.quantity %></option><% }) %></select></label><label><%= copy.returnQuantity %><input type=\"number\" name=\"quantity\" min=\"1\" max=\"99\" step=\"1\" value=\"1\" required></label><label><%= copy.returnType %><select name=\"requestType\" required><option value=\"return\"><%= copy.returnTypeReturn %></option><option value=\"exchange\"><%= copy.returnTypeExchange %></option><option value=\"refund\"><%= copy.returnTypeRefund %></option></select></label><label><%= copy.returnReason %><textarea name=\"reason\" required minlength=\"5\" maxlength=\"1000\" rows=\"3\"></textarea></label><button type=\"submit\" class=\"btn btn-dark\"><%= copy.returnSubmit %></button></form></div>\n  <% } %>\n  <% if(cancelResult&&notice[cancelResult]){ %><div class=\"<%= cancelResult==='cancelled'?'success-alert':'alert' %>\" role=\"status\"><%= notice[cancelResult] %></div><% } %>\n  <% if(!cancelled&&['pending','processing'].includes(order.status)&&!(order.status==='pending'&&order.payment_provider==='mollie')){ %>\n    <div class=\"rule\"></div><h2><%= customerText(locale==='nl'?(order.status==='pending'&&order.payment_provider!=='bank_transfer'?'Bestelling annuleren':'Annulering aanvragen'):(order.status==='pending'&&order.payment_provider!=='bank_transfer'?'Cancel this order':'Request cancellation')) %></h2>\n    <% const needsManagerReview=order.status==='processing'||(order.status==='pending'&&order.payment_provider==='bank_transfer'); %>\n    <% if(needsManagerReview&&order.cancellation_request_decision==='pending'){ %><div class=\"alert\" role=\"status\"><%= customerText(locale==='nl'?'De winkel beoordeelt al een annuleringsverzoek.':'A cancellation request is already being reviewed by the store.') %></div>\n    <% } else { %><p class=\"muted\"><%= customerText(locale==='nl'?(order.status==='pending'&&order.payment_provider==='bank_transfer'?'Een bankoverschrijving kan onderweg zijn voordat deze zichtbaar is. Vraag annulering aan; de winkel controleert eerst de betaling.':order.status==='pending'?'Je kunt de bestelling annuleren voordat de winkel deze accepteert.':'De winkel heeft de bestelling geaccepteerd. Je kunt nog annulering aanvragen, maar de voorbereiding voor levering kan al begonnen zijn.'):(order.status==='pending'&&order.payment_provider==='bank_transfer'?'A bank transfer may still be in transit before it appears on the statement. Request cancellation so the store can check for an incoming payment first.':order.status==='pending'?'You can cancel before the store accepts the order.':'The store has accepted the order. You can request cancellation, but delivery may already be in preparation.')) %></p>\n      <form class=\"form-stack\" method=\"post\" action=\"<%= isGuestOrder?'/checkout/success/cancel':`/account/order/${order.id}/cancel` %>\"><input type=\"hidden\" name=\"_csrf\" value=\"<%= csrf %>\"><% if(isGuestOrder){ %><input type=\"hidden\" name=\"orderId\" value=\"<%= order.id %>\"><% } %><label><%= customerText(locale==='nl'?(needsManagerReview?'Reden voor annulering *':'Reden (optioneel)'):(needsManagerReview?'Reason for cancellation *':'Reason (optional)')) %><textarea name=\"reason\" <%= needsManagerReview?'required':'' %> maxlength=\"500\" rows=\"3\" placeholder=\"<%= locale==='nl'?(needsManagerReview?'Leg uit waarom je wilt annuleren.':'Optionele reden.'):(needsManagerReview?'Explain why you need to cancel.':'Optional reason.') %>\"></textarea></label><button type=\"submit\" class=\"btn btn-light\"><%= customerText(locale==='nl'?(needsManagerReview?'Annulering aanvragen':'Bestelling annuleren'):(needsManagerReview?'Request cancellation':'Cancel order')) %></button></form>\n    <% } %>\n  <% } %>\n  <% if(isGuestOrder&&typeof guestOrderAccessCode==='string'&&guestOrderAccessCode){ %>\n  <details class=\"tip-box\"><summary><%= customerText(\"Private order access code\") %></summary><p><%= customerText(\"Keep this code private. Save it securely to open this guest order on another browser. Anyone with this code and your order details can access the order.\") %></p><code data-no-translate><%= guestOrderAccessCode %></code></details>\n  <% } %>\n  <div class=\"hero-actions\"><a class=\"btn btn-dark\" href=\"<%= isGuestOrder?'/register':'/account' %>\"><%= isGuestOrder?copy.createAccount:copy.account %></a><a class=\"text-link\" href=\"/shop\"><%= copy.continue %></a></div>\n</div></section>\n<%- include('partials/footer') %>\n","wishlist.ejs":"<%- include('partials/header',{title:'Wishlist'}) %>\n<section class=\"container page-head\"><%- include('partials/back-button', { fallback: '/account' }) %><span class=\"eyebrow\"><%= customerText(\"SAVED FOR LATER\") %></span><h1><%= customerText(\"Your wishlist\") %></h1><p><%= customerText(\"Keep products you like in one place and add them to your bag whenever you're ready.\") %></p></section>\n<section class=\"container section\">\n  <% if(!products.length){ %>\n    <div class=\"empty\"><span class=\"empty-icon\">♡</span><h2><%= customerText(\"Your wishlist is empty.\") %></h2><p><%= customerText(\"Save products from the shop to find them here later.\") %></p><a class=\"btn btn-dark\" href=\"/shop\"><%= customerText(\"Browse products\") %></a></div>\n  <% } else { %>\n    <div class=\"product-grid product-grid-signature\">\n      <% products.forEach(p=>{ %>\n        <%- include('partials/product-card',{p:p}) %>\n      <% }) %>\n    </div>\n  <% } %>\n</section>\n<%- include('partials/footer') %>","withdrawal-form.ejs":"<%- include('partials/header', {title: title}) %>\n<section class=\"container page-head policy-head\">\n  <%- include('partials/back-button', {fallback: '/shipping-returns'}) %>\n  <span class=\"eyebrow\"><%= customerText(locale==='nl'?'CONSUMENTENRECHTEN':locale==='ckb'?'مافی کڕیار':locale==='ar'?'حقوق المستهلك':'CONSUMER RIGHTS') %></span>\n  <h1><%= customerText(locale==='nl'?'Modelformulier voor herroeping':locale==='ckb'?'فۆرمی نموونەی پاشگەزبوونەوە':locale==='ar'?'نموذج العدول عن الشراء':'Model withdrawal form') %></h1>\n  <p><%= customerText(locale==='nl'?'Gebruik dit formulier als het herroepingsrecht op je aankoop van toepassing is. Je bent niet verplicht dit formulier te gebruiken.':locale==='ckb'?'ئەگەر مافی پاشگەزبوونەوە بۆ کڕینەکەت دەگونجێت، دەتوانیت ئەم فۆرمە بەکاربهێنیت؛ بەکارهێنانی ئەم فۆرمە مەرج نییە.':locale==='ar'?'يمكنك استخدام هذا النموذج إذا كان حق العدول ينطبق على مشترياتك؛ ولا يشترط استخدام هذا النموذج.':'You can use this model if the right of withdrawal applies to your purchase; use of this particular form is optional.') %></p>\n</section>\n<section class=\"container section policy-section\">\n  <article class=\"panel policy-copy withdrawal-model\">\n    <p><strong><%= customerText(locale==='nl'?'Aan':locale==='ckb'?'بۆ':locale==='ar'?'إلى':'To') %>:</strong> <%= legalName||storeName %><% if(businessAddress){ %>, <%= businessAddress %><% } %><% if(supportEmail){ %> · <a href=\"mailto:<%= supportEmail %>\"><%= supportEmail %></a><% } %></p>\n    <p><%= customerText(locale==='nl'?'Hierbij deel ik mee dat ik de overeenkomst betreffende de volgende goederen/diensten wil herroepen:':locale==='ckb'?'بەمە ئاگادارتان دەکەمەوە کە دەمەوێت لە گرێبەستی کڕینی ئەم کاڵا/خزمەتگوزارییانە پاشگەز ببمەوە:':locale==='ar'?'أبلغكم برغبتي في العدول عن العقد المتعلق بالسلع/الخدمات التالية:':'I hereby give notice that I wish to withdraw from my contract of sale of the following goods/services:') %></p>\n    <div class=\"withdrawal-line\" aria-hidden=\"true\"></div>\n    <dl class=\"legal-detail-list\">\n      <div><dt><%= customerText(locale==='nl'?'Bestelnummer':locale==='ckb'?'ژمارەی داواکاری':locale==='ar'?'رقم الطلب':'Order reference') %></dt><dd class=\"withdrawal-blank\">______________________________</dd></div>\n      <div><dt><%= customerText(locale==='nl'?'Besteld op / ontvangen op':locale==='ckb'?'ڕێکەوتی داواکردن / وەرگرتن':locale==='ar'?'تاريخ الطلب / الاستلام':'Ordered on / received on') %></dt><dd class=\"withdrawal-blank\">______________________________</dd></div>\n      <div><dt><%= customerText(locale==='nl'?'Naam consument':locale==='ckb'?'ناوی کڕیار':locale==='ar'?'اسم المستهلك':'Consumer name') %></dt><dd class=\"withdrawal-blank\">______________________________</dd></div>\n      <div><dt><%= customerText(locale==='nl'?'Adres consument':locale==='ckb'?'ناونیشانی کڕیار':locale==='ar'?'عنوان المستهلك':'Consumer address') %></dt><dd class=\"withdrawal-blank\">______________________________</dd></div>\n      <div><dt><%= customerText(locale==='nl'?'Datum':locale==='ckb'?'ڕێکەوت':locale==='ar'?'التاريخ':'Date') %></dt><dd class=\"withdrawal-blank\">______________________________</dd></div>\n      <div><dt><%= customerText(locale==='nl'?'Handtekening (alleen op papier)':locale==='ckb'?'واژۆ (تەنها لە کاغەز)':locale==='ar'?'التوقيع (للنسخة الورقية فقط)':'Signature (paper form only)') %></dt><dd class=\"withdrawal-blank\">______________________________</dd></div>\n    </dl>\n    <p><%= customerText(locale==='nl'?'In België en andere toepasselijke EU-consumentenverkopen geldt doorgaans een herroepingstermijn van 14 dagen, met wettelijke uitzonderingen. De regels in andere landen kunnen verschillen. Raadpleeg het retourbeleid van deze winkel.':locale==='ckb'?'لە هەندێک کڕینی کڕیاری یەکێتی ئەوروپادا بە گشتی ١٤ ڕۆژ مافی پاشگەزبوونەوە هەیە، بەڵام جیاوازیی یاسایی هەیە. لە وڵاتانی تر ڕێساکان جیاوازن. سیاسەتی گەڕاندنەوەی ئەم فرۆشگایە بخوێنەرەوە.':locale==='ar'?'تسري عادةً مهلة 14 يومًا على مشتريات المستهلك المؤهلة في الاتحاد الأوروبي، مع استثناءات قانونية. قد تختلف القواعد في الدول الأخرى. راجع سياسة إرجاع المتجر.':'Eligible EU consumer sales normally have a 14-day withdrawal period, subject to legal exceptions. Rules may differ outside the EU. Consult this store’s returns policy.') %></p>\n    <p><a href=\"/shipping-returns\"><%= customerText(locale==='nl'?'Retourbeleid lezen':locale==='ckb'?'سیاسەتی گەڕاندنەوە بخوێنەوە':locale==='ar'?'قراءة سياسة الإرجاع':'Read the returns policy') %></a><% if(supportEmail){ %> · <a href=\"mailto:<%= supportEmail %>?subject=<%= encodeURIComponent('Withdrawal request') %>\"><%= customerText(locale==='nl'?'Stuur een e-mail naar de winkel':locale==='ckb'?'ئیمەیڵ بۆ فرۆشگا بنێرە':locale==='ar'?'أرسل بريدًا للمتجر':'Email the store') %></a><% } %></p>\n    <p class=\"field-note\"><%= customerText(locale==='nl'?'Je kunt deze pagina afdrukken via de afdrukfunctie van je browser.':locale==='ckb'?'دەتوانیت لە ڕێگەی وێبگەڕەکەت ئەم پەڕەیە چاپ بکەیت.':locale==='ar'?'يمكنك طباعة هذه الصفحة من المتصفح.':'Use your browser’s Print command to print this form.') %></p>\n  </article>\n</section>\n<%- include('partials/footer') %>\n"};
 export default Object.freeze(views);
