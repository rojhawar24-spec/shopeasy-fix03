ng><span><%= pageText(locale==='ckb'?'زانیاری گەیاندن و گەڕاندنەوە بخوێنەوە.':locale==='ar'?'راجع معلومات الشحن والإرجاع.':locale==='nl'?'Lees de informatie over verzending en retouren.':'Read shipping and return details before ordering.') %></span></a>\n</section>\n<% if (newProducts && newProducts.length) { %>\n<section id=\"new-arrivals\" class=\"container section new-arrivals-section\"><div class=\"section-head\"><div><span class=\"eyebrow\"><%= pageText(locale === 'ckb' ? 'تازە زیادکراوەکان' : locale === 'ar' ? 'أُضيفت حديثًا' : locale === 'nl' ? 'NIEUW TOEGEVOEGD' : 'JUST ADDED') %></span><h2><%= pageText(locale === 'ckb' ? 'بەرهەمی نوێ لە فرۆشگا' : locale === 'ar' ? 'أحدث المنتجات' : locale === 'nl' ? 'Nieuw in de winkel' : 'New in the shop') %></h2></div><a class=\"text-link\" href=\"/shop?sort=newest\"><%= pageText(locale === 'ckb' ? 'هەموو بەرهەمەکان ←' : locale === 'ar' ? 'كل المنتجات ←' : locale === 'nl' ? 'Bekijk alle producten →' : 'See all products →') %></a></div><div class=\"product-grid product-grid-signature\"><% newProducts.forEach(p=>{ %><%- include('partials/product-card',{p:p}) %><% }) %></div></section>\n<% } %>\n\n<% if (aiEnabled) { %><section class=\"container section ai-card\"><div><span class=\"eyebrow\"><%= pageText(\"OPTIONAL AI\") %></span><h2><%= pageText(locale==='nl'?'Hulp nodig bij het kiezen?':locale==='ckb'?'یارمەتی بۆ هەڵبژاردن؟':locale==='ar'?'هل تحتاج إلى مساعدة في الاختيار؟':'A little help choosing?') %></h2><p><%= pageText(locale==='nl'?'Stel een korte productvraag aan de winkelassistent.':locale==='ckb'?'پرسیارێکی کورت دەربارەی بەرهەمەکان بکە.':locale==='ar'?'اطرح سؤالًا قصيرًا عن منتجات المتجر.':'Ask a quick question about products in this store.') %></p></div><div class=\"ai-form\"><label for=\"ai-input\"><%= pageText(locale==='nl'?'Je vraag':locale==='ckb'?'پرسیارەکەت':locale==='ar'?'سؤالك':'Your question') %></label><div class=\"ai-input-row\"><input id=\"ai-input\" maxlength=\"500\" placeholder=\"<%= pageText(locale==='nl'?'Wat is handig voor dagelijks woon-werkverkeer?':locale==='ckb'?'کام بەرهەم بۆ بەکارهێنانی ڕۆژانە باشە؟':locale==='ar'?'ما المنتج المناسب للاستخدام اليومي؟':'What works well for daily travel?') %>\"><button type=\"button\" class=\"btn btn-dark\" data-ai-ask><%= pageText(locale==='nl'?'Vraag':locale==='ckb'?'بپرسە':locale==='ar'?'اسأل':'Ask') %></button></div><p class=\"field-note\"><%= pageText(locale==='nl'?'Je vraag en maximaal 12 openbare productgegevens (naam, omschrijving, actuele verkoopprijs met winkelvaluta, verkoopbare voorraad na reserveringen en productslug) worden naar de ingestelde AI-provider gestuurd. Duidelijke e-mailadressen, telefoonnummers, IBAN-achtige waarden en herkenbare straatadressen worden verwijderd, maar niet alle persoonlijke gegevens kunnen automatisch worden herkend. Deel hier daarom nooit namen, adressen, contactgegevens, rekeningnummers, bestelgegevens, wachtwoorden of betaalgegevens. De externe AI-provider verwerkt de verzonden tekst volgens zijn eigen voorwaarden en bewaartermijn.':locale==='ckb'?'پرسیارەکەت و زۆرترین ١٢ زانیاریی گشتیی بەرهەم (ناو، وەسف، نرخی فرۆشتنی ئێستا بە دراوی فرۆشگا، بڕی فرۆشتنی بەردەست دوای لەبەرگرتنەوە و بەستەری بەرهەم) بۆ دابینکەری AI دەنێردرێن. ئیمەیڵی ئاشکرا، ژمارەی تەلەفۆن، IBAN ـی هاوشێوە و ناونیشانی شەقام کە بە ئاشکرایی بناسرێتەوە دەسڕدرێنەوە، بەڵام هەموو زانیارییە کەسییەکان ناناسێتەوە. ناو، ناونیشان، زانیاریی پەیوەندی، ژمارەی هەژمار، وردەکاریی داواکاری، وشەی نهێنی یان زانیاریی پارەدان مەنووسە. دابینکەری دەرەکی AI دەقە نێردراوەکان بە پێی مەرج و ماوەی هەڵگرتنی خۆی پرۆسێس دەکات.':locale==='ar'?'يُرسل سؤالك وما يصل إلى 12 حقلًا عامًا للمنتجات (الاسم والوصف وسعر البيع الحالي بعملة المتجر والكمية المتاحة للبيع بعد الحجوزات ومعرّف المنتج) إلى مزود الذكاء الاصطناعي المُعدّ. تُزال عناوين البريد الواضحة وأرقام الهواتف والقيم الشبيهة بـ IBAN وعناوين الشوارع التي يمكن التعرف عليها قبل الإرسال، لكن لا يمكن اكتشاف كل البيانات الشخصية تلقائيًا. لا تكتب أسماء أو عناوين أو معلومات اتصال أو أرقام حسابات أو تفاصيل طلبات أو كلمات مرور أو بيانات دفع. يعالج مزود الذكاء الاصطناعي الخارجي النص المرسل وفق شروطه وفترة الاحتفاظ الخاصة به.':'Your question and up to 12 public product fields (name, description, current selling price in the store currency, sellable stock after reservations and product slug) are sent to the configured AI provider. Obvious email addresses, phone numbers, IBAN-like values and recognizable street addresses are removed, but not all personal information can be detected automatically. Never enter names, addresses, contact details, account numbers, order details, passwords or payment data. The external AI provider processes submitted text under its own terms and retention policy.') %></p><div id=\"ai-answer\" class=\"ai-answer\" aria-live=\"polite\"></div></div></section><% } %>\n<%- include('partials/footer') %>","imprint.ejs":"<%- include('partials/header', {title: title}) %>\n<section class=\"container page-head policy-head\">\n  <%- include('partials/back-button', {fallback: '/'}) %>\n  <span class=\"eyebrow\"><%= customerText(locale==='nl'?'TRANSPARANTIE':locale==='ckb'?'ڕوونی':locale==='ar'?'الشفافية':'TRANSPARENCY') %></span>\n  <h1><%= customerText(locale==='nl'?'Bedrijfsgegevens':locale==='ckb'?'زانیاریی کۆمپانیا':locale==='ar'?'معلومات الشركة':'Business information') %></h1>\n  <p><%= customerText(locale==='nl'?'Dit zijn de gegevens die de winkelbeheerder heeft ingevuld.':locale==='ckb'?'ئەمە ئەو زانیارییانەن کە بەڕێوەبەری فرۆشگا تۆماری کردوون.':locale==='ar'?'هذه هي البيانات التي أدخلها مدير المتجر.':'These are the business details provided by the store operator.') %></p>\n</section>\n<section class=\"container section policy-section\">\n  <article class=\"panel policy-copy business-imprint\" aria-label=\"<%= title %>\">\n    <dl class=\"legal-detail-list\">\n      <div><dt><%= customerText(locale==='nl'?'Winkelnaam':locale==='ckb'?'ناوی فرۆشگا':locale==='ar'?'اسم المتجر':'Store name') %></dt><dd><%= storeName %></dd></div>\n      <% if(legalName){ %><div><dt><%= customerText(locale==='nl'?'Juridische naam':locale==='ckb'?'ناوی یاسایی':locale==='ar'?'الاسم القانوني':'Legal business name') %></dt><dd><%= legalName %></dd></div><% } %>\n      <% if(businessAddress){ %><div><dt><%= customerText(locale==='nl'?'Vestigingsadres':locale==='ckb'?'ناونیشانی کار':locale==='ar'?'عنوان النشاط':'Business address') %></dt><dd><%= businessAddress %></dd></div><% } %>\n      <% if(enterpriseNumber){ %><div><dt><%= customerText(locale==='nl'?'Ondernemingsnummer / registratie':locale==='ckb'?'ژمارەی تۆمار':locale==='ar'?'رقم التسجيل':'Business registration') %></dt><dd><%= enterpriseNumber %></dd></div><% } %>\n      <% if(vatNumber){ %><div><dt><%= customerText(locale==='nl'?'Btw-nummer':locale==='ckb'?'ژمارەی باج':locale==='ar'?'الرقم الضريبي':'Tax / VAT number') %></dt><dd><%= vatNumber %></dd></div><% } %>\n      <% if(supportEmail){ %><div><dt><%= customerText(locale==='nl'?'E-mail':locale==='ckb'?'ئیمەیڵ':locale==='ar'?'البريد الإلكتروني':'Email') %></dt><dd><a href=\"mailto:<%= supportEmail %>\"><%= supportEmail %></a></dd></div><% } %>\n      <% if(businessPhone){ %><div><dt><%= customerText(locale==='nl'?'Telefoon':locale==='ckb'?'تەلەفۆن':locale==='ar'?'الهاتف':'Telephone') %></dt><dd><a href=\"tel:<%= String(businessPhone).replace(/[^+0-9]/g,'') %>\"><%= businessPhone %></a></dd></div><% } %>\n    </dl>\n    <% if(!legalName||!businessAddress||!enterpriseNumber||!supportEmail||!businessPhone){ %>\n      <div class=\"alert\" role=\"note\"><%= customerText(locale==='nl'?'Niet alle bedrijfsgegevens zijn ingevuld. De winkelbeheerder moet de verplichte informatie voor het land van vestiging aanvullen voordat de winkel live gaat.':locale==='ckb'?'هەموو زانیارییەکانی کۆمپانیا پڕ نەکراونەتەوە. بەڕێوەبەر دەبێت پێش دەستپێکردنی فرۆشتن زانیاریی یاساییی پێویست تەواو بکات.':locale==='ar'?'لم تُستكمل جميع بيانات النشاط التجاري. يجب على مدير المتجر إضافة المعلومات القانونية المطلوبة قبل البيع.':'Some business identity fields are not configured. The operator must provide all legally required details for the actual merchant country before accepting live orders.') %></div>\n    <% } %>\n    <p><a href=\"/terms\"><%= customerText(locale==='nl'?'Algemene voorwaarden':locale==='ckb'?'مەرجەکان':locale==='ar'?'الشروط والأحكام':'Terms & conditions') %></a> · <a href=\"/privacy\"><%= customerText(locale==='nl'?'Privacybeleid':locale==='ckb'?'سیاسەتی تایبەتمەندی':locale==='ar'?'سياسة الخصوصية':'Privacy policy') %></a> · <a href=\"/shipping-returns\"><%= customerText(locale==='nl'?'Verzending en retouren':locale==='ckb'?'گەیاندن و گەڕاندنەوە':locale==='ar'?'الشحن والإرجاع':'Shipping and returns') %></a></p>\n  </article>\n</section>\n<%- include('partials/footer') %>\n","local-manager-recovery.ejs":"<%- include('partials/header',{title:title||'Local Manager recovery'}) %>\n<section class=\"auth-wrap\" id=\"main-content\">\n  <div class=\"auth-card local-manager-recovery-card\">\n    <span class=\"eyebrow\">LOCAL DEVELOPMENT ONLY</span>\n    <h1>Manager account recovery</h1>\n    <p class=\"muted\">This page is available only from this computer when ShopEasy is running in development mode with a local SQLite database. It is not a public password-reset page.</p>\n    <% if(error){ %><div class=\"alert\" role=\"alert\"><%= error %></div><% } %>\n    <% if(success){ %><div class=\"success-alert\" role=\"status\"><%= success %></div><% } %>\n    <section class=\"form-stack\" aria-labelledby=\"manager-status-heading\">\n      <h2 id=\"manager-status-heading\">Manager status</h2>\n      <% if(managerFound){ %>\n        <p><strong>Manager account:</strong> <%= managerName||'Store Manager' %></p>\n        <p><strong>Email:</strong> <%= managerEmail %></p>\n        <p><strong>Login status:</strong> <%= loginStatus %></p>\n        <p class=\"field-note\">This page does not display or change your authenticator secret or recovery codes.</p>\n        <div class=\"rule\"></div>\n        <h2>Option 1 · Unlock only</h2>\n        <p class=\"muted\">Use this if you know your current password and only want to clear the failed-login block. Your password and MFA remain unchanged.</p>\n        <form class=\"form-stack\" method=\"post\" action=\"/local-manager-recovery\">\n          <input type=\"hidden\" name=\"_csrf\" value=\"<%= csrf %>\">\n          <input type=\"hidden\" name=\"action\" value=\"unlock\">\n          <label>Confirm Manager email<input type=\"email\" name=\"managerEmail\" required maxlength=\"120\" autocomplete=\"off\" value=\"<%= managerEmail %>\"></label>\n          <label>Type UNLOCK MANAGER<input type=\"text\" name=\"confirmation\" required autocomplete=\"off\" spellcheck=\"false\"></label>\n          <button class=\"btn btn-dark btn-wide\" type=\"submit\">Clear login block</button>\n        </form>\n        <div class=\"rule\"></div>\n        <h2>Option 2 · Set a new password</h2>\n        <p class=\"muted\">Use this only if your current password is unknown or incorrect. Existing MFA settings are preserved.</p>\n        <form class=\"form-stack\" method=\"post\" action=\"/local-manager-recovery\">\n          <input type=\"hidden\" name=\"_csrf\" value=\"<%= csrf %>\">\n          <input type=\"hidden\" name=\"action\" value=\"reset-password\">\n          <label>Confirm Manager email<input type=\"email\" name=\"managerEmail\" required maxlength=\"120\" autocomplete=\"off\" value=\"<%= managerEmail %>\"></label>\n          <label>New password<input type=\"password\" name=\"newPassword\" required minlength=\"15\" maxlength=\"200\" autocomplete=\"new-password\"></label>\n          <label>Confirm new password<input type=\"password\" name=\"confirmPassword\" required minlength=\"15\" maxlength=\"200\" autocomplete=\"new-password\"></label>\n          <button class=\"btn btn-dark btn-wide\" type=\"submit\">Update Manager password</button>\n        </form>\n      <% } else { %>\n        <div class=\"alert\" role=\"status\"><%= loginStatus %></div>\n        <p class=\"muted\">The page will not create a new Manager or promote an Admin. Check the Manager bootstrap settings and restart the local application first.</p>\n      <% } %>\n    </section>\n    <p class=\"switch-auth\"><a href=\"/login\">Return to sign in</a></p>\n  </div>\n</section>\n<%- include('partials/footer') %>\n","login.ejs":"<%- include('partials/header',{title:mode==='register'?'Create account':'Sign in'}) %>\n<section class=\"auth-wrap\" aria-labelledby=\"auth-title\"><div class=\"auth-card\"><nav class=\"auth-tabs\" aria-label=\"<%= pageText('Account access') %>\"><a href=\"<%= next ? `/login?next=${encodeURIComponent(next)}` : '/login' %>\" <% if(mode==='login'){ %>aria-current=\"page\"<% } %>><%= pageText(\"Sign in\") %></a><a href=\"<%= next ? `/register?next=${encodeURIComponent(next)}` : '/register' %>\" <% if(mode==='register'){ %>aria-current=\"page\"<% } %>><%= pageText(\"Create account\") %></a></nav><span class=\"eyebrow\"><%= pageText(mode==='register'?'NEW CUSTOMER':'WELCOME BACK') %></span><h1 id=\"auth-title\"><%= pageText(mode==='register'?'Create your account':'Welcome back') %></h1><p class=\"muted\"><%= pageText(mode==='register'?'Join ShopEasy to track orders and check out faster.':'Sign in to your ShopEasy account.') %></p><% if(typeof passwordReset !== 'undefined' && passwordReset){ %><div class=\"success-alert\" role=\"status\"><%= pageText(\"Your password has been reset. Sign in with your new password.\") %></div><% } %><% if(typeof emailVerified !== 'undefined' && emailVerified){ %><div class=\"success-alert\" role=\"status\"><%= pageText(\"Your email address has been verified. You can sign in now.\") %></div><% } %><% if(typeof signInCancelled !== 'undefined' && signInCancelled){ %><div class=\"success-alert\" role=\"status\"><%= pageText(\"Sign-in was cancelled. Enter your credentials whenever you are ready to try again.\") %></div><% } %><% if(error){ %><div class=\"alert\" id=\"auth-error\" role=\"alert\" tabindex=\"-1\" data-auth-error><%= pageText(error) %></div><% } %><% if(typeof notice !== 'undefined' && notice){ %><div class=\"auth-next-step\" role=\"status\"><%= pageText(notice) %></div><% } %><% if(mode==='register'){ %><form class=\"form-stack\" method=\"post\" action=\"/register\"><input type=\"hidden\" name=\"next\" value=\"<%= next||'/account' %>\"><input type=\"hidden\" name=\"_csrf\" value=\"<%= csrf %>\"><label><%= pageText(\"Full name\") %><input type=\"text\" name=\"fullName\" required maxlength=\"120\" autocomplete=\"name\" placeholder=\"<%= pageText('Enter your full name') %>\" value=\"<%= fullName||'' %>\"></label><label><%= pageText(\"Email address\") %><input type=\"email\" name=\"email\" required maxlength=\"120\" autocomplete=\"email\" autocapitalize=\"none\" spellcheck=\"false\" placeholder=\"<%= pageText('Enter your email address') %>\" value=\"<%= email||'' %>\"></label><label><%= pageText(\"Password\") %><input type=\"password\" name=\"password\" required minlength=\"15\" maxlength=\"200\" autocomplete=\"new-password\" placeholder=\"<%= pageText('Create a password') %>\"><span class=\"field-note\"><%= pageText(\"Use 15–200 characters. Avoid common or repeated passwords.\") %></span></label><label><%= pageText(\"Confirm password\") %><input type=\"password\" name=\"confirmPassword\" required minlength=\"15\" maxlength=\"200\" autocomplete=\"new-password\" placeholder=\"<%= pageText('Re-enter your password') %>\"></label><label class=\"checkbox-inline auth-terms\"><input type=\"checkbox\" name=\"termsAccepted\" required><span><%= pageText(\"I agree to the \") %><a href=\"/terms\" target=\"_blank\" rel=\"noopener\"><%= pageText(\"Terms & Conditions\") %></a><%= pageText(\" and \") %><a href=\"/privacy\" target=\"_blank\" rel=\"noopener\"><%= pageText(\"Privacy Policy\") %></a><%= pageText(\".\") %></span></label><button type=\"submit\" class=\"btn btn-dark btn-wide\"><%= pageText(\"Create account\") %></button></form><p class=\"switch-auth\"><%= pageText(\"Already have an account? \") %><a href=\"<%= next ? `/login?next=${encodeURIComponent(next)}` : '/login' %>\"><%= pageText(\"Sign in\") %></a></p><% } else { %><form class=\"form-stack\" method=\"post\" action=\"/login\"><input type=\"hidden\" name=\"_csrf\" value=\"<%= csrf %>\"><input type=\"hidden\" name=\"next\" value=\"<%= next %>\"><label><%= pageText(\"Email address\") %><input type=\"email\" name=\"email\" required maxlength=\"120\" autocomplete=\"username\" autocapitalize=\"none\" spellcheck=\"false\" placeholder=\"<%= pageText('Enter your email address') %>\" value=\"<%= email||'' %>\"></label><label><%= pageText(\"Password\") %><input type=\"password\" name=\"password\" required maxlength=\"200\" id=\"login-password\" autocomplete=\"current-password\" placeholder=\"<%= pageText('Enter your password') %>\"></label><div class=\"auth-help\"><button type=\"button\" class=\"auth-password-toggle\" data-password-toggle data-labels=\"<%= JSON.stringify({show:pageText('Show password'),hide:pageText('Hide password')}) %>\" aria-controls=\"login-password\" aria-pressed=\"false\" hidden><%= pageText(\"Show password\") %></button><a class=\"text-link\" href=\"<%= next ? `/forgot-password?next=${encodeURIComponent(next)}` : '/forgot-password' %>\"><%= pageText(\"Forgot password?\") %></a></div><button type=\"submit\" class=\"btn btn-dark btn-wide\"><%= pageText(\"Sign in\") %></button></form><p class=\"switch-auth\"><%= pageText(\"Don\\u2019t have an account yet? \") %><a href=\"<%= next ? `/register?next=${encodeURIComponent(next)}` : '/register' %>\"><%= pageText(\"Create an account\") %></a></p><div class=\"rule\"></div><details><summary><%= pageText(\"Need an email verification message?\") %></summary><form class=\"form-stack\" method=\"post\" action=\"/verify-email/resend\"><input type=\"hidden\" name=\"_csrf\" value=\"<%= csrf %>\"><label><%= pageText(\"Email address\") %><input type=\"email\" name=\"email\" required maxlength=\"120\" autocomplete=\"username\" autocapitalize=\"none\" spellcheck=\"false\" value=\"<%= email||'' %>\"></label><button type=\"submit\" class=\"btn btn-dark\"><%= pageText(\"Resend verification\") %></button></form></details><% } %><p class=\"auth-browse\"><a href=\"/shop\"><%= pageText(\"Continue shopping\") %> <span aria-hidden=\"true\"><%= pageText(\"\\u2192\") %></span></a></p></div></section>\n<%- include('partials/footer') %>\n","mfa-disable.ejs":"<%- include('partials/header',{title:title||'Disable authenticator'}) %>\n<section class=\"auth-wrap\">\n  <div class=\"auth-card\">\n    <span class=\"eyebrow\"><%= customerText(\"MANAGER SECURITY\") %></span>\n    <h1><%= customerText(\"Reset two-factor authentication\") %></h1>\n    <p class=\"muted\"><%= customerText(\"Manager accounts cannot remain without MFA. This action turns off the current enrollment, revokes all sessions and requires a fresh authenticator setup the next time you sign in.\") %></p>\n    <% if(email){ %><p><strong><%= customerText(\"Account:\") %></strong> <%= email %></p><% } %>\n    <% if(error){ %><div class=\"alert\" role=\"alert\"><%= customerText(error) %></div><% } %>\n    <form class=\"form-stack\" method=\"post\" action=\"/mfa/disable\">\n      <input type=\"hidden\" name=\"_csrf\" value=\"<%= csrf %>\">\n      <label for=\"password\"><%= customerText(\"Current password\") %></label>\n      <input id=\"password\" name=\"password\" type=\"password\" autocomplete=\"current-password\" maxlength=\"200\" required>\n      <label for=\"code\"><%= customerText(\"Current authenticator code or unused recovery code\") %></label>\n      <input id=\"code\" name=\"code\" type=\"text\" autocomplete=\"one-time-code\" maxlength=\"64\" required>\n      <button type=\"submit\" class=\"btn btn-dark btn-wide\"><%= customerText(\"Reset MFA and revoke sessions\") %></button>\n    </form>\n    <p><a class=\"text-link\" href=\"/admin\"><%= customerText(\"Cancel and return to the dashboard\") %></a></p>\n  </div>\n</section>\n<%- include('partials/footer') %>\n","mfa-recovery-codes.ejs":"<%- include('partials/header',{title:title||'Save your recovery codes'}) %>\n<section class=\"auth-wrap\">\n  <div class=\"auth-card mfa-auth-card\">\n    <span class=\"eyebrow\"><%= customerText(\"MFA ACTIVATED\") %></span>\n    <h1><%= customerText(\"Save your recovery codes\") %></h1>\n    <div class=\"success-alert\" role=\"status\"><%= customerText(\"Two-factor authentication is active. Existing Manager sessions have been revoked.\") %></div>\n    <p><%= customerText(\"Each recovery code can be used once if you cannot access your authenticator app. These codes are shown only now. Store them somewhere private and separate from your password.\") %></p>\n    <ul class=\"mfa-recovery-codes\">\n      <% for (const code of codes) { %><li><code><%= code %></code></li><% } %>\n    </ul>\n    <p class=\"field-note\"><%= customerText(\"Do not share these codes. ShopEasy stores only SHA-256 hashes, not the displayed codes.\") %></p>\n    <a class=\"btn btn-dark btn-wide\" href=\"<%= nextPath %>\"><%= customerText(\"Continue to Manager dashboard\") %></a>\n  </div>\n</section>\n<%- include('partials/footer') %>\n","mfa-setup.ejs":"<%- include('partials/header',{title:title||'Set up two-factor authentication'}) %>\n<section class=\"auth-wrap\">\n  <div class=\"auth-card mfa-auth-card\">\n    <span class=\"eyebrow\"><%= customerText(\"MANAGER SECURITY\") %></span>\n    <h1><%= customerText(\"Set up your authenticator\") %></h1>\n    <p class=\"muted\"><%= customerText(\"This is the first sign-in for this Manager account. Two-factor authentication is required before store management can open. Scan this QR code with Google Authenticator, Microsoft Authenticator, 1Password or another TOTP app, or enter the setup key manually below.\") %></p>\n    <% if(error){ %><div class=\"alert\" role=\"alert\"><%= customerText(error) %></div><% } %>\n    <p><strong><%= customerText(\"Account:\") %></strong> <%= email %></p>\n    <% if(qrDataUrl){ %>\n      <div class=\"mfa-qr-frame\">\n        <img id=\"mfa-qr-image\" src=\"<%= qrDataUrl %>\" alt=\"QR code for the ShopEasy authenticator setup\" width=\"280\" height=\"280\" class=\"mfa-qr-image\" decoding=\"sync\">\n      </div>\n      <div class=\"mfa-qr-actions\">\n        <button type=\"button\" id=\"mfa-download-qr\" class=\"btn btn-outline\"><%= customerText(\"Download QR code (PNG)\") %></button>\n      </div>\n      <p id=\"mfa-download-status\" class=\"mfa-download-status\" role=\"status\" aria-live=\"polite\" aria-atomic=\"true\"></p>\n      <section class=\"mfa-manual-panel\" aria-labelledby=\"mfa-manual-title\">\n        <h2 id=\"mfa-manual-title\"><%= customerText(\"Or enter manually:\") %></h2>\n        <p><%= customerText(\"In your authenticator app, choose the option to enter a setup key manually, then enter this key. Keep it private and do not send it to anyone.\") %></p>\n        <p class=\"mfa-secret-wrap\"><code id=\"manual-secret\" class=\"mfa-manual-secret\"><%= secret %></code></p>\n        <button type=\"button\" id=\"mfa-copy-key\" class=\"btn btn-outline\" data-copy-target=\"manual-secret\"><%= customerText(\"Copy key\") %></button>\n        <p id=\"mfa-copy-status\" class=\"field-note\" role=\"status\" aria-live=\"polite\"></p>\n      </section>\n      <p class=\"field-note\"><%= customerText(\"Scan the QR code OR enter the key manually. Both methods connect your authenticator to the same setup.\") %></p>\n      <hr>\n      <form class=\"form-stack\" method=\"post\" action=\"/mfa/verify\">\n        <input type=\"hidden\" name=\"_csrf\" value=\"<%= csrf %>\">\n        <label for=\"code\"><%= customerText(\"6-digit authenticator code\") %></label>\n        <input id=\"code\" name=\"code\" type=\"text\" inputmode=\"numeric\" pattern=\"[0-9]{6}\" minlength=\"6\" maxlength=\"6\" autocomplete=\"one-time-code\" required autofocus>\n        <p class=\"field-note\"><%= customerText(\"Enter the current code shown by your authenticator app to activate MFA.\") %></p>\n        <button type=\"submit\" class=\"btn btn-dark btn-wide\"><%= customerText(\"Verify and activate MFA\") %></button>\n      </form>\n      <details class=\"mfa-regenerate-details\">\n        <summary><%= customerText(\"Need to generate a new setup key?\") %></summary>\n        <p><%= customerText(\"Only do this if you want to replace the current, not-yet-activated setup key.\") %></p>\n        <form method=\"post\" action=\"/mfa/setup\" class=\"form-stack\">\n          <input type=\"hidden\" name=\"_csrf\" value=\"<%= csrf %>\">\n          <button type=\"submit\" class=\"btn btn-outline\"><%= customerText(\"Generate a new setup QR\") %></button>\n        </form>\n      </details>\n    <% } else { %>\n      <p class=\"alert\" role=\"alert\"><%= customerText(\"The QR code could not be prepared. Check the server configuration and sign in again.\") %></p>\n    <% } %>\n    <form method=\"post\" action=\"/mfa/cancel\" class=\"form-stack mfa-cancel-form\">\n      <input type=\"hidden\" name=\"_csrf\" value=\"<%= csrf %>\">\n      <button type=\"submit\" class=\"btn btn-outline btn-wide\"><%= customerText(\"Cancel sign-in and return to login\") %></button>\n    </form>\n    <p class=\"field-note\"><%= customerText(\"The browser Back button does not cancel a security challenge. Use this button to safely end this sign-in attempt.\") %></p>\n  </div>\n</section>\n<% if(qrDataUrl){ %><script src=\"/js/mfa-setup.js?v=2.8.93-r12.11-e2-repair13-hardcheck7-2026-11-04\" defer></script><% } %>\n<%- include('partials/footer') %>\n","mfa-verify.ejs":"<%- include('partials/header',{title:title||'Two-factor verification'}) %>\n<section class=\"auth-wrap\">\n  <div class=\"auth-card\">\n    <span class=\"eyebrow\"><%= customerText(\"MANAGER SECURITY\") %></span>\n    <h1><%= customerText(\"Verify it is you\") %></h1>\n    <p class=\"muted\"><%= customerText(\"Enter the current 6-digit code from your authenticator app. A saved one-time recovery code also works if your authenticator is unavailable.\") %></p>\n    <% if(email){ %><p><strong><%= customerText(\"Account:\") %></strong> <%= email %></p><% } %>\n    <% if(error){ %><div class=\"alert\" role=\"alert\"><%= customerText(error) %></div><% } %>\n    <form class=\"form-stack\" method=\"post\" action=\"/mfa/verify\">\n      <input type=\"hidden\" name=\"_csrf\" value=\"<%= csrf %>\">\n      <label for=\"code\"><%= customerText(\"Authenticator or recovery code\") %></label>\n      <input id=\"code\" name=\"code\" type=\"text\" inputmode=\"text\" maxlength=\"64\" autocomplete=\"one-time-code\" autocapitalize=\"characters\" spellcheck=\"false\" required autofocus>\n      <button type=\"submit\" class=\"btn btn-dark btn-wide\"><%= customerText(\"Verify and sign in\") %></button>\n    </form>\n    <p class=\"field-note\"><%= customerText(\"A challenge expires after 5 minutes. Codes are limited to 5 attempts per 15-minute window.\") %></p>\n    <form method=\"post\" action=\"/mfa/cancel\" class=\"form-stack\">\n      <input type=\"hidden\" name=\"_csrf\" value=\"<%= csrf %>\">\n      <button type=\"submit\" class=\"btn btn-outline\"><%= customerText(\"Cancel sign-in\") %></button>\n    </form>\n  </div>\n</section>\n<%- include('partials/footer') %>\n","order-lookup.ejs":"<%- include('partials/header',{title:'Track an order'}) %>\n<section class=\"container page-head order-lookup-head\"><%- include('partials/back-button', { fallback: '/' }) %><div><span class=\"eyebrow\"><%= customerText(\"ORDER SUPPORT\") %></span><h1><%= customerText(\"Track an order\") %></h1><p><%= customerText(\"Enter your order number and checkout email. Sign in for an account order. For a guest order, use the checkout browser or your saved private access code.\") %></p></div></section>\n<section class=\"container section\"><div class=\"panel\"><div class=\"panel-heading-v5\"><div><span class=\"eyebrow\"><%= customerText(\"ORDER LOOKUP\") %></span><h2><%= customerText(\"Check the latest update\") %></h2><p class=\"muted\"><%= customerText(\"Order details require proof of access as well as matching order and email details.\") %></p></div></div>\n<% if(typeof securityNotice!=='undefined' && securityNotice){ %><div class=\"alert\" role=\"status\"><%= customerText(\"Your security check expired. The lookup was not submitted. Enter your details again on this secure form.\") %></div><% } %>\n<form method=\"post\" action=\"/order-lookup\" class=\"form-stack\"><input type=\"hidden\" name=\"_csrf\" value=\"<%= csrf %>\"><label><%= customerText(\"Order number\") %><input name=\"orderNumber\" inputmode=\"numeric\" pattern=\"[0-9]{1,12}\" required maxlength=\"12\" value=\"<%= typeof lookupOrderNumber!=='undefined'?lookupOrderNumber:'' %>\"></label><label><%= customerText(\"Email address\") %><input type=\"email\" name=\"email\" autocomplete=\"email\" required maxlength=\"120\"></label><label><%= customerText(\"Guest order access code (if saved)\") %><input type=\"password\" name=\"guestAccessToken\" autocomplete=\"off\" maxlength=\"200\" spellcheck=\"false\" autocapitalize=\"none\" aria-describedby=\"guest-access-help\"></label><p class=\"field-note\" id=\"guest-access-help\"><%= customerText(\"Leave this blank when using the browser where you placed the guest order. Keep access codes private.\") %></p><button class=\"btn btn-dark\" type=\"submit\"><%= customerText(\"Find order\") %></button></form>\n<% if(error){ %><div class=\"alert\" role=\"alert\"><%= customerText(error) %></div><% } %><% if(typeof returnRequested!=='undefined' && returnRequested){ %><div class=\"success-alert\" role=\"status\"><%= customerText(\"Your return request was sent to the store for review.\") %></div><% } %>\n<% if(order){ const statusNames={pending:'Received',paid:'Payment recorded',processing:'Preparing',shipped:'Shipped',completed:'Delivered',cancelled:'Cancelled'}; const deliveryText=order.status==='completed'?'Delivered':order.status==='cancelled'?'Not available':'A delivery date has not yet been confirmed by the store or carrier.'; %>\n<div class=\"rule\"></div><h2><%= customerText(\"Order #\") %><%= order.id %></h2><p><strong><%= customerText(\"Status:\") %></strong> <%= statusNames[order.status]||order.status %></p><p><strong><%= customerText(\"Delivery:\") %></strong> <%= deliveryText %></p><h3><%= customerText(\"Items\") %></h3><ul><% order.items.forEach(item=>{ %><li><%= item.product_name %><% if(item.variant_value){ %> — <%= item.variant_name %>: <%= item.variant_value %><% } %> × <%= item.quantity %></li><% }) %></ul><p><strong><%= customerText(\"Total:\") %></strong> <%= formatPrice(order.total_cents,order.currency) %></p>\n<% if(order.payment_provider==='bank_transfer'&&(typeof bankTransferInfo!=='undefined' && bankTransferInfo)&&order.status==='pending'){ %><div class=\"tip-box\"><strong><%= customerText(locale==='nl'?'Bankgegevens voor je overschrijving':locale==='ckb'?'زانیاریی بانکی بۆ گواستنەوەکەت':locale==='ar'?'بيانات التحويل المصرفي':'Bank transfer details') %></strong><p><%= bankTransferInfo.bankName %> · <%= bankTransferInfo.accountHolder %></p><p><strong><%= customerText(locale==='nl'?'IBAN / rekeningnummer':locale==='ckb'?'IBAN / ژمارەی هەژمار':locale==='ar'?'IBAN / رقم الحساب':'IBAN / account') %>:</strong> <code><%= bankTransferInfo.account %></code></p><% if(bankTransferInfo.bic){ %><p><strong>BIC/SWIFT:</strong> <code><%= bankTransferInfo.bic %></code></p><% } %><p><strong><%= customerText(locale==='nl'?'Betalingsreferentie':locale==='ckb'?'ژمارەی تایبەتی پارەدان':locale==='ar'?'مرجع الدفع':'Payment reference') %>:</strong> <code><%= bankTransferInfo.reference %></code></p><p><strong><%= customerText(locale==='nl'?'Bedrag':locale==='ckb'?'بڕی پارە':locale==='ar'?'المبلغ':'Amount') %>:</strong> <%= formatPrice(order.total_cents,order.currency) %></p><% if(bankTransferInfo.instructions){ %><p><%= bankTransferInfo.instructions %></p><% } %><p class=\"field-note\"><%= customerText(locale==='nl'?'Je bestelling blijft onbetaald totdat de winkel de overschrijving heeft gecontroleerd.':locale==='ckb'?'داواکارییەکەت تا پشتڕاستکردنەوەی گواستنەوەکە لەلایەن فرۆشگا پارەدراو نابێت.':locale==='ar'?'يبقى طلبك غير مدفوع حتى يتحقق المتجر من وصول التحويل.':'Your order stays unpaid until the store verifies the incoming transfer.') %></p></div><% } %>\n<% if(order.returnable){ %><div class=\"rule\"></div><h3><%= customerText(\"Request a return\") %></h3><form method=\"post\" action=\"/order/<%= order.id %>/return-request\" class=\"form-stack\"><input type=\"hidden\" name=\"_csrf\" value=\"<%= csrf %>\"><input type=\"hidden\" name=\"email\" value=\"<%= lookupEmail||'' %>\"><label><%= customerText(\"Item\") %><select name=\"orderItemId\" required><% order.items.forEach(item=>{ %><option value=\"<%= item.id %>\"><%= item.product_name %> — <%= customerText(locale==='nl'?'gekocht':'purchased') %> <%= item.quantity %></option><% }) %></select></label><label><%= customerText(\"Quantity\") %><input type=\"number\" name=\"quantity\" min=\"1\" max=\"99\" value=\"1\" required></label><label><%= customerText(\"Request type\") %><select name=\"requestType\" required><option value=\"return\"><%= customerText(\"Return\") %></option><option value=\"exchange\"><%= customerText(\"Exchange\") %></option><option value=\"refund\"><%= customerText(\"Refund review\") %></option></select></label><label><%= customerText(\"Reason\") %><select name=\"reasonCode\" required><option value=\"damaged\"><%= customerText(\"Damaged item\") %></option><option value=\"wrong_item\"><%= customerText(\"Wrong item received\") %></option><option value=\"not_as_described\"><%= customerText(\"Not as described\") %></option><option value=\"changed_mind\"><%= customerText(\"Changed my mind\") %></option><option value=\"other\"><%= customerText(\"Other\") %></option></select></label><label><%= customerText(\"Additional details (optional)\") %><textarea name=\"note\" maxlength=\"800\" rows=\"3\"></textarea></label><button class=\"btn btn-dark\" type=\"submit\"><%= customerText(\"Send return request\") %></button></form><% } %>\n<% } %></div></section><%- include('partials/footer') %>\n","order.ejs":"<%- include('partials/header',{title:`Order #${order.id}`}) %>\n<%\nconst statusLabels={\n  fr:{pending:'En attente de confirmation',processing:'Acceptée · en préparation',shipped:'Expédiée · en livraison',completed:'Livrée',cancelled:'Annulée',paid:'Payée'},\n  en:{pending:'Waiting for confirmation',processing:'Accepted · preparing',shipped:'Shipped · out for delivery',completed:'Delivered',cancelled:'Cancelled',paid:'Paid'},\n  ckb:{pending:'چاوەڕوانی پشتڕاستکردنەوە',processing:'پەسەندکرا · ئامادە دەکرێت',shipped:'نێردراوە · لە ڕێگای گەیاندندایە',completed:'گەیێندراوە',cancelled:'هەڵوەشێنراوەتەوە',paid:'پارە دراوە'},\n  ar:{pending:'بانتظار التأكيد',processing:'تم القبول · قيد التجهيز',shipped:'تم الشحن · في طريق التوصيل',completed:'تم التسليم',cancelled:'ملغى',paid:'مدفوع'},\n  nl:{pending:'Wacht op bevestiging',processing:'Geaccepteerd · wordt klaargemaakt',shipped:'Verzonden · onderweg',completed:'Geleverd',cancelled:'Geannuleerd',paid:'Betaald'}\n};\nconst stateText=statusLabels[locale]||statusLabels.en;\nconst statusFlow=order.status==='paid'?['paid','processing','shipped','completed']:['pending','processing','shipped','completed'];\nconst statusIndex=Math.max(0,statusFlow.indexOf(order.status));\nconst cancelMessages={\n  cancelled:locale==='ckb'?'داواکارییەکە هەڵوەشێنرایەوە.':locale==='ar'?'تم إلغاء الطلب.':locale==='nl'?'Je bestelling is geannuleerd. Je kunt verder winkelen.':'Your order was cancelled. You can return to shopping.',\n  requested:locale==='ckb'?'داواکاریی هەڵوەشاندنەوە نێردرا؛ فرۆشگا پێداچوونەوەی بۆ دەکات.':locale==='ar'?'تم إرسال طلب الإلغاء إلى المتجر للمراجعة.':locale==='nl'?'Je annuleringsverzoek is naar de winkel gestuurd ter beoordeling.':'Your cancellation request was sent to the store for review.',\n  'already-requested':locale==='ckb'?'داواکارییەکەت پێشتر نێردراوە.':locale==='ar'?'تم إرسال طلب الإلغاء من قبل.':locale==='nl'?'Je hebt al een annulering aangevraagd.':'You have already requested cancellation.',\n  unavailable:locale==='ckb'?'ئەم داواکارییە لەم قۆناغەدا ناتوانرێت هەڵبوەشێنرێتەوە.':locale==='ar'?'لا يمكن إلغاء هذا الطلب في مرحلته الحالية.':locale==='nl'?'Deze bestelling kan in de huidige status niet worden geannuleerd.':'This order cannot be cancelled in its current state.',\n  'reason-required':locale==='ckb'?'تکایە هۆکار بنووسە.':locale==='ar'?'يرجى إدخال سبب طلب الإلغاء.':locale==='nl'?'Vermeld een reden voordat je annulering aanvraagt.':'Enter a reason before requesting cancellation.',\n  changed:locale==='ckb'?'دۆخی داواکاری گۆڕاوە. پەڕەکە نوێ بکەرەوە.':locale==='ar'?'تغيرت حالة الطلب. حدّث الصفحة.':locale==='nl'?'De status van je bestelling is gewijzigd. Vernieuw de pagina en controleer de actuele status.':'The order status changed. Refresh and check the current status.'\n};\n%>\n<% if(typeof securityNotice!=='undefined' && securityNotice){ %><section class=\"container\"><div class=\"alert\" role=\"status\"><%= customerText(locale==='nl'?'Je beveiligingscontrole is verlopen. Er is geen wijziging aan de bestelling verzonden. Controleer de huidige bestelstatus voordat je een nieuw verzoek indient.':'Your security check expired. No order update was submitted. Review the current order status before sending another request.') %></div></section><% } %>\n<section class=\"container page-head order-page-head\">\n  <%- include('partials/back-button', { fallback: '/account' }) %>\n  <div class=\"order-head-line\"><div><span class=\"eyebrow\"><%= customerText(\"ORDER\") %></span><h1>#<%= order.id %></h1></div><button type=\"button\" class=\"btn btn-light\" data-print-order><%= customerText(\"Print / save PDF\") %></button></div>\n  <div class=\"order-current-state\"><span class=\"status status-<%= order.status %>\"><%= stateText[order.status]||order.status %></span><time datetime=\"<%= order.created_at %>\" title=\"<%= formatDateTimeDisplay(order.created_at,storeTimeZone) %>\"><%= formatRelativeTime(order.created_at) %></time></div>\n</section>\n\n<% if(cancelResult && cancelMessages[cancelResult]){ %><section class=\"container\"><div class=\"<%= cancelResult==='cancelled'?'success-alert':'alert' %> order-notice\" role=\"status\"><%= customerText(cancelMessages[cancelResult]) %></div></section><% } %>\n\n<section class=\"container order-status-panel\">\n  <% if(order.status==='cancelled'){ %><div class=\"cancelled-state\"><span class=\"state-icon\">!</span><div><strong><%= customerText(\"Order cancelled\") %></strong><p><%= customerText(\"The order will not be delivered.\") %></p></div></div><% } else { %>\n    <div class=\"status-panel-title\"><div><span class=\"eyebrow\"><%= customerText(\"ORDER PROGRESS\") %></span><h2><%= customerText(\"Track your order\") %></h2></div><strong><%= stateText[order.status]||order.status %></strong></div>\n    <div class=\"order-timeline\" role=\"group\" aria-label=\"<%= customerText(\"Order progress\") %>\">\n      <% statusFlow.forEach((state,idx)=>{ const done=idx<=statusIndex; %><div class=\"timeline-step <%= done?'done':'' %> <%= idx===statusIndex?'current':'' %>\"><span class=\"timeline-dot\"><%= idx<statusIndex?'✓':idx+1 %></span><div><strong><%= customerText(stateText[state]) %></strong><small><%= customerText(state==='paid'?'Payment received; awaiting store confirmation.':state==='pending'?'Order received':state==='processing'?'Store is preparing it':state==='shipped'?'Delivery is on the way':'Order completed') %></small></div></div><% if(idx<statusFlow.length-1){ %><span class=\"timeline-line <%= idx<statusIndex?'done':'' %>\" aria-hidden=\"true\"></span><% } %><% }) %>\n    </div>\n  <% } %>\n</section>\n\n<section class=\"container order-layout order-layout-v5\">\n  <div class=\"order-main-stack\">\n    <div class=\"panel order-items-card\"><div class=\"panel-heading-v5\"><div><span class=\"eyebrow\"><%= customerText(\"ORDER CONTENTS\") %></span><h2><%= customerText(\"Items\") %></h2></div><span><%= order.items.length %><%= customerText(\" item\") %><%= customerText(order.items.length===1?'':'s') %></span></div>\n      <div class=\"order-items-v5\"><% order.items.forEach(i=>{ %><div class=\"order-product-row\"><div class=\"order-product-thumb\"><img src=\"<%= safeImageUrl(i.image_url||'/assets/product-placeholder.svg') %>\" data-fallback-src=\"/assets/product-placeholder.svg\" alt=\"\" width=\"120\" height=\"140\" loading=\"lazy\" decoding=\"async\"></div><div class=\"order-product-info\"><strong data-no-translate><%= i.product_name %></strong><% if(i.variant_value){ %><span><%= i.variant_name %>: <%= i.variant_value %><% if(i.variant_value_2){ %> · <%= i.variant_name_2 %>: <%= i.variant_value_2 %><% } %></span><% } %><small><%= customerText(\"Quantity × \") %><%= i.quantity %></small></div><strong class=\"order-product-price\"><%= formatPrice(i.total_cents,order.currency) %></strong></div><% }) %></div>\n      <div class=\"order-total-box\"><div><span><%= customerText(\"Items subtotal\") %></span><strong><%= formatPrice(order.subtotal_cents,order.currency) %></strong></div><% if(order.automatic_discount_cents>0){ %><div><span><%= customerText(\"Automatic product discounts\") %></span><strong>-<%= formatPrice(order.automatic_discount_cents,order.currency) %></strong></div><% } %><% if(order.discount_cents>0){ %><div><span><%= customerText(\"Coupon discount\") %></span><strong>-<%= formatPrice(order.discount_cents,order.currency) %></strong></div><% } %><div><span><%= customerText(\"Delivery fee\") %></span><strong><%= order.shipping_cents===0?'Free':formatPrice(order.shipping_cents,order.currency) %></strong></div><% if(order.tax_rate_bps!==null&&order.tax_rate_bps!==undefined){ %><div><span><%= customerText(order.tax_included?(locale==='nl'?'Belasting inbegrepen in de prijzen':locale==='ckb'?'باژ لە نرخەکاندا هەژمار کراوە':locale==='ar'?'الضريبة مشمولة في الأسعار':'Tax included in prices'):(locale==='nl'?'Belasting toegevoegd':locale==='ckb'?'باژ زیاد کراوە':locale==='ar'?'تمت إضافة الضريبة':'Tax added')) %> (<%= (Number(order.tax_rate_bps)/100).toFixed(2) %>%)</span><strong><%= formatPrice(order.tax_cents||0,order.currency) %></strong></div><% } else { %><p class=\"field-note\"><%= customerText(\"No regional tax rule was recorded for this order; this is not a tax-compliance confirmation.\") %></p><% } %><div class=\"grand-total\"><span><%= customerText(\"Total\") %></span><strong><%= formatPrice(order.total_cents,order.currency) %></strong></div></div>\n    </div>\n  </div>\n\n  <div class=\"order-side-stack\">\n    <div class=\"panel order-info-card\"><div class=\"panel-heading-v5\"><div><span class=\"eyebrow\"><%= customerText(\"DELIVERY\") %></span><h2><%= customerText(\"Delivery details\") %></h2></div></div><div class=\"delivery-person\"><span class=\"person-avatar\"><%= (order.shipping_name||'?').slice(0,1).toUpperCase() %></span><div><strong><%= order.shipping_name %></strong><span><%= customerText(\"Delivery address\") %></span></div></div><p class=\"address-block\"><%= order.shipping_address %><br><%= order.shipping_postal_code %> <%= order.shipping_city %><br><%= order.shipping_country %></p><div class=\"payment-chip\"><span><%= customerText(locale==='nl'?'Betaalmethode':locale==='ckb'?'شێوازی پارەدان':locale==='ar'?'طريقة الدفع':'Payment method') %></span><strong><%= customerText(order.payment_provider==='cash_on_delivery'?(locale==='nl'?'Contant bij levering':'Cash on delivery'):order.payment_provider==='bank_transfer'?(locale==='nl'?'Bankoverschrijving':locale==='ckb'?'گواستنەوەی بانکی':locale==='ar'?'تحويل مصرفي':'Bank transfer'):order.payment_provider==='mollie'?'Card payment':order.payment_provider==='gift_card'?'Gift card':'Payment method') %></strong></div><% if(order.payment_provider==='bank_transfer'&&(typeof bankTransferInfo!=='undefined' && bankTransferInfo)&&order.status==='pending'){ %><div class=\"tip-box\"><strong><%= customerText(locale==='nl'?'Betaal per bankoverschrijving':locale==='ckb'?'پارەدان بە گواستنەوەی بانکی':locale==='ar'?'الدفع بالتحويل المصرفي':'Pay by bank transfer') %></strong><p><%= bankTransferInfo.bankName %> · <%= bankTransferInfo.accountHolder %></p><p><strong><%= customerText(locale==='nl'?'Rekening':'Account') %>:</strong> <code><%= bankTransferInfo.account %></code></p><% if(bankTransferInfo.bic){ %><p><strong>BIC/SWIFT:</strong> <code><%= bankTransferInfo.bic %></code></p><% } %><p><strong><%= customerText(locale==='nl'?'Referentie':'Reference') %>:</strong> <code><%= bankTransferInfo.reference %></code></p><p><strong><%= formatPrice(order.total_cents,order.currency) %></strong></p><% if(bankTransferInfo.instructions){ %><p><%= bankTransferInfo.instructions %></p><% } %><p class=\"field-note\"><%= customerText(locale==='nl'?'Je bestelling blijft onbetaald totdat de winkel de ontvangst controleert.':'Your order remains unpaid until the store verifies the incoming transfer.') %></p></div><% } %><% if(order.customer_note){ %><div class=\"customer-note\"><span><%= customerText(\"Order note\") %></span><p><%= order.customer_note %></p></div><% } %></div>\n\n    <div class=\"panel order-action-card\">\n      <% if(order.status==='pending'&&order.payment_provider==='bank_transfer'){ %><span class=\"eyebrow\"><%= customerText(\"CHANGES\") %></span><h2><%= customerText(\"Request cancellation\") %></h2><% if(order.cancellation_request_decision==='pending'){ %><div class=\"alert\" role=\"status\"><%= customerText(\"Your cancellation request is waiting for the store's decision. Do not send another bank transfer while the request is being reviewed.\") %></div><p><strong><%= customerText(\"Reason:\") %></strong> <%= order.cancellation_request_reason %></p><% } else { %><p><%= customerText(\"Bank transfers can arrive after they are sent. To avoid releasing reserved stock while a payment may still be in transit, the store must review your cancellation request.\") %></p><form method=\"post\" action=\"/account/order/<%= order.id %>/cancel\" class=\"form-stack\"><input type=\"hidden\" name=\"_csrf\" value=\"<%= csrf %>\"><label><%= customerText(\"Reason *\") %><textarea name=\"reason\" required maxlength=\"500\" rows=\"3\" placeholder=\"<%= customerText(\"Explain why you need to cancel this bank-transfer order.\") %>\"></textarea></label><button class=\"btn btn-light\" type=\"submit\"><%= customerText(\"Request cancellation\") %></button></form><% } %>\n      <% } else if(order.status==='pending'){ %><span class=\"eyebrow\"><%= customerText(\"CHANGES\") %></span><h2><%= customerText(\"Need to cancel?\") %></h2><p><%= customerText(\"You may cancel while the store is still reviewing the order.\") %></p><form method=\"post\" action=\"/account/order/<%= order.id %>/cancel\" class=\"form-stack\" data-confirm=\"<%= customerText(\"Cancel this order?\") %>\"><input type=\"hidden\" name=\"_csrf\" value=\"<%= csrf %>\"><label><%= customerText(\"Reason (optional)\") %><textarea name=\"reason\" maxlength=\"500\" rows=\"3\" placeholder=\"<%= customerText(\"I no longer need this item.\") %>\"></textarea></label><button class=\"btn btn-light\" type=\"submit\"><%= customerText(\"Cancel order\") %></button></form>\n      <% } else if(order.status==='processing'&&order.payment_provider==='cash_on_delivery'){ %><span class=\"eyebrow\"><%= customerText(\"CHANGES\") %></span><h2><%= customerText(locale==='nl'?'Annulering aanvragen':locale==='ckb'?'داوای هەڵوەشاندنەوە':'Request cancellation') %></h2><% if(order.cancellation_request_decision==='pending'){ %><div class=\"alert\" role=\"status\"><%= customerText(locale==='nl'?'Je annuleringsverzoek wacht op beoordeling door de winkel.':locale==='ckb'?'داواکاریی هەڵوەشاندنەوەکەت چاوەڕوانی پێداچوونەوەی فرۆشگایە.':\"Your cancellation request is waiting for the store's decision.\") %></div><p><strong><%= customerText(locale==='nl'?'Reden':locale==='ckb'?'هۆکار':'Reason') %>:</strong> <%= order.cancellation_request_reason %></p><% } else { %><p><%= customerText(locale==='nl'?'De winkel heeft je bestelling aanvaard. Je kunt vóór verzending een annulering aanvragen.':locale==='ckb'?'فرۆشگا داواکارییەکەت پەسەند کردووە. پێش ناردنی کاڵا دەتوانیت داوای هەڵوەشاندنەوە بکەیت.':'The store accepted your order. You can request cancellation before it ships.') %></p><form method=\"post\" action=\"/account/order/<%= order.id %>/cancel\" class=\"form-stack\"><input type=\"hidden\" name=\"_csrf\" value=\"<%= csrf %>\"><label><%= customerText(locale==='nl'?'Reden *':locale==='ckb'?'هۆکار *':'Reason *') %><textarea name=\"reason\" required maxlength=\"500\" rows=\"3\" placeholder=\"<%= locale==='nl'?'Leg uit waarom je wilt annuleren.':locale==='ckb'?'هۆکاری داوای هەڵوەشاندنەوە بنووسە.':'Explain why you need to cancel.' %>\"></textarea></label><button class=\"btn btn-light\" type=\"submit\"><%= customerText(locale==='nl'?'Annulering aanvragen':locale==='ckb'?'داوای هەڵوەشاندنەوە':'Request cancellation') %></button></form><% } %>\n      <% } else if(order.status==='paid'||order.status==='processing'){ %><span class=\"eyebrow\"><%= customerText('PAYMENT') %></span><h2><%= customerText(locale==='nl'?'Betaald · wijziging nodig?':locale==='ckb'?'پارە دراوە · پێویستت بە گۆڕانکارییە؟':locale==='ar'?'مدفوع · هل تحتاج إلى تغيير؟':'Payment received') %></h2><p><%= customerText(locale==='nl'?'Deze bestelling is al betaald. ShopEasy voert geen automatische terugbetaling uit via een annuleringsverzoek. Neem vóór verzending contact op met de winkel; na levering kun je via deze pagina een retour- of terugbetalingsverzoek indienen.':locale==='ckb'?'پارەی ئەم داواکارییە وەرگیراوە. ShopEasy بە داواکاریی هەڵوەشاندنەوە پارە بە ئۆتۆماتیکی ناگەڕێنێتەوە. پێش ناردنی کاڵا پەیوەندی بە فرۆشگا بکە؛ دوای گەیاندن دەتوانیت داواکاریی گەڕاندنەوە بنێریت.':locale==='ar'?'تم استلام الدفع. لا ينفذ ShopEasy استردادًا تلقائيًا عبر طلب الإلغاء. اتصل بالمتجر قبل الشحن؛ وبعد التسليم يمكنك تقديم طلب إرجاع أو استرداد من هذه الصفحة.':'Payment has been received. ShopEasy does not automatically refund paid orders through a cancellation request. Contact the store before shipment; after delivery, you can submit a return or refund request from this page.') %></p>\n      <% } else if(order.status==='shipped'){ %><span class=\"eyebrow\"><%= customerText(\"DELIVERY\") %></span><h2><%= customerText(\"Delivery in progress\") %></h2><p><%= customerText(\"Your order is already out for delivery. Contact the store using the contact details on its policy page.\") %></p><a class=\"btn btn-light\" href=\"/shipping-returns\"><%= customerText(\"Shipping & returns\") %></a>\n      <% } else if(order.status==='completed'){ %><span class=\"eyebrow\"><%= customerText(\"AFTER DELIVERY\") %></span><h2><%= customerText(\"Need a return?\") %></h2><p><%= customerText(\"This order is marked delivered. Use the returns policy to ask for a return or refund.\") %></p><a class=\"btn btn-light\" href=\"/shipping-returns\"><%= customerText(\"Shipping & returns\") %></a>\n      <% } else { %><span class=\"eyebrow\"><%= customerText(\"ORDER\") %></span><h2><%= customerText(\"Order closed\") %></h2><p><%= customerText(\"This order is no longer editable.\") %></p><% } %>\n    </div>\n  </div>\n</section>\n<% if((orderHistory||[]).length){ %><section class=\"container section\"><div class=\"panel\"><div class=\"panel-heading-v5\"><div><span class=\"eyebrow\"><%= customerText(\"ORDER HISTORY\") %></span><h2><%= customerText(locale==='ckb'?'مێژووی داواکاری':locale==='ar'?'سجل الطلب':'Order status history') %></h2><p class=\"muted\"><%= customerText(locale==='ckb'?'هەر گۆڕانکارییەک لە دۆخی داواکاری لێرە پیشان دەدرێت.':locale==='ar'?'يظهر هنا كل تغيير في حالة الطلب.':'Every recorded status change appears here, including cancellation.') %></p></div></div><ol class=\"form-stack order-history-list\"><% orderHistory.forEach(event=>{ %><li><div><strong><%= stateText[event.to_status]||event.to_status %></strong><small class=\"muted\"><time datetime=\"<%= event.created_at %>\" title=\"<%= formatDateTimeDisplay(event.created_at,storeTimeZone) %>\"><%= formatDateTimeDisplay(event.created_at,storeTimeZone) %></time></small><% if(event.note){ %><p class=\"muted\"><%= event.note %></p><% } %></div></li><% }) %></ol></div></section><% } %>\n\n<%\nconst returnCopy={\n  en:{title:'Returns, exchanges & refunds',intro:'Send a request for the items you bought. The store will review it; no money is transferred automatically.',requested:'Requested · waiting for review',approved:'Approved · follow the store instructions',rejected:'Request declined',item_received:'Item received by store',exchange_sent:'Replacement sent',refund_recorded:'Refund recorded by store',completed:'Exchange completed',cancelled:'Request cancelled',request:'Start a request',item:'Item',quantity:'Quantity',type:'Request type',reason:'Why are you requesting this?',return:'Return an item',exchange:'Exchange an item',refund:'Refund review',submit:'Send request',restock:'Return/refund amount is not paid automatically. This page records the store’s decision.'},\n  ckb:{title:'گەڕاندنەوە، ئاڵوگۆڕ و گەڕاندنەوەی پارە',intro:'داواکارییەک بۆ کاڵاکەت بنێرە. فرۆشگا پێداچوونەوەی بۆ دەکات؛ پارە بە ئۆتۆماتیکی ناگەڕێندرێتەوە.',requested:'نێردرا · چاوەڕوانی پێداچوونەوە',approved:'پەسەندکرا · ڕێنمایی فرۆشگا ببینە',rejected:'داواکارییەکە ڕەت کرایەوە',item_received:'کاڵاکە گەیشتە فرۆشگا',exchange_sent:'کاڵای جێگرەوە نێردرا',refund_recorded:'گەڕاندنەوەی پارە تۆمار کرا',completed:'ئاڵوگۆڕ تەواو بوو',cancelled:'داواکارییەکە هەڵوەشێنرایەوە',request:'دروستکردنی داواکاری',item:'کاڵا',quantity:'ژمارە',type:'جۆری داواکاری',reason:'هۆکاری داواکاری',return:'گەڕاندنەوەی کاڵا',exchange:'ئاڵوگۆڕی کاڵا',refund:'پێداچوونەوەی گەڕاندنەوەی پارە',submit:'ناردنی داواکاری',restock:'پارە بە ئۆتۆماتیکی ناگەڕێندرێتەوە؛ بڕیار و تۆماری فرۆشگا لێرە پیشان دەدرێت.'},\n  ar:{title:'الإرجاع والاستبدال واسترداد الأموال',intro:'أرسل طلبًا بشأن المنتجات التي اشتريتها. سيراجع المتجر الطلب؛ لا يتم تحويل الأموال تلقائيًا.',requested:'تم الطلب · بانتظار المراجعة',approved:'تمت الموافقة · اتبع تعليمات المتجر',rejected:'تم رفض الطلب',item_received:'استلم المتجر المنتج',exchange_sent:'تم إرسال البديل',refund_recorded:'تم تسجيل الاسترداد',completed:'اكتمل الاستبدال',cancelled:'تم إلغاء الطلب',request:'إنشاء طلب',item:'المنتج',quantity:'الكمية',type:'نوع الطلب',reason:'سبب الطلب',return:'إرجاع منتج',exchange:'استبدال منتج',refund:'مراجعة استرداد',submit:'إرسال الطلب',restock:'لا يتم تحويل الأموال تلقائيًا؛ تعرض هذه الصفحة قرار المتجر وسجله.'},\n  nl:{title:'Retouren, omruilingen en terugbetalingen',intro:'Dien een verzoek in voor de artikelen die je hebt gekocht. De winkel beoordeelt je verzoek; er wordt niet automatisch geld overgemaakt.',requested:'Aangevraagd · wacht op beoordeling',approved:'Goedgekeurd · volg de instructies van de winkel',rejected:'Verzoek afgewezen',item_received:'Artikel ontvangen door de winkel',exchange_sent:'Vervangend artikel verzonden',refund_recorded:'Terugbetaling geregistreerd door de winkel',completed:'Omruiling afgerond',cancelled:'Verzoek geannuleerd',request:'Een verzoek indienen',item:'Artikel',quantity:'Aantal',type:'Soort verzoek',reason:'Waarom dien je dit verzoek in?',return:'Artikel retourneren',exchange:'Artikel omruilen',refund:'Terugbetaling laten beoordelen',submit:'Verzoek verzenden',restock:'Een retour- of terugbetalingsbedrag wordt niet automatisch uitbetaald. Op deze pagina wordt de beslissing van de winkel geregistreerd.'}\n};\nconst returnText=returnCopy[locale]||returnCopy.en;\nconst returnErrorText=typeof returnError==='string'?returnError:'';\n%>\n<section class=\"container section\">\n  <div class=\"panel\">\n    <div class=\"panel-heading-v5\"><div><span class=\"eyebrow\"><%= customerText(\"AFTER-SALES\") %></span><h2><%= returnText.title %></h2><p class=\"muted\"><%= returnText.intro %></p></div></div>\n    <% if(returnErrorText){ %><div class=\"alert\" role=\"alert\"><%= customerText(returnErrorText) %></div><% } %>\n    <% if(typeof returnResult!=='undefined'&&returnResult==='requested'){ %><div class=\"success-alert\" role=\"status\"><%= customerText(locale==='ckb'?'داواکارییەکەت بۆ پێداچوونەوە نێردرا.':locale==='ar'?'تم إرسال طلبك إلى المتجر للمراجعة.':locale==='nl'?'Je verzoek is ter beoordeling naar de winkel gestuurd.':'Your request was sent to the store for review.') %></div><% } %>\n    <% if((returns||[]).length){ %><div class=\"table-wrap\" role=\"region\" aria-label=\"<%= customerText(\"Return requests table\") %>\" tabindex=\"0\"><table><thead><tr><th><%= customerText(\"Request\") %></th><th><%= customerText(\"Item\") %></th><th><%= customerText(\"Quantity\") %></th><th><%= customerText(\"Status\") %></th><th><%= customerText(\"Refund recorded\") %></th><th><%= customerText(\"Updated\") %></th></tr></thead><tbody><% returns.forEach(r=>{ const statusCopy=returnText[r.status]||r.status; %><tr><td>#<%= r.id %> · <%= r.request_type %></td><td data-no-translate><%= r.product_name %><% if(r.variant_value){ %><small class=\"order-variant\"><%= r.variant_name %>: <%= r.variant_value %><% if(r.variant_value_2){ %> · <%= r.variant_name_2 %>: <%= r.variant_value_2 %><% } %></small><% } %></td><td><%= r.quantity %></td><td><span class=\"status status-<%= r.status %>\"><%= statusCopy %></span><% if(r.manager_note){ %><small class=\"muted\"><%= r.manager_note %></small><% } %></td><td><%= r.refund_recorded_at?formatPrice(r.refund_amount_cents,order.currency):'—' %></td><td><time datetime=\"<%= r.updated_at %>\" title=\"<%= formatDateTimeDisplay(r.updated_at,storeTimeZone) %>\"><%= formatRelativeTime(r.updated_at) %></time></td></tr><% }) %></tbody></table></div><% } else { %><p class=\"muted\"><%= customerText(\"No return or refund requests have been made for this order.\") %></p><% } %>\n    <% if(order.status==='completed'){ %><div class=\"rule\"></div><h3><%= returnText.request %></h3><form method=\"post\" action=\"/order/<%= order.id %>/return-request\" class=\"form-stack\" data-confirm=\"<%= customerText(\"Send this after-sales request to the store?\") %>\"><input type=\"hidden\" name=\"_csrf\" value=\"<%= csrf %>\"><label><%= returnText.item %><select name=\"orderItemId\" required><option value=\"\"><%= customerText(\"Choose an item\") %></option><% order.items.forEach(item=>{ %><option value=\"<%= item.id %>\"><%= item.product_name %><% if(item.variant_value){ %> · <%= item.variant_name %>: <%= item.variant_value %><% if(item.variant_value_2){ %> · <%= item.variant_name_2 %>: <%= item.variant_value_2 %><% } %><% } %> · <%= customerText(locale==='nl'?'gekocht':'purchased') %> <%= item.quantity %></option><% }) %></select></label><label><%= returnText.quantity %><input type=\"number\" name=\"quantity\" min=\"1\" max=\"99\" step=\"1\" value=\"1\" required></label><label><%= returnText.type %><select name=\"requestType\" required><option value=\"return\"><%= returnText.return %></option><option value=\"exchange\"><%= returnText.exchange %></option><option value=\"refund\"><%= returnText.refund %></option></select></label><label><%= returnText.reason %><select name=\"reasonCode\" required><option value=\"damaged\"><%= customerText(\"Damaged item\") %></option><option value=\"wrong_item\"><%= customerText(\"Wrong item received\") %></option><option value=\"not_as_described\"><%= customerText(\"Not as described\") %></option><option value=\"changed_mind\"><%= customerText(\"Changed my mind\") %></option><option value=\"other\"><%= customerText(\"Other\") %></option></select></label><label><%= customerText(\"Additional details (optional)\") %><textarea name=\"note\" maxlength=\"800\" rows=\"4\"></textarea></label><p class=\"muted\"><%= returnText.restock %></p><button class=\"btn btn-dark\" type=\"submit\"><%= returnText.submit %></button></form><% } else { %><p class=\"muted\"><%= customerText(\"Return requests become available when the store marks the order delivered.\") %></p><% } %>\n  </div>\n</section>\n<%- include('partials/footer') %>\n","partials/admin-nav.ejs":"<%\n  const adminNavPath = typeof path === 'string' ? path.split('?')[0].replace(/\\/$/, '') || '/admin' : '/admin';\n  const navActive = (target) => target === '/admin' ? adminNavPath === '/admin' : (adminNavPath === target || adminNavPath.startsWith(`${target}/`));\n%>\n<% if(user?.role==='manager'){ %>\n<nav class=\"admin-nav container\" aria-label=\"Store manager navigation\" aria-describedby=\"manager-nav-help\" tabindex=\"0\">\n  <span class=\"sr-only\" id=\"manager-nav-help\">On smaller screens, scroll horizontally for more sections.</span>\n  <div class=\"admin-nav-group\">\n    <span class=\"admin-nav-label\">WORKSPACE</span>\n    <a href=\"/admin\" class=\"<%= navActive('/admin')?'active':'' %>\"<% if(navActive('/admin')){ %> aria-current=\"page\"<% } %>>Overview</a>\n  </div>\n  <div class=\"admin-nav-group\">\n    <span class=\"admin-nav-label\">CATALOGUE</span>\n    <a href=\"/admin/products\" class=\"<%= navActive('/admin/products')?'active':'' %>\"<% if(navActive('/admin/products')){ %> aria-current=\"page\"<% } %>>Products</a>\n    <a href=\"/admin/categories\" class=\"<%= navActive('/admin/categories')?'active':'' %>\"<% if(navActive('/admin/categories')){ %> aria-current=\"page\"<% } %>>Categories</a>\n  </div>\n  <div class=\"admin-nav-group\">\n    <span class=\"admin-nav-label\">SALES</span>\n    <a href=\"/admin/orders\" class=\"<%= navActive('/admin/orders')?'active':'' %>\"<% if(navActive('/admin/orders')){ %> aria-current=\"page\"<% } %>>Orders</a>\n    <a href=\"/admin/returns\" class=\"<%= navActive('/admin/returns')?'active':'' %>\"<% if(navActive('/admin/returns')){ %> aria-current=\"page\"<% } %>>Returns</a>\n    <a href=\"/admin/customers\" class=\"<%= navActive('/admin/customers')?'active':'' %>\"<% if(navActive('/admin/customers')){ %> aria-current=\"page\"<% } %>>Customers</a>\n  </div>\n  <div class=\"admin-nav-group\">\n    <span class=\"admin-nav-label\">PROMOTIONS</span>\n    <a href=\"/admin/coupons\" class=\"<%= navActive('/admin/coupons')?'active':'' %>\"<% if(navActive('/admin/coupons')){ %> aria-current=\"page\"<% } %>>Discounts</a>\n    <a href=\"/admin/bundles\" class=\"<%= navActive('/admin/bundles')?'active':'' %>\"<% if(navActive('/admin/bundles')){ %> aria-current=\"page\"<% } %>>Bundles</a>\n    <a href=\"/admin/gift-cards\" class=\"<%= navActive('/admin/gift-cards')?'active':'' %>\"<% if(navActive('/admin/gift-cards')){ %> aria-current=\"page\"<% } %>>Gift cards</a>\n    <a href=\"/admin/newsletter\" class=\"<%= navActive('/admin/newsletter')?'active':'' %>\"<% if(navActive('/admin/newsletter')){ %> aria-current=\"page\"<% } %>>Newsletter</a>\n    <a href=\"/admin/reviews\" class=\"<%= navActive('/admin/reviews')?'active':'' %>\"<% if(navActive('/admin/reviews')){ %> aria-current=\"page\"<% } %>>Reviews</a>\n    <a href=\"/admin/stories\" class=\"<%= navActive('/admin/stories')?'active':'' %>\"<% if(navActive('/admin/stories')){ %> aria-current=\"page\"<% } %>>Stories</a>\n  </div>\n  <div class=\"admin-nav-group\">\n    <span class=\"admin-nav-label\">STORE CONTENT</span>\n    <a href=\"/admin/appearance\" class=\"<%= navActive('/admin/appearance')?'active':'' %>\">Design studio</a>\n    <a href=\"/admin/branding\" class=\"<%= navActive('/admin/branding')?'active':'' %>\"<% if(navActive('/admin/branding')){ %> aria-current=\"page\"<% } %>>Storefront</a>\n  </div>\n  <div class=\"admin-nav-group admin-nav-manager-tools\">\n      <span class=\"admin-nav-label\">MANAGER TOOLS</span>\n      <a href=\"/admin/settings\" class=\"<%= navActive('/admin/settings')?'active':'' %>\"<% if(navActive('/admin/settings')){ %> aria-current=\"page\"<% } %>>Settings</a>\n      <a href=\"/admin/e-invoicing\" class=\"<%= navActive('/admin/e-invoicing')?'active':'' %>\"<% if(navActive('/admin/e-invoicing')){ %> aria-current=\"page\"<% } %>>E-invoicing</a>\n      <a href=\"/admin/staff\" class=\"<%= navActive('/admin/staff')?'active':'' %>\"<% if(navActive('/admin/staff')){ %> aria-current=\"page\"<% } %>>Staff &amp; account</a>\n      <a href=\"/admin/audit\" class=\"<%= navActive('/admin/audit')?'active':'' %>\"<% if(navActive('/admin/audit')){ %> aria-current=\"page\"<% } %>>Audit trail</a>\n      <a href=\"/admin/gdpr\" class=\"<%= navActive('/admin/gdpr')?'active':'' %>\"<% if(navActive('/admin/gdpr')){ %> aria-current=\"page\"<% } %>>Privacy tools</a>\n      <a href=\"/admin/license\" class=\"<%= navActive('/admin/license')?'active':'' %>\"<% if(navActive('/admin/license')){ %> aria-current=\"page\"<% } %>>License</a>\n    </div>\n  <a class=\"admin-nav-preview\" href=\"/shop\">View shop ↗</a>\n</nav>\n<div class=\"admin-workspace-content\" id=\"manager-page-content\">\n<% } %>\n","partials/back-button.ejs":"<%\n  const backLocaleValue = typeof locale === 'string' ? locale.toLowerCase() : 'en';\n  const backLocale = ['nl','en','ckb','ar','fr'].includes(backLocaleValue) ? backLocaleValue : 'en';\n  const requested = String(typeof fallback === 'string' ? fallback : '/shop');\n  // Absolute same-site paths only; never navigate to a dynamic cross-origin referrer.\n  const backDestination = /^\\/(?!\\/)[a-zA-Z0-9/_-]*$/.test(requested) ? requested : '/shop';\n  const destinationType = backDestination === '/cart' ? 'cart'\n    : backDestination === '/shop' ? 'shop'\n    : backDestination === '/account' ? 'account'\n    : backDestination.startsWith('/admin') ? 'manager'\n    : backDestination === '/login' ? 'login' : 'overview';\n  const backCopy = {\n    en:{cart:'Back to bag',shop:'Back to shop',account:'My orders',manager:'Back to Manager',login:'Back to sign in',overview:'Back to overview'},\n    nl:{cart:'Terug naar winkelmandje',shop:'Terug naar winkel',account:'Mijn bestellingen',manager:'Terug naar beheer',login:'Terug naar inloggen',overview:'Terug naar overzicht'},\n    fr:{cart:'Retour au panier',shop:'Retour à la boutique',account:'Mes commandes',manager:'Retour à la gestion',login:'Retour à la connexion',overview:'Retour à l’accueil'},\n    ckb:{cart:'گەڕانەوە بۆ سەبەتە',shop:'گەڕانەوە بۆ فرۆشگا',account:'داواکارییەکانم',manager:'گەڕانەوە بۆ بەڕێوەبردن',login:'گەڕانەوە بۆ چوونەژوورەوە',overview:'گەڕانەوە بۆ سەرەکی'},\n    ar:{cart:'العودة إلى السلة',shop:'العودة إلى المتجر',account:'طلباتي',manager:'العودة للإدارة',login:'العودة لتسجيل الدخول',overview:'العودة إلى الرئيسية'}\n  };\n  const backLabel = (backCopy[backLocale]||backCopy.en)[destinationType];\n%>\n<nav class=\"page-back\" aria-label=\"<%= backLabel %>\">\n  <a class=\"back-button\" href=\"<%= backDestination %>\" aria-label=\"<%= backLabel %>\"><span class=\"back-button-label\"><%= backLabel %></span></a>\n</nav>\n","partials/footer.ejs":"<% const footerFrench = {\n  'Recently viewed products': 'Produits consultés récemment',\n  'Close cart preview': 'Fermer l’aperçu du panier',\n  'Dismiss language suggestion': 'Ignorer la suggestion de langue',\n  'Close product preview': 'Fermer l’aperçu du produit',\n  'Products selected for comparison': 'Produits sélectionnés pour la comparaison',\n  'Close comparison': 'Fermer la comparaison',\n  'EXPLORE AGAIN': 'À DÉCOUVRIR À NOUVEAU',\n  'STAY CONNECTED': 'RESTONS EN CONTACT',\n  'Receive updates only after confirming your email. No third-party tracker is required.': 'Recevez des nouvelles uniquement après confirmation de votre adresse e-mail. Aucun traceur tiers n’est nécessaire.',\n  'Email address': 'Adresse e-mail',\n  'Subscribe': 'S’abonner',\n  'Shop': 'Boutique',\n  'All products': 'Tous les produits',\n  'Stories': 'Actualités',\n  'Wishlist': 'Favoris',\n  'Cart': 'Panier',\n  'Information': 'Informations',\n  'Privacy': 'Confidentialité',\n  'Cookies': 'Cookies',\n  'Terms': 'Conditions générales',\n  'Shipping & returns': 'Livraison et retours',\n  'FAQ': 'Questions fréquentes',\n  'Contact': 'Contact',\n  'Track an order': 'Suivre une commande',\n  'Account': 'Compte',\n  'Contact & business details': 'Coordonnées de l’entreprise',\n  'Phone': 'Téléphone',\n  'Business name': 'Raison sociale',\n  'Registration / licence': 'Numéro d’entreprise',\n  'Business address': 'Adresse de l’entreprise',\n  'YOUR BAG': 'VOTRE PANIER',\n  'Cart preview': 'Aperçu du panier',\n  'Loading cart…': 'Chargement du panier…',\n  'View bag': 'Voir le panier',\n  'Checkout': 'Passer commande',\n  'Language and region suggestion': 'Langue et région suggérées',\n  'Based only on your browser settings. Choose a language if you want. Confirm your real delivery country and prices at checkout.': 'Suggestion basée uniquement sur les paramètres de votre navigateur. Confirmez le pays de livraison et les prix lors de la commande.',\n  'Language': 'Langue',\n  'Apply': 'Appliquer',\n  'Not now': 'Pas maintenant',\n  'Product preview': 'Aperçu du produit',\n  'Review sizes, variants, availability and shipping on the full product page.': 'Consultez les tailles, variantes, disponibilités et conditions de livraison sur la fiche du produit.',\n  'View full product →': 'Voir la fiche du produit →',\n  'Compare products · ': 'Comparer les produits · ',\n  'Compare selection': 'Comparer la sélection',\n  'Compare your selection': 'Comparer votre sélection',\n  'Compare displayed prices and open each product for current stock, delivery and complete specifications.': 'Comparez les prix affichés et consultez chaque produit pour vérifier le stock, la livraison et les caractéristiques.',\n  'Necessary': 'Nécessaires',\n  'Required for sessions, security and order handling.': 'Indispensables aux sessions, à la sécurité et au traitement des commandes.',\n  'Always on': 'Toujours actifs',\n  'Analytics': 'Statistiques',\n  'Usage measurement to improve the service.': 'Mesure d’utilisation pour améliorer le service.',\n  'Marketing': 'Marketing',\n  'Advertising cookies and campaign measurement.': 'Cookies publicitaires et mesure des campagnes.',\n  'Necessary storage is always on. Your choice is saved on this device for 180 days. No analytics or advertising scripts are loaded in this release.': 'Les cookies nécessaires sont toujours actifs. Votre choix est conservé pendant 180 jours sur cet appareil. Aucun script statistique ou publicitaire n’est chargé dans cette version.',\n  'Payment options shown at checkout.': 'Moyens de paiement indiqués à la commande.'\n}; const footerText = value => locale === 'fr' ? (footerFrench[value] || value) : value; %>\n<% if(typeof managerWorkspaceShell!=='undefined' && managerWorkspaceShell){ %></div><!-- /.admin-workspace-content --><% } %>\n<% if(!isAdminRoute && appearance.recentlyViewed){ %>\n<section class=\"container recently-viewed\" data-recently-viewed hidden aria-label=\"<%= footerText('Recently viewed products') %>\">\n <div class=\"section-heading\"><div><span class=\"eyebrow\"><%= footerText('EXPLORE AGAIN') %></span><h2><%= locale==='fr'?'Consultés récemment':locale==='nl'?'Recent bekeken':locale==='ckb'?'دوایین بەرهەمە بینراوەکان':locale==='ar'?'شوهدت مؤخرًا':'Recently viewed' %></h2></div></div>\n <div class=\"recent-items\" data-recent-items></div>\n</section>\n<% } %>\n</main>\n<% if(!isAdminRoute && appearance.newsletter){ %>\n<section class=\"container newsletter-section\" aria-labelledby=\"newsletter-title\"><div><span class=\"eyebrow\"><%= footerText('STAY CONNECTED') %></span><h2 id=\"newsletter-title\"><%= locale==='fr'?'Actualités de la boutique':locale==='nl'?'Nieuws uit de winkel':locale==='ckb'?'هەواڵی فرۆشگا':locale==='ar'?'أخبار المتجر':'Store updates, by choice' %></h2><p><%= footerText('Receive updates only after confirming your email. No third-party tracker is required.') %></p></div><form action=\"/newsletter/subscribe\" method=\"post\" class=\"engagement-inline-form\"><input type=\"hidden\" name=\"_csrf\" value=\"<%= csrf %>\"><label for=\"newsletter-email\"><%= footerText('Email address') %></label><input type=\"email\" name=\"email\" id=\"newsletter-email\" maxlength=\"254\" autocomplete=\"email\" required><button class=\"btn btn-dark\" type=\"submit\"><%= footerText('Subscribe') %></button></form></section>\n<% } %>\n<% if(isAdminRoute){ %><div class=\"manager-quiet-footer\" role=\"contentinfo\"><span>ShopEasy Manager</span><span>Use <a href=\"/admin/products\">Products</a> to manage the catalogue or <a href=\"/\">View shop</a> to check the public design.</span></div><% } else { %><footer class=\"site-footer\"><div class=\"container footer-grid\">\n  <div class=\"footer-brand\"><strong><%= storeName %></strong><p><%= checkoutCardEnabled\n  ? (locale==='nl'?'Duidelijke prijzen en betaalopties bij het afrekenen.':locale==='fr'?'Prix clairs et moyens de paiement indiqués à la commande.':'Clear prices and payment options at checkout.')\n  : (locale==='nl'?'Duidelijke prijzen en beschikbare betaalmethoden bij het afrekenen.':locale==='fr'?'Prix clairs et paiement selon les moyens proposés.':'Clear prices and available payment methods at checkout.') %></p></div>\n  <div class=\"footer-link-column\"><span class=\"footer-title\"><%= footerText('Shop') %></span><a href=\"/shop\"><%= footerText('All products') %></a><% if(featureStoriesEnabled){ %><a href=\"/stories\"><%= footerText('Stories') %></a><% } %><% if(featureWishlistEnabled){ %><a href=\"/wishlist\"><%= footerText('Wishlist') %></a><% } %><a href=\"/cart\"><%= footerText('Cart') %></a></div>\n  <div class=\"footer-link-column\"><span class=\"footer-title\"><%= footerText('Information') %></span><a href=\"/privacy\"><%= footerText('Privacy') %></a><a href=\"/cookies\"><%= footerText('Cookies') %></a><a href=\"/terms\"><%= footerText('Terms') %></a><a href=\"/shipping-returns\"><%= footerText('Shipping & returns') %></a><a href=\"/withdrawal-form\"><%= locale==='fr'?'Formulaire de rétractation':locale==='nl'?'Modelformulier herroeping':locale==='ckb'?'فۆرمی پاشگەزبوونەوە':locale==='ar'?'نموذج الانسحاب':'Withdrawal form' %></a><a href=\"/imprint\"><%= locale==='fr'?'Informations légales':locale==='nl'?'Bedrijfsgegevens':locale==='ckb'?'زانیاریی کۆمپانیا':locale==='ar'?'معلومات الشركة':'Business information' %></a><a href=\"/faq\"><%= footerText('FAQ') %></a><a href=\"/contact\"><%= footerText('Contact') %></a><a href=\"/order-lookup\"><%= footerText('Track an order') %></a><a href=\"/account\"><%= footerText('Account') %></a></div>\n  <% if(supportEmail||businessPhone||legalName||enterpriseNumber||businessAddress||vatNumber){ %><div class=\"footer-business-column\"><span class=\"footer-title\"><%= footerText('Contact & business details') %></span>\n    <% if(supportEmail){ %><div class=\"footer-detail\"><span>Email</span><a href=\"mailto:<%= supportEmail %>\"><%= supportEmail %></a></div><% } %>\n    <% if(businessPhone){ %><div class=\"footer-detail\"><span><%= footerText('Phone') %></span><a href=\"tel:<%= encodeURIComponent(businessPhone) %>\"><%= businessPhone %></a></div><% } %>\n    <% if(legalName){ %><div class=\"footer-detail\"><span><%= footerText('Business name') %></span><strong><%= legalName %></strong></div><% } %>\n    <% if(enterpriseNumber){ %><div class=\"footer-detail\"><span><%= footerText('Registration / licence') %></span><strong><%= enterpriseNumber %></strong></div><% } %>\n    <% if(businessAddress){ %><div class=\"footer-detail\"><span><%= footerText('Business address') %></span><strong><%= businessAddress %></strong></div><% } %>\n    <% if(vatNumber){ %><div class=\"footer-detail\"><span><%= locale==='fr'?'Numéro de TVA':locale==='nl'?'Btw-nummer':locale==='ckb'?'ژمارەی باج':locale==='ar'?'الرقم الضريبي':'Tax / VAT number' %></span><strong><%= vatNumber %></strong></div><% } %>\n  </div><% } %>\n</div><div class=\"container footer-bottom\"><span>© <%= new Date().getFullYear() %> <%= legalName || storeName %>. <%= locale==='fr'?'Tous droits réservés.':locale==='nl'?'Alle rechten voorbehouden.':locale==='ckb'?'هەموو مافەکان پارێزراون.':locale==='ar'?'جميع الحقوق محفوظة.':'All rights reserved.' %></span><% if(licenseInfo?.licensedTo){ %><span>Licensed to: <%= licenseInfo.licensedTo %></span><% } %><button type=\"button\" class=\"footer-cookie-open\" data-cookie-open><%= locale==='fr'?'Paramètres des cookies':locale==='nl'?'Cookie-instellingen':locale==='ckb'?'ڕێکخستنی کوکی':locale==='ar'?'إعدادات ملفات تعريف الارتباط':'Cookie settings' %></button><span><%= footerText('Payment options shown at checkout.') %></span><span class=\"language-pill footer-language\"><%= locale==='ckb'?'کوردی':locale==='ar'?'العربية':locale==='en'?'EN':locale.toUpperCase() %></span></div></footer><% } %>\n\n<% if(!isAdminRoute && appearance.cartDrawer){ %>\n<dialog class=\"shop-dialog cart-preview-dialog\" data-cart-drawer aria-labelledby=\"cart-preview-title\">\n <div class=\"cart-preview-header\"><div><span class=\"eyebrow\"><%= footerText('YOUR BAG') %></span><h2 id=\"cart-preview-title\"><%= footerText('Cart preview') %></h2></div><button type=\"button\" class=\"shop-dialog-close\" data-cart-drawer-close aria-label=\"<%= footerText('Close cart preview') %>\">×</button></div>\n <p data-cart-drawer-message role=\"status\" aria-live=\"polite\"><%= footerText('Loading cart…') %></p>\n <ul class=\"cart-preview-list\" data-cart-drawer-items></ul>\n <strong class=\"cart-preview-total\" data-cart-drawer-total></strong>\n <div class=\"cart-preview-actions\"><a href=\"/cart\" class=\"btn btn-light\"><%= footerText('View bag') %></a><a href=\"/checkout\" class=\"btn btn-dark\" data-cart-drawer-checkout><%= footerText('Checkout') %></a></div>\n</dialog>\n<% } %>\n<% if(!isAdminRoute && appearance.countrySuggestion && availableUiLocales.length>1){ %>\n<section class=\"language-suggestion\" data-language-suggestion hidden aria-labelledby=\"language-suggestion-title\">\n <div><strong id=\"language-suggestion-title\"><%= footerText('Language and region suggestion') %></strong><p data-language-suggestion-description><%= footerText('Based only on your browser settings. Choose a language if you want. Confirm your real delivery country and prices at checkout.') %></p><p data-country-suggestion hidden></p></div>\n <form action=\"/language\" method=\"post\"><input type=\"hidden\" name=\"_csrf\" value=\"<%= csrf %>\"><input type=\"hidden\" name=\"returnTo\" value=\"<%= returnTo %>\"><label for=\"language-suggestion-select\" class=\"sr-only\"><%= footerText('Language') %></label><select id=\"language-suggestion-select\" name=\"language\"><% uiLocaleOptions.filter(item=>availableUiLocales.includes(item.code)).forEach(option=>{ %><option value=\"<%= option.code %>\" <%= locale===option.code?'selected':'' %>><%= option.nativeLabel %></option><% }) %></select><button type=\"submit\" class=\"btn btn-dark\"><%= footerText('Apply') %></button></form>\n <button type=\"button\" data-language-suggestion-dismiss class=\"btn btn-light\" aria-label=\"<%= footerText('Dismiss language suggestion') %>\"><%= footerText('Not now') %></button>\n</section><% } %>\n<% if(!isAdminRoute && appearance.quickView){ %>\n<dialog class=\"shop-dialog quick-view-dialog\" data-quick-dialog aria-labelledby=\"quick-view-title\">\n <button class=\"shop-dialog-close\" type=\"button\" data-quick-close aria-label=\"<%= footerText('Close product preview') %>\">×</button>\n <div class=\"quick-view-content\"><img data-quick-photo data-fallback-src=\"/assets/product-placeholder.svg\" src=\"/assets/product-placeholder.svg\" alt=\"\" width=\"500\" height=\"600\" decoding=\"async\"><div class=\"quick-view-info\">\n <span class=\"eyebrow\" data-quick-category data-no-translate></span><h2 id=\"quick-view-title\" data-quick-title data-no-translate><%= footerText('Product preview') %></h2><strong class=\"quick-view-price\" data-quick-price data-no-translate></strong><p data-quick-stock role=\"status\"></p>\n <p class=\"field-note\"><%= footerText('Review sizes, variants, availability and shipping on the full product page.') %></p><a class=\"btn btn-dark\" data-quick-link href=\"/shop\"><%= footerText('View full product →') %></a>\n </div></div>\n</dialog>\n<% } %>\n<% if(!isAdminRoute && appearance.compare){ %>\n<section class=\"compare-tray\" data-compare-tray hidden aria-label=\"<%= footerText('Products selected for comparison') %>\">\n <div><strong><%= footerText('Compare products · ') %><span data-compare-count>0</span>/3</strong><div class=\"compare-list\" data-compare-list></div><p data-compare-note aria-live=\"polite\"></p></div>\n <button type=\"button\" class=\"btn btn-dark\" data-compare-open><%= footerText('Compare selection') %></button>\n</section>\n<dialog class=\"shop-dialog compare-dialog\" data-compare-dialog aria-labelledby=\"compare-dialog-title\">\n <div class=\"compare-dialog-head\"><h2 id=\"compare-dialog-title\"><%= footerText('Compare your selection') %></h2><button type=\"button\" class=\"shop-dialog-close\" data-compare-close aria-label=\"<%= footerText('Close comparison') %>\">×</button></div>\n <p><%= footerText('Compare displayed prices and open each product for current stock, delivery and complete specifications.') %></p>\n <div class=\"compare-columns\" data-compare-columns></div>\n</dialog>\n<% } %>\n\n<% if(!isAdminRoute){ %>\n<section class=\"cookie-consent-banner\" data-cookie-banner hidden aria-labelledby=\"cookie-consent-title\" aria-describedby=\"cookie-consent-description\" role=\"region\" data-storage-unavailable=\"<%= locale==='ckb'?'بیرگەی وێبگەڕ ڕێگەی پاشەکەوتکردن نادات. هەڵبژاردەکان لە نوێکردنەوەی پەڕەدا لەبیر دەچن.':locale==='ar'?'لا يسمح تخزين المتصفح بحفظ اختيارك. سيظهر الطلب مجددًا بعد تحديث الصفحة.':locale==='nl'?'De browseropslag is niet beschikbaar. Je keuze kan niet worden bewaard en dit bericht verschijnt opnieuw nadat je de pagina vernieuwt.':locale==='fr'?'Le stockage du navigateur est indisponible. Votre choix ne peut pas être mémorisé et cet avis réapparaîtra après actualisation.':'Browser storage is unavailable, so this choice cannot be saved and this notice will return after refresh.' %>\">\n  <div class=\"cookie-consent-content\">\n    <div class=\"cookie-consent-copy\">\n      <span class=\"eyebrow\"><%= locale==='ckb'?'تایبەتمەندی':locale==='ar'?'الخصوصية':locale==='nl'?'PRIVACYKEUZES':locale==='fr'?'VIE PRIVÉE':'PRIVACY CHOICES' %></span>\n      <h2 id=\"cookie-consent-title\"><%= locale==='ckb'?'ڕێکخستنی کوکی':locale==='ar'?'خيارات ملفات تعريف الارتباط':locale==='nl'?'Cookiekeuzes':locale==='fr'?'Choix des cookies':'Cookie choices' %></h2>\n      <p id=\"cookie-consent-description\"><% if(locale==='ckb'){ %>بیرگەی پێویست بۆ هەژمار، سەبەتە و ئاسایشە. ئامار و ڕیکلام بە بنەڕەت ناچالاکن.<% } else if(locale==='en'){ %>Necessary storage supports your account, basket and security. Analytics and marketing stay off by default.<% } else if(locale==='ar'){ %>التخزين الضروري يدعم الحساب والسلة والأمان. التحليلات والتسويق متوقفان افتراضيًا.<% } else if(locale==='nl'){ %>Noodzakelijke opslag ondersteunt je account, winkelmandje en beveiliging. Analyses en marketing zijn standaard uitgeschakeld.<% } else if(locale==='fr'){ %>Les données nécessaires assurent le fonctionnement du compte, du panier et de la sécurité. Les mesures d’audience et la publicité sont désactivées par défaut.<% } %></p>\n      <div class=\"cookie-consent-links\">\n        <a href=\"/cookies\"><%= locale==='ckb'?'سیاسەتی کوکی بخوێنەوە':locale==='ar'?'اقرأ سياسة ملفات تعريف الارتباط':locale==='nl'?'Lees het cookiebeleid':locale==='fr'?'Consulter la politique des cookies':'Read the cookie policy' %></a>\n        <button type=\"button\" class=\"cookie-consent-customize-link\" data-cookie-customize><%= locale==='ckb'?'ڕێکخستن':locale==='ar'?'تخصيص':locale==='nl'?'Instellingen':locale==='fr'?'Paramètres':'Customize' %></button>\n      </div>\n      <p class=\"cookie-banner-status\" data-cookie-banner-status role=\"status\" aria-live=\"polite\" hidden></p>\n    </div>\n    <div class=\"cookie-consent-actions\" role=\"group\" aria-label=\"Cookie choice actions\">\n      <button type=\"button\" class=\"btn btn-light\" data-cookie-reject><%= locale==='ckb'?'ڕەتکردنەوەی هەڵبژاردەکان':locale==='ar'?'رفض الاختيارية':locale==='nl'?'Alles weigeren':locale==='fr'?'Tout refuser':'Reject optional' %></button>\n      <button type=\"button\" class=\"btn btn-light\" data-cookie-accept><%= locale==='ckb'?'قبوڵکردنی هەموو':locale==='ar'?'قبول الكل':locale==='nl'?'Alles accepteren':locale==='fr'?'Tout accepter':'Accept all' %></button>\n    </div>\n  </div>\n</section>\n<div class=\"cookie-preferences-overlay\" data-cookie-preferences hidden>\n  <section class=\"cookie-preferences-dialog\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"cookie-preferences-title\" tabindex=\"-1\">\n    <div class=\"cookie-preferences-heading\"><div><span class=\"eyebrow\"><%= locale==='ckb'?'ڕێکخستنەکانی تایبەتمەندی':locale==='ar'?'إعدادات الخصوصية':locale==='nl'?'PRIVACYINSTELLINGEN':locale==='fr'?'CONFIDENTIALITÉ':'PRIVACY SETTINGS' %></span><h2 id=\"cookie-preferences-title\"><%= locale==='ckb'?'هەڵبژاردەکانی کوکی':locale==='ar'?'تفضيلات ملفات تعريف الارتباط':locale==='nl'?'Cookie-instellingen':locale==='fr'?'Paramètres des cookies':'Cookie preferences' %></h2></div><button type=\"button\" class=\"cookie-close\" data-cookie-close aria-label=\"<%= locale==='nl'?'Voorkeuren sluiten':locale==='fr'?'Fermer les préférences':locale==='ar'?'إغلاق':locale==='ckb'?'داخستن':'Close preferences' %>\">×</button></div>\n    <p><%= locale==='nl'?'Noodzakelijke opslag is altijd ingeschakeld. Je keuze wordt 180 dagen op dit apparaat bewaard. In deze versie worden geen analyse- of advertentiescripts geladen.':locale==='fr'?'Les cookies nécessaires sont toujours actifs. Votre choix est conservé pendant 180 jours sur cet appareil. Aucun script statistique ou publicitaire n’est chargé dans cette version.':locale==='ckb'?'کوکیی پێویست هەمیشە چالاکە. هەڵبژاردەکانت لەسەر ئەم ئامێرە هەڵدەگیرێن بۆ ١٨٠ ڕۆژ. لەم وەشانەدا هیچ کۆدی ئامار یان ڕیکلام بار ناکرێت.':locale==='ar'?'الملفات الضرورية مفعّلة دائمًا. تُحفظ اختياراتك على هذا الجهاز لمدة 180 يومًا. لا يتم تحميل أدوات التحليلات أو الإعلانات في هذا الإصدار.':'Necessary storage is always on. Your choice is saved on this device for 180 days. No analytics or advertising scripts are loaded in this release.' %></p>\n    <div class=\"cookie-preference-list\">\n      <div class=\"cookie-preference-row\"><div><strong><%= locale==='nl'?'Noodzakelijk':locale==='fr'?'Nécessaires':locale==='ckb'?'کوکیی پێویست':locale==='ar'?'الضرورية':'Necessary' %></strong><p><%= locale==='nl'?'Vereist voor sessies, beveiliging en het verwerken van bestellingen.':locale==='fr'?'Indispensables aux sessions, à la sécurité et au traitement des commandes.':locale==='ckb'?'بۆ سەشن، ئاسایش و بەڕێوەبردنی داواکاری پێویستن.':locale==='ar'?'مطلوبة للجلسة والأمان وإدارة الطلب.':'Required for sessions, security and order handling.' %></p></div><span class=\"cookie-always-on\"><%= locale==='nl'?'Altijd ingeschakeld':locale==='fr'?'Toujours actifs':locale==='ckb'?'هەمیشە چالاک':locale==='ar'?'دائمًا مفعّلة':'Always on' %></span></div>\n      <label class=\"cookie-preference-row\" for=\"cookie-analytics\"><span><strong><%= locale==='nl'?'Statistieken':locale==='fr'?'Statistiques':locale==='ckb'?'ئامار و شیکردنەوە':locale==='ar'?'التحليلات':'Analytics' %></strong><small><%= locale==='nl'?'Gebruiksmeting om de dienstverlening te verbeteren.':locale==='fr'?'Mesure d’utilisation pour améliorer le service.':locale==='ckb'?'داتای بەکارهێنان بۆ باشترکردنی خزمەتگوزاری.':locale==='ar'?'قياس الاستخدام لتحسين الخدمة.':'Usage measurement to improve the service.' %></small></span><input type=\"checkbox\" id=\"cookie-analytics\" data-cookie-analytics></label>\n      <label class=\"cookie-preference-row\" for=\"cookie-marketing\"><span><strong><%= locale==='nl'?'Marketing':locale==='fr'?'Marketing':locale==='ckb'?'ڕیکلام و شوێنکەوتن':locale==='ar'?'التسويق والتتبع':'Marketing' %></strong><small><%= locale==='nl'?'Advertentiecookies en het meten van campagnes.':locale==='fr'?'Cookies publicitaires et mesure des campagnes.':locale==='ckb'?'کوکیی ڕیکلام و پێوانەکردنی کاریگەری.':locale==='ar'?'ملفات تعريف الارتباط الإعلانية وقياس الحملات.':'Advertising cookies and campaign measurement.' %></small></span><input type=\"checkbox\" id=\"cookie-marketing\" data-cookie-marketing></label>\n    </div>\n    <p class=\"cookie-preferences-status\" data-cookie-preferences-status role=\"status\" aria-live=\"polite\"></p>\n    <button type=\"button\" class=\"cookie-reset-choice\" data-cookie-reset><%= locale==='nl'?'Opnieuw om toestemming vragen':locale==='fr'?'Revoir mon choix de consentement':locale==='ckb'?'دووبارە داوای ڕەزامەندی بکە':locale==='ar'?'اطلب موافقتي من جديد':'Ask for my choice again' %></button>\n    <div class=\"cookie-preferences-actions\"><button type=\"button\" class=\"btn btn-light\" data-cookie-close><%= locale==='ckb'?'پاشگەزبوونەوە':locale==='ar'?'إلغاء':locale==='nl'?'Annuleren':locale==='fr'?'Annuler':'Cancel' %></button><button type=\"button\" class=\"btn btn-light\" data-cookie-reject><%= locale==='ckb'?'ڕەتکردنەوەی هەڵبژاردەکان':locale==='ar'?'رفض الاختيارية':locale==='nl'?'Alles weigeren':locale==='fr'?'Tout refuser':'Reject optional' %></button><button type=\"button\" class=\"btn btn-dark\" data-cookie-save><%= locale==='ckb'?'پاشەکەوتکردنی هەڵبژاردەکان':locale==='ar'?'حفظ التفضيلات':locale==='nl'?'Keuzes opslaan':locale==='fr'?'Enregistrer mes choix':'Save choices' %></button></div>\n  </section>\n</div>\n<% } %>\n\n<% if(!isAdminRoute && !isCheckoutRoute){ %><nav class=\"mobile-bottom-nav\" aria-label=\"Mobile navigation\">\n  <a href=\"/\" class=\"<%= path==='/'?'active':'' %>\"><span class=\"mobile-nav-icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"m3 10 9-7 9 7M5.5 9v12h13V9M9.5 21v-6h5v6\"/></svg></span><span class=\"mobile-nav-label\">Home</span></a>\n  <a href=\"/shop\" class=\"<%= path.startsWith('/shop')?'active':'' %>\"><span class=\"mobile-nav-icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"17\" rx=\"2\"/><path d=\"M3 9h18M9 4v5m6-5v5\"/></svg></span><span class=\"mobile-nav-label\"><%= footerText('Shop') %></span></a>\n  <% if(featureWishlistEnabled && isLoggedIn){ %><a href=\"/wishlist\" class=\"<%= path.startsWith('/wishlist')?'active':'' %>\"><span class=\"mobile-nav-icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M20.8 8.7c0 5.4-8.8 11-8.8 11s-8.8-5.6-8.8-11A4.7 4.7 0 0 1 12 6a4.7 4.7 0 0 1 8.8 2.7Z\"/></svg><b data-wishlist-count><%= wishlistCount %></b></span><span class=\"mobile-nav-label\">Saved</span></a><% } else if(featureWishlistEnabled){ %><a href=\"/login?next=%2Fwishlist\"><span class=\"mobile-nav-icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M20.8 8.7c0 5.4-8.8 11-8.8 11s-8.8-5.6-8.8-11A4.7 4.7 0 0 1 12 6a4.7 4.7 0 0 1 8.8 2.7Z\"/></svg></span><span class=\"mobile-nav-label\">Saved</span></a><% } else { %><a href=\"/order-lookup\" class=\"<%= path.startsWith('/order-lookup')?'active':'' %>\"><span class=\"mobile-nav-icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><rect x=\"4\" y=\"4\" width=\"16\" height=\"16\" rx=\"2\"/><path d=\"M7 10h10M7 14h7\"/></svg></span><span class=\"mobile-nav-label\"><%= locale==='fr'?'Suivre':locale==='nl'?'Volgen':locale==='ckb'?'شوێنکەوتن':locale==='ar'?'التتبع':'Track' %></span></a><% } %>\n  <a href=\"/cart\" class=\"<%= path.startsWith('/cart')?'active':'' %>\"><span class=\"mobile-nav-icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M5 8h14l-1.2 12H6.2L5 8Z\"/><path d=\"M9 8V6a3 3 0 0 1 6 0v2\"/></svg><b><%= cartCount %></b></span><span class=\"mobile-nav-label\"><%= footerText('Cart') %></span></a>\n  <a href=\"<%= isLoggedIn?'/account':'/login' %>\" class=\"<%= path.startsWith('/account')||path.startsWith('/login')?'active':'' %>\"><span class=\"mobile-nav-icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4.5 21a7.5 7.5 0 0 1 15 0\"/></svg></span><span class=\"mobile-nav-label\"><%= footerText('Account') %></span></a>\n</nav><% } %>