weigeren':locale==='fr'?'Tout refuser':'Reject optional' %></button>\n      <button type=\"button\" class=\"btn btn-light\" data-cookie-accept><%= locale==='ckb'?'قبوڵکردنی هەموو':locale==='ar'?'قبول الكل':locale==='nl'?'Alles accepteren':locale==='fr'?'Tout accepter':'Accept all' %></button>\n    </div>\n  </div>\n</section>\n<div class=\"cookie-preferences-overlay\" data-cookie-preferences hidden>\n  <section class=\"cookie-preferences-dialog\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"cookie-preferences-title\" tabindex=\"-1\">\n    <div class=\"cookie-preferences-heading\"><div><span class=\"eyebrow\"><%= locale==='ckb'?'ڕێکخستنەکانی تایبەتمەندی':locale==='ar'?'إعدادات الخصوصية':locale==='nl'?'PRIVACYINSTELLINGEN':locale==='fr'?'CONFIDENTIALITÉ':'PRIVACY SETTINGS' %></span><h2 id=\"cookie-preferences-title\"><%= locale==='ckb'?'هەڵبژاردەکانی کوکی':locale==='ar'?'تفضيلات ملفات تعريف الارتباط':locale==='nl'?'Cookie-instellingen':locale==='fr'?'Paramètres des cookies':'Cookie preferences' %></h2></div><button type=\"button\" class=\"cookie-close\" data-cookie-close aria-label=\"<%= locale==='fr'?'Fermer les préférences':locale==='ar'?'إغلاق':locale==='ckb'?'داخستن':'Close preferences' %>\">×</button></div>\n    <p><%= locale==='fr'?'Les cookies nécessaires sont toujours actifs. Votre choix est conservé pendant 180 jours sur cet appareil. Aucun script statistique ou publicitaire n’est chargé dans cette version.':locale==='ckb'?'کوکیی پێویست هەمیشە چالاکە. هەڵبژاردەکانت لەسەر ئەم ئامێرە هەڵدەگیرێن بۆ ١٨٠ ڕۆژ. لەم وەشانەدا هیچ کۆدی ئامار یان ڕیکلام بار ناکرێت.':locale==='ar'?'الملفات الضرورية مفعّلة دائمًا. تُحفظ اختياراتك على هذا الجهاز لمدة 180 يومًا. لا يتم تحميل أدوات التحليلات أو الإعلانات في هذا الإصدار.':'Necessary storage is always on. Your choice is saved on this device for 180 days. No analytics or advertising scripts are loaded in this release.' %></p>\n    <div class=\"cookie-preference-list\">\n      <div class=\"cookie-preference-row\"><div><strong><%= locale==='fr'?'Nécessaires':locale==='ckb'?'کوکیی پێویست':locale==='ar'?'الضرورية':'Necessary' %></strong><p><%= locale==='fr'?'Indispensables aux sessions, à la sécurité et au traitement des commandes.':locale==='ckb'?'بۆ سەشن، ئاسایش و بەڕێوەبردنی داواکاری پێویستن.':locale==='ar'?'مطلوبة للجلسة والأمان وإدارة الطلب.':'Required for sessions, security and order handling.' %></p></div><span class=\"cookie-always-on\"><%= locale==='fr'?'Toujours actifs':locale==='ckb'?'هەمیشە چالاک':locale==='ar'?'دائمًا مفعّلة':'Always on' %></span></div>\n      <label class=\"cookie-preference-row\" for=\"cookie-analytics\"><span><strong><%= locale==='fr'?'Statistiques':locale==='ckb'?'ئامار و شیکردنەوە':locale==='ar'?'التحليلات':'Analytics' %></strong><small><%= locale==='fr'?'Mesure d’utilisation pour améliorer le service.':locale==='ckb'?'داتای بەکارهێنان بۆ باشترکردنی خزمەتگوزاری.':locale==='ar'?'قياس الاستخدام لتحسين الخدمة.':'Usage measurement to improve the service.' %></small></span><input type=\"checkbox\" id=\"cookie-analytics\" data-cookie-analytics></label>\n      <label class=\"cookie-preference-row\" for=\"cookie-marketing\"><span><strong><%= locale==='fr'?'Marketing':locale==='ckb'?'ڕیکلام و شوێنکەوتن':locale==='ar'?'التسويق والتتبع':'Marketing' %></strong><small><%= locale==='fr'?'Cookies publicitaires et mesure des campagnes.':locale==='ckb'?'کوکیی ڕیکلام و پێوانەکردنی کاریگەری.':locale==='ar'?'ملفات تعريف الارتباط الإعلانية وقياس الحملات.':'Advertising cookies and campaign measurement.' %></small></span><input type=\"checkbox\" id=\"cookie-marketing\" data-cookie-marketing></label>\n    </div>\n    <p class=\"cookie-preferences-status\" data-cookie-preferences-status role=\"status\" aria-live=\"polite\"></p>\n    <button type=\"button\" class=\"cookie-reset-choice\" data-cookie-reset><%= locale==='nl'?'Opnieuw om toestemming vragen':locale==='fr'?'Revoir mon choix de consentement':locale==='ckb'?'دووبارە داوای ڕەزامەندی بکە':locale==='ar'?'اطلب موافقتي من جديد':'Ask for my choice again' %></button>\n    <div class=\"cookie-preferences-actions\"><button type=\"button\" class=\"btn btn-light\" data-cookie-close><%= locale==='ckb'?'پاشگەزبوونەوە':locale==='ar'?'إلغاء':locale==='nl'?'Annuleren':locale==='fr'?'Annuler':'Cancel' %></button><button type=\"button\" class=\"btn btn-light\" data-cookie-reject><%= locale==='ckb'?'ڕەتکردنەوەی هەڵبژاردەکان':locale==='ar'?'رفض الاختيارية':locale==='nl'?'Alles weigeren':locale==='fr'?'Tout refuser':'Reject optional' %></button><button type=\"button\" class=\"btn btn-dark\" data-cookie-save><%= locale==='ckb'?'پاشەکەوتکردنی هەڵبژاردەکان':locale==='ar'?'حفظ التفضيلات':locale==='nl'?'Keuzes opslaan':locale==='fr'?'Enregistrer mes choix':'Save choices' %></button></div>\n  </section>\n</div>\n<% } %>\n\n<% if(!isAdminRoute && !isCheckoutRoute){ %><nav class=\"mobile-bottom-nav\" aria-label=\"Mobile navigation\">\n  <a href=\"/\" class=\"<%= path==='/'?'active':'' %>\"><span class=\"mobile-nav-icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"m3 10 9-7 9 7M5.5 9v12h13V9M9.5 21v-6h5v6\"/></svg></span><span class=\"mobile-nav-label\">Home</span></a>\n  <a href=\"/shop\" class=\"<%= path.startsWith('/shop')?'active':'' %>\"><span class=\"mobile-nav-icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"17\" rx=\"2\"/><path d=\"M3 9h18M9 4v5m6-5v5\"/></svg></span><span class=\"mobile-nav-label\"><%= footerText('Shop') %></span></a>\n  <% if(featureWishlistEnabled && isLoggedIn){ %><a href=\"/wishlist\" class=\"<%= path.startsWith('/wishlist')?'active':'' %>\"><span class=\"mobile-nav-icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M20.8 8.7c0 5.4-8.8 11-8.8 11s-8.8-5.6-8.8-11A4.7 4.7 0 0 1 12 6a4.7 4.7 0 0 1 8.8 2.7Z\"/></svg><b data-wishlist-count><%= wishlistCount %></b></span><span class=\"mobile-nav-label\">Saved</span></a><% } else if(featureWishlistEnabled){ %><a href=\"/login?next=%2Fwishlist\"><span class=\"mobile-nav-icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M20.8 8.7c0 5.4-8.8 11-8.8 11s-8.8-5.6-8.8-11A4.7 4.7 0 0 1 12 6a4.7 4.7 0 0 1 8.8 2.7Z\"/></svg></span><span class=\"mobile-nav-label\">Saved</span></a><% } else { %><a href=\"/order-lookup\" class=\"<%= path.startsWith('/order-lookup')?'active':'' %>\"><span class=\"mobile-nav-icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><rect x=\"4\" y=\"4\" width=\"16\" height=\"16\" rx=\"2\"/><path d=\"M7 10h10M7 14h7\"/></svg></span><span class=\"mobile-nav-label\"><%= locale==='fr'?'Suivre':locale==='nl'?'Volgen':locale==='ckb'?'شوێنکەوتن':locale==='ar'?'التتبع':'Track' %></span></a><% } %>\n  <a href=\"/cart\" class=\"<%= path.startsWith('/cart')?'active':'' %>\"><span class=\"mobile-nav-icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M5 8h14l-1.2 12H6.2L5 8Z\"/><path d=\"M9 8V6a3 3 0 0 1 6 0v2\"/></svg><b><%= cartCount %></b></span><span class=\"mobile-nav-label\"><%= footerText('Cart') %></span></a>\n  <a href=\"<%= isLoggedIn?'/account':'/login' %>\" class=\"<%= path.startsWith('/account')||path.startsWith('/login')?'active':'' %>\"><span class=\"mobile-nav-icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4.5 21a7.5 7.5 0 0 1 15 0\"/></svg></span><span class=\"mobile-nav-label\"><%= footerText('Account') %></span></a>\n</nav><% } %>\n<% if(locale==='fr'){ %><script src=\"/js/i18n-fr.js?v=2027-fr\" defer></script><% } else if(locale==='ar'){ %><script src=\"/js/i18n-ar.js?v=2.8.94-r27\" defer></script><% } else if(locale==='ckb'){ %><script src=\"/js/i18n-ckb.js?v=2.8.94-r27\" defer></script><% } else if(locale==='nl'){ %><script src=\"/js/i18n-nl.js?v=2.8.94-r27\" defer></script><% } %>\n<script src=\"/js/image-fallback.js?v=2.8.94-r27\" defer></script>\n<script src=\"/js/product-image-preview.js?v=2027-r27\" defer></script>\n<% if(String(path||'').startsWith('/product/')){ %><script src=\"/js/product-photo-zoom.js?v=2027-r27\" defer></script><% } %>\n<script src=\"/js/app.js?v=2027-r27\" defer></script>\n<script src=\"/js/retail-2027.js?v=2027-p2\" defer></script>\n<% if(path==='/login' || path==='/register'){ %><script src=\"/js/home-login.js?v=2027-r27\" defer></script><% } %>\n</body></html>\n","partials/header.ejs":"<%\n  const themeModeLabel = ({en:'Use dark mode',ckb:'دۆخی تاریک بەکاربهێنە',ar:'استخدام الوضع الداكن',nl:'Donkere modus gebruiken',fr:'Activer le mode sombre'})[locale] || 'Use dark mode';\n  const announcementLabel = ({en:'Store announcements',ckb:'ڕاگەیاندنەکانی فرۆشگا',ar:'إعلانات المتجر',nl:'Winkelmededelingen',fr:'Annonces de la boutique'})[locale] || 'Store announcements';\n  const titleTranslations = {\n    fr: {'Home':'Accueil','Shop':'Boutique','Account':'Compte','Cart':'Panier','Checkout':'Paiement','Sign in':'Se connecter','Create account':'Créer un compte','Products':'Produits','Product not found':'Produit introuvable','Order not found':'Commande introuvable','Page not found':'Page introuvable','FAQ':'Questions fréquentes','Contact':'Contact','Terms':'Conditions générales','Privacy':'Confidentialité','Shipping & returns':'Livraison et retours','Business information':'Mentions légales','Withdrawal form':'Formulaire de rétractation','Store manager':'Gestion de la boutique','Store settings':'Paramètres de la boutique','Categories':'Catégories','Order status':'Statut de commande','Wishlist':'Favoris','Orders':'Commandes','Customers':'Clients','Product':'Produit','Account security':'Sécurité du compte'},\n    nl: {'Home':'Startpagina','Account security':'Accountbeveiliging','Account':'Account','Cart':'Winkelmandje','Checkout':'Afrekenen','Forgot your password?':'Wachtwoord vergeten?','Create account':'Account aanmaken','Sign in':'Inloggen','Information':'Informatie','Shop':'Winkel','Stories':'Verhalen','Checkout cancelled':'Afrekenen geannuleerd','Order status':'Bestelstatus','Wishlist':'Verlanglijst','Audit log':'Auditlogboek','Storefront branding':'Winkelpresentatie','Categories':'Categorieën','Coupons':'Kortingsbonnen','Customers':'Klanten','Store manager':'Winkelbeheer','Orders':'Bestellingen','Products':'Producten','Store settings':'Winkelinstellingen','Add product':'Product toevoegen','Edit product':'Product bewerken','Add story':'Verhaal toevoegen','Edit story':'Verhaal bewerken','Privacy':'Privacy','Terms':'Voorwaarden','Shipping & returns':'Verzending & retouren','FAQ':'Veelgestelde vragen','Contact':'Contact','Business information':'Bedrijfsgegevens','Withdrawal form':'Herroepingsformulier','Page not found':'Pagina niet gevonden','Order not found':'Bestelling niet gevonden','Product not found':'Product niet gevonden'},\n    ckb: {'Home':'سەرەکی','Account security':'پاراستنی هەژمار','Account':'هەژمار','Cart':'سەبەتە','Checkout':'تەواوکردنی کڕین','Forgot your password?':'وشەی نهێنیت لەبیرچووە؟','Create account':'دروستکردنی هەژمار','Sign in':'چوونەژوورەوە','Information':'زانیاری','Shop':'فرۆشگا','Stories':'چیرۆکەکان','Checkout cancelled':'هەڵوەشاندنەوەی داواکاری','Order status':'دۆخی داواکاری','Wishlist':'لیستی دڵخوازەکان','Audit log':'تۆماری پشکنین','Storefront branding':'دیزاینی فرۆشگا','Categories':'پۆلەکان','Coupons':'کۆدەکانی داشکاندن','Customers':'کڕیارەکان','Store manager':'بەڕێوەبردنی فرۆشگا','Orders':'داواکارییەکان','Products':'بەرهەمەکان','Store settings':'ڕێکخستنەکانی فرۆشگا','Add product':'زیادکردنی بەرهەم','Edit product':'دەستکاریکردنی بەرهەم','Add story':'زیادکردنی چیرۆک','Edit story':'دەستکاریکردنی چیرۆک','Privacy':'پاراستنی تایبەتمەندی','Terms':'مەرجەکان','Shipping & returns':'گەیاندن و گەڕاندنەوە','Business information':'زانیاریی بازرگانی','Withdrawal form':'فۆرمی پاشگەزبوونەوە','Page not found':'پەڕە نەدۆزرایەوە','Order not found':'داواکاری نەدۆزرایەوە','Product not found':'بەرهەم نەدۆزرایەوە'},\n    ar: {'Home':'الرئيسية','Account security':'أمان الحساب','Account':'الحساب','Cart':'سلة التسوق','Checkout':'إتمام الطلب','Forgot your password?':'هل نسيت كلمة المرور؟','Create account':'إنشاء حساب','Sign in':'تسجيل الدخول','Information':'معلومات','Shop':'المتجر','Stories':'القصص','Checkout cancelled':'تم إلغاء الطلب','Order status':'حالة الطلب','Wishlist':'قائمة الأمنيات','Audit log':'سجل التدقيق','Storefront branding':'تصميم واجهة المتجر','Categories':'الفئات','Coupons':'القسائم','Customers':'العملاء','Store manager':'إدارة المتجر','Orders':'الطلبات','Products':'المنتجات','Store settings':'إعدادات المتجر','Add product':'إضافة منتج','Edit product':'تعديل المنتج','Add story':'إضافة قصة','Edit story':'تعديل القصة','Privacy':'سياسة الخصوصية','Terms':'الشروط والأحكام','Shipping & returns':'الشحن والإرجاع','Business information':'معلومات الشركة','Withdrawal form':'نموذج الانسحاب','Page not found':'الصفحة غير موجودة','Order not found':'الطلب غير موجود','Product not found':'المنتج غير موجود'}\n  };\n  const rawTitle = title || storeName;\n  const localizedTitle = titleTranslations[locale]?.[rawTitle] || rawTitle;\n  const pageTitle = title ? `${localizedTitle} · ${storeName}` : storeName;\n  const defaultDescription = locale === 'fr'\n    ? `${localizedTitle} chez ${storeName}. Découvrez nos produits, comparez les prix et commandez en toute sécurité.`\n    : locale === 'nl'\n    ? `${localizedTitle} bij ${storeName}. Bekijk producten, vergelijk duidelijke prijzen en plaats veilig een bestelling. Betaal bij levering wanneer deze optie beschikbaar is.`\n    : locale === 'ckb'\n    ? `${localizedTitle} لە ${storeName}. بەرهەمەکان ببینە، نرخە ڕوونەکان بەراورد بکە و بە پارەدان لە کاتی گەیاندن داواکاری بکە.`\n    : locale === 'ar'\n      ? `${localizedTitle} في ${storeName}. تصفح المنتجات وقارن الأسعار الواضحة واطلب مع الدفع نقدًا عند التسليم.`\n      : `${localizedTitle} at ${storeName}. Browse products, compare clear prices and place a secure cash-on-delivery order.`;\n  const pageDescription = (typeof description === 'string' && description.trim())\n    ? description.trim().slice(0,300)\n    : defaultDescription.slice(0,300);\n  const privatePrefixes = ['/admin','/account','/cart','/checkout','/login','/register','/forgot-password','/wishlist','/success','/order','/order-lookup','/local-manager-recovery','/verify-email','/mfa','/session','/payments','/api'];\n  const privateRoutePath = String(path || '/').toLowerCase();\n  const noIndexPage = Boolean((typeof seoNoIndex !== 'undefined' && seoNoIndex) || isAdminRoute || isCheckoutRoute || privatePrefixes.some(prefix => privateRoutePath === prefix || privateRoutePath.startsWith(`${prefix}/`)));\n  const canonicalUrl = !noIndexPage && typeof seoCanonicalUrl === 'string' ? seoCanonicalUrl : '';\n  const alternateLinks = !noIndexPage && Array.isArray(seoAlternateLinks) ? seoAlternateLinks : [];\n  const socialLocale = locale === 'ckb' ? 'ckb' : locale === 'ar' ? 'ar' : locale === 'nl' ? 'nl_BE' : locale === 'fr' ? 'fr_BE' : 'en_GB';\n  // All pages use app.css. This allow-list only scopes storefront-specific mobile-search markup.\n  const routePath = String(path || '/').split('?')[0].replace(/\\/$/, '') || '/';\n  const isStorefrontPage = routePath === '/' ||\n    ['/shop','/wishlist','/cart','/checkout','/checkout/success','/order-lookup','/success','/privacy','/terms','/cookies','/shipping-returns','/imprint','/withdrawal-form','/faq','/contact','/policy','/stories','/error','/login','/forgot-password'].includes(routePath) ||\n    ['/category/','/product/','/order/','/account/order/'].some(prefix => routePath.startsWith(prefix));\n%>\n<!doctype html>\n<html lang=\"<%= locale==='ckb'?'ckb':locale==='ar'?'ar':locale==='nl'?'nl-BE':locale==='fr'?'fr-BE':'en-GB' %>\" dir=\"<%= ['ckb','ar'].includes(locale)?'rtl':'ltr' %>\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n  <meta name=\"description\" content=\"<%= pageDescription %>\">\n  <meta name=\"robots\" content=\"<%= noIndexPage?'noindex, nofollow':'index, follow' %>\">\n  <meta property=\"og:title\" content=\"<%= pageTitle %>\">\n  <meta property=\"og:description\" content=\"<%= pageDescription %>\">\n  <% if(typeof socialImageUrl === 'string' && /^https:\\/\\/[^\\s<>]+$/i.test(socialImageUrl)){ %><meta property=\"og:image\" content=\"<%= socialImageUrl %>\"><% } %>\n  <meta property=\"og:type\" content=\"website\">\n  <meta property=\"og:site_name\" content=\"<%= storeName %>\">\n  <meta property=\"og:locale\" content=\"<%= socialLocale %>\">\n  <% if(canonicalUrl){ %><meta property=\"og:url\" content=\"<%= canonicalUrl %>\"><link rel=\"canonical\" href=\"<%= canonicalUrl %>\"><% alternateLinks.forEach(alternate => { %><link rel=\"alternate\" hreflang=\"<%= alternate.hreflang %>\" href=\"<%= alternate.href %>\"><% }); %><% } %>\n  <meta name=\"twitter:card\" content=\"summary\">\n  <meta name=\"twitter:title\" content=\"<%= pageTitle %>\">\n  <meta name=\"twitter:description\" content=\"<%= pageDescription %>\">\n  <link rel=\"icon\" href=\"<%= safeImageUrl(shopLogo) %>\" type=\"<%= shopLogo.endsWith('.png') ? 'image/png' : shopLogo.endsWith('.webp') ? 'image/webp' : shopLogo.endsWith('.jpg') ? 'image/jpeg' : 'image/svg+xml' %>\">\n  <meta name=\"csrf-token\" content=\"<%= csrf %>\">\n  <meta name=\"theme-color\" content=\"#F7F6F2\">\n  <meta name=\"color-scheme\" content=\"light dark\">\n  <% if(typeof productJsonLdSafe === 'string' && productJsonLdSafe){ %><script type=\"application/ld+json\"><%- productJsonLdSafe %></script><% } %>\n  <% if(typeof organizationJsonLdSafe === 'string' && organizationJsonLdSafe){ %><script type=\"application/ld+json\"><%- organizationJsonLdSafe %></script><% } %>\n  <% if(typeof breadcrumbJsonLdSafe === 'string' && breadcrumbJsonLdSafe){ %><script type=\"application/ld+json\"><%- breadcrumbJsonLdSafe %></script><% } %>\n  <title><%= pageTitle %></title>\n  <meta name=\"shopeasy-design-version\" content=\"editorial-2027\">\n  <% if(appearance.darkMode){ %><script src=\"/js/theme-early-2027.js?v=atelier-1\"></script><% } %>\n  <link rel=\"stylesheet\" href=\"/css/app.css?v=2027-r27\">\n  <link rel=\"stylesheet\" href=\"/css/design-tokens.css?v=2027-p1\">\n  <link rel=\"stylesheet\" href=\"/css/retail-2027.css?v=2027-p1\">\n  <link rel=\"stylesheet\" href=\"/css/editorial-2027.css?v=2027-atelier-1\">\n  <link rel=\"stylesheet\" href=\"/theme/shop.css?v=2027-p1\">\n  <link rel=\"stylesheet\" href=\"/css/research-polish-2027.css?v=2027-r27\">\n</head>\n<body data-design-version=\"research-2027\" data-page-kind=\"<%= isAdminRoute ? 'manager' : isCheckoutRoute ? 'checkout' : 'storefront' %>\" data-motion=\"<%= appearance.motion?'on':'off' %>\" class=\"<%= isAdminRoute ? 'is-admin-app' : 'is-storefront-app' %>\">\n<a class=\"skip-link\" href=\"#main-content\"><%= locale==='fr'?'Aller au contenu':'Skip to content' %></a>\n<div class=\"announcement\" role=\"region\" aria-label=\"<%= announcementLabel %>\"><div class=\"container announcement-inner\"><div class=\"announcement-message\"><span><%= checkoutCardEnabled ? (locale==='ckb'?'کاش و کارت':locale==='ar'?'الدفع نقدًا وبالبطاقة':locale==='nl'?'Contant of met kaart betalen':locale==='fr'?'Paiement à la livraison ou par carte':'Cash on delivery and card') : (locale==='ckb'?'پارەدان لە کاتی گەیاندن':locale==='ar'?'الدفع نقدًا عند التسليم':locale==='nl'?'Contant betalen bij levering':locale==='fr'?'Paiement à la livraison':'Cash on delivery') %><% if(bankTransferEnabled){ %><%= locale==='ckb'?' · گواستنەوەی بانکی':locale==='ar'?' · تحويل مصرفي':locale==='nl'?' · Bankoverschrijving':locale==='fr'?' · Virement bancaire':' · Bank transfer' %><% } %></span><span class=\"announcement-divider\" aria-hidden=\"true\">·</span><span><%= locale==='ckb'?'نرخی ڕوون':locale==='ar'?'أسعار واضحة':locale==='nl'?'Duidelijke prijzen':locale==='fr'?'Prix transparents':'Clear pricing' %></span></div><div class=\"announcement-tools\"><form class=\"language-switch\" action=\"/language\" method=\"post\" aria-label=\"<%= locale==='fr'?'Choisir la langue':'Choose language' %>\"><input type=\"hidden\" name=\"_csrf\" value=\"<%= csrf %>\"><input type=\"hidden\" name=\"returnTo\" value=\"<%= returnTo||path||'/' %>\"><label class=\"sr-only\" for=\"site-language\"><%= locale==='fr'?'Langue':'Language' %></label><select id=\"site-language\" name=\"language\" data-language-select aria-label=\"Language\"><% if((availableUiLocales||['en','ckb','ar','nl','fr']).includes('en')){ %><option value=\"en\" <%= locale==='en'?'selected':'' %>>English</option><% } %><% if((availableUiLocales||['en','ckb','ar','nl','fr']).includes('ckb')){ %><option value=\"ckb\" <%= locale==='ckb'?'selected':'' %>>کوردی (سۆرانی)</option><% } %><% if((availableUiLocales||['en','ckb','ar','nl','fr']).includes('ar')){ %><option value=\"ar\" <%= locale==='ar'?'selected':'' %>>العربية</option><% } %><% if((availableUiLocales||['en','ckb','ar','nl','fr']).includes('nl')){ %><option value=\"nl\" <%= locale==='nl'?'selected':'' %>>Nederlands</option><% } %><% if((availableUiLocales||['en','ckb','ar','nl','fr']).includes('fr')){ %><option value=\"fr\" <%= locale==='fr'?'selected':'' %>>Français</option><% } %></select><noscript><button class=\"language-apply\" type=\"submit\"><%= locale==='fr'?'Appliquer':'Apply' %></button></noscript></form><% if(appearance.darkMode&&!isAdminRoute){ %><button type=\"button\" class=\"theme-toggle theme-toggle-inline\" data-theme-toggle data-no-translate aria-label=\"<%= themeModeLabel %>\" aria-pressed=\"false\" title=\"<%= themeModeLabel %>\"><span data-theme-icon aria-hidden=\"true\">☾</span><span class=\"sr-only\" data-theme-label><%= themeModeLabel %></span></button><% } %></div></div></div>\n<header class=\"site-header\">\n  <div class=\"container nav-row\">\n    <a class=\"brand\" href=\"/\" aria-label=\"<%= storeName %> home\"><img class=\"brand-logo\" src=\"<%= safeImageUrl(shopLogo) %>\" alt=\"\" width=\"38\" height=\"38\"><span class=\"brand-word\"><%= storeName %></span></a>\n    <% if (!isAdminRoute && isStorefrontPage) { %>\n    <div class=\"search-box storefront-search\" <%= featureAutocompleteEnabled?'data-search-box':'' %>>\n      <form class=\"search\" action=\"/shop\" method=\"get\" role=\"search\">\n        <span class=\"search-icon\" aria-hidden=\"true\">⌕</span>\n        <input data-search-input name=\"search\" autocomplete=\"off\" aria-label=\"<%= locale==='fr'?'Rechercher des produits':'Search products' %>\" placeholder=\"<%= locale==='fr'?'Rechercher des produits…':'Search products…' %>\" value=\"<%= typeof search !== 'undefined' ? search : '' %>\">\n        <button type=\"submit\" aria-label=\"<%= locale==='fr'?'Rechercher':'Search' %>\">→</button>\n      </form>\n      <div class=\"search-results\" data-search-results hidden></div><% if(typeof aiEnabled !== 'undefined' && aiEnabled){ %><small class=\"search-ai-disclosure\"><%= locale==='nl'?'AI-zoekhulp bij volledig zoeken; je zoekterm wordt gedeeld met de ingestelde AI-dienst.':locale==='ckb'?'یارمەتی گەڕانی AI لە گەڕانی تەواودا؛ تەنها وشەی گەڕان بۆ خزمەتگوزاری AI دەنێردرێت.':locale==='ar'?'بحث بمساعدة الذكاء الاصطناعي عند إرسال البحث؛ تتم مشاركة عبارة البحث فقط مع خدمة الذكاء الاصطناعي المهيأة.':locale==='fr'?'Recherche assistée par IA lors de la recherche complète ; seule votre requête est transmise au service d’IA configuré.':'AI-assisted results on full search; only your search phrase is sent to the configured AI service.' %></small><% } %>\n    </div>\n    <% } else if (!isAdminRoute) { %>\n    <div class=\"search-box\" <%= featureAutocompleteEnabled?'data-search-box':'' %>>\n      <form class=\"search\" action=\"/shop\" method=\"get\" role=\"search\">\n        <span class=\"search-icon\" aria-hidden=\"true\">⌕</span>\n        <input data-search-input name=\"search\" autocomplete=\"off\" aria-label=\"<%= locale==='fr'?'Rechercher des produits':'Search products' %>\" placeholder=\"<%= locale==='fr'?'Rechercher des produits…':'Search products…' %>\" value=\"<%= typeof search !== 'undefined' ? search : '' %>\">\n        <button type=\"submit\" aria-label=\"<%= locale==='fr'?'Rechercher':'Search' %>\">→</button>\n      </form>\n      <div class=\"search-results\" data-search-results hidden></div><% if(typeof aiEnabled !== 'undefined' && aiEnabled){ %><small class=\"search-ai-disclosure\"><%= locale==='nl'?'AI-zoekhulp bij volledig zoeken; je zoekterm wordt gedeeld met de ingestelde AI-dienst.':locale==='ckb'?'یارمەتی گەڕانی AI لە گەڕانی تەواودا؛ تەنها وشەی گەڕان بۆ خزمەتگوزاری AI دەنێردرێت.':locale==='ar'?'بحث بمساعدة الذكاء الاصطناعي عند إرسال البحث؛ تتم مشاركة عبارة البحث فقط مع خدمة الذكاء الاصطناعي المهيأة.':locale==='fr'?'Recherche assistée par IA lors de la recherche complète ; seule votre requête est transmise au service d’IA configuré.':'AI-assisted results on full search; only your search phrase is sent to the configured AI service.' %></small><% } %>\n    </div>\n    <% } %>\n    <% if (isAdminRoute) { %>\n    <div class=\"admin-header-actions\" role=\"group\" aria-label=\"Manager account actions\">\n      <% if(appearance.darkMode){ %><button type=\"button\" class=\"theme-toggle theme-toggle-admin\" data-theme-toggle data-no-translate aria-label=\"<%= themeModeLabel %>\" aria-pressed=\"false\" title=\"<%= themeModeLabel %>\"><span data-theme-icon aria-hidden=\"true\">☾</span><span class=\"sr-only\" data-theme-label><%= themeModeLabel %></span></button><% } %>\n      <form class=\"admin-header-language\" action=\"/language\" method=\"post\" aria-label=\"Change language\">\n        <input type=\"hidden\" name=\"_csrf\" value=\"<%= csrf %>\">\n        <input type=\"hidden\" name=\"returnTo\" value=\"<%= returnTo||path||'/admin' %>\">\n        <label class=\"sr-only\" for=\"admin-language\"><%= locale==='fr'?'Langue':'Language' %></label>\n        <select id=\"admin-language\" name=\"language\" data-language-select aria-label=\"Language\">\n          <% if((availableUiLocales||['en','ckb','ar','nl','fr']).includes('en')){ %><option value=\"en\" <%= locale==='en'?'selected':'' %>>EN</option><% } %>\n          <% if((availableUiLocales||['en','ckb','ar','nl','fr']).includes('ckb')){ %><option value=\"ckb\" <%= locale==='ckb'?'selected':'' %>>CKB</option><% } %>\n          <% if((availableUiLocales||['en','ckb','ar','nl','fr']).includes('ar')){ %><option value=\"ar\" <%= locale==='ar'?'selected':'' %>>AR</option><% } %>\n          <% if((availableUiLocales||['en','ckb','ar','nl','fr']).includes('nl')){ %><option value=\"nl\" <%= locale==='nl'?'selected':'' %>>NL</option><% } %>\n          <% if((availableUiLocales||['en','ckb','ar','nl','fr']).includes('fr')){ %><option value=\"fr\" <%= locale==='fr'?'selected':'' %>>FR</option><% } %>\n        </select>\n        <noscript><button type=\"submit\" class=\"admin-header-language-submit\"><%= locale==='fr'?'Appliquer':'Apply' %></button></noscript>\n      </form>\n      <% if (String(user?.role||'').toLowerCase() === 'manager') { %><a class=\"admin-header-account\" href=\"/admin/staff\"><%= locale==='ckb'?'هەژمار':locale==='ar'?'الحساب':locale==='nl'?'Account':'Account' %></a><% } else { %><a class=\"admin-header-account\" href=\"/admin\"><%= locale==='ckb'?'پوختە':locale==='ar'?'نظرة عامة':locale==='nl'?'Overzicht':'Overview' %></a><% } %>\n      <form class=\"admin-header-logout\" method=\"post\" action=\"/logout\"><input type=\"hidden\" name=\"_csrf\" value=\"<%= csrf %>\"><button type=\"submit\"><%= locale==='ckb'?'چوونەدەرەوە':locale==='ar'?'تسجيل الخروج':locale==='nl'?'Uitloggen':locale==='fr'?'Se déconnecter':'Log out' %></button></form>\n    </div>\n    <% } else { %>\n    <nav class=\"nav-links\" data-nav aria-label=\"Primary navigation\" id=\"site-navigation\">\n      <a href=\"/shop\">Shop</a>\n      <% function renderNavCategory(c,depth=0){ %><div class=\"nav-category-node depth-<%= depth %>\"><a href=\"/category/<%= encodeURIComponent(c.slug) %>\" data-no-translate><% if(depth===0){ %><strong><%= c.name %></strong><% } else { %><%= c.name %><% } %></a><% if(c.children?.length){ %><div class=\"nav-category-children\"><% c.children.forEach(child=>renderNavCategory(child,depth+1)); %></div><% } %></div><% } %><% if(navCategories?.length){ %><div class=\"nav-category-menu\"><button type=\"button\" class=\"nav-category-trigger\" aria-expanded=\"false\" aria-controls=\"site-category-panel\">Categories <span aria-hidden=\"true\">⌄</span></button><div class=\"nav-category-panel\" id=\"site-category-panel\"><% navCategories.forEach(c=>renderNavCategory(c)); %><a class=\"nav-category-all\" href=\"/shop\">View all products →</a></div></div><% } %>\n      <% if(featureStoriesEnabled){ %><a href=\"/stories\">Stories</a><% } %>\n      <% if (isLoggedIn) { %><% if(featureWishlistEnabled){ %><a href=\"/wishlist\"><%= locale==='fr'?'Favoris':'Saved' %> <b data-wishlist-count><%= wishlistCount %></b></a><% } %><a href=\"/account\"><%= locale==='fr'?'Compte':'Account' %></a><% } else { %><a href=\"/login\"><%= locale==='fr'?'Se connecter':'Sign in' %></a><% } %>\n      <a class=\"cart-nav\" href=\"/cart\"<% if(appearance.cartDrawer){ %> data-cart-drawer-trigger<% } %>><%= locale==='ckb'?'سەبەتە':locale==='ar'?'السلة':locale==='nl'?'Winkelmandje':locale==='fr'?'Panier':'Bag' %> <b><%= cartCount %></b></a>\n      <% if (user && ['admin','manager'].includes(user.role)) { %><a class=\"admin-link\" href=\"/admin\">Manage</a><% } %>\n      <% if (isLoggedIn) { %><form class=\"inline-form nav-logout\" method=\"post\" action=\"/logout\"><input type=\"hidden\" name=\"_csrf\" value=\"<%= csrf %>\"><button type=\"submit\"><%= locale==='fr'?'Se déconnecter':'Log out' %></button></form><% } %>\n    </nav>\n    <% if (isStorefrontPage) { %><button type=\"button\" class=\"storefront-search-toggle\" data-search-toggle aria-expanded=\"false\" aria-controls=\"mobile-storefront-search\" aria-label=\"Open search\"><span aria-hidden=\"true\">⌕</span></button><% } %>\n    <button type=\"button\" class=\"menu-toggle\" data-menu-toggle aria-expanded=\"false\" aria-controls=\"site-navigation\" aria-label=\"Open navigation\">☰</button>\n    <% } %>\n  </div>\n  <% if (!isAdminRoute && isStorefrontPage) { %>\n  <div class=\"container mobile-search storefront-mobile-search\" id=\"mobile-storefront-search\" <%= featureAutocompleteEnabled?'data-search-box':'' %> hidden>\n    <form class=\"search\" action=\"/shop\" method=\"get\" role=\"search\">\n      <label class=\"sr-only\" for=\"mobile-storefront-search-input\"><%= locale==='fr'?'Rechercher des produits':'Search products' %></label>\n      <span class=\"search-icon\" aria-hidden=\"true\">⌕</span>\n      <input id=\"mobile-storefront-search-input\" data-search-input name=\"search\" autocomplete=\"off\" aria-label=\"<%= locale==='fr'?'Rechercher des produits':'Search products' %>\" placeholder=\"<%= locale==='fr'?'Rechercher des produits…':'Search products…' %>\" value=\"<%= typeof search !== 'undefined' ? search : '' %>\">\n      <button type=\"submit\" aria-label=\"<%= locale==='fr'?'Rechercher':'Search' %>\">→</button>\n      <button type=\"button\" data-search-close aria-label=\"Close search\"><span aria-hidden=\"true\">×</span></button>\n    </form>\n    <div class=\"search-results\" data-search-results hidden></div><% if(typeof aiEnabled !== 'undefined' && aiEnabled){ %><small class=\"search-ai-disclosure\"><%= locale==='nl'?'AI-zoekhulp bij volledig zoeken; je zoekterm wordt gedeeld met de ingestelde AI-dienst.':locale==='ckb'?'یارمەتی گەڕانی AI لە گەڕانی تەواودا؛ تەنها وشەی گەڕان بۆ خزمەتگوزاری AI دەنێردرێت.':locale==='ar'?'بحث بمساعدة الذكاء الاصطناعي عند إرسال البحث؛ تتم مشاركة عبارة البحث فقط مع خدمة الذكاء الاصطناعي المهيأة.':locale==='fr'?'Recherche assistée par IA lors de la recherche complète ; seule votre requête est transmise au service d’IA configuré.':'AI-assisted results on full search; only your search phrase is sent to the configured AI service.' %></small><% } %>\n  </div>\n  <% } else if (!isAdminRoute) { %>\n  <div class=\"container mobile-search\" <%= featureAutocompleteEnabled?'data-search-box':'' %>>\n    <form class=\"search\" action=\"/shop\" method=\"get\" role=\"search\">\n      <span class=\"search-icon\" aria-hidden=\"true\">⌕</span>\n      <input data-search-input name=\"search\" autocomplete=\"off\" aria-label=\"<%= locale==='fr'?'Rechercher des produits':'Search products' %>\" placeholder=\"<%= locale==='fr'?'Rechercher des produits…':'Search products…' %>\" value=\"<%= typeof search !== 'undefined' ? search : '' %>\">\n      <button type=\"submit\" aria-label=\"<%= locale==='fr'?'Rechercher':'Search' %>\">→</button>\n    </form>\n    <div class=\"search-results\" data-search-results hidden></div><% if(typeof aiEnabled !== 'undefined' && aiEnabled){ %><small class=\"search-ai-disclosure\"><%= locale==='nl'?'AI-zoekhulp bij volledig zoeken; je zoekterm wordt gedeeld met de ingestelde AI-dienst.':locale==='ckb'?'یارمەتی گەڕانی AI لە گەڕانی تەواودا؛ تەنها وشەی گەڕان بۆ خزمەتگوزاری AI دەنێردرێت.':locale==='ar'?'بحث بمساعدة الذكاء الاصطناعي عند إرسال البحث؛ تتم مشاركة عبارة البحث فقط مع خدمة الذكاء الاصطناعي المهيأة.':locale==='fr'?'Recherche assistée par IA lors de la recherche complète ; seule votre requête est transmise au service d’IA configuré.':'AI-assisted results on full search; only your search phrase is sent to the configured AI service.' %></small><% } %>\n  </div>\n  <% } %>\n</header>\n<main id=\"main-content\" class=\"<%= isAdminRoute ? 'admin-main' : 'storefront-main' %>\">\n","partials/product-card.ejs":"<%\nconst product = typeof p !== 'undefined' ? p : null;\nif (product) {\n  const discount = app.locals.discountPercent(product);\n  const effective = app.locals.effectivePrice(product);\n  const available = Math.max(0, Number(product.available_stock || 0));\n  const variants = Math.max(0, Number(product.variant_count || 0));\n  const cardText = (text, parameters = {}) => typeof pageText === 'function'\n    ? pageText(text, parameters)\n    : text.replace(/\\{(\\w+)\\}/g, (match, key) => Object.hasOwn(parameters, key) ? String(parameters[key]) : match);\n  const saved = typeof wishlistIds !== 'undefined' && wishlistIds?.has?.(product.id);\n%>\n<article class=\"product-card product-card-signature\">\n  <div class=\"product-media\">\n    <a href=\"/product/<%= encodeURIComponent(product.slug) %>\" class=\"product-image\">\n      <img src=\"<%= safeImageUrl(product.image_url) %>\" data-fallback-src=\"/assets/product-placeholder.svg\" alt=\"<%= product.name %>\" data-no-translate width=\"800\" height=\"1000\" loading=\"lazy\" decoding=\"async\">\n      <span class=\"product-image-shade\" aria-hidden=\"true\"></span>\n    </a>\n    <span class=\"product-badges\" role=\"group\" aria-label=\"<%= cardText('Product highlights') %>\">\n        <% if(product.featured){ %><span class=\"product-badge featured\"><%= cardText('Featured') %></span><% } %>\n        <% if(discount>0){ %><span class=\"product-badge sale\">-<%= discount %>%</span><% } %>\n        <% if(available<=0){ %><span class=\"product-badge out\"><%= cardText('Sold out') %></span><% } %>\n    </span>\n    <% if(appearance.quickView||appearance.compare){ %><div class=\"product-hover-actions\">\n      <% if(appearance.quickView){ %><button type=\"button\" class=\"product-quick-view\" data-quick-view data-quick-name=\"<%= product.name %>\" data-quick-image=\"<%= safeImageUrl(product.image_url) %>\" data-quick-price=\"<%= formatPrice(effective,currency) %>\" data-quick-category=\"<%= product.category_name||'' %>\" data-quick-url=\"/product/<%= encodeURIComponent(product.slug) %>\" data-quick-stock=\"<%= available %>\" aria-label=\"<%= cardText('Quick view {name}', {name:product.name}) %>\"><%= cardText('Quick view') %> <span aria-hidden=\"true\">↗</span></button><% } %>\n      <% if(appearance.compare){ %><button type=\"button\" class=\"product-compare\" data-compare-add data-compare-name=\"<%= product.name %>\" data-compare-price=\"<%= formatPrice(effective,currency) %>\" data-compare-url=\"/product/<%= encodeURIComponent(product.slug) %>\" data-compare-image=\"<%= safeImageUrl(product.image_url) %>\" aria-pressed=\"false\"><span data-compare-label><%= cardText('Compare +') %></span><span class=\"sr-only\">: <span data-no-translate><%= product.name %></span></span></button><% } %>\n    </div><% } %>\n    <% if(isLoggedIn && featureWishlistEnabled){ %>\n      <button type=\"button\" class=\"product-favorite wishlist-toggle <%= saved?'saved':'' %>\" data-wishlist-toggle data-product-id=\"<%= product.id %>\" data-product-name=\"<%= product.name %>\" aria-label=\"<%= cardText(saved ? 'Remove {name} from wishlist' : 'Add {name} to wishlist', {name:product.name}) %>\" aria-pressed=\"<%= saved?'true':'false' %>\">\n        <span aria-hidden=\"true\"><%= saved ? '♥' : '♡' %></span>\n      </button>\n    <% } %>\n  </div>\n\n  <div class=\"product-card-body\">\n    <div class=\"product-card-topline\">\n      <% if(product.category_name){ %><span class=\"product-category\" data-no-translate><%= product.category_name %></span><% } %>\n      <% if(available > 0 && available <= 5){ %><span class=\"product-stock-pill\"><span aria-hidden=\"true\">●</span> <%= cardText('Only {count} left', {count:available}) %></span><% } %>\n    </div>\n\n    <div class=\"product-card-main\">\n      <div class=\"product-title-block\">\n        <h3 data-no-translate><a href=\"/product/<%= encodeURIComponent(product.slug) %>\"><%= product.name %></a></h3>\n        <% if(product.short_description){ %><p class=\"product-blurb\" data-no-translate><%= product.short_description %></p><% } %>\n      </div>\n      <div class=\"price price-premium\" role=\"group\" aria-label=\"<%= cardText('Price') %>\">\n        <strong><%= formatPrice(effective,currency) %></strong>\n        <% if(effective < product.price_cents){ %><del><%= formatPrice(product.price_cents,currency) %></del><% } %>\n      </div>\n    </div>\n\n    <div class=\"product-card-meta-row\">\n      <% if(variants>0){ %><span><span class=\"meta-icon\" aria-hidden=\"true\">◇</span><%= cardText(variants===1 ? '{count} option' : '{count} options', {count:variants}) %></span><% } %>\n      <% if(available>0){ %><span class=\"in-stock\"><span class=\"meta-icon\" aria-hidden=\"true\">✓</span> <%= cardText('In stock') %></span><% } else { %><span class=\"out-stock\"><span class=\"meta-icon\" aria-hidden=\"true\">—</span> <%= cardText('Unavailable') %></span><% } %>\n    </div>\n\n    <div class=\"product-card-footer\">\n      <a class=\"btn btn-dark btn-small product-main-cta\" href=\"/product/<%= encodeURIComponent(product.slug) %>\">\n        <%= cardText(variants>0 && available>0 ? 'Choose options' : 'View product') %>\n        <span class=\"sr-only\">: <span data-no-translate><%= product.name %></span></span>\n        <span aria-hidden=\"true\">→</span>\n      </a>\n    </div>\n  </div>\n</article>\n<% } %>\n","partials/purchase-journey.ejs":"<%\n  const pStage = (typeof journeyStage==='string' && ['cart','checkout','confirmation'].includes(journeyStage)) ? journeyStage : 'cart';\n  const pLabels = {\n    en:['Your bag','Details & payment','Order confirmation'],\n    nl:['Winkelmandje','Gegevens & betaling','Bestelbevestiging'],\n    fr:['Votre panier','Livraison & paiement','Confirmation'],\n    ckb:['سەبەتەکەت','زانیاری و پارەدان','پشتڕاستکردنەوەی داواکاری'],\n    ar:['سلة التسوق','البيانات والدفع','تأكيد الطلب']\n  };\n  const pSteps=['cart','checkout','confirmation'];\n  const pCurrent=pSteps.indexOf(pStage);\n  const pText=pLabels[locale]||pLabels.en;\n%>\n<nav class=\"purchase-journey container\" aria-label=\"<%= locale==='nl'?'Voortgang van je bestelling':locale==='fr'?'Étapes de commande':locale==='ckb'?'قۆناغەکانی داواکاری':locale==='ar'?'خطوات الطلب':'Order progress' %>\">\n  <ol class=\"purchase-journey-list\">\n    <% pSteps.forEach((step,index)=>{const isCurrent=index===pCurrent;const isPast=index<pCurrent; %>\n      <li class=\"purchase-journey-item <%= isCurrent?'is-current':isPast?'is-complete':'' %>\" <%- isCurrent?'aria-current=\"step\"':'' %>>\n        <span class=\"purchase-journey-number\" aria-hidden=\"true\"><%= isPast?'✓':index+1 %></span>\n        <% if(isPast && step==='cart'){ %><a href=\"/cart\"><%= pText[index] %></a><% } else { %><span><%= pText[index] %></span><% } %>\n      </li>\n    <% }) %>\n  </ol>\n</nav>\n","partials/story-viewer.ejs":"<dialog class=\"story-viewer\" data-story-viewer aria-label=\"Story viewer\">\n  <div class=\"story-viewer-shell\">\n    <button type=\"button\" class=\"story-viewer-close\" data-story-close aria-label=\"Close story\">×</button>\n    <button type=\"button\" class=\"story-viewer-nav story-viewer-prev\" data-story-prev aria-label=\"Previous story\">‹</button>\n    <div class=\"story-viewer-media\">\n      <img data-story-image data-fallback-src=\"/assets/story.svg\" src=\"/assets/story.svg\" alt=\"\" width=\"900\" height=\"1200\" decoding=\"async\">\n    </div>\n    <div class=\"story-viewer-content\">\n      <span class=\"eyebrow\" data-story-expiry></span>\n      <h2 data-story-title data-no-translate></h2>\n      <p data-story-body data-no-translate></p>\n      <div class=\"story-viewer-actions\">\n        <a class=\"btn btn-mint\" data-story-product-link href=\"/shop\" hidden>View & buy</a>\n        <form method=\"post\" action=\"/cart/add\" data-story-buy-form hidden>\n          <input type=\"hidden\" name=\"_csrf\" data-story-csrf>\n          <input type=\"hidden\" name=\"productId\" data-story-product-id>\n          <input type=\"hidden\" name=\"quantity\" value=\"1\">\n          <button type=\"submit\" class=\"btn btn-mint\">Add to bag</button>\n        </form>\n        <a class=\"btn btn-light\" data-story-link href=\"/stories\" hidden>Open story link</a>\n      </div>\n      <div class=\"story-viewer-status\" data-story-status aria-live=\"polite\"></div>\n    </div>\n    <button type=\"button\" class=\"story-viewer-nav story-viewer-next\" data-story-next aria-label=\"Next story\">›</button>\n  </div>\n</dialog>\n","policy.ejs":"<%- include('partials/header', {title: title}) %>\n\n<section class=\"container page-head policy-head\">\n  <%- include('partials/back-button', { fallback: '/' }) %>\n  <span class=\"eyebrow\"><%= customerText(\"INFORMATION\") %></span>\n  <h1><%= heading %></h1>\n  <p><%= customerText(locale==='nl'?'Lees deze informatie zorgvuldig door voordat je de winkel gebruikt.':locale==='fr'?'Veuillez lire attentivement ces informations avant d’utiliser la boutique.':locale==='ckb'?'تکایە پێش بەکارهێنانی فرۆشگا ئەم زانیارییانە بە وردی بخوێنەرەوە.':locale==='ar'?'يرجى قراءة هذه المعلومات بعناية قبل استخدام المتجر.':'Please read this information carefully before using the store.') %></p>\n</section>\n\n<section class=\"container section policy-section\">\n  <% if(policyFallback){ %>\n    <div class=\"alert\" role=\"status\"><% if(locale==='ckb'){ %>ئەم دەقە بە زمانی ئینگلیزی پیشان دەدرێت، چونکە وەرگێڕانی پێداچوونەوەکراوی سۆرانی بۆ ئەم فرۆشگایە دانەنراوە.<% } else if(locale==='ar'){ %>يُعرض هذا النص باللغة الإنجليزية لأن المتجر لم يضف ترجمة عربية مُراجعة لهذه السياسة بعد.<% } else if(locale==='nl'){ %>Dit beleid wordt momenteel in het Engels getoond omdat de winkel nog geen nagekeken Nederlandse vertaling heeft toegevoegd.<% } else if(locale==='fr'){ %>Ce document est actuellement affiché en anglais, car la boutique n’a pas encore ajouté de traduction française vérifiée.<% } else { %><%= customerText(\"This policy is currently shown in English because a reviewed translation for the selected language has not been provided by the store.\") %><% } %></div>\n  <% } %>\n  <article\n    class=\"panel policy-copy\"\n    data-no-translate\n    aria-label=\"<%= heading %>\"\n  >\n    <% if (body && body.trim()) { %>\n\n      <%= body %>\n\n    <% } else { %>\n\n      <p class=\"policy-empty\"><%= customerText(locale==='nl'?'Deze informatie is nog niet toegevoegd.':locale==='fr'?'Ces informations n’ont pas encore été ajoutées.':locale==='ckb'?'ئەم زانیارییە هێشتا زیاد نەکراوە.':locale==='ar'?'لم تتم إضافة هذه المعلومات بعد.':'This information has not been added yet.') %></p>\n\n    <% } %>\n  </article>\n</section>\n\n<%- include('partials/footer') %>","product.ejs":"<%- include('partials/header',{title:product.name}) %>\n<% const productImagesForPage=Array.isArray(images)?images:[]; const primaryProductImage=productImagesForPage.find(image=>Number(image.is_primary)===1)||productImagesForPage[0]||null; const productVariantsForPage=Array.isArray(variants)?variants:[]; const selectedVariantForPage=productVariantsForPage.find(variant=>Number(variant.id)===Number(selectedVariantId))||null; const optionOneName=productVariantsForPage[0]?.option_name||'Option'; const optionTwoName=productVariantsForPage[0]?.option_name_2||''; const variantClientData=JSON.stringify(productVariantsForPage.map(variant=>({id:Number(variant.id),value:String(variant.option_value||''),value2:String(variant.option_value_2||''),sku:String(variant.sku||''),stock:Number(variant.available_stock)||0,imageUrl:safeImageUrl(variant.image_url,'')}))); %>\n<div class=\"container product-return-navigation\"><%- include('partials/back-button',{fallback:'/shop'}) %></div>\n<section class=\"container product-detail product-detail-v5\"<% if(appearance.recentlyViewed){ %> data-recent-product data-recent-url=\"/product/<%= encodeURIComponent(product.slug) %>\" data-recent-name=\"<%= product.name %>\" data-recent-price=\"<%= formatPrice(app.locals.effectivePrice(product),currency) %>\" data-recent-image=\"<%= safeImageUrl(product.image_url) %>\"<% } %>>\n  <% if(added){ %><div class=\"cart-added-success\" role=\"status\" aria-live=\"polite\"><span class=\"cart-added-icon\" aria-hidden=\"true\">✓</span><div><strong><%= customerText(\"Added to your bag\") %></strong><p><%= customerText(\"Your item is in the bag. You can keep shopping or review your bag when you're ready.\") %></p></div><div class=\"cart-added-actions\"><a class=\"btn btn-dark btn-small\" href=\"/cart\"><%= customerText(\"View bag\") %></a><a class=\"btn btn-light btn-small\" href=\"/shop\"><%= customerText(\"Continue shopping\") %></a></div></div><% } %>\n  <% if(cartError){ %><div class=\"alert cart-action-error\" role=\"alert\" aria-live=\"assertive\"><% if(cartError==='option'){ %><%= customerText(\"Choose an available option before adding this product to your bag.\") %><% } else if(cartError==='quantity'){ %><%= customerText(\"You can add up to 99 of the same product option. Check the quantity and try again.\") %><% } else if(cartError==='stock'){ %><%= customerText(\"Stock changed before we could add this item. Please review current availability.\") %><% } else { %><%= customerText(\"This product is no longer available. Please browse the shop for current products.\") %><% } %></div><% } %>\n  <div class=\"product-media-column\">\n    <nav class=\"breadcrumbs\" aria-label=\"<%= customerText(\"Breadcrumb\") %>\"><a href=\"/\"><%= customerText(\"Home\") %></a><span aria-hidden=\"true\">/</span><a href=\"/shop\"><%= customerText(\"Shop\") %></a><% if(product.category_slug){ %><span aria-hidden=\"true\">/</span><a href=\"/category/<%= encodeURIComponent(product.category_slug) %>\"><%= product.category_name || product.category_slug %></a><% } %><span aria-hidden=\"true\">/</span><span aria-current=\"page\" data-no-translate><%= product.name %></span></nav>\n    \n    <div class=\"product-media-gallery\" data-product-gallery>\n      <div class=\"product-visual product-visual-v5 product-visual-v6\">\n        <img src=\"<%= safeImageUrl(primaryProductImage?.image_url||product.image_url) %>\" data-fallback-src=\"/assets/product-placeholder.svg\" alt=\"<%= product.name %>\" width=\"800\" height=\"1000\" fetchpriority=\"high\" decoding=\"async\" data-product-main-image data-base-image-url=\"<%= safeImageUrl(primaryProductImage?.image_url||product.image_url) %>\" data-base-image-alt=\"<%= product.name %>\">\n        <a class=\"product-photo-expand\" href=\"<%= safeImageUrl(primaryProductImage?.image_url||product.image_url) %>\" target=\"_blank\" rel=\"noopener noreferrer\" data-product-photo-expand><span aria-hidden=\"true\">⌕</span><span><%= customerText(locale==='nl'?'Vergroten':locale==='fr'?'Agrandir':locale==='ckb'?'گەورەکردنەوە':locale==='ar'?'تكبير':'View larger') %></span></a>\n      </div>\n      <dialog class=\"product-photo-dialog\" data-product-photo-dialog aria-label=\"<%= locale==='nl'?'Productfoto groter':locale==='fr'?'Photo du produit':locale==='ckb'?'وێنەی گەورەی بەرهەم':locale==='ar'?'صورة المنتج المكبرة':'Enlarged product image' %>\"><div class=\"product-photo-dialog-inner\"><button type=\"button\" data-product-photo-close class=\"product-photo-close\"><%= customerText(locale==='nl'?'Sluiten':locale==='fr'?'Fermer':locale==='ckb'?'داخستن':locale==='ar'?'إغلاق':'Close') %> <span aria-hidden=\"true\">×</span></button><img src=\"<%= safeImageUrl(primaryProductImage?.image_url||product.image_url) %>\" data-product-photo-large data-fallback-src=\"/assets/product-placeholder.svg\" alt=\"<%= product.name %>\" width=\"1000\" height=\"1000\" decoding=\"async\"></div></dialog>\n      <% if(productImagesForPage.length>1){ %>\n        <div class=\"product-gallery-thumbnails\" role=\"group\" aria-label=\"<%= customerText(\"Product photos\") %>\">\n          <% productImagesForPage.forEach((image,index)=>{ %><button type=\"button\" class=\"product-gallery-thumbnail <%= image.image_url===(primaryProductImage?.image_url||product.image_url)?'is-active':'' %>\" data-gallery-image data-image-url=\"<%= safeImageUrl(image.image_url) %>\" data-image-alt=\"<%= image.alt_text||product.name %>\" aria-label=\"View product photo <%= index+1 %>\" aria-pressed=\"<%= image.image_url===(primaryProductImage?.image_url||product.image_url)?'true':'false' %>\"><img src=\"<%= safeImageUrl(image.image_url) %>\" data-fallback-src=\"/assets/product-placeholder.svg\" alt=\"\" width=\"100\" height=\"120\" loading=\"lazy\" decoding=\"async\"></button><% }) %>\n        </div>\n      <% } %>\n    </div>\n  </div>\n\n  <div class=\"product-copy product-copy-v5 product-copy-v6\">\n    <div class=\"product-intro\">\n      <% if(product.category_name){ %><span class=\"eyebrow\"><%= product.category_name %></span><% } else { %><span class=\"eyebrow\"><%= customerText(\"PRODUCT\") %></span><% } %>\n      <h1 data-no-translate><%= product.name %></h1>\n      <% if(product.short_description){ %><p class=\"lead\" data-no-translate><%= product.short_description %></p><% } %>\n    </div>\n\n    <% if(isManager && managerProduct){ const hasProductHistory=Number(managerProduct.order_item_count||0)>0; const hasProductReservations=Number(managerProduct.reserved_inventory_total||0)>0; const canPermanentlyDelete=!hasProductHistory&&!hasProductReservations; %>\n      <section class=\"manager-product-actions\" aria-label=\"<%= customerText(\"Product management\") %>\">\n        <div class=\"manager-product-actions-copy\"><strong><%= customerText(\"Products\") %></strong><span><%= customerText(\"Manage product details, prices, availability and what customers can see.\") %></span></div>\n        <div class=\"manager-product-action-buttons\">\n          <a class=\"btn btn-light btn-small\" href=\"/admin/products/<%= product.id %>/edit\"><%= customerText(\"Edit\") %></a>\n          <form method=\"post\" action=\"/admin/products/archive\" data-confirm=\"<%= customerText(\"Archive this product? It will be hidden from the shop but kept for historic orders.\") %>\"><input type=\"hidden\" name=\"_csrf\" value=\"<%= csrf %>\"><input type=\"hidden\" name=\"id\" value=\"<%= product.id %>\"><button type=\"submit\" class=\"btn btn-light btn-small\" <% if(hasProductReservations){ %>disabled aria-disabled=\"true\" title=\"<%= customerText('Finish or cancel active orders first.') %>\"<% } %>><%= customerText(\"Archive\") %></button></form>\n          <form method=\"post\" action=\"/admin/products/delete\" data-confirm=\"<%= customerText(\"Permanently delete this product? This cannot be undone. Products with order history must be retained.\") %>\"><input type=\"hidden\" name=\"_csrf\" value=\"<%= csrf %>\"><input type=\"hidden\" name=\"id\" value=\"<%= product.id %>\"><button type=\"submit\" class=\"btn btn-danger btn-small\" <% if(!canPermanentlyDelete){ %>disabled aria-disabled=\"true\" title=\"<%= customerText(hasProductHistory?'Order history must be kept.':'Reserved stock must be released first.') %>\"<% } %>><%= customerText(\"Delete permanently\") %></button></form>\n        </div>\n        <% if(!canPermanentlyDelete){ %><p class=\"manager-product-action-note\"><%= customerText(hasProductHistory?'This product has order history and cannot be permanently deleted. Keep it archived to preserve the records.':'This product has reserved units. Finish or cancel the active order first.') %></p><% } %>\n      </section>\n    <% } %>\n\n    <div class=\"product-price-block\">\n      <div class=\"detail-price\">\n        <span><%= formatPrice(app.locals.effectivePrice(product),currency) %></span>\n        <% if(app.locals.effectivePrice(product)<product.price_cents){ %><del><%= formatPrice(product.price_cents,currency) %></del><span class=\"discount\">-<%= app.locals.discountPercent(product) %>%</span><% } %>\n      </div>\n      <div class=\"stock-line stock-line-v5\" data-product-stock-line><span class=\"dot <%= product.available_stock>0?'ok':'bad' %>\" data-product-stock-dot></span><strong data-product-stock-label><%= customerText(product.available_stock>0?(variants.length?'Choose options':'In stock'):'Sold out') %></strong><span data-product-stock-count><%= product.available_stock>0?`${product.available_stock} available in total`:'Currently unavailable' %></span></div>\n    </div>\n\n    <% if(product.description){ %>\n      <section class=\"product-info-section\">\n        <h2><%= customerText(\"About this product\") %></h2>\n        <p class=\"detail-description\" data-no-translate><%= product.description %></p>\n      </section>\n    <% } %>\n\n    <form method=\"post\" action=\"/cart/add\" class=\"buy-box buy-box-v5 buy-box-v6 <%= variants.length?'has-variants':'' %>\" data-product-variant-form data-variant-map=\"<%= variantClientData %>\">\n      <input type=\"hidden\" name=\"_csrf\" value=\"<%= csrf %>\">\n      <input type=\"hidden\" name=\"productId\" value=\"<%= product.id %>\">\n      <% if(variants.length){ %>\n        <input type=\"hidden\" name=\"variantId\" value=\"<%= selectedVariantId||'' %>\" data-selected-variant-id>\n        <fieldset class=\"product-option-field\" <% if(product.available_stock<=0){ %>aria-disabled=\"true\" disabled<% } %>>\n          <legend><span class=\"field-label\"><%= customerText(\"Choose your options \") %><b>*</b></span></legend>\n          <label class=\"product-attribute-select\"><span><%= optionOneName %></span><select name=\"variantValue\" required data-option-one-select><option value=\"\"><%= customerText(\"Choose \") %><%= optionOneName.toLowerCase() %></option><% [...new Set(variants.map(variant=>String(variant.option_value)))].forEach(value=>{ const available=variants.some(variant=>String(variant.option_value)===value&&Number(variant.available_stock)>0); %><option value=\"<%= value %>\" <%= selectedVariantForPage&&selectedVariantForPage.option_value===value?'selected':'' %> <%= available?'':'disabled' %>><%= value %><%= customerText(available?'':' · Sold out') %></option><% }) %></select></label>\n          <% if(optionTwoName){ %>\n            <label class=\"product-attribute-select\"><span><%= optionTwoName %></span><select name=\"variantValue2\" required data-option-two-select><option value=\"\"><%= customerText(\"Choose \") %><%= optionTwoName.toLowerCase() %></option><% [...new Set(variants.filter(variant=>!selectedVariantForPage||variant.option_value===selectedVariantForPage.option_value).map(variant=>String(variant.option_value_2)))].forEach(value=>{ const available=variants.some(variant=>String(variant.option_value)===String(selectedVariantForPage?.option_value||'')&&String(variant.option_value_2)===value&&Number(variant.available_stock)>0); %><option value=\"<%= value %>\" <%= selectedVariantForPage&&selectedVariantForPage.option_value_2===value?'selected':'' %> <%= selectedVariantForPage&&!available?'disabled':'' %>><%= value %><%= customerText(selectedVariantForPage&&!available?' · Sold out':'') %></option><% }) %></select></label>\n          <% } %>\n          <span class=\"field-note\" id=\"product-option-note\" data-variant-option-note><%= locale==='nl'?'Kies '+(optionTwoName?`${optionOneName.toLowerCase()} en ${optionTwoName.toLowerCase()}`:optionOneName.toLowerCase())+'. Elke combinatie heeft een afzonderlijke SKU en voorraad.':'Select '+(optionTwoName?`${optionOneName.toLowerCase()} and ${optionTwoName.toLowerCase()}`:optionOneName.toLowerCase())+'. Each combination has a separate SKU and stock count.' %></span>\n        </fieldset>\n      <% } %>\n      <label class=\"quantity-field\"><span class=\"field-label\"><%= customerText(\"Quantity\") %></span><input type=\"number\" name=\"quantity\" min=\"1\" max=\"<%= Math.min(99,product.available_stock) %>\" value=\"1\" required data-product-quantity data-aggregate-stock=\"<%= product.available_stock %>\" <%= product.available_stock<=0?'disabled':'' %>></label>\n      <div class=\"buy-actions-v5\">\n        <button type=\"submit\" class=\"btn btn-dark btn-v5-buy\" data-variant-submit <%= product.available_stock<=0?'disabled':'' %>><%= customerText(product.available_stock>0?'Add to cart':'Sold out') %><span aria-hidden=\"true\">→</span></button>\n        <% if(isLoggedIn && featureWishlistEnabled){ %><button type=\"button\" class=\"icon-btn wishlist-toggle product-wishlist product-wishlist-v5 <%= wishlistIds.has(product.id)?'saved':'' %>\" data-wishlist-toggle data-product-id=\"<%= product.id %>\" data-product-name=\"<%= product.name %>\" aria-label=\"<%= wishlistIds.has(product.id)?'Remove':'Add' %> <%= product.name %> to wishlist\" aria-pressed=\"<%= wishlistIds.has(product.id)?'true':'false' %>\"><%= customerText(wishlistIds.has(product.id)?'♥':'♡') %></button><% } %>\n      </div>\n    </form>\n\n    <section class=\"product-purchase-facts\" aria-label=\"<%= customerText(\"Ordering information\") %>\">\n      <div class=\"purchase-fact purchase-fact-shipping\"><span class=\"purchase-fact-icon\" aria-hidden=\"true\">↗</span><div><strong><%= customerText(locale==='nl'?'Bezorgkosten':'Delivery cost') %></strong><small><% if(shippingDisplay?.rulesConfigured&&!shippingDisplay?.rulesValid){ %><%= customerText(locale==='nl'?'De bezorgkosten voor jouw locatie zijn momenteel niet beschikbaar. Neem contact op met de winkel voordat je bestelt.':'Delivery pricing for your location is not currently available. Contact the store before ordering.') %><% } else if(shippingDisplay?.hasDestinationRules){ %><%= customerText(locale==='nl'?'Berekend voor jouw bezorgadres en getoond voordat je de bestelling bevestigt.':'Calculated for your delivery location and shown before you confirm the order.') %><% } else if(Number(shippingDisplay?.feeCents||0)===0){ %><%= customerText(locale==='nl'?'Deze winkel heeft momenteel gratis bezorging ingesteld.':'Free delivery is currently configured by this store.') %><% } else { %><%= customerText(locale==='nl'?'Ingestelde standaardkost: ':'Configured standard fee: ') %><%= formatPrice(shippingDisplay.feeCents,currency) %>. <%= customerText(locale==='nl'?'Een eventuele regionale afwijking wordt bij het afrekenen bevestigd.':'Any regional override is confirmed at checkout.') %><% } %></small></div></div>\n      <div class=\"purchase-fact\"><span class=\"purchase-fact-icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M3 7.5h18v12H3z\"/><path d=\"M3 10.5h18M7 15.5h3\"/></svg></span><div><strong><%= customerText(locale==='nl'?'Betaalmogelijkheden':locale==='fr'?'Moyens de paiement':locale==='ckb'?'ڕێگاکانی پارەدان':locale==='ar'?'طرق الدفع':'Payment options') %></strong><small><%= customerText(locale==='nl'?'Bekijk de beschikbare methodes bij het afrekenen.':locale==='fr'?'Consultez les modes disponibles à la caisse.':'See available methods at checkout.') %></small></div></div>\n      <div class=\"purchase-fact\"><span class=\"purchase-fact-icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M12 3 19 6v5c0 5-3 8-7 10-4-2-7-5-7-10V6z\"/><path d=\"m9 12 2 2 4-4\"/></svg></span><div><strong><%= customerText(\"Availability checked\") %></strong><small><%= customerText(\"Stock is checked again before checkout.\") %></small></div></div>\n      <a class=\"purchase-fact\" href=\"/shipping-returns\"><span class=\"purchase-fact-icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M4 7h12v10H4z\"/><path d=\"M16 10h3l2 3v4h-5zM7.5 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM18 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z\"/></svg></span><div><strong><%= customerText(\"Delivery & returns\") %></strong><small><%= customerText(\"Read the store’s delivery and return policies.\") %></small></div><span class=\"purchase-fact-arrow\" aria-hidden=\"true\">↗</span></a>\n    </section>\n  </div>\n</section>\n<% if(appearance.stockAlerts && Number(product.available_stock||0)===0){ %>\n<section class=\"panel engagement-panel container\" aria-labelledby=\"stock-alert-title\"><h2 id=\"stock-alert-title\"><%= customerText(locale==='nl'?'Een melding bij nieuwe voorraad':locale==='ckb'?'ئاگادارکردنەوەی بەردەستبوون':locale==='ar'?'تنبيه عند توفر المنتج':'Email me when available') %></h2>\n<p><%= customerText(\"No message is sent until you confirm your email. One alert per request.\") %></p>\n<% if(alertNotice==='check-email'){ %><p role=\"status\"><%= customerText(\"Check your inbox to confirm the stock alert.\") %></p><% } else if(alertNotice==='unavailable'){ %><p role=\"alert\"><%= customerText(\"Email alerts are not configured yet.\") %></p><% } else if(alertNotice==='invalid'){ %><p role=\"alert\"><%= customerText(\"Enter a valid email address.\") %></p><% } %>\n<form method=\"post\" action=\"/stock-alerts/request\" class=\"engagement-inline-form\"><input type=\"hidden\" name=\"_csrf\" value=\"<%= csrf %>\"><input type=\"hidden\" name=\"productId\" value=\"<%= product.id %>\"><label for=\"stock-alert-email\"><%= customerText(\"Email address\") %></label><input type=\"email\" id=\"stock-alert-email\" name=\"email\" autocomplete=\"email\" maxlength=\"254\" required><button type=\"submit\" class=\"btn btn-dark\"><%= customerText(\"Notify me\") %></button></form>\n</section><% } %>\n<% if(appearance.reviews){ %>\n<section class=\"container section reviews-panel\" id=\"reviews\" aria-labelledby=\"reviews-title\"><div class=\"section-head\"><div><span class=\"eyebrow\"><%= customerText(\"VERIFIED PURCHASES\") %></span><h2 id=\"reviews-title\"><%= customerText(locale==='nl'?'Beoordelingen':locale==='ckb'?'هەڵسەنگاندنەکان':locale==='ar'?'التقييمات':'Customer reviews') %></h2></div><strong><%= reviewStats.count ? `${reviewStats.average.toFixed(1)} / 5 · ${reviewStats.count}` : 'No published reviews yet' %></strong></div>\n<% if(reviewNotice==='pending'){ %><p role=\"status\" class=\"success-alert\"><%= customerText(\"Review received. It will appear after moderation.\") %></p><% } else if(reviewNotice==='not-eligible'){ %><p role=\"alert\"><%= customerText(\"Reviews are only available after a completed order on your account. Please check your rating and text.\") %></p><% } %>\n<div class=\"review-grid\"><% reviews.forEach(review=>{ %><article class=\"panel review-card\"><span aria-label=\"<%= review.rating %> out of 5 stars\"><%= '★'.repeat(review.rating) %><%= '☆'.repeat(5-review.rating) %></span><h3 data-no-translate><%= review.title %></h3><p data-no-translate><%= review.body %></p><small><%= customerText(\"Verified purchase · \") %><%= customerText(locale==='nl'?'Geverifieerde koper':locale==='ckb'?'کڕیاری پشتڕاستکراو':locale==='ar'?'مشتري موثّق':'Verified buyer') %> · <%= review.created_at %></small></article><% }) %></div>\n<% if(canReview){ %><form method=\"post\" action=\"/products/<%= product.id %>/reviews\" class=\"panel form-stack engagement-review-form\"><input type=\"hidden\" name=\"_csrf\" value=\"<%= csrf %>\"><h3><%= customerText(\"Review your purchase\") %></h3><label for=\"review-rating\"><%= customerText(\"Rating\") %></label><select name=\"rating\" id=\"review-rating\" required><option value=\"\"><%= customerText(\"Choose a rating\") %></option><% for(let n=5;n>=1;n--){ %><option value=\"<%= n %>\"><%= n %> / 5</option><% } %></select><label for=\"review-title\"><%= customerText(\"Review title\") %></label><input name=\"title\" id=\"review-title\" required minlength=\"3\" maxlength=\"100\"><label for=\"review-body\"><%= customerText(\"Your review\") %></label><textarea name=\"body\" id=\"review-body\" rows=\"4\" required minlength=\"15\" maxlength=\"2000\"></textarea><button class=\"btn btn-dark\" type=\"submit\"><%= customerText(\"Submit for approval\") %></button></form><% } %>\n</section>\n<% } %>\n<% if(featureRelatedProductsEnabled&&Array.isArray(relatedProducts)&&relatedProducts.length){ %>\n<section class=\"container section related-products-section\" aria-labelledby=\"related-products-title\">\n  <div class=\"section-head related-products-heading\"><div><span class=\"eyebrow\"><%= customerText(\"KEEP EXPLORING\") %></span><h2 id=\"related-products-title\"><%= customerText(\"You may also like\") %></h2><p><%= customerText(\"Discover more from this shop.\") %></p></div><a class=\"btn btn-light btn-small\" href=\"/shop\"><%= customerText(\"View all products \") %><span aria-hidden=\"true\">→</span></a></div>\n  <div class=\"product-grid shop-grid product-grid-signature related-products-grid\"><% relatedProducts.forEach(p=>{ %><%- include('partials/product-card',{p:p}) %><% }) %></div>\n</section>\n<% } %>\n<% if(appearance.stickyPurchase && Number(product.available_stock||0)>0){ %><div class=\"product-mobile-purchase\"><button type=\"button\" data-purchase-focus><%= customerText(locale==='nl'?'Kies opties en voeg toe':locale==='ckb'?'هەڵبژێرە و زیاد بکە':locale==='ar'?'اختر وأضف للسلة':'Choose options & add to bag') %> · <%= formatPrice(app.locals.effectivePrice(product),currency) %></button></div><% } %>\n<%- include('partials/footer') %>\n","shop.ejs":"<%- include('partials/header',{title:'Shop'}) %>\n<%\nconst _categoryInfo = typeof categoryInfo !== 'undefined' && categoryInfo ? categoryInfo : null;\nconst _categoryPath = typeof categoryPath !== 'undefined' && Array.isArray(categoryPath) ? categoryPath : [];\nconst _childCategories = typeof childCategories !== 'undefined' && Array.isArray(childCategories) ? childCategories : [];\nconst shopFilterState = { category: category||'', search: search||'', sort: sort||'', minPrice: minPrice||'', maxPrice: maxPrice||'', stock: inStockOnly?'1':'' };\nconst shopFrench = {\n  'Added to your bag': 'Ajouté au panier',\n  \"Your item is in the bag. You can keep shopping or review your bag when you're ready.\": 'Votre article est dans le panier. Vous pouvez continuer vos achats ou consulter votre panier.',\n  'View bag': 'Voir le panier',\n  'Continue shopping': 'Continuer les achats',\n  'Choose an available option before adding this product to your bag.': 'Choisissez une option disponible avant d’ajouter ce produit au panier.',\n  'You can add up to 99 of the same product option. Check the quantity and try again.': 'Vous pouvez ajouter au maximum 99 unités de la même option. Vérifiez la quantité.',\n  'Stock changed before we could add this item. Please review current availability.': 'Le stock a changé. Vérifiez la disponibilité actuelle.',\n  'This product is no longer available. Please browse the shop for current products.': 'Ce produit n’est plus disponible. Consultez les autres produits.',\n  'Category': 'Catégorie', 'Category path':'Chemin des catégories',\n  'All categories': 'Toutes les catégories',\n  'Sort': 'Trier',\n  'Featured': 'À la une',\n  'Newest': 'Nouveautés',\n  'Price: low to high': 'Prix : croissant',\n  'Price: high to low': 'Prix : décroissant',\n  'Name: A–Z': 'Nom : A–Z',\n  'No products found.': 'Aucun produit trouvé.',\n  'Try fewer words, another category or a different sort order.': 'Essayez moins de mots, une autre catégorie ou un autre tri.',\n  'Reset shop': 'Réinitialiser la boutique',\n  'All': 'Tous',\n  'Page': 'Page',\n  '← Previous': '← Précédent',\n  'Next →': 'Suivant →',\n  'Filter products': 'Filtrer les produits',\n  'Remove sorting': 'Supprimer le tri',\n  'Remove minimum price': 'Supprimer le prix minimum',\n  'Remove maximum price': 'Supprimer le prix maximum',\n  'Your security check expired. No change was submitted. Please use the fresh form on this page.': 'Votre contrôle de sécurité a expiré. Aucune modification n’a été envoyée. Utilisez le formulaire actualisé.',\n  'e.g. clothing, homeware, accessories': 'ex. vêtements, maison, accessoires',\n  'Any': 'Tous'\n};\nconst shopText = value => customerText(value);\nfunction shopFilterUrlWithout(excluded) {\n  const params = new URLSearchParams();\n  for (const [key,value] of Object.entries(shopFilterState)) if (key!==excluded && value) params.set(key,value);\n  const query = params.toString();\n  return query ? `/shop?${query}` : '/shop';\n}\n%>\n<section class=\"container page-head\"><div><span class=\"eyebrow\"><%= customerText(_categoryInfo ? (locale === 'ckb' ? 'پۆل' : locale === 'ar' ? 'الفئة' : locale === 'nl' ? 'CATEGORIE' : locale === 'fr' ? 'CATÉGORIE' : 'CATEGORY') : (locale === 'ckb' ? 'کۆمەڵەی بەرهەم' : locale === 'ar' ? 'المجموعة' : locale === 'nl' ? 'COLLECTIE' : locale === 'fr' ? 'COLLECTION' : 'COLLECTION')) %></span><h1 data-no-translate><%= _categoryInfo?.name || (locale === 'ckb' ? 'هەموو بەرهەمەکان ببینە.' : locale === 'ar' ? 'تسوّق جميع المنتجات.' : locale === 'nl' ? 'Bekijk alle producten.' : locale === 'fr' ? 'Découvrez tous les produits.' : 'Shop everything.') %></h1><p data-no-translate><%= _categoryInfo?.description || (locale === 'ckb' ? 'بەپێی ناو و وەسف بگەڕێ، پۆلەکان ببینە و بەپێی نرخ یان نوێترین بەرهەمەکان ڕیزبەندی بکە.' : locale === 'ar' ? 'ابحث بالاسم أو الوصف، وتصفّح الفئات ورتّب حسب السعر أو الأحدث.' : locale === 'nl' ? 'Zoek op naam of beschrijving, bekijk de categorieën en sorteer op prijs of nieuwste producten.' : locale === 'fr' ? 'Recherchez par nom ou description, parcourez les catégories et triez par prix ou par nouveauté.' : 'Find products by name or description, browse categories and sort by price or newest arrivals.') %></p><% if(_categoryInfo && _categoryPath.length>1){ %><nav class=\"category-breadcrumbs\" aria-label=\"<%= shopText('Category path') %>\"><% _categoryPath.slice(0,-1).forEach((crumb,index)=>{ %><a href=\"/category/<%= encodeURIComponent(crumb.slug) %>\"><%= crumb.name %></a><span aria-hidden=\"true\">›</span><% }) %><strong data-no-translate><%= _categoryInfo.name %></strong></nav><% } %></div></section>\n\n<% if(_categoryInfo && (_categoryInfo.image_url || _childCategories.length)){ %>\n<section class=\"container section category-context\">\n  <% if(_categoryInfo?.image_url){ %><div class=\"category-context-image\"><img src=\"<%= safeImageUrl(_categoryInfo.image_url) %>\" data-fallback-src=\"/assets/product-placeholder.svg\" alt=\"<%= _categoryInfo.name %>\" width=\"1200\" height=\"500\" loading=\"lazy\" decoding=\"async\"></div><% } %>\n  <% if(_childCategories.length){ %><div class=\"section-head\"><div><span class=\"eyebrow\"><%= customerText(locale === 'ckb' ? 'گەڕان' : locale === 'ar' ? 'استكشف' : locale === 'nl' ? 'ONTDEK' : locale === 'fr' ? 'DÉCOUVRIR' : 'EXPLORE') %></span><h2><%= locale === 'ckb' ? `بەپێی ژێرپۆل بگەڕێ: ${_categoryInfo.name}` : locale === 'ar' ? `تسوّق ${_categoryInfo.name} حسب الفئة الفرعية` : locale === 'nl' ? `Bekijk ${_categoryInfo.name} per subcategorie` : locale === 'fr' ? `Découvrez ${_categoryInfo.name} par sous-catégorie` : `Shop ${_categoryInfo.name} by subcategory` %></h2></div></div><div class=\"category-grid category-subgrid\"><% _childCategories.slice(0,12).forEach((child,index)=>{ %><a class=\"category-card\" href=\"/category/<%= encodeURIComponent(child.slug) %>\"><div class=\"category-card-media\"><img src=\"<%= child.image_url ? safeImageUrl(child.image_url) : '/assets/category-placeholder.svg' %>\" data-fallback-src=\"/assets/category-placeholder.svg\" alt=\"\" aria-hidden=\"true\" width=\"800\" height=\"500\" loading=\"lazy\" decoding=\"async\"></div><div class=\"category-card-overlay\"><span class=\"category-index\"><%= String(index+1).padStart(2,'0') %></span><strong data-no-translate><%= child.name %></strong><span><%= locale === 'ckb' ? `بەرهەم: ${Number(child.product_count||0)}` : locale === 'ar' ? `المنتجات: ${Number(child.product_count||0)}` : locale === 'nl' ? `Producten: ${Number(child.product_count||0)}` : locale === 'fr' ? `Produits : ${Number(child.product_count||0)}` : `Products: ${Number(child.product_count||0)}` %> · <%= customerText(locale === 'ckb' ? 'بگەڕێ ←' : locale === 'ar' ? 'استكشف ←' : locale === 'nl' ? 'Ontdek →' : locale === 'fr' ? 'Découvrir →' : 'Explore →') %></span></div></a><% }) %></div><% } %>\n</section>\n<% } %>\n<section class=\"container section shop-section\">\n  <% if(added){ %><div class=\"cart-added-success\" role=\"status\" aria-live=\"polite\"><span class=\"cart-added-icon\" aria-hidden=\"true\">✓</span><div><strong><%= shopText('Added to your bag') %></strong><p><%= shopText(\"Your item is in the bag. You can keep shopping or review your bag when you're ready.\") %></p></div><div class=\"cart-added-actions\"><a class=\"btn btn-dark btn-small\" href=\"/cart\"><%= shopText('View bag') %></a><a class=\"btn btn-light btn-small\" href=\"/shop\"><%= shopText('Continue shopping') %></a></div></div><% } %>\n  <% if(cartError){ %><div class=\"alert cart-action-error\" role=\"alert\" aria-live=\"assertive\"><% if(cartError==='option'){ %><%= shopText('Choose an available option before adding this product to your bag.') %><% } else if(cartError==='quantity'){ %><%= shopText('You can add up to 99 of the same product option. Check the quantity and try again.') %><% } else if(cartError==='stock'){ %><%= shopText('Stock changed before we could add this item. Please review current availability.') %><% } else { %><%= shopText('This product is no longer available. Please browse the shop for current products.') %><% } %></div><% } %>\n  <div class=\"shop-filter-mobile-bar\" data-shop-filter-mobile-bar>\n    <button type=\"button\" class=\"shop-filter-toggle\" aria-controls=\"shop-filter-form\" aria-expanded=\"true\" data-shop-filter-toggle>\n      <span aria-hidden=\"true\" class=\"shop-filter-symbol\">☷</span>\n      <span><%= customerText(locale==='nl'?'Filters en sorteren':locale==='fr'?'Filtres et tri':locale==='ckb'?'پاڵاوتن و ڕیزبەندی':locale==='ar'?'التصفية والترتيب':'Filters & sort') %></span>\n      <% const activeFilterCount=[Boolean(category),Boolean(search),Boolean(minPrice),Boolean(maxPrice),Boolean(inStockOnly),Boolean(sort&&sort!=='featured')].filter(Boolean).length; %>\n      <% if(activeFilterCount){ %><span class=\"shop-filter-count\"><%= activeFilterCount %></span><% } %>\n      <span class=\"shop-filter-chevron\" aria-hidden=\"true\">⌄</span>\n    </button>\n    <span class=\"shop-mobile-result-count\"><strong><%= resultCount %></strong> <%= customerText(locale==='nl'?'producten':locale==='fr'?'produits':locale==='ckb'?'بەرهەم':locale==='ar'?'منتج':'products') %></span>\n  </div>\n  <form id=\"shop-filter-form\" class=\"shop-controls\" method=\"get\" action=\"/shop\" aria-label=\"<%= shopText('Filter products') %>\">\n    <div class=\"shop-filters-heading\"><div><span class=\"eyebrow\"><%= customerText(locale==='nl'?'PRODUCTEN VINDEN':locale==='fr'?'RECHERCHER DES PRODUITS':locale==='ckb'?'دۆزینەوەی بەرهەم':locale==='ar'?'ابحث عن المنتجات':'FIND YOUR PRODUCTS') %></span><h2><%= customerText(locale==='nl'?'Zoek en filter':locale==='fr'?'Rechercher et filtrer':locale==='ckb'?'گەڕان و پاڵاوتن':locale==='ar'?'البحث والتصفية':'Search & filter') %></h2></div><p><%= customerText(locale==='nl'?'Kies een categorie, prijs of sortering en pas alles in één keer toe.':locale==='fr'?'Choisissez une catégorie, un prix et un tri, puis appliquez les filtres.':locale==='ckb'?'پۆل، نرخ و ڕیزبەندی هەڵبژێرە، پاشان پاڵاوتن جێبەجێ بکە.':locale==='ar'?'اختر الفئة والسعر والترتيب ثم طبّق الفلاتر.':'Choose your category, price and sort order, then apply the filters.') %></p></div>\n    <% const categoryChildren=new Map(); categories.forEach(c=>{const key=c.parent_id?Number(c.parent_id):0;if(!categoryChildren.has(key))categoryChildren.set(key,[]);categoryChildren.get(key).push(c);}); function shopCategoryOptions(parentId,depth,seen=new Set()){if(depth>80)return '';return (categoryChildren.get(parentId)||[]).map(c=>{const id=Number(c.id);if(seen.has(id))return '';const nextSeen=new Set(seen);nextSeen.add(id);return `<option data-no-translate value=\"${escapeHtml(c.slug)}\" ${category===c.slug?'selected':''}>${'— '.repeat(depth)}${escapeHtml(c.name)}</option>`+shopCategoryOptions(id,depth+1,nextSeen);}).join('');} %><div class=\"filter-block\"><label for=\"category-filter\"><%= shopText('Category') %></label><select id=\"category-filter\" name=\"category\"><option value=\"\"><%= shopText('All categories') %></option><%- shopCategoryOptions(0,0) %></select></div>\n    <div class=\"filter-block\"><label for=\"sort-filter\"><%= shopText('Sort') %></label><select id=\"sort-filter\" name=\"sort\"><option value=\"featured\" <%= sort==='featured'||!sort?'selected':'' %>><%= shopText('Featured') %></option><option value=\"newest\" <%= sort==='newest'?'selected':'' %>><%= shopText('Newest') %></option><option value=\"price_low\" <%= sort==='price_low'?'selected':'' %>><%= shopText('Price: low to high') %></option><option value=\"price_high\" <%= sort==='price_high'?'selected':'' %>><%= shopText('Price: high to low') %></option><option value=\"name\" <%= sort==='name'?'selected':'' %>><%= shopText('Name: A–Z') %></option></select></div>\n    <div class=\"filter-search\"><label for=\"shop-search\"><%= customerText(locale==='nl'?'Zoek producten':locale==='fr'?'Rechercher':locale==='ckb'?'گەڕانی بەرهەم':locale==='ar'?'بحث عن المنتجات':'Search products') %></label><div class=\"inline-search\"><input id=\"shop-search\" name=\"search\" value=\"<%= search %>\" maxlength=\"80\" placeholder=\"<%= shopText('e.g. clothing, homeware, accessories') %>\"></div><% if(aiEnabled){ %><small class=\"search-ai-disclosure\"><%= customerText(locale==='fr'?'Lors de la recherche, l’IA peut proposer des synonymes. Seuls les termes de recherche sont envoyés au service d’IA configuré ; les résultats proviennent uniquement de votre catalogue actif.':locale==='nl'?'Bij verzenden kan AI je zoekterm uitbreiden met synoniemen. Alleen zoekwoorden worden naar de ingestelde AI-dienst gestuurd; resultaten komen altijd uit je eigen actieve catalogus.':locale==='ckb'?'کاتێک گەڕان دەنێریت، AI دەتوانێت وشە هاوواتاکان زیاد بکات. تەنها وشەی گەڕان بۆ AI دەنێردرێت و ئەنجامەکان هەمیشە لە کاڵاکانی چالاکی فرۆشگاکەتن.':locale==='ar'?'عند إرسال البحث، قد يوسّع الذكاء الاصطناعي العبارة بمرادفات. تتم مشاركة كلمات البحث فقط، وتأتي النتائج دائمًا من كتالوج متجرك النشط.':'When submitted, AI may expand your query with synonyms. Only search terms are sent to the configured AI service; results always come from your active catalog.') %></small><% } %></div>\n    <div class=\"filter-block\"><label for=\"min-price-filter\"><%= customerText(locale==='nl'?'Minimumprijs':locale==='fr'?'Prix minimum':'Minimum price') %></label><input id=\"min-price-filter\" name=\"minPrice\" type=\"number\" inputmode=\"decimal\" min=\"0\" step=\"<%= typeof priceFilterStep !== 'undefined' ? priceFilterStep : 'any' %>\" value=\"<%= minPrice||'' %>\" placeholder=\"0\"></div>\n    <div class=\"filter-block\"><label for=\"max-price-filter\"><%= customerText(locale==='nl'?'Maximumprijs':locale==='fr'?'Prix maximum':'Maximum price') %></label><input id=\"max-price-filter\" name=\"maxPrice\" type=\"number\" inputmode=\"decimal\" min=\"0\" step=\"<%= typeof priceFilterStep !== 'undefined' ? priceFilterStep : 'any' %>\" value=\"<%= maxPrice||'' %>\" placeholder=\"<%= shopText('Any') %>\"></div>\n    <label class=\"filter-stock\"><input type=\"checkbox\" name=\"stock\" value=\"1\" <%= inStockOnly?'checked':'' %>> <%= customerText(locale==='nl'?'Alleen producten op voorraad':locale==='fr'?'Uniquement les produits en stock':'In-stock products only') %></label>\n    <div class=\"shop-filter-actions\"><button type=\"submit\" class=\"btn btn-dark\"><%= customerText(locale==='nl'?'Filters toepassen':locale==='fr'?'Appliquer':locale==='ckb'?'جێبەجێکردن':locale==='ar'?'تطبيق الفلاتر':'Apply filters') %></button><a class=\"btn btn-light\" href=\"<%= _categoryInfo?'/category/'+encodeURIComponent(_categoryInfo.slug):'/shop' %>\"><%= customerText(locale==='nl'?'Wissen':locale==='fr'?'Effacer':locale==='ckb'?'سڕینەوە':locale==='ar'?'مسح':'Clear filters') %></a></div>\n  </form>\n  <div class=\"shop-results\">\n  <% if(priceRangeInvalid){ %><div class=\"alert\" role=\"alert\"><%= customerText(locale==='nl'?'Controleer de minimum- en maximumprijs. Gebruik bedragen die passen bij de winkelvaluta en zorg dat het maximum niet lager is dan het minimum. De prijsfilter is niet toegepast.':locale==='fr'?'Vérifiez les prix minimum et maximum. Respectez les décimales de la devise et assurez-vous que le maximum n’est pas inférieur au minimum. Aucun filtre de prix n’a été appliqué.':locale==='ckb'?'نرخی کەمترین و زۆرترین بپشکنە. ژمارەی خانە دەهەمییەکان دەبێت لەگەڵ دراوی فرۆشگا بگونجێت و نرخی زۆرترین لە کەمترین کەمتر نەبێت. پاڵاوتنی نرخ جێبەجێ نەکرا.':locale==='ar'?'تحقّق من الحدّ الأدنى والأقصى للسعر. استخدم عدد المنازل العشرية المناسب لعملة المتجر وتأكد أن الحدّ الأقصى ليس أقلّ من الحدّ الأدنى. لم يُطبّق فلتر السعر.':'Check the minimum and maximum prices. Use the correct decimal precision for the store currency, and make sure the maximum is not below the minimum. No price filter was applied.') %></div><% } %>\n  <% if(typeof aiSearchUsed !== 'undefined' && aiSearchUsed){ %><div class=\"tip-box\" role=\"status\"><%= customerText(locale==='fr'?'L’IA a élargi la recherche. Les résultats affichent uniquement des produits actifs de cette boutique.':locale==='nl'?'AI heeft je zoekterm uitgebreid. Je ziet alleen echte, actieve producten uit deze winkel.':locale==='ckb'?'AI وشەی گەڕانەکەت فراوان کرد. تەنها بەرهەمی ڕاستەقینە و چالاکەکانی ئەم فرۆشگایە دەبینیت.':locale==='ar'?'وسّع الذكاء الاصطناعي عبارة البحث. النتائج تعرض منتجات نشطة وحقيقية من هذا المتجر فقط.':'AI expanded your search. Results show real active products from this store only.') %></div><% } %>\n  <% if(typeof securityNotice!=='undefined' && securityNotice){ %><div class=\"alert\" role=\"status\"><%= shopText('Your security check expired. No change was submitted. Please use the fresh form on this page.') %></div><% } %>\n  <% if(appearance.filterChips && (category||search||minPrice||maxPrice||inStockOnly||(sort&&sort!=='featured'))){ %>\n  <nav class=\"active-filter-bar\" aria-label=\"<%= locale==='nl'?'Actieve filters':locale==='fr'?'Filtres actifs':locale==='ckb'?'پاڵاوتنە چالاکەکان':locale==='ar'?'الفلاتر النشطة':'Active filters' %>\">\n    <strong class=\"active-filter-title\"><%= customerText(locale==='nl'?'Actieve filters':locale==='fr'?'Filtres actifs':locale==='ckb'?'پاڵاوتنە چالاکەکان':locale==='ar'?'الفلاتر النشطة':'Active filters') %></strong>\n    <div class=\"active-filter-list\">\n      <% if(category){ const selectedCategory=categories.find(item=>item.slug===category); %><a href=\"<%= shopFilterUrlWithout('category') %>\" aria-label=\"<%= locale==='nl'?'Categorie verwijderen:':locale==='fr'?'Supprimer la catégorie :':'Remove category:' %> <%= selectedCategory?.name||category %>\"><%= selectedCategory?.name||category %><span aria-hidden=\"true\"> ×</span></a><% } %>\n      <% if(search){ %><a href=\"<%= shopFilterUrlWithout('search') %>\" aria-label=\"<%= locale==='nl'?'Zoekterm verwijderen:':locale==='fr'?'Supprimer la recherche :':'Remove search:' %> <%= search %>\"><%= customerText(locale==='nl'?'Zoeken:':locale==='fr'?'Recherche:':'Search:') %> <%= search %><span aria-hidden=\"true\"> ×</span></a><% } %>\n      <% if(sort&&sort!=='featured'){ %><a href=\"<%= shopFilterUrlWithout('sort') %>\" aria-label=\"<%= shopText('Remove sorting') %>\"><%= customerText(locale==='nl'?'Sorteren:':locale==='fr'?'Tri :':'Sort:') %> <%= {newest:'Newest',price_low:'Price ↑',price_high:'Price ↓',name:'Name A–Z'}[sort]||sort %><span aria-hidden=\"true\"> ×</span></a><% } %>\n      <% if(minPrice){ %><a href=\"<%= shopFilterUrlWithout('minPrice') %>\" aria-label=\"<%= shopText('Remove minimum price') %>\"><%= customerText(locale==='nl'?'Minimum:':'Min:') %> <%= minPrice %><span aria-hidden=\"true\"> ×</span></a><% } %>\n      <% if(maxPrice){ %><a href=\"<%= shopFilterUrlWithout('maxPrice') %>\" aria-label=\"<%= shopText('Remove maximum price') %>\"><%= customerText(locale==='nl'?'Maximum:':'Max:') %> <%= maxPrice %><span aria-hidden=\"true\"> ×</span></a><% } %>\n      <% if(inStockOnly){ %><a href=\"<%= shopFilterUrlWithout('stock') %>\" aria-label=\"<%= customerText(\"Remove in-stock filter\") %>\"><%= customerText(locale==='nl'?'Op voorraad':locale==='fr'?'En stock':'In stock') %><span aria-hidden=\"true\"> ×</span></a><% } %>\n    </div>\n    <a class=\"active-filter-clear\" href=\"<%= _categoryInfo?'/category/'+encodeURIComponent(_categoryInfo.slug):'/shop' %>\"><%= customerText(locale==='nl'?'Alles wissen':locale==='fr'?'Tout effacer':locale==='ckb'?'هەموو بسڕەوە':locale==='ar'?'مسح الكل':'Clear all') %></a>\n  </nav>\n  <% } %>\n  <div class=\"shop-toolbar\"><div class=\"chips\"><a class=\"chip <%= !category?'active':'' %>\" href=\"/shop\"><%= shopText('All') %></a><% categories.forEach(c=>{ 