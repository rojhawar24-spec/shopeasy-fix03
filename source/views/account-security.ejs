<%- include('partials/header',{title:'Account security'}) %>
<section class="auth-wrap"><div class="auth-card"><%- include('partials/back-button', { fallback: '/account' }) %><span class="eyebrow"><%= customerText("SECURITY") %></span><h1><%= customerText("Protect your account.") %></h1><p class="muted"><%= customerText("Change your password and sign out other active sessions.") %></p><% if(error){ %><div class="alert" role="alert"><%= customerText(error) %></div><% } %><% if(changed){ %><div class="alert success-alert" role="status"><%= customerText("Password changed. Other active sessions were signed out.") %></div><% } %><form class="form-stack" method="post" action="/account/security"><input type="hidden" name="_csrf" value="<%= csrf %>"><label><%= customerText("Current password") %><input type="password" name="currentPassword" required maxlength="200" autocomplete="current-password"></label><label><%= customerText("New password") %><input type="password" name="newPassword" required minlength="15" maxlength="200" autocomplete="new-password"></label><label><%= customerText("Confirm new password") %><input type="password" name="confirmPassword" required minlength="15" maxlength="200" autocomplete="new-password"></label><button type="submit" class="btn btn-dark btn-wide"><%= customerText("Change password") %></button></form><p class="field-note"><%= customerText("Use a unique password that you do not reuse elsewhere.") %></p></div></section>
<%- include('partials/footer') %>