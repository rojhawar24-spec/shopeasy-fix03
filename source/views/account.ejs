<%- include('partials/header',{title:'Account'}) %>
<% const orderStatusLabels={fr:{pending:'En attente de confirmation',processing:'En préparation',shipped:'En cours de livraison',completed:'Livrée',cancelled:'Annulée',paid:'Payée'},en:{pending:'Awaiting confirmation',processing:'Preparing',shipped:'Out for delivery',completed:'Delivered',cancelled:'Cancelled',paid:'Paid'},ckb:{pending:'چاوەڕوانی پشتڕاستکردنەوە',processing:'ئامادەکردنی داواکاری',shipped:'لە ڕێگای گەیاندندایە',completed:'گەیێندراوە',cancelled:'هەڵوەشێنراوەتەوە',paid:'پارە دراوە'},ar:{pending:'بانتظار التأكيد',processing:'قيد التجهيز',shipped:'في طريق التوصيل',completed:'تم التسليم',cancelled:'ملغى',paid:'مدفوع'},nl:{pending:'Wacht op bevestiging',processing:'Wordt klaargemaakt',shipped:'Onderweg voor levering',completed:'Geleverd',cancelled:'Geannuleerd',paid:'Betaald'}}; const orderStatusText=orderStatusLabels[locale]||orderStatusLabels.en; %>
<section class="container page-head account-heading"><%- include('partials/back-button', { fallback: '/' }) %><div class="account-welcome"><span class="account-avatar" aria-hidden="true"><%= String(user.email||'U').trim().charAt(0).toUpperCase() %></span><div><span class="eyebrow"><%= customerText(locale==='nl'?(user.role==='admin'?'BEHEERDERSACCOUNT':user.role==='manager'?'MANAGERACCOUNT':'JE ACCOUNT'):user.role==='admin'?'ADMIN ACCOUNT':user.role==='manager'?'MANAGER ACCOUNT':'YOUR ACCOUNT') %></span><h1><%= customerText(locale==='nl'?'Welkom terug.':'Welcome back.') %></h1><p><%= customerText(locale==='nl'?'Je bent aangemeld als':'You are signed in as') %> <strong><%= user.email %></strong>.</p></div></div><div class="account-order-count"><strong><%= total %></strong><span><%= customerText(total===1?'order in your history':'orders in your history') %></span></div></section>
<% if(user.role==='admin'||user.role==='manager'){ %><section class="container account-grid"><div class="panel manager-account-card"><div class="panel-head"><div><span class="eyebrow"><%= customerText("STORE CONTROL") %></span><h2><%= customerText(locale==='nl'?(user.role==='manager'?'Manager-toegang':'Beperkte toegang'):user.role==='manager'?'Manager access':'Limited access') %></h2></div><span class="status"><%= customerText(user.role==='admin'?'Admin':'Manager') %></span></div><p class="muted"><%= customerText(locale==='nl' ? (user.role==='manager' ? 'Je Manager-account heeft volledige toegang tot het winkelbeheer, waaronder producten, categorieën, voorraad, kortingen, verhalen, bestellingen, klanten, de etalage, instellingen, audits en licentiegegevens.' : 'Je Admin-account heeft beperkte, alleen-lezen toegang tot het winkeloverzicht. Alleen een Manager-account kan winkelgegevens of instellingen wijzigen.') : user.role==='manager' ? 'Your Manager account has full store-management access, including products, categories, stock, discounts, stories, orders, customers, storefront, settings, audit and license information.' : 'Your Admin account has limited, read-only access to the store overview. A Manager account is required to change store data or settings.') %></p><div class="quick-links"><a class="btn btn-dark" href="/admin"><%= customerText(locale==='nl'?(user.role==='manager'?'Manager openen':'Overzicht openen'):user.role==='manager'?'Open manager':'Open overview') %></a><a class="btn btn-light" href="/account/security"><%= customerText(locale==='nl'?'Accountbeveiliging':'Account security') %></a></div></div></section><% } %>
<section class="container account-grid"><div class="panel account-overview-card"><div class="panel-head"><div><span class="eyebrow"><%= customerText("ACCOUNT OVERVIEW") %></span><h2><%= customerText(locale==='nl'?'Je gegevens':'Your details') %></h2><p class="muted"><%= customerText(locale==='nl'?'Beheer je aanmelding en ga verder met winkelen.':'Manage your login and continue shopping.') %></p></div></div><p class="account-email"><span class="muted"><%= customerText(locale==='nl'?'E-mailadres':'Email address') %></span><strong><%= user.email %></strong></p><div class="quick-links"><a class="btn btn-light" href="/account/security"><%= customerText(locale==='nl'?'Accountbeveiliging':'Account security') %></a><a class="btn btn-dark" href="/shop"><%= customerText(locale==='nl'?'Bekijk producten':'Browse products') %></a><form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-light" type="submit"><%= customerText(locale==='nl'?'Afmelden':'Sign out') %></button></form></div></div><div class="panel account-orders-card"><div class="panel-head"><div><span class="eyebrow"><%= customerText("ORDER HISTORY") %></span><h2><%= customerText(locale==='nl'?'Je bestellingen':'Your orders') %></h2><p class="muted"><%= customerText(locale==='nl'?'Volg elke bestelling vanaf de bevestiging tot aan de levering.':'Follow each order from confirmation to delivery.') %></p></div></div><% if(orders.length){orders.forEach(o=>{ %><a class="order-row" href="/account/order/<%= o.id %>"><div><strong><span><%= customerText("Order #") %></span> <%= o.id %></strong><time datetime="<%= o.created_at %>" title="<%= formatDateTimeDisplay(o.created_at,storeTimeZone) %>"><%= formatRelativeTime(o.created_at) %></time></div><div><span class="status status-<%= o.status %>"><%= orderStatusText[o.status]||o.status %></span><strong><%= formatPrice(o.total_cents,o.currency) %></strong></div></a><% }) %><% if(hasPrev||hasNext){ %><div class="pagination"><% if(hasPrev){ %><a class="btn btn-light btn-small" href="/account?page=<%= page-1 %>"><%= customerText(locale==='nl'?'← Vorige':'← Previous') %></a><% } else { %><span></span><% } %><span><%= customerText("Page ") %><strong><%= page %></strong></span><% if(hasNext){ %><a class="btn btn-dark btn-small" href="/account?page=<%= page+1 %>"><%= customerText(locale==='nl'?'Volgende →':'Next →') %></a><% } else { %><span></span><% } %></div><% } %><% } else { %><div class="empty compact"><h3><%= customerText(locale==='nl'?'Nog geen bestellingen.':'No orders yet.') %></h3><p><%= customerText(locale==='nl'?'Wanneer je een bestelling plaatst, kun je de status hier volgen.':'When you place an order, you can follow its status here.') %></p><a href="/shop" class="btn btn-dark"><%= customerText(locale==='nl'?'Bekijk producten →':'Browse products →') %></a></div><% } %></div></section>
<%- include('partials/footer') %>