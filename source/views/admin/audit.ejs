<%- include('../partials/header',{title:'Audit log'}) %><%- include('../partials/admin-nav') %>
<section class="container page-head"><%- include('../partials/back-button', { fallback: '/admin' }) %><div><span class="eyebrow">SECURITY</span><h1>Audit log</h1><p>Important manager actions are recorded without storing secrets or payment credentials.</p></div></section>
<section class="container section"><div class="panel table-wrap" role="region" aria-label="Audit trail table. Scroll horizontally if needed." tabindex="0"><table><thead><tr><th>Date</th><th>Actor</th><th>Action</th><th>Target</th></tr></thead><tbody><% logs.forEach(l=>{ %><tr><td><%= formatDateTimeDisplay(l.created_at,storeTimeZone) %></td><td><%= l.email || 'System' %></td><td><%= l.action %></td><td><%= l.target_type %><%= l.target_id ? ' #'+l.target_id : '' %></td></tr><% }) %></tbody></table></div></section>
<%- include('../partials/footer',{managerWorkspaceShell:user?.role==='manager'}) %>