<%- include('../partials/header',{title:'Categories'}) %>
<%- include('../partials/admin-nav') %>
<section class="container page-head admin-head"><%- include('../partials/back-button', { fallback: '/admin' }) %><div><span class="eyebrow">PRODUCT CATEGORIES</span><h1>Categories</h1><p>Create clear groups so customers can find products quickly, such as Clothing, Homeware or Accessories.</p></div></section>
<section class="container admin-two-col section">
<form class="panel form-stack" method="post" enctype="multipart/form-data" action="/admin/categories/save"><input type="hidden" name="_csrf" value="<%= csrf %>"><% if(editCategory?.id){ %><input type="hidden" name="id" value="<%= editCategory.id %>"><% } %><% if(error){ %><div class="alert" role="alert"><%= error %></div><% } %>
<h2><%= editCategory?.id?'Edit category':'Add category' %></h2>
<label>Name *<input name="name" maxlength="80" required placeholder="Accessories" value="<%= editCategory?.name||'' %>"></label>
<%
  const blockedIds=new Set();
  if(editCategory?.id){
    const markDescendants=(id,seen=new Set([Number(id)]))=>{ categories.filter(x=>Number(x.parent_id)===Number(id)).forEach(x=>{ const childId=Number(x.id); if(seen.has(childId)) return; seen.add(childId); blockedIds.add(childId); markDescendants(childId,seen); }); };
    blockedIds.add(Number(editCategory.id)); markDescendants(editCategory.id);
  }
  const categoryChildren=new Map();
  categories.forEach(c=>{ const key=c.parent_id?Number(c.parent_id):0; if(!categoryChildren.has(key)) categoryChildren.set(key,[]); categoryChildren.get(key).push(c); });
  function parentOptions(parentId,depth,seen=new Set()){ if(depth>80) return ''; const rows=categoryChildren.get(parentId)||[]; return rows.map(c=>{ const id=Number(c.id); if(blockedIds.has(id)||seen.has(id)) return ''; const nextSeen=new Set(seen); nextSeen.add(id); return `<option translate="no" data-no-translate value="${id}" ${Number(editCategory?.parent_id)===id?'selected':''}>${'&nbsp;'.repeat(depth*4)}${depth?'↳ ':''}${escapeHtml(c.name)}</option>` + parentOptions(id,depth+1,nextSeen); }).join(''); }
%>
<label>Parent category<select name="parentId"><option value="">Top-level category</option><%- parentOptions(0,0) %></select><span class="field-note">Optional. Choose a parent only for a subcategory, such as Mugs under Homeware. Leave it as Top-level category for a main group.</span></label>
<label>Description<textarea name="description" maxlength="2000" rows="4" placeholder="Short category description for customers and SEO."><%= editCategory?.description||'' %></textarea></label>
<section class="form-section easy-photo-section"><h2>Category photo</h2><% if(editCategory?.image_url||editCategory?.imageUrl){ %><img src="<%= safeImageUrl(editCategory.image_url||editCategory.imageUrl) %>" alt="Current category photo" width="120" height="120" data-fallback-src="/assets/category-placeholder.svg" data-category-current><% } %><label class="product-upload-card" data-easy-drop><strong>＋ Choose photo</strong><span class="field-note">Click or drop a JPG, PNG or WebP photo here.</span><input type="file" name="image" accept="image/jpeg,image/png,image/webp" data-easy-photo></label><div data-easy-preview aria-live="polite"></div><label class="checkbox-inline"><input type="checkbox" name="removeImage" value="1">Remove current photo</label><details><summary>Use a photo link instead (optional)</summary><label>Image URL<input name="imageUrl" maxlength="500" value="<%= editCategory?.image_url||editCategory?.imageUrl||'' %>" placeholder="https://…"></label></details><small class="field-note">Save the category to store the photo.</small></section>
<div class="form-two"><label>Display order (lower numbers first)<input type="number" name="sortOrder" min="0" max="100000000" step="1" value="<%= editCategory?.sort_order??0 %>"><span class="field-note">Use 0 for highest priority. A smaller number makes this category appear earlier in the shop.</span></label><label class="checkbox-inline"><input type="checkbox" name="active" <%= editCategory ? editCategory.active ? 'checked' : '' : 'checked' %>> Show this category in the shop</label></div>
<div class="form-actions"><button type="submit" class="btn btn-dark btn-wide"><%= editCategory?.id?'Save changes':'Add category' %></button><% if(editCategory?.id){ %><a class="btn btn-light btn-wide" href="/admin/categories">Cancel</a><% } %></div></form>
<div class="panel table-wrap" role="region" aria-label="Categories table. Scroll horizontally if needed." tabindex="0"><table><thead><tr><th>Category</th><th>Products</th><th>Visibility</th><th></th></tr></thead><tbody><% categories.forEach(c=>{ %><tr><td><div><strong data-no-translate><%= c.parent_name ? '↳ ' : '' %><%= c.name %></strong><br><span class="muted"><%= c.parent_name ? `Child of ${c.parent_name}` : 'Top-level' %> · /category/<%= c.slug %></span></div></td><td><strong><%= Number(c.product_count||0) %></strong><br><span class="muted"><%= Number(c.child_count||0) %> <%= locale==='ar' ? (Number(c.child_count||0)===1?'فئة فرعية':'فئات فرعية') : locale==='ckb' ? 'پۆلی لاوەکی' : (Number(c.child_count||0)===1?'child category':'child categories') %></span></td><td><span class="status <%= c.active?'':'off' %>"><%= c.active?'Live':'Hidden' %></span></td><td class="table-actions"><div class="table-action-group"><a class="btn btn-light btn-small" href="/admin/categories?edit=<%= c.id %>">Edit</a><% if(!Number(c.child_count)){ %><form method="post" action="/admin/categories/delete" data-confirm="Delete category <%= c.name %>? Products will become uncategorized."><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= c.id %>"><button type="submit" class="btn btn-danger btn-small">Delete</button></form><% } else { %><span class="muted">Move children first</span><% } %></div></td></tr><% }) %><% if(!categories.length){ %><tr><td colspan="4"><div class="empty compact"><h3>No categories yet.</h3><p class="muted">That is okay. Products can remain uncategorised until the manager decides to add catalog groups.</p></div></td></tr><% } %></tbody></table></div>
</section>
<%- include('../partials/footer',{managerWorkspaceShell:user?.role==='manager'}) %>

<script src="/js/easy-photo-upload-v1.js" defer></script>