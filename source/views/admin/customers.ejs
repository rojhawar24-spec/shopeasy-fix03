<%
const registrationCopy={"en":{"status":"Account access","pending":"Awaiting ownership verification","submit":"Confirm account ownership","identity":"I have verified that this customer owns this email address.","password":"New password (at least 15 characters)","confirm":"Confirm new password","guidance":"Set a new password agreed privately with the verified customer. Never approve an unknown registration using its original password.","approved":"Account ownership confirmed. The customer can now sign in with the new password.","unavailable":"This registration could not be approved. Refresh and check its current status.","confirmation-required":"Verify ownership and confirm the checkbox before approving this registration.","active":"Verified or existing account","invalid-password":"Use matching new passwords of at least 15 characters, avoiding common or repeated passwords."},"nl":{"status":"Accounttoegang","pending":"Wacht op eigendomscontrole","submit":"Accountbezit bevestigen","identity":"Ik heb gecontroleerd dat dit e-mailadres van deze klant is.","password":"Nieuw wachtwoord (minstens 15 tekens)","confirm":"Nieuw wachtwoord bevestigen","guidance":"Stel een nieuw wachtwoord in dat privé met de geverifieerde klant is afgesproken. Keur een onbekende registratie nooit goed met het oorspronkelijke wachtwoord.","approved":"Accountbezit bevestigd. De klant kan nu inloggen met het nieuwe wachtwoord.","unavailable":"Deze registratie kon niet worden goedgekeurd. Vernieuw de pagina en controleer de huidige status.","confirmation-required":"Controleer het eigendom en vink de bevestiging aan voordat je deze registratie goedkeurt.","active":"Geverifieerd of bestaand account","invalid-password":"Gebruik overeenkomende nieuwe wachtwoorden van minstens 15 tekens. Vermijd veelgebruikte of herhaalde wachtwoorden."},"fr":{"status":"Accès au compte","pending":"Vérification du titulaire en attente","submit":"Confirmer le titulaire du compte","identity":"J’ai vérifié que cette adresse e-mail appartient à ce client.","password":"Nouveau mot de passe (au moins 15 caractères)","confirm":"Confirmer le nouveau mot de passe","guidance":"Définissez un nouveau mot de passe convenu en privé avec le client vérifié. N’approuvez jamais une inscription inconnue avec son mot de passe initial.","approved":"Titulaire du compte confirmé. Le client peut se connecter avec le nouveau mot de passe.","unavailable":"Cette inscription n’a pas pu être approuvée. Actualisez la page et vérifiez son statut actuel.","confirmation-required":"Vérifiez le titulaire et cochez la confirmation avant d’approuver cette inscription.","active":"Compte vérifié ou existant","invalid-password":"Utilisez deux nouveaux mots de passe identiques d’au moins 15 caractères. Évitez les mots de passe courants ou répétitifs."},"ar":{"status":"الوصول إلى الحساب","pending":"بانتظار التحقق من الملكية","submit":"تأكيد ملكية الحساب","identity":"تحققت من أن عنوان البريد الإلكتروني هذا يخص هذا العميل.","password":"كلمة مرور جديدة (15 حرفًا على الأقل)","confirm":"تأكيد كلمة المرور الجديدة","guidance":"عيّن كلمة مرور جديدة متفقًا عليها سرًا مع العميل الذي تم التحقق منه. لا توافق أبدًا على تسجيل مجهول باستخدام كلمة مروره الأصلية.","approved":"تم تأكيد ملكية الحساب. يمكن للعميل الآن تسجيل الدخول بكلمة المرور الجديدة.","unavailable":"تعذرت الموافقة على هذا التسجيل. حدّث الصفحة وتحقق من حالته الحالية.","confirmation-required":"تحقق من الملكية وحدد مربع التأكيد قبل الموافقة على هذا التسجيل.","active":"حساب موثّق أو موجود","invalid-password":"استخدم كلمتي مرور جديدتين متطابقتين من 15 حرفًا على الأقل، وتجنب الكلمات الشائعة أو المتكررة."},"ckb":{"status":"دەستگەیشتن بە هەژمار","pending":"چاوەڕوانی پشتڕاستکردنەوەی خاوەندارێتی","submit":"خاوەندارێتی هەژمار پشتڕاست بکەرەوە","identity":"پشتڕاستم کردووەتەوە کە ئەم ئیمەیڵە هی ئەم کڕیارەیە.","password":"وشەی نهێنی نوێ (لانیکەم ١٥ پیت)","confirm":"وشەی نهێنی نوێ پشتڕاست بکەرەوە","guidance":"وشەی نهێنی نوێ دابنێ کە بە تایبەتی لەگەڵ کڕیاری پشتڕاستکراوە ڕێککەوتوون. هەرگیز تۆماربوونێکی نەناسراو بە وشەی نهێنی سەرەتاییەکەی پەسەند مەکە.","approved":"خاوەندارێتی هەژمار پشتڕاست کرایەوە. کڕیار ئێستا دەتوانێت بە وشەی نهێنی نوێ بچێتە ژوورەوە.","unavailable":"ئەم تۆماربوونە پەسەند نەکرا. پەڕەکە نوێ بکەرەوە و دۆخی ئێستای بپشکنە.","confirmation-required":"پێش پەسەندکردنی تۆماربوونەکە، خاوەندارێتی پشتڕاست بکەرەوە و خانەی پشتڕاستکردنەوە هەڵبژێرە.","active":"هەژماری پشتڕاستکراوە یان پێشوو","invalid-password":"دوو وشەی نهێنی نوێی یەکسان بەکاربهێنە کە لانیکەم ١٥ پیت بن؛ لە وشە نهێنییە باوەکان و دووبارەکان دوور بکەوە."}};
const approvalCopy=registrationCopy[locale]||registrationCopy.en;
const registrationNotice=typeof registrationResult==='string'&&['approved','unavailable','confirmation-required','invalid-password'].includes(registrationResult)?approvalCopy[registrationResult]:'';
%>
<%- include('../partials/header',{title:'Customers'}) %><%- include('../partials/admin-nav') %>
<section class="container page-head admin-head"><%- include('../partials/back-button', { fallback: '/admin' }) %><div><span class="eyebrow">CUSTOMERS</span><h1>Customers.</h1><p>Contact information is shown here only to an authorised manager. Full delivery details stay on each order.</p></div></section>
<% if(registrationNotice){ %><section class="container"><div class="alert" role="status" translate="no" data-no-translate><%= registrationNotice %></div></section><% } %>
<section class="container section"><form class="admin-filters panel" method="get" action="/admin/customers"><div><label for="customer-search">Search</label><input id="customer-search" name="search" value="<%= search %>" maxlength="120" placeholder="Customer email"></div><button type="submit" class="btn btn-dark">Search</button><a class="btn btn-light" href="/admin/customers">Reset</a></form></section>
<section class="container section section-topless"><div class="table-meta"><span><strong><%= total %></strong> customers</span><span>Page <%= page %></span></div><div class="panel table-wrap" role="region" aria-label="Customers table. Scroll horizontally if needed." tabindex="0"><table><thead><tr><th>Customer</th><th>Phone</th><th>Latest location</th><th>Orders</th><th>Lifetime value</th><th translate="no" data-no-translate><%= approvalCopy.status %></th></tr></thead><tbody><% customers.forEach(c=>{ %><tr><td><strong data-no-translate><%= c.email %></strong><br><span class="muted">Joined <%= formatDateTimeDisplay(c.created_at,storeTimeZone).split(',')[0] %></span></td><td data-no-translate><%= c.phone||'—' %></td><td data-no-translate><%= c.last_city||'—' %><%= c.last_country?', '+c.last_country:'' %></td><td><%= c.order_count %></td><td><strong><%= formatPrice(c.lifetime_value_cents,currency) %></strong></td><td>
<% if(Number(c.email_verification_required)===1&&!c.email_verified_at){ %>
  <strong translate="no" data-no-translate><%= approvalCopy.pending %></strong>
  <% if(user?.role==='manager'){ %><details><summary translate="no" data-no-translate><%= approvalCopy.submit %></summary>
    <form method="post" action="/admin/customers/<%= c.id %>/approve-registration" class="form-stack" translate="no" data-no-translate>
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <p class="field-note" id="registration-guidance-<%= c.id %>"><%= approvalCopy.guidance %></p>
      <label><%= approvalCopy.password %><input type="password" name="password" autocomplete="new-password" required minlength="15" maxlength="200" aria-describedby="registration-guidance-<%= c.id %>"></label>
      <label><%= approvalCopy.confirm %><input type="password" name="confirmPassword" autocomplete="new-password" required minlength="15" maxlength="200"></label>
      <label class="checkbox-inline"><input type="checkbox" name="identityConfirmed" value="yes" required><%= approvalCopy.identity %></label>
      <button class="btn btn-light btn-small" type="submit"><%= approvalCopy.submit %></button>
    </form>
  </details><% } %>
<% } else { %><span translate="no" data-no-translate><%= approvalCopy.active %></span><% } %>
</td></tr><% }) %><% if(!customers.length){ %><tr><td colspan="6"><div class="empty compact"><h3>No customers found.</h3><a href="/admin/customers" class="text-link">Clear search →</a></div></td></tr><% } %></tbody></table></div><div class="pagination"><% if(hasPrev){ %><a class="btn btn-light btn-small" href="/admin/customers?page=<%= page-1 %>&search=<%= encodeURIComponent(search) %>">← Previous</a><% } else { %><span></span><% } %><span>Page <strong><%= page %></strong></span><% if(hasNext){ %><a class="btn btn-dark btn-small" href="/admin/customers?page=<%= page+1 %>&search=<%= encodeURIComponent(search) %>">Next →</a><% } else { %><span></span><% } %></div></section>
<%- include('../partials/footer',{managerWorkspaceShell:user?.role==='manager'}) %>