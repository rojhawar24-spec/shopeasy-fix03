<%- include('../partials/header',{title:'Store manager'}) %>
<%- include('../partials/admin-nav') %>
<div class="container manager-dashboard-shell">
  <div class="manager-dashboard-content">
<section class="container page-head admin-head"><div><span class="eyebrow">STORE OVERVIEW</span><h1>Manage your store</h1><p>A clear control centre for setup, products, inventory, customer orders and storefront content.</p></div><div class="quick-links"><a class="btn btn-mint" href="/admin/products/new">+ Add product</a></div></section>
<section class="container admin-grid"><a class="stat-card" href="/admin/products"><span>Products</span><strong><%= productCount %></strong><small><%= activeProducts %> live · <%= soldOutProducts %> sold out</small></a><a class="stat-card" href="/admin/orders"><span>Orders</span><strong><%= orderCount %></strong><small><%= pendingOrders %> <%= paymentMode==='cash_on_delivery'?'awaiting acceptance':'waiting for payment' %></small></a><a class="stat-card" href="/admin/customers"><span>Customers</span><strong><%= customerCount %></strong><small>Accounts with protected order history</small></a><a class="stat-card" href="#low-stock"><span>Low-stock alerts</span><strong><%= lowStockCount||0 %></strong><small>Products or variants at/below their reorder level</small></a><div class="stat-card"><span>Recorded revenue</span><strong><%= formatPrice(paidRevenue,currency) %></strong><small>Cash-collected / fulfilled orders</small></div><div class="stat-card"><span>Estimated gross profit</span><strong><%= formatPrice(grossProfitCents,currency) %></strong><small>After product costs and coupons; excludes operating costs, tax and shipping. <%= grossProfitMissingOrders %> completed order(s) excluded because historical unit cost is unknown.</small></div></section>
<% if(launch){ const ready=Boolean(launch.ready); %>
<section class="container section manager-setup-section">
  <div class="manager-setup-panel <%= ready?'is-ready':'is-incomplete' %>">
    <div class="manager-setup-copy"><span class="eyebrow">STORE READINESS</span><h2><%= ready?'Your checkout setup is ready':'Finish setting up your store' %></h2><p><%= ready?'The launch checks are complete. Keep product prices, delivery coverage and order handling up to date.':'You can keep editing settings and products now. Checkout remains closed until the required setup and inventory are ready.' %></p><p class="field-note manager-setup-note">A missing product, country or policy keeps checkout closed. It must never prevent you from saving business details and configuration drafts.</p><span class="status <%= ready?'status-completed':'off' %>"><%= ready?'Ready to accept orders':'Checkout closed · setup incomplete' %></span></div>
    <div class="manager-setup-actions"><% if(user?.role==='manager'){ %><a class="btn btn-dark" href="/admin/settings">Review store settings →</a><% } %><a class="btn btn-light" href="/admin/products"><%= Number(launch.sellableProductCount||0)>0?'Review products':'Add your first product' %> →</a><a class="btn btn-light" href="/admin/orders">Manage orders →</a></div>
  </div>
</section>
<% } %>
<section class="container section manager-ad-readiness" aria-labelledby="manager-ad-title">
  <div class="panel"><div class="panel-head"><div><span class="eyebrow">GOOGLE ADS & MERCHANT CENTER</span><h2 id="manager-ad-title">Advertising launch checklist</h2><p class="muted">Google reviews your real public website and account. This is a checklist, not Google approval or verification.</p></div><span class="status <%= launch?.ready?'status-pending':'off' %>"><%= launch?.ready?'Manual review required':'Finish checkout setup first' %></span></div>
  <div class="manager-ad-checklist"><a href="/admin/settings"><strong>01 · Business identity</strong><span>Verify company name, address, phone/email and customer service</span></a><a href="/imprint" target="_blank" rel="noopener noreferrer"><strong>02 · Public company information</strong><span>Check that the public page matches your Merchant Center account</span></a><a href="/shipping-returns" target="_blank" rel="noopener noreferrer"><strong>03 · Shipping and returns</strong><span>Real destinations, fees, withdrawal rules and refund times</span></a><a href="/admin/products"><strong>04 · Products and prices</strong><span>No placeholder images; real photos, accurate stock and checkout price</span></a><a href="/shop" target="_blank" rel="noopener noreferrer"><strong>05 · Customer purchase</strong><span>Test as a guest, including checkout, payment and confirmation</span></a></div>
  <p class="field-note">Do not launch campaigns until your public HTTPS domain, GoogleAdsBot access, consent handling and all purchases are tested. Ads tracking is not enabled by this panel.</p></div>
</section>
<section class="container section" id="low-stock"><div class="panel"><div class="panel-head"><div><span class="eyebrow">INVENTORY SAFETY</span><h2>Low-stock alerts</h2><p class="muted">Available stock is physical stock minus reserved quantities. Variant rows are checked individually.</p></div><span class="status <%= Number(lowStockCount||0)>0?'off':'status-completed' %>"><%= Number(lowStockCount||0)>0?`${lowStockCount} need review`:'Stock levels look clear' %></span></div><% if(lowStockInventory?.length){ %><div class="table-wrap" role="region" aria-label="Low-stock inventory table" tabindex="0"><table><thead><tr><th scope="col">Product</th><th scope="col">Variant</th><th scope="col">SKU</th><th scope="col">Available</th><th scope="col">Reorder level</th></tr></thead><tbody><% lowStockInventory.forEach(row=>{ %><tr><td><strong><%= row.product_name %></strong></td><td><%= [row.variant_value,row.variant_value_2].filter(Boolean).join(' · ')||'Base product' %></td><td><%= row.product_sku %></td><td><span class="status <%= Number(row.available_stock)===0?'off':'status-pending' %>"><%= row.available_stock %></span></td><td><%= row.reorder_level %></td></tr><% }) %></tbody></table></div><% if(Number(lowStockCount||0)>lowStockInventory.length){ %><p class="muted">Showing the first <%= lowStockInventory.length %> low-stock lines. Open Products to review stock.</p><% } %><% } else { %><div class="empty compact"><h3>No low-stock products.</h3><p class="muted">ShopEasy will flag active products and active variants when available stock reaches their reorder level.</p></div><% } %><a class="btn btn-light" href="/admin/products">Review inventory →</a></div></section>
<section class="container section">
  <div class="panel dashboard-promotion-panel">
    <div class="panel-head"><div><span class="eyebrow">PROMOTIONS</span><h2>Featured stories</h2><p class="muted">Show a product or promotion in Stories for a limited time.</p></div><span class="status"><%= liveStories %> live · <%= storyCount %> total</span></div>
    <div class="dashboard-promotion-actions"><a class="btn btn-dark" href="/admin/stories/new">Create a story</a><a class="btn btn-light" href="/admin/stories">Manage stories</a></div>
  </div>
</section>
<section class="container section section-topless"><div class="panel"><div class="panel-head"><div><span class="eyebrow">LATEST ACTIVITY</span><h2>Recent orders</h2></div><a class="text-link" href="/admin/orders">View all →</a></div><div class="table-wrap admin-recent-orders-wrap" role="region" aria-label="Recent orders table. Scroll horizontally if needed." tabindex="0"><table class="admin-dashboard-table"><thead><tr><th scope="col">Order</th><th scope="col">Customer</th><th scope="col">Phone</th><th scope="col">Total</th><th scope="col">Status</th><th scope="col">Date</th><th scope="col">Actions</th></tr></thead><tbody><% recentOrders.forEach(o=>{ %><tr><td><span class="table-mobile-label">Order</span><a class="table-link" href="/admin/orders/<%= o.id %>">#<%= o.id %></a><small class="dashboard-date-mobile" dir="auto"><%= formatRelativeTime(o.created_at) %></small></td><td><span class="table-mobile-label">Customer</span><strong dir="ltr" class="admin-order-email"><%= String(o.email||'').split('@')[0] %>@<wbr><%= String(o.email||'').split('@').slice(1).join('@') %></strong><small class="dashboard-phone-mobile" dir="ltr"><%= o.customer_phone||'—' %></small></td><td class="dashboard-phone-cell" dir="ltr"><span class="table-mobile-label">Phone</span><%= o.customer_phone||'—' %></td><td><span class="table-mobile-label">Total</span><strong><%= formatPrice(o.total_cents,o.currency) %></strong></td><td><span class="table-mobile-label">Status</span><span class="status status-<%= o.status %>"><%= o.status %></span></td><td class="order-date-cell"><span class="table-mobile-label">Date</span><time dir="ltr" datetime="<%= o.created_at %>" title="<%= formatDateTimeDisplay(o.created_at,storeTimeZone) %>"><strong><%= formatDateTimeDisplay(o.created_at,storeTimeZone) %></strong><small dir="auto"><%= formatRelativeTime(o.created_at) %></small></time></td><td><span class="table-mobile-label">Actions</span><a class="btn btn-dark btn-small order-manage-link" href="/admin/orders/<%= o.id %>">Manage order →</a></td></tr><% }) %><% if(!recentOrders.length){ %><tr><td colspan="7"><div class="empty compact"><h3>No orders yet.</h3><p class="muted">Orders will appear here after a successful checkout.</p></div></td></tr><% } %></tbody></table></div></div></section>
  </div>
</div>
<%- include('../partials/footer',{managerWorkspaceShell:user?.role==='manager'}) %>