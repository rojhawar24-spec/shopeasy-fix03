<%- include('../partials/header',{title:'Gift cards'}) %>
<%- include('../partials/admin-nav') %>
<section class="container page-head admin-head"><div><span class="eyebrow">STORED VALUE · CONTROLLED</span><h1>Gift cards</h1><p>Cards are issued by the Manager, stored as hashed random codes and debited inside the same database transaction as the order. This release supports full gift-card payment only.</p></div></section>
<section class="container form-page"><div class="panel form-stack">
<% if(error){ %><div role="alert" class="alert"><%= error %></div><% } %>
<% if(refunded){ %><div role="status" class="success-alert">Refund request processed. Check the ledger before trying again.</div><% } %>
<% if(createdCode){ %><div class="success-alert" role="status"><strong>Copy this gift card code now — it is not stored in plaintext and cannot be displayed again:</strong><p><code class="gift-card-code-wrap"><%= createdCode %></code></p><p>Only share through your approved secure customer channel.</p></div><% } %>
<form action="/admin/gift-cards/toggle" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><label class="checkbox-inline"><input name="enabled" type="checkbox" <%= enabled?'checked':'' %>> Enable gift-card payments</label><button class="btn btn-light" type="submit">Save feature switch</button></form>
<form action="/admin/gift-cards/issue" method="post" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><h2>Issue credit</h2><p>Issuing a gift card creates a financial liability. Do so only after confirming the customer payment outside this interface.</p><label>Credit amount in shop currency<input name="amount" type="text" inputmode="decimal" required placeholder="50.00" maxlength="24"></label><button type="submit" class="btn btn-dark" <%= enabled?'':'disabled' %>>Issue gift card (code shown once)</button></form>
<form action="/admin/gift-cards/refund" method="post" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><h2>Return credit for a whole order</h2><p>Only orders completed or cancelled and entirely paid with a gift card. A full credit return can happen only once per order. Verify the customer's refund/return entitlement first.</p><label>Order ID<input type="number" name="orderId" min="1" required></label><label>Reason (minimum 10 characters)<textarea name="reason" required minlength="10" maxlength="200"></textarea></label><button type="submit" class="btn btn-light">Return order value to gift card</button></form>
</div><div class="panel"><h2>Cards · last 100</h2><% if(!cards.length){ %><p class="empty-state" role="status"><%= locale==='nl'?'Er zijn nog geen cadeaubonnen uitgegeven.':locale==='fr'?'Aucune carte-cadeau n’a encore été émise.':locale==='ckb'?'هێشتا هیچ کارتی دیارییەک دەرنەکراوە.':locale==='ar'?'لم يتم إصدار بطاقات هدايا بعد.':'No gift cards have been issued yet.' %></p><% } else { %><div class="table-scroll" role="region" aria-label="Gift cards table. Scroll horizontally if needed." tabindex="0"><table><caption class="sr-only">Cards · last 100</caption><thead><tr><th scope="col">Card ID</th><th scope="col">Currency</th><th scope="col">Issued</th><th scope="col">Balance</th><th scope="col">Status</th></tr></thead><tbody><% cards.forEach(card=>{ %><tr><td><%= card.id %></td><td><%= card.currency %></td><td><%= formatPrice(card.original_amount_cents,card.currency) %></td><td><%= formatPrice(card.balance_cents,card.currency) %></td><td><%= card.active?'Active':'Inactive' %></td></tr><% }) %></tbody></table></div><% } %></div></section>
<%- include('../partials/footer',{managerWorkspaceShell:user?.role==='manager'}) %>
