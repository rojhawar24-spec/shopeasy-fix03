<%- include('../partials/header',{title:'License status'}) %>
<%- include('../partials/admin-nav') %>
<section class="container page-head"><%- include('../partials/back-button', { fallback: '/admin' }) %><div><span class="eyebrow">ADMIN ONLY</span><h1>License metadata</h1><p>This page checks environment-variable format only. It does not verify legal ownership, payment, a signature, or the validity of a license key.</p></div></section>
<section class="container section"><div class="panel"><h2>Status: <%= licenseInfo.configured ? 'Metadata configured — unverified' : 'Incomplete' %></h2><dl class="detail-list"><dt>Licensor</dt><dd><%= licenseInfo.licensorName || 'Not configured' %></dd><dt>Licensed to</dt><dd><%= licenseInfo.licensedTo || 'Not configured' %></dd><dt>License email</dt><dd><%= licenseInfo.licenseEmail || 'Not configured' %></dd><dt>Start date</dt><dd><%= licenseInfo.licenseDate || 'Not configured or invalid' %></dd><dt>Type</dt><dd><%= licenseInfo.licenseType %></dd><dt>Key format</dt><dd><%= licenseInfo.keyFormatValid ? 'Valid format (key hidden)' : 'Missing or invalid format' %></dd><dt>Missing / invalid settings</dt><dd><%= licenseInfo.missing.length ? licenseInfo.missing.join(', ') : 'None detected' %></dd></dl><p class="muted"><strong>Important:</strong> <%= licenseInfo.note %> Do not treat this page as proof that the person configuring the store owns the code or may license third-party materials.</p><p>Complete the signed purchase agreement and ownership/dependency review outside the application. Keep license keys in deployment secrets, never in source control.</p></div></section>
<%- include('../partials/footer',{managerWorkspaceShell:user?.role==='manager'}) %>
