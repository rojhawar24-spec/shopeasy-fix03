<%- include('../partials/header',{title:'Newsletter'}) %>
<%- include('../partials/admin-nav') %>
<section class="container page-head"><span class="eyebrow">CONSENT-BASED EMAIL</span><h1>Newsletter campaigns</h1><p>Confirmed subscribers: <strong><%= subscriberCount %></strong>. Subscribers confirm each address before receiving campaigns. Sending requires Resend, a HTTPS BASE_URL and a 32+ character NEWSLETTER_UNSUBSCRIBE_SECRET; every email has an unsubscribe link.</p></section>
<section class="container section"><% if(error){ %><p role="alert" class="alert"><%= error %></p><% } %><% if(created){ %><p role="status" class="success-alert">Campaign saved; no messages have been sent.</p><% } %><% if(sent){ %><p role="status"><%= sent==='configure'?'Configure Resend, BASE_URL (HTTPS) and NEWSLETTER_UNSUBSCRIBE_SECRET (at least 32 characters).':sent==='error'?'Batch failed; check server logs.':`${sent} emails sent in the requested batch.` %></p><% } %>
<% if(!appearance.newsletter){ %><p>Enable verified newsletter signup in Design Studio first.</p><% } else { %>
<form method="post" action="/admin/newsletter/create" class="panel form-stack engagement-review-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><h2>Create a campaign</h2><label for="newsletter-subject">Subject</label><input id="newsletter-subject" name="subject" maxlength="140" minlength="5" required><label for="newsletter-body">Message (plain text, no HTML)</label><textarea id="newsletter-body" name="body" rows="8" maxlength="5000" minlength="20" required></textarea><button class="btn btn-dark" type="submit">Save campaign (do not send)</button></form>
<% } %>
<h2>Saved campaigns</h2><div class="review-grid"><% campaigns.forEach(c=>{ %><article class="panel review-card"><h3><%= c.subject %></h3><p><%= c.body %></p><small>Created: <%= c.created_at %> · Delivered: <%= c.delivered %></small><form method="post" action="/admin/newsletter/send-batch"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="campaignId" value="<%= c.id %>"><button class="btn btn-dark" type="submit" <%= !appearance.newsletter?'disabled':'' %>>Send next batch (max 15)</button></form><p class="field-note">Explicitly sends to confirmed subscribers only. Repeat to deliver more. Failed messages may be retried up to three times; an interrupted sending state requires operator review.</p></article><% }) %></div>
</section><%- include('../partials/footer',{managerWorkspaceShell:user?.role==='manager'}) %>
