<%- include('../partials/header',{title:`Cash order #${order.id}`}) %>
<%- include('../partials/admin-nav') %>
<section class="container page-head admin-head"><%- include('../partials/back-button', { fallback: '/admin/orders' }) %><div><span class="eyebrow"><span>CASH ON DELIVERY · ORDER #</span> <%= order.id %></span><h1>Customer order.</h1><p><%= order.email %> · <time datetime="<%= order.created_at %>" title="<%= formatDateTimeDisplay(order.created_at,storeTimeZone) %>"><%= formatDateTimeDisplay(order.created_at,storeTimeZone) %> · <%= formatRelativeTime(order.created_at) %></time></p></div><span class="status status-<%= order.status %>"><%= order.status %></span></section>
<% if(statusError){ %><section class="container"><div class="alert" role="alert"><%= statusError %></div></section><% } %>
<section class="container order-layout"><div class="panel"><div class="panel-head"><div><span class="eyebrow">PURCHASE</span><h2>Items</h2></div></div><% order.items.forEach(i=>{ %><div class="order-item"><span data-no-translate><%= i.product_name %><% if(i.variant_value){ %><small class="order-variant"><%= i.variant_name %>: <%= i.variant_value %><% if(i.variant_value_2){ %> · <%= i.variant_name_2 %>: <%= i.variant_value_2 %><% } %></small><% } %> × <%= i.quantity %></span><strong><%= formatPrice(i.total_cents,order.currency) %></strong></div><% }) %><div class="rule"></div><div class="summary-row"><span>Items subtotal</span><strong><%= formatPrice(order.subtotal_cents,order.currency) %></strong></div><% if(order.automatic_discount_cents>0){ %><div class="summary-row"><span>Automatic product discounts</span><strong>-<%= formatPrice(order.automatic_discount_cents,order.currency) %></strong></div><% } %><% if(order.discount_cents>0){ %><div class="summary-row"><span>Coupon discount</span><strong>-<%= formatPrice(order.discount_cents,order.currency) %></strong></div><% } %><div class="summary-row"><span>Shipping</span><strong><%= order.shipping_cents===0?'Free':formatPrice(order.shipping_cents,order.currency) %></strong></div><% if(order.tax_rate_bps!==null&&order.tax_rate_bps!==undefined){ %><div class="summary-row"><span><%= order.tax_included?'Tax included in prices':'Tax added' %> (<%= (Number(order.tax_rate_bps)/100).toFixed(2) %>%)</span><strong><%= formatPrice(order.tax_cents||0,order.currency) %></strong></div><% } else { %><p class="field-note">No regional tax rule was recorded for this order. This record does not certify tax compliance.</p><% } %><div class="summary-row total"><span>Total · cash due on delivery</span><strong><%= formatPrice(order.total_cents,order.currency) %></strong></div></div>
<section class="panel" aria-labelledby="delivery-details-heading"><div class="panel-head"><div><span class="eyebrow">CUSTOMER</span><h2 id="delivery-details-heading">Delivery details</h2></div></div><div class="customer-detail"><div><span>Email</span><strong data-no-translate><%= order.email %></strong></div><div><span>Phone</span><strong><%= order.customer_phone||'Not provided' %></strong></div><div><span>Full name</span><strong data-no-translate><%= order.shipping_name %></strong></div></div><p data-no-translate><strong data-no-translate><%= order.shipping_name %></strong><br><%= order.shipping_address %><br><%= order.shipping_postal_code %> <%= order.shipping_city %><br><%= order.shipping_country %></p><% if(order.customer_note){ %><div class="tip-box"><strong>Customer note</strong><br><span class="policy-copy" data-no-translate><%= order.customer_note %></span></div><% } %><div class="rule"></div><h2>Fulfilment</h2><% if(order.status==='pending'){ %><p class="muted">This order is waiting for your acceptance. Reserved stock remains held until you accept or decline/cancel the order. There is no automatic time limit.</p><div class="form-actions"><form method="post" action="/admin/orders/status"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= order.id %>"><input type="hidden" name="status" value="processing"><button type="submit" class="btn btn-dark">Accept order</button></form><form method="post" action="/admin/orders/status"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= order.id %>"><input type="hidden" name="status" value="cancelled"><button type="submit" class="btn btn-light">Decline</button></form></div><% } else if(order.status==='processing'){ %><% if(order.cancellation_requested_at&&order.cancellation_request_decision==='pending'){ %><div class="alert" role="status"><strong>Customer requested cancellation.</strong><p><%= order.cancellation_request_reason %></p><p class="muted"><%= locale==='nl'?'Aangevraagd: ':'Requested: ' %><%= formatDateTimeDisplay(order.cancellation_requested_at,storeTimeZone) %>. <%= locale==='nl'?'Beslis vóór verzending.':'Decide before shipping.' %></p></div><div class="form-actions"><form method="post" action="/admin/orders/status"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= order.id %>"><input type="hidden" name="status" value="cancelled"><button type="submit" class="btn btn-danger">Approve cancellation & release stock</button></form><form method="post" action="/admin/orders/status"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= order.id %>"><input type="hidden" name="status" value="reject_cancel_request"><button type="submit" class="btn btn-light">Reject request & continue order</button></form></div><% } else { %><% if(order.cancellation_requested_at&&order.cancellation_request_decision==='rejected'){ %><p class="muted"><%= locale==='nl'?'Het vorige annuleringsverzoek is afgewezen op ':'Previous cancellation request was rejected on ' %><%= formatDateTimeDisplay(order.cancellation_request_decided_at,storeTimeZone) %>. <%= locale==='nl'?'Reden:':'Reason:' %> <%= order.cancellation_request_reason %></p><% } %><p class="muted">Accepted. Prepare the items and take them out for delivery.</p><div class="form-actions"><form method="post" action="/admin/orders/status"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= order.id %>"><input type="hidden" name="status" value="shipped"><button type="submit" class="btn btn-dark">Mark out for delivery</button></form><form method="post" action="/admin/orders/status"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= order.id %>"><input type="hidden" name="status" value="cancelled"><button type="submit" class="btn btn-light">Cancel before shipping</button></form></div><% } %><% } else if(order.status==='shipped'){ %><p class="muted">Collect <strong><%= formatPrice(order.total_cents,order.currency) %></strong> in cash from the customer before completing this order.</p><form method="post" action="/admin/orders/status"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= order.id %>"><input type="hidden" name="status" value="completed"><button type="submit" class="btn btn-mint">Delivered & cash received</button></form><% } else if(order.status==='completed'){ %><p class="success-alert">Order delivered and cash recorded as received.</p><% } else { %><p class="muted">This order was declined and reserved stock was released.</p><% } %><p class="muted">Terms accepted: <%= order.terms_accepted_at?formatDateTimeDisplay(order.terms_accepted_at,storeTimeZone):'Not recorded' %></p><p class="muted">Payment: Cash on delivery<% if(order.payment_reference){ %> · received<br>Reference: <%= order.payment_reference %><% } %></p></section></section>
<%- include('../partials/order-email-deliveries',{order,emailDeliveries:typeof emailDeliveries!=='undefined'?emailDeliveries:[],emailResult:typeof emailResult!=='undefined'?emailResult:''}) %>
<%- include('../partials/footer',{managerWorkspaceShell:user?.role==='manager'}) %>