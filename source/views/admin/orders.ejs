<%- include('../partials/header',{title:'Orders'}) %><%- include('../partials/admin-nav') %>
<section class="container page-head admin-head"><%- include('../partials/back-button', { fallback: '/admin' }) %><div><span class="eyebrow">COMMERCE</span><h1>Orders</h1><p>Search by order number or customer email, filter by status and review every fulfillment step.</p></div></section>
<section class="container section"><form class="admin-filters panel" method="get" action="/admin/orders"><div><label for="order-search">Search</label><input id="order-search" name="search" value="<%= search %>" maxlength="80" placeholder="Order # or customer email"></div><div><label for="order-status">Status</label><select id="order-status" name="status"><option value="">All statuses</option><% ['pending','paid','processing','shipped','completed','cancelled'].forEach(s=>{ %><option value="<%= s %>" <%= status===s?'selected':'' %>><%= s.charAt(0).toUpperCase()+s.slice(1) %></option><% }) %></select></div><button type="submit" class="btn btn-dark">Filter orders</button><a class="btn btn-light" href="/admin/orders">Reset</a></form></section>
<section class="container section section-topless"><div class="table-meta"><span><strong><%= total %></strong> matching orders</span><span>Page <%= page %></span></div><div class="panel table-wrap admin-orders-table-wrap" role="region" aria-label="Orders table. Scroll horizontally if needed." tabindex="0"><table class="admin-orders-table"><thead><tr><th scope="col">Order</th><th scope="col">Customer</th><th scope="col">Total</th><th scope="col">Status</th><th scope="col">Placed</th><th scope="col">Actions</th></tr></thead><tbody><% orders.forEach(o=>{ %><tr><td><span class="table-mobile-label">Order</span><a class="table-link" href="/admin/orders/<%= o.id %>">#<%= o.id %></a></td><td><span class="table-mobile-label">Customer</span><span class="admin-order-customer" dir="ltr"><%= o.email %></span></td><td><span class="table-mobile-label">Total</span><strong><%= formatPrice(o.total_cents,o.currency) %></strong></td><td><span class="table-mobile-label">Status</span><span class="status status-<%= o.status %>"><%= o.status %></span></td><td class="order-date-cell"><span class="table-mobile-label">Placed</span><time dir="ltr" datetime="<%= o.created_at %>" title="<%= formatDateTimeDisplay(o.created_at,storeTimeZone) %>"><strong><%= formatDateTimeDisplay(o.created_at,storeTimeZone) %></strong><small dir="auto"><%= formatRelativeTime(o.created_at) %></small></time></td><td><span class="table-mobile-label">Actions</span><a class="btn btn-dark btn-small order-manage-link" href="/admin/orders/<%= o.id %>">Manage order →</a></td></tr><% }) %><% if(!orders.length){ %><tr><td colspan="6"><div class="empty compact"><h3>No orders found.</h3><a href="/admin/orders" class="text-link">Clear filters →</a></div></td></tr><% } %></tbody></table></div>
<div class="pagination"><% if(hasPrev){ %><a class="btn btn-light btn-small" href="/admin/orders?page=<%= page-1 %>&search=<%= encodeURIComponent(search) %>&status=<%= encodeURIComponent(status) %>">← Previous</a><% } else { %><span></span><% } %><span>Page <strong><%= page %></strong></span><% if(hasNext){ %><a class="btn btn-dark btn-small" href="/admin/orders?page=<%= page+1 %>&search=<%= encodeURIComponent(search) %>&status=<%= encodeURIComponent(status) %>">Next →</a><% } else { %><span></span><% } %></div></section>
<%- include('../partials/footer',{managerWorkspaceShell:user?.role==='manager'}) %>