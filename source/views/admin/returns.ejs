<%
const returnRows=typeof returns!=='undefined'?returns:returnRequests;
const returnPage=typeof page==='number'?page:1;
const returnPageSize=typeof pageSize==='number'?pageSize:100;
const returnPages=typeof pages==='number'?Math.max(1,pages):1;
const returnTotal=typeof total==='number'?total:returnRows.length;
const pagerCopy={
 en:{label:'Return request pages',previous:'Previous',next:'Next',page:'Page',of:'of',shown:'shown'},
 nl:{label:'Pagina’s met retourverzoeken',previous:'Vorige',next:'Volgende',page:'Pagina',of:'van',shown:'weergegeven'},
 fr:{label:'Pages des demandes de retour',previous:'Précédente',next:'Suivante',page:'Page',of:'sur',shown:'affichées'},
 ar:{label:'صفحات طلبات الإرجاع',previous:'السابق',next:'التالي',page:'الصفحة',of:'من',shown:'معروضة'},
 ckb:{label:'پەڕەکانی داواکاریی گەڕاندنەوە',previous:'پێشوو',next:'دواتر',page:'پەڕە',of:'لە',shown:'پیشاندراو'}
}[locale]||{label:'Return request pages',previous:'Previous',next:'Next',page:'Page',of:'of',shown:'shown'};
%>
<%- include('../partials/header',{title:'Returns and refunds'}) %>
<%- include('../partials/admin-nav') %>
<section class="container page-head admin-head"><div><span class="eyebrow">AFTER-SALES</span><h1>Returns, exchanges &amp; refunds</h1><p>Review customer requests and record each fulfilment step.</p></div><a class="btn btn-light" href="/admin/orders">View orders →</a></section>
<section class="container section">
  <div class="alert" role="note"><strong>Important:</strong> recording a refund here is an audit record only. It does not move money, contact a bank, send a payment, or call a payment provider. Transfer the money through your actual payment method first, then record the amount, method and reference. Restock returned goods only after physically receiving and inspecting them.</div>
  <% if(resultMessage){ %><div class="alert" role="status"><%= resultMessage %></div><% } %>
  <div class="panel">
    <div class="panel-head"><div><span class="eyebrow">REQUEST QUEUE</span><h2>Customer requests</h2></div><span class="status"><%= returnRows.length %> <%= pagerCopy.of %> <%= returnTotal %> <%= pagerCopy.shown %></span></div>
    <form method="get" action="/admin/returns" class="form-two"><input type="hidden" name="pageSize" value="<%= returnPageSize %>"><label>Filter by status<select name="status"><option value="">All statuses</option><% [['requested','Requested'],['approved','Approved'],['item_received','Item received'],['exchange_sent','Replacement sent'],['refund_recorded','Refund recorded'],['completed','Completed'],['rejected','Rejected'],['cancelled','Cancelled']].forEach(([value,label])=>{ %><option value="<%= value %>" <%= status===value?'selected':'' %>><%= label %></option><% }) %></select></label><div class="form-actions"><button class="btn btn-dark" type="submit">Apply filter</button><a class="btn btn-light" href="/admin/returns">Reset</a></div></form>
  </div>
  <% if(!returnRows.length){ %><div class="panel empty"><h2>No return requests in this filter.</h2><p class="muted">Customer requests from delivered orders appear here.</p></div><% } %>
  <% returnRows.forEach(r=>{ const variant=[r.variant_value?`${r.variant_name||'Option'}: ${r.variant_value}`:'',r.variant_value_2?`${r.variant_name_2||'Option 2'}: ${r.variant_value_2}`:''].filter(Boolean).join(' · '); %>
    <article class="panel section-topless returns-request-card" aria-labelledby="return-title-<%= r.id %>">
      <div class="panel-head"><div><span class="eyebrow">RETURN REQUEST #<%= r.id %> · ORDER <a href="/admin/orders/<%= r.order_id %>">#<%= r.order_id %></a></span><h2 id="return-title-<%= r.id %>"><span translate="no" data-no-translate><%= r.product_name %><% if(variant){ %> <span class="muted">— <%= variant %></span><% } %></span></h2><p class="muted"><%= r.customer_email %> · <%= formatDateTimeDisplay(r.created_at,storeTimeZone) %></p></div><span class="status <%= ['rejected','cancelled'].includes(r.status)?'off':r.status==='completed'?'status-completed':'status-pending' %>"><%= locale==='nl'?({requested:'Aangevraagd',approved:'Goedgekeurd',item_received:'Artikel ontvangen',exchange_sent:'Vervangend artikel verzonden',refund_recorded:'Terugbetaling geregistreerd',completed:'Afgerond',rejected:'Afgewezen',cancelled:'Geannuleerd'}[r.status]||r.status.replaceAll('_',' ')):r.status.replaceAll('_',' ') %></span></div>
      <div class="summary-row"><span>Request type</span><strong><%= r.request_type %></strong></div><div class="summary-row"><span>Quantity</span><strong><%= r.quantity %> of <%= r.purchased_quantity %></strong></div><div class="summary-row"><span>Original item price</span><strong><%= formatPrice(r.unit_price_cents,r.currency) %> each</strong></div><div class="summary-row"><span>Order total</span><strong><%= formatPrice(r.total_cents,r.currency) %></strong></div>
      <div class="tip-box"><strong>Customer reason</strong><p><%= r.reason %></p></div>
      <% if(r.manager_note){ %><p class="muted"><strong>Latest staff note:</strong> <%= r.manager_note %></p><% } %>
      <% if(r.refund_recorded_at){ %><div class="tip-box"><strong>Refund record</strong><p><%= formatPrice(r.refund_amount_cents,r.currency) %> · <%= r.refund_method %><% if(r.refund_reference){ %> · <%= locale==='nl'?'Referentie:':'Reference:' %> <%= r.refund_reference %><% } %></p><p class="muted"><%= locale==='nl'?'Geregistreerd op ':'Recorded ' %><%= formatDateTimeDisplay(r.refund_recorded_at,storeTimeZone) %>. <%= locale==='nl'?'Controleer de daadwerkelijke overschrijving afzonderlijk.':'Verify the real transfer separately.' %></p></div><% } %>
      <% if(r.exchange_tracking_reference){ %><p class="muted"><strong>Replacement tracking/reference:</strong> <%= r.exchange_tracking_reference %><% if(r.exchange_shipped_at){ %> · <%= locale==='nl'?'Verzonden':'Sent' %> <%= formatDateTimeDisplay(r.exchange_shipped_at,storeTimeZone) %><% } %></p><% } %>
      <div class="rule"></div>
      <% if(r.status==='requested'){ %>
        <div class="form-two"><form method="post" action="/admin/returns/<%= r.id %>/action" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="approve"><label>Staff note (optional)<textarea name="managerNote" maxlength="500" rows="2"></textarea></label><button class="btn btn-dark" type="submit">Approve request</button></form><form method="post" action="/admin/returns/<%= r.id %>/action" class="form-stack" data-confirm="Reject this customer request?"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="reject"><label>Reason for rejection<textarea name="managerNote" maxlength="500" rows="2" required minlength="3"></textarea></label><button class="btn btn-danger" type="submit">Reject request</button></form></div>
      <% } else if(r.status==='approved' && ['return','exchange'].includes(r.request_type)){ %>
        <form method="post" action="/admin/returns/<%= r.id %>/action" class="form-stack" data-confirm="Only continue if you have physically received and inspected these items."><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="receive"><label>Inspection note<textarea name="managerNote" maxlength="500" rows="2"></textarea></label><label class="checkbox-inline"><input type="checkbox" name="restockReturnedItem"> Add <%= r.quantity %> unit(s) back to available stock (tick only if inspected and resalable)</label><button class="btn btn-dark" type="submit">Mark item received</button></form>
      <% } else if(r.status==='approved' && r.request_type==='refund'){ %>
        <form method="post" action="/admin/returns/<%= r.id %>/action" class="form-stack" data-confirm="Record this only after the refund has actually been sent to the customer."><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="record_refund"><div class="form-two"><label>Refund amount *<input name="refundAmount" type="number" inputmode="decimal" min="<%= formatMoneyInput(1,r.currency) %>" max="<%= formatMoneyInput(r.refund_max_cents||0,r.currency) %>" step="<%= formatMoneyInput(1,r.currency) %>" required><small class="field-note">Maximum for this request after the order discount: <%= formatPrice(r.refund_max_cents||0,r.currency) %></small></label><label>Actual method *<select name="refundMethod" required><option value="">Select method</option><option value="cash">Cash</option><option value="bank_transfer">Bank transfer</option><option value="other">Other</option></select></label></div><label>Transaction / receipt reference<input name="refundReference" maxlength="100"></label><label>Staff note<textarea name="managerNote" maxlength="500" rows="2"></textarea></label><button class="btn btn-dark" type="submit">Record completed refund</button></form>
      <% } else if(r.status==='item_received' && r.request_type==='return'){ %>
        <form method="post" action="/admin/returns/<%= r.id %>/action" class="form-stack" data-confirm="Record this only after the refund has actually been sent to the customer."><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="record_refund"><div class="form-two"><label>Refund amount *<input name="refundAmount" type="number" inputmode="decimal" min="<%= formatMoneyInput(1,r.currency) %>" max="<%= formatMoneyInput(r.refund_max_cents||0,r.currency) %>" step="<%= formatMoneyInput(1,r.currency) %>" required><small class="field-note">Maximum for this request after the order discount: <%= formatPrice(r.refund_max_cents||0,r.currency) %></small></label><label>Actual method *<select name="refundMethod" required><option value="">Select method</option><option value="cash">Cash</option><option value="bank_transfer">Bank transfer</option><option value="other">Other</option></select></label></div><label>Transaction / receipt reference<input name="refundReference" maxlength="100"></label><label>Staff note<textarea name="managerNote" maxlength="500" rows="2"></textarea></label><button class="btn btn-dark" type="submit">Record completed refund</button></form>
      <% } else if(r.status==='item_received' && r.request_type==='exchange'){ %>
        <p class="field-note"><%= ({en:'This replacement uses the same product and variant as the original order. Sending it deducts this quantity from available stock:',nl:'Deze vervanging gebruikt hetzelfde product en dezelfde variant als de oorspronkelijke bestelling. Bij verzending wordt dit aantal van de beschikbare voorraad afgeboekt:',fr:'Ce remplacement utilise le même produit et la même variante que la commande initiale. Son envoi déduit cette quantité du stock disponible :',ar:'يستخدم هذا الاستبدال المنتج والخيار نفسيهما في الطلب الأصلي. يؤدي إرساله إلى خصم هذه الكمية من المخزون المتاح:',ckb:'ئەم جێگرەوەیە هەمان بەرهەم و هەمان هەڵبژاردەی داواکاریی سەرەتایی بەکاردەهێنێت. ناردنی ئەم ژمارەیە لە کۆگای بەردەست کەم دەکاتەوە:'})[locale]||'This replacement uses the same product and variant as the original order. Sending it deducts this quantity from available stock:' %> <strong translate="no" data-no-translate><%= r.product_name %><% if(variant){ %> · <%= variant %><% } %> × <%= r.quantity %></strong></p>
        <form method="post" action="/admin/returns/<%= r.id %>/action" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="dispatch_exchange"><label>Replacement shipment / tracking reference *<input name="exchangeReference" maxlength="100" required minlength="3"></label><label>Staff note<textarea name="managerNote" maxlength="500" rows="2"></textarea></label><button class="btn btn-dark" type="submit">Mark replacement sent</button></form>
      <% } else if(r.status==='exchange_sent' && r.request_type==='exchange'){ %>
        <form method="post" action="/admin/returns/<%= r.id %>/action" class="form-stack" data-confirm="Confirm that the customer has received the replacement and close this exchange?"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="complete_exchange"><label>Final note<textarea name="managerNote" maxlength="500" rows="2"></textarea></label><button class="btn btn-dark" type="submit">Confirm delivered &amp; close exchange</button></form>
      <% } else { %><p class="muted">No further action is available for this status. Keep the original request and refund/shipping records for reconciliation.</p><% } %>
    </article>
  <% }) %>
  <nav class="pagination" aria-label="<%= pagerCopy.label %>">
    <% if(returnPage>1){ %><a class="btn btn-light btn-small" rel="prev" href="/admin/returns?page=<%= returnPage-1 %>&amp;pageSize=<%= returnPageSize %>&amp;status=<%= encodeURIComponent(status) %>"><%= pagerCopy.previous %></a><% } else { %><span></span><% } %>
    <span><%= pagerCopy.page %> <strong><%= returnPage %></strong> <%= pagerCopy.of %> <%= returnPages %></span>
    <% if(returnPage<returnPages){ %><a class="btn btn-dark btn-small" rel="next" href="/admin/returns?page=<%= returnPage+1 %>&amp;pageSize=<%= returnPageSize %>&amp;status=<%= encodeURIComponent(status) %>"><%= pagerCopy.next %></a><% } else { %><span></span><% } %>
  </nav>
</section>
<%- include('../partials/footer',{managerWorkspaceShell:user?.role==='manager'}) %>
