<%- include('../partials/header',{title:'Store settings'}) %>
<%- include('../partials/admin-nav') %>
<section class="container page-head admin-head">
  <%- include('../partials/back-button', { fallback: '/admin' }) %>
  <div><span class="eyebrow">SETUP & INTEGRATIONS</span><h1>Store settings</h1><p>Manage your market, business details, delivery, payment information and customer policies in one place. You can save these settings before adding products or buying stock. Incomplete launch requirements only keep checkout closed.</p></div>
  <span class="status <%= storeReady?'':'off' %>"><%= storeReady?'Checkout ready':(saved?'Draft saved · checkout not ready':'Checkout setup incomplete') %></span>
</section>
<% const policyDefs=[{key:'privacy',base:'privacyPolicy',label:'Privacy policy',max:12000},{key:'terms',base:'termsPolicy',label:'Terms & conditions',max:12000},{key:'shipping',base:'shippingPolicy',label:'Shipping policy',max:8000},{key:'returns',base:'returnsPolicy',label:'Returns / refunds policy',max:8000}]; const currencyNames={AED:'UAE dirham',EUR:'Euro',IQD:'Iraqi dinar',SYP:'Syrian pound',UAH:'Ukrainian hryvnia',USD:'US dollar',GBP:'Pound sterling',JPY:'Japanese yen',KWD:'Kuwaiti dinar',BHD:'Bahraini dinar',SAR:'Saudi riyal',QAR:'Qatari riyal',CAD:'Canadian dollar',AUD:'Australian dollar',CHF:'Swiss franc',INR:'Indian rupee',TRY:'Turkish lira'}; const validationTarget=(item)=>item.startsWith('store currency')?'#currency-field':item.startsWith('interface languages')?'#ui-languages-field':item.startsWith('support email')?'#support-email-field':item.startsWith('business phone')?'#business-phone-field':item.startsWith('payment mode')?'#payment-mode-field':item.startsWith('payment provider')?'#payment-provider-field':item.startsWith('legal merchant country')?'#merchant-country-field':item.startsWith('bank/payment-provider contact email')?'#bank-contact-email-field':item.startsWith('bank/payment-provider contact phone')?'#bank-contact-phone-field':item.startsWith('bank/payment-provider contact fields')?'#bank-contact-section':item.startsWith('bank transfer details')?'#bank-transfer-settings':item.startsWith('delivery fee')?'#delivery-fee-field':item.startsWith('delivery countries')?'#delivery-countries-field':item.startsWith('regional delivery rules')?'#shipping-rules-field':item.startsWith('regional tax rules')?'#tax-rules-field':item.startsWith('policy text')?'#customer-policies':'#store-settings-form'; const simplified=marketSetupMode==='simplified_cod' && launch?.marketSetupMode!=='standard'; const standardLaunchChecks=[['Store name',Boolean(storeName?.trim()),'#manager-business-identity'],['Legal / business name',Boolean(legalName?.trim()),'#manager-business-identity'],['Business address',Boolean(businessAddress?.trim()),'#manager-business-identity'],['Valid support email',/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(supportEmail||'')),'#manager-business-identity'],['Business phone',String(businessPhone||'').replace(/\D/g,'').length>=7,'#manager-business-identity'],['Business registration / licence number',Boolean(String(enterpriseNumber||'').trim()),'#manager-business-identity'],['Consumer pricing tax declaration',Boolean(pricesIncludeTax),'#manager-business-identity'],['Privacy policy (English, 40+ characters)',String(policies?.privacy?.en||'').trim().length>=40,'#customer-policies'],['Terms (English, 40+ characters)',String(policies?.terms?.en||'').trim().length>=40,'#customer-policies'],['Shipping policy (English, 40+ characters)',String(policies?.shipping?.en||'').trim().length>=40,'#customer-policies'],['Returns policy (English, 40+ characters)',String(policies?.returns?.en||'').trim().length>=40,'#customer-policies'],['At least one delivery country',Boolean(launch?.deliveryCountriesConfigured),'#manager-market-delivery'],['At least one in-stock product',Number(sellableProductCount)>0,'/admin/products'],['Cash-on-delivery checkout',paymentMode==='cash_on_delivery'||paymentMode==='cash_and_card','#checkout-payments']]; const simplifiedLaunchChecks=[['Store name',Boolean(storeName?.trim()),'#manager-business-identity'],['Business contact (email or phone)',Boolean(String(supportEmail||'').trim()||String(businessPhone||'').trim()),'#manager-business-identity'],['Customer terms (English, 20+ characters)',String(policies?.terms?.en||'').trim().length>=20,'#customer-policies'],['At least one delivery country',Boolean(launch?.deliveryCountriesConfigured),'#manager-market-delivery'],['At least one in-stock product',Number(sellableProductCount)>0,'/admin/products'],['Cash-on-delivery checkout',paymentMode==='cash_on_delivery'||paymentMode==='cash_and_card','#checkout-payments']]; if(currencyPriceReviewRequired){standardLaunchChecks.push(['Review product and coupon amounts after currency change',false,'/admin/products']); simplifiedLaunchChecks.push(['Review product and coupon amounts after currency change',false,'/admin/products']);} const standardMissingLaunchChecks=standardLaunchChecks.filter(([,complete])=>!complete); const simplifiedMissingLaunchChecks=simplifiedLaunchChecks.filter(([,complete])=>!complete); %>
<section class="container settings-checklist-wrap">
  <div class="settings-checklist" role="status" aria-live="polite">
    <span class="eyebrow">LAUNCH CHECK · affects checkout only, not saving settings</span>
    <strong>BEFORE CUSTOMERS CAN ORDER</strong>
    <p class="field-note">Complete the missing items below before opening checkout. A missing product, country or policy keeps checkout closed; it does not prevent saving a draft. You can save this page at any time; saving does not open checkout.</p>
    <div data-launch-check-profile="standard" <%= simplified?'hidden':'' %>>
      <strong><%= standardMissingLaunchChecks.length?'Complete these items before checkout opens':'All required setup items are complete. Review your local business and tax obligations separately.' %></strong>
      <% if(standardMissingLaunchChecks.length){ %><ul class="settings-checklist-items"><% standardMissingLaunchChecks.forEach(item=>{ %><li><span><%= item[0] %></span><a href="<%= item[2] %>"><%= item[2]==='/admin/products'?'Review products':'Open settings' %> →</a></li><% }) %></ul><% } %>
    </div>
    <div data-launch-check-profile="simplified_cod" <%= simplified?'':'hidden' %>>
      <strong><%= simplifiedMissingLaunchChecks.length?'Complete these items before checkout opens':'All required setup items are complete. Review your local business and tax obligations separately.' %></strong>
      <% if(simplifiedMissingLaunchChecks.length){ %><ul class="settings-checklist-items"><% simplifiedMissingLaunchChecks.forEach(item=>{ %><li><span><%= item[0] %></span><a href="<%= item[2] %>"><%= item[2]==='/admin/products'?'Review products':'Open settings' %> →</a></li><% }) %></ul><% } %>
    </div>
    <small>Saving a draft does not open checkout. Complete the items above when you are ready to accept orders, and review customer policies for every market and language you enable.</small>
  </div>
</section>
<section class="container form-page">
  <% if(typeof validationErrors!=='undefined'&&Array.isArray(validationErrors)&&validationErrors.length){ %>
  <section class="alert settings-validation-summary" role="alert" aria-labelledby="settings-validation-title">
    <div><strong id="settings-validation-title">Settings could not be saved yet</strong><p>Your entries are still shown in this form. Correct the items below and select Save settings again.</p></div>
    <ul><% validationErrors.forEach(item=>{ %><li><a href="<%= validationTarget(item) %>"><%= item %></a></li><% }) %></ul>
    <p>Incomplete business details and missing delivery coverage can remain as a draft. Invalid field formats must be corrected before ShopEasy can save this submission.</p>
  </section>
  <% } else if(error){ %><div class="alert settings-validation-summary" role="alert"><strong>Settings could not be saved.</strong><p><%= error %></p></div><% } %>
  <% if(typeof deliveryCountriesWarning!=='undefined'&&deliveryCountriesWarning){ %><div class="alert" role="alert"><strong>Settings saved, delivery countries not changed.</strong><p>The other valid settings were saved. Your previous delivery-country list was preserved because the submitted list was invalid. Enter up to 250 valid country names, one per line, then save again. If no previous list existed, checkout stays closed until you configure at least one country.</p></div><% } %>
  <% if(typeof shippingRulesReset!=='undefined'&&shippingRulesReset){ %><div class="alert" role="status"><strong>Regional delivery fees were reset.</strong><p>You changed the store currency. To prevent old-currency fees from being interpreted as new-currency amounts, regional delivery overrides were cleared. Enter fees in the new currency and save again. Percentage tax rules were preserved.</p></div><% } %>
  <% if(saved&&currencyChanged){ %><div class="success-alert" role="status">Settings saved successfully. The store currency changed. Product prices and money-based coupon amounts were adjusted to the new currency’s decimal precision, not converted at an exchange rate. Checkout is paused until you manually set real market prices, review all affected amounts and confirm below.</div><% } else if(saved&&storeReady){ %><div class="success-alert" role="status">Settings saved successfully. Checkout setup is complete.</div><% } else if(saved){ %><div class="success-alert" role="status">Draft saved successfully. The missing launch-check items (for example products or delivery countries) block checkout only; they do not prevent saving settings.</div><% } %>
  <p class="field-note">Fields marked * are required before checkout can open, not before you save a draft. The checklist above shows what is still missing.</p>
  <form id="store-settings-form" class="panel form-stack settings-form-v271" method="post" action="/admin/settings" data-settings-form>
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <input type="hidden" name="uiLanguagesSubmitted" value="1">
    <input type="hidden" name="bankTransferSettingsSubmitted" value="1">
    <div class="form-section"><span class="eyebrow">01 · MARKET SETUP</span><h2>Choose the checkout setup level.</h2>
      <p class="field-note" id="belgian-market-compliance" role="status" <%= marketSetupMode==='simplified_cod'&&launch?.marketSetupMode==='standard'?'':'hidden' %>><strong>Belgium delivery requires Standard checkout readiness.</strong> Even if Simplified COD remains selected, checkout will stay closed until business identity, contact details, tax declaration and all four customer policies are complete. Saving a draft is always allowed.</p>
      <label>Market setup profile *<select name="marketSetupMode" data-market-setup-mode-select required><option value="standard" <%= marketSetupMode==='standard'?'selected':'' %>>Standard / full setup</option><option value="simplified_cod" <%= marketSetupMode==='simplified_cod'?'selected':'' %>>Simplified local cash-on-delivery</option></select></label>
      <div class="settings-profile-preview" role="status" aria-live="polite">
        <strong data-market-setup-preview-title><%= simplified?'Preview: Simplified local cash-on-delivery':'Preview: Standard / full setup' %></strong>
        <p data-market-setup-summary="standard" <%= simplified?'hidden':'' %>>After you save, checkout stays closed until you complete the full business identity, valid contact details, registration/licence, tax declaration, all four English policies (40+ characters each), delivery countries, at least one in-stock product and any currency price review.</p>
        <p data-market-setup-summary="simplified_cod" <%= simplified?'':'hidden' %>>After you save, checkout stays closed until you set a store name, one valid business contact, English customer terms (20+ characters), delivery countries, at least one in-stock product and any currency price review. This profile does not remove legal or tax duties that apply to your business.</p>
        <p class="field-note">This is a preview only. The selected profile takes effect after you save settings. It changes checkout readiness, not legal advice or the store payment method.</p>
      </div>
      <p class="field-note" data-profile-copy="standard" <%= simplified?'hidden':'' %>><strong>Standard / full:</strong> requires business identity, tax declaration and all English customer policies before orders are accepted.</p>
      <p class="field-note" data-profile-copy="simplified_cod" <%= simplified?'':'hidden' %>><strong>Simplified local COD:</strong> requires a store name, one business contact, delivery coverage, a simple English customer-terms text and an in-stock product. It does not mean local legal or tax duties disappear. Use this profile only when it matches your business model, after checking the local rules that apply to your store.</p>
    </div>
    <div class="form-section language-preferences-section"><span class="eyebrow">02 · STOREFRONT LANGUAGE</span><h2>Choose the default language and available languages</h2>
      <p class="field-note">The default language appears when a visitor opens the shop for the first time. Visitors can switch only to languages you enable here. A visitor’s saved language choice is remembered until it is disabled or changed.</p>
      <label>Default storefront language *<select name="uiDefaultLocale" required><% (uiLocaleOptions||[]).forEach(option=>{ %><option value="<%= option.code %>" <%= uiDefaultLocale===option.code?'selected':'' %>><%= option.label %> — <%= option.nativeLabel %></option><% }) %></select></label>
      <fieldset class="language-enable-list" id="ui-languages-field"><legend>Languages customers can choose *</legend>
        <% (uiLocaleOptions||[]).forEach(option=>{ %><label class="checkbox-inline"><input type="checkbox" name="enabledUiLocales" value="<%= option.code %>" <%= (uiEnabledLocales||[]).includes(option.code)?'checked':'' %>> <span><strong><%= option.label %></strong> · <span lang="<%= option.code %>" dir="<%= option.dir %>"><%= option.nativeLabel %></span></span></label><% }) %>
      </fieldset>
      <p class="field-note">At least one language must remain enabled. The default language must also be enabled. Sorani and Arabic use right-to-left layout; English, Dutch and French use left-to-right layout. Dutch storefront copy is translated, but market-specific legal policies still need to be entered and reviewed by the store owner.</p>
    </div>
    <div class="form-section" id="manager-business-identity"><span class="eyebrow">03 · BUSINESS IDENTITY</span><h2>Who operates this store?</h2>
      <p class="field-note">The public store name and brand text are managed in <a href="/admin/branding">Storefront settings</a> or <a href="/admin/appearance">Design studio</a>. Keep that name consistent with your business identity here.</p>
      <label>Legal / business name <span data-profile-required-indicator="standard" <%= simplified?'hidden':'' %>>*</span><input name="legalName" maxlength="160" value="<%= legalName %>"></label>
      <label>Business address <span data-profile-required-indicator="standard" <%= simplified?'hidden':'' %>>*</span><input name="businessAddress" maxlength="500" value="<%= businessAddress %>"></label>
      <div class="form-two"><label id="support-email-field">Support email <span data-profile-required-indicator="standard" <%= simplified?'hidden':'' %>>*</span><input type="email" name="supportEmail" maxlength="160" value="<%= supportEmail %>" autocomplete="email"></label><label id="business-phone-field">Business phone <span data-profile-required-indicator="standard" <%= simplified?'hidden':'' %>>*</span><input name="businessPhone" maxlength="40" value="<%= businessPhone %>" autocomplete="tel"><span class="field-note">Include the international calling code if customers may be abroad.</span></label></div>
      <div class="form-two"><label>Business registration / licence number <span data-profile-required-indicator="standard" <%= simplified?'hidden':'' %>>*</span><input name="enterpriseNumber" maxlength="80" value="<%= enterpriseNumber %>"><span class="field-note">Enter the legal company registration or licence identifier required in your market. Do not enter fake data to pass the launch check.</span></label><label>Tax / VAT number (if applicable)<input name="vatNumber" maxlength="80" value="<%= vatNumber %>"><span class="field-note">Use the format assigned by your local tax authority.</span></label></div>
      <label class="checkbox-inline"><input type="checkbox" name="pricesIncludeTax" <%= pricesIncludeTax?'checked':'' %>> Consumer prices include the applicable taxes for this store's market <span data-profile-required-indicator="standard" <%= simplified?'hidden':'' %>>*</span><span data-profile-copy="simplified_cod" <%= simplified?'':'hidden' %>>(optional here)</span></label>
      <p class="field-note">This checkbox describes how you price consumer-facing products. It does not set a tax rate. Regional tax rules below only calculate the percentage you enter for matching destinations; they do not discover legal rates, handle every tax category, or certify compliance. Enter shipping fees inclusive of tax when this option is on and the matching rule taxes shipping.</p>
    </div>
    <% if(currencyPriceReviewRequired){ %><div class="alert" role="group"><strong>Currency amount review required</strong><p>Checkout is disabled until you review the new-currency amounts. Check every active and archived product’s regular price, purchase cost and sale price, plus fixed coupon values and coupon minimums. Correct them for your market before confirming below.</p><label class="checkbox-inline"><input type="checkbox" name="confirmCurrencyPriceReview" value="on" <%= confirmCurrencyPriceReview?'checked':'' %>> I reviewed the product prices in this store currency and confirm they are correct.</label></div><% } %>
    <div class="form-section" id="manager-market-delivery"><span class="eyebrow">04 · CURRENCY & DELIVERY</span><h2>Choose one currency for this store</h2>
      <label id="currency-field">Store currency *<select name="currency" data-store-currency-select data-original-currency="<%= storedCurrency %>" data-has-currency-data="<%= Number(currencyProductCount)>0||Number(currencyCouponCount)>0?'1':'0' %>" required aria-describedby="currency-note"><% (availableCurrencies||['EUR']).forEach(code=>{ %><option value="<%= code %>" <%= String(currency).toUpperCase()===code?'selected':'' %>><%= code %><%= currencyNames[code]?' — '+currencyNames[code]:'' %></option><% }) %></select><span id="currency-note" class="field-note">One store-wide currency, such as IQD (Iraqi dinar), SYP, EUR or USD. This is not multi-currency conversion.</span></label>
      <div class="alert" role="note">
        <p>You can change the store currency after adding products. This adjusts stored decimal precision only; it does not apply an exchange rate. If products or money-based coupons exist, Save adjusts their stored amounts and pauses checkout until you correct the prices for your market.</p>
        <% if(Number(currencyOrderCount)>0){ %><p><strong>Existing order currencies:</strong> <%= (currencyOrderCurrencies||[]).map(item=>`${item.currency} (${item.count})`).join(', ') %>.</p><p>Store currency must match every historical order currency; historic totals are never converted.</p><% if((currencyOrderCurrencies||[]).length>1){ %><p class="field-note">This order history contains multiple currencies; store currency cannot be changed safely.</p><% } else { %><p class="field-note">Choose <strong><%= currencyOrderCurrencies?.[0]?.currency||storedCurrency %></strong> to align the store setting with the currency already recorded on these orders. If product or coupon prices exist, checkout remains paused until you review those amounts.</p><% } %><% } %>
      </div>
      <div id="currency-product-review" class="alert" role="group" <%= (Number(currencyProductCount)>0||Number(currencyCouponCount)>0||currencyChangeNeedsReview)?'':'hidden' %>>
        <strong>Currency change: prices need manual review.</strong>
        <p>You can save the new currency even when products or money-based coupons already exist. ShopEasy adjusts their stored amounts only to the target currency’s decimal precision; it does not apply an exchange rate. For example, EUR 89.00 is scaled to IQD 89.000 for storage precision only, not a market-converted Iraqi dinar price. Save succeeds, but checkout is paused until you edit and verify every active and archived product price, purchase cost, sale price, fixed coupon values and coupon minimum-order amounts. Enter your real market prices before confirming below.</p>
      </div>
      <label id="delivery-fee-field">Delivery fee per order<input data-store-shipping-fee name="shippingFee" inputmode="decimal" min="0" step="<%= formatMoneyInput(1,currency) %>" required value="<%= formatMoneyInput(shippingFeeCents,currency) %>"><span class="field-note">Added once to the entire order, not per product. Enter 0 for free delivery. When changing currency, the field resets to 0 so you can enter a valid fee in the new currency.</span></label>
      <label id="delivery-countries-field">Countries where you actually deliver *<textarea name="deliveryCountries" rows="4" maxlength="5000" aria-describedby="delivery-countries-note" placeholder="Country A&#10;Country B"><%= deliveryCountries||'' %></textarea><span id="delivery-countries-note" class="field-note">Enter up to 250 valid country names, one per line. Only listed countries are offered at checkout, and the server rejects orders for every other country. List a country only when you can fulfil and collect cash there. The country list is the outer allow-list; use the regional delivery rules below for cities and postal-code areas.</span></label>
      <label id="shipping-rules-field">Regional delivery fee overrides <textarea name="shippingZoneRules" rows="5" maxlength="25000" dir="ltr" placeholder="Country A | City A | * | 5.00&#10;Country A | * | 10 | 3.00"><%= shippingZoneRules||'' %></textarea><span class="field-note">Optional, maximum 250 lines. Format exactly: <code>Country | City or * | Postal prefix or * | Fee</code>. Example: <code>Country A | City A | * | 5.00</code>. Use the store currency. A more specific matching rule wins. If none matches, the standard delivery fee above applies. Changing currency clears these fee overrides to prevent accidental mispricing.</span></label>
      <label id="tax-rules-field">Regional VAT / sales-tax rules <textarea name="taxRules" rows="5" maxlength="25000" dir="ltr" placeholder="Country A | * | * | 0 | no"><%= taxRules||'' %></textarea><span class="field-note">Optional, maximum 250 lines. Format exactly: <code>Country | City or * | Postal prefix or * | Rate % | Tax shipping (yes/no)</code>. Rates must be entered and checked by the store owner; <code>0</code> is a rate and must be entered explicitly when appropriate. Once any tax rule is configured, checkout blocks a destination without a matching rule. All products use the same configured rate: product-specific exemptions, thresholds, multiple taxes, tax registration and filing are not implemented.</span></label>
    </div>
    <div class="form-section payment-settings-section" id="checkout-payments"><span class="eyebrow">05 · PAYMENTS, BANK CONTACT & CUSTOMER EMAIL</span><h2>Payment methods and provider setup</h2>
      <p class="field-note">Cash on delivery is the safe default. Card checkout appears to customers only when a provider adapter is implemented and every eligibility/configuration check passes. Selecting a provider here does not create an account or activate it with that company.</p>
      <div class="form-two">
        <label id="payment-mode-field">Checkout methods<select name="paymentMode" required><option value="cash_on_delivery" <%= paymentMode==='cash_on_delivery'?'selected':'' %>>Cash on delivery only</option><option value="cash_and_card" <%= paymentMode==='cash_and_card'?'selected':'' %>>Cash on delivery + card (only if ready)</option></select><span class="field-note">Choose COD only for now if you are not ready to accept card payments. Card can never replace COD as the sole option in this version.</span></label>
        <label id="payment-provider-field">Payment provider<select name="paymentProvider" required><option value="none" <%= paymentProvider==='none'?'selected':'' %>>Not selected</option><% (paymentProviders||[]).forEach(provider=>{ %><option value="<%= provider.id %>" <%= paymentProvider===provider.id?'selected':'' %>><%= provider.name %><%= provider.integrated?' — adapter available':' — contact/onboarding only' %></option><% }) %></select><span class="field-note">Only Mollie has an implemented hosted card adapter in this build. PayTabs, FIB, iyzico, ZainCash and Stripe are listed for official contact/onboarding only; their transactions remain disabled.</span></label>
      </div>
      <label id="merchant-country-field">Legal country where the merchant/business is registered<select name="paymentMerchantCountry"><% (merchantCountries||[]).forEach(country=>{ %><option value="<%= country.code %>" <%= paymentMerchantCountry===country.code?'selected':'' %>><%= country.label %></option><% }) %></select><span class="field-note">This must be your real legal business country, not the customer’s delivery country. Never choose a different country to bypass provider rules. If you are currently in Syria but legally registered elsewhere, enter that country only if the registration and payout account genuinely qualify.</span></label>
      <% if(paymentMerchantCountry==='SY'){ %><div class="alert" role="alert"><strong>Card provider eligibility needs special care.</strong><p>Mollie’s published merchant-country list does not include Syria and Stripe prohibits direct or indirect dealings involving Syria. Keep COD active unless a regulated provider explicitly confirms your actual legal business and settlement setup in writing.</p></div><% } %>
      <div class="payment-readiness <%= paymentStatus?.checkoutCardEnabled?'is-ready':'is-blocked' %>" role="status"><span class="payment-readiness-dot" aria-hidden="true"></span><div><strong><%= paymentStatus?.checkoutCardEnabled?'Card checkout configuration checks passed':'Card checkout is not active' %></strong><p><%= paymentStatus?.message||'Cash on delivery remains the only active method.' %></p><p class="field-note">Mollie API key: <%= paymentStatus?.checks?.apiKeyConfigured?'configured for this environment':'not configured or invalid' %> · Public HTTPS URL: <%= paymentStatus?.checks?.publicHttpsUrlConfigured?'valid':'missing/invalid' %> · Merchant country: <%= paymentStatus?.checks?.supportedMerchantCountry?'supported by Mollie':'not confirmed as supported for the selected provider' %> · Currency: <%= paymentStatus?.checks?.supportedCurrency?'in the supported card-currency list':'not supported by the selected card adapter' %></p></div></div>
      <p class="field-note">Do not paste API keys or bank login credentials into this page. For the Mollie adapter, set <code>MOLLIE_API_KEY</code> in the server’s private environment and set <code>BASE_URL</code> to the public HTTPS origin. Use a test API key and complete sandbox checks before considering live keys. A local <code>localhost</code> URL cannot receive provider webhooks. Test keys keep card checkout off unless this is a non-production staging environment and <code>MOLLIE_TEST_CHECKOUT_ENABLED=true</code>; real card payments require <code>NODE_ENV=production</code> and a live key.</p>
      <div class="payment-provider-directory"><div class="panel-head"><div><span class="eyebrow">OFFICIAL PROVIDER DIRECTORY</span><h3>Onboarding, bank settlement and support</h3></div></div>
        <p class="field-note">These are verified official pages, not invented telephone numbers or personal contacts. Confirm merchant-country eligibility, fees, card currencies, settlement bank requirements, chargeback handling and legal documentation directly with the provider before signing up.</p>
        <div class="payment-provider-grid">
          <% (paymentProviders||[]).forEach(provider=>{ %><article class="payment-provider-card"><div class="payment-provider-title"><strong><%= provider.name %></strong><span class="status <%= provider.integrated?'status-active':'status-pending' %>"><%= provider.integrated?'Hosted adapter in code':'Onboarding only' %></span></div><p><%= provider.region %> · <%= provider.kind %></p><% if(provider.contactInfo){ %><p class="provider-contact-info"><strong>Official public contact:</strong> <%= provider.contactInfo %></p><% } %><% if(provider.contactEmail||provider.contactPhone){ %><div class="provider-direct-contacts" role="group" aria-label="<%= provider.name %> direct public contacts"><strong>Direct contact</strong><div><% if(provider.contactEmail){ %><a href="mailto:<%= provider.contactEmail %>">Email <%= provider.contactEmail %></a><% } %><% if(provider.contactPhone){ %><a href="tel:<%= String(provider.contactPhone).replace(/[^+0-9]/g,'') %>"><%= provider.contactPhoneLabel||provider.contactPhone %></a><% } %></div></div><% } %><p><%= provider.note %></p><div class="payment-provider-links"><a href="<%= provider.onboardingUrl %>" target="_blank" rel="noopener noreferrer">Official onboarding</a><a href="<%= provider.supportUrl %>" target="_blank" rel="noopener noreferrer">Support / contact</a><a href="<%= provider.docsUrl %>" target="_blank" rel="noopener noreferrer">Technical documentation</a></div></article><% }) %>
        </div>
      </div>
      <div class="form-section" id="bank-transfer-settings"><span class="eyebrow">CUSTOMER PAYMENT · MANUAL BANK TRANSFER</span><h3>Bank transfer details shown to customers</h3>
        <p class="field-note">This enables a manual bank transfer option. ShopEasy does not connect to your bank and cannot detect incoming transfers automatically. IBAN country length and MOD-97 check digits are checked, but national BBAN character rules are not fully validated and this does not prove that the account exists or belongs to you. A local account number receives only a basic format check. Independently confirm the exact beneficiary and account with your bank before enabling this method. Customers receive a unique order reference; a Manager must verify the real bank statement and exact amount before marking the order paid. Never enter online-banking passwords or card details.</p>
        <label class="checkbox-inline"><input type="checkbox" name="bankTransferEnabled" <%= bankTransferEnabled?'checked':'' %>> Enable bank transfer only after you have independently checked the account details with your bank</label>
        <div class="form-two"><label>Bank name<input name="bankTransferBankName" maxlength="100" value="<%= bankTransferBankName||'' %>" autocomplete="off" placeholder="Bank name"></label><label>Account holder / beneficiary<input name="bankTransferAccountHolder" maxlength="120" value="<%= bankTransferAccountHolder||'' %>" autocomplete="off" placeholder="Legal account holder"></label></div>
        <div class="form-two"><label>IBAN or local bank account number<input name="bankTransferAccount" maxlength="40" value="<%= bankTransferAccount||'' %>" autocomplete="off" spellcheck="false" placeholder="IBAN or local account number"></label><label>BIC / SWIFT (optional)<input name="bankTransferBic" maxlength="11" value="<%= bankTransferBic||'' %>" autocomplete="off" spellcheck="false" placeholder="8 or 11 characters"></label></div>
        <label>Additional payment instructions (optional)<textarea name="bankTransferInstructions" rows="3" maxlength="500" placeholder="Tell customers when to transfer or how to contact the store."><%= bankTransferInstructions||'' %></textarea></label>
        <div class="integration <%= bankTransferReady?'highlight':'' %>"><div><strong><%= bankTransferReady?'Bank transfer details pass format checks':'Bank transfer is not ready' %></strong><span><%= bankTransferReady?'Customers can select bank transfer at checkout. Each order stores a snapshot of these details. You must still confirm the account and beneficiary with your bank.':'Enter a bank name, account holder and an IBAN or local account number in the accepted format before enabling this method.' %></span></div></div>
      </div>
      <div class="form-section bank-contact-section" id="bank-contact-section"><span class="eyebrow">PRIVATE MANAGER NOTES</span><h3>Bank / payment-provider contact for this store</h3><p class="field-note">These optional fields are internal Manager notes for the bank or provider representative handling your merchant application. They are stored in the store settings and are not displayed to customers. Do not enter account passwords, card numbers, CVV, API secrets or online-banking credentials.</p>
        <div class="form-two"><label>Contact person / account manager<input name="bankContactName" maxlength="120" autocomplete="off" value="<%= bankContactName||'' %>" placeholder="Name of your bank/provider contact"></label><label id="bank-contact-email-field">Work email<input type="email" name="bankContactEmail" maxlength="160" autocomplete="off" value="<%= bankContactEmail||'' %>" placeholder="representative@example.com"></label></div>
        <div class="form-two"><label id="bank-contact-phone-field">Direct business phone<input name="bankContactPhone" maxlength="40" autocomplete="off" value="<%= bankContactPhone||'' %>" placeholder="Include country calling code"></label><label>Merchant / application reference<input name="bankContactReference" maxlength="120" autocomplete="off" value="<%= bankContactReference||'' %>" placeholder="Application ID or account reference"></label></div>
      </div>
      <div class="integration"><div><strong><%= emailEnabled?'Password-recovery email configured':'Password-recovery email not configured' %></strong><span><%= emailEnabled?'The configured provider sends six-digit account recovery codes only.':'Only six-digit password recovery codes are supported. Password recovery codes will not be sent until a provider and verified sender are configured.' %></span></div></div>
      <p class="field-note">No automatic order-confirmation email, shipping email or manager notification is sent unless those separate features are configured and verified.</p>
    </div>
    <div class="form-section"><span class="eyebrow">06 · OPTIONAL AI</span><h2>AI shopping assistant</h2>
      <div class="integration highlight"><div><strong><%= aiEnabled?'AI is ON':'AI is OFF' %></strong><span><%= aiEnabled?'The assistant is available only when the server provider is configured.':'The shop works without AI.' %></span></div><label class="switch"><input type="checkbox" name="aiEnabled" <%= aiEnabled?'checked':'' %>><span class="switch-ui" aria-hidden="true"></span><span>Enable AI</span></label></div>
      <p class="field-note"><% if(locale==='nl'){ %>Wanneer AI is ingeschakeld en op de server is geconfigureerd, kan ShopEasy zoektermen uitbreiden en de winkelassistent aandrijven. Voor zoekuitbreiding wordt de zoektekst (maximaal 80 tekens) en interfacetaal naar de externe AI-provider gestuurd. De winkelassistent ontvangt daarnaast de vraag (maximaal 500 tekens) en maximaal 12 openbare productvelden: naam, omschrijving, actuele verkoopprijs met winkelvaluta, verkoopbare voorraad na reserveringen en productslug. Duidelijke e-mailadressen, telefoonnummers, IBAN-achtige waarden en herkenbare straatadressen worden vóór verzending verwijderd, maar dit herkent niet alle persoonlijke gegevens. Deel daarom nooit namen, adressen, contactgegevens, rekeningnummers, bestelgegevens, wachtwoorden of betaalgegevens. De externe AI-provider verwerkt verzonden tekst volgens zijn eigen voorwaarden en bewaartermijn. ShopEasy voegt geen klantaccounts, klantadressen, bestellingen of betaalgegevens toe. Zoekresultaten komen uit echte actieve producten in je database. Als AI niet beschikbaar is, blijft normaal zoeken werken.<% } else if(locale==='ckb'){ %>کاتێک AI چالاک و لە سێرڤەر ڕێکخراو بێت، ShopEasy دەتوانێت وشەی گەڕان فراوان بکات و یارمەتیدەری کڕین بەکاربهێنێت. بۆ فراوانکردنی گەڕان، دەقی گەڕان (تا ٨٠ پیت) و زمانی ڕووکاری بۆ دابینکەری دەرەکی AI دەنێردرێت. یارمەتیدەری کڕین هەروەها پرسیارەکە (تا ٥٠٠ پیت) و زۆرترین ١٢ خانەی گشتیی بەرهەم وەردەگرێت: ناو، وەسف، نرخی فرۆشتنی ئێستا بە دراوی فرۆشگا، بڕی فرۆشتنی بەردەست دوای لەبەرگرتنەوە و بەستەری بەرهەم. ئیمەیڵی ئاشکرا، ژمارەی تەلەفۆن، IBAN ـی هاوشێوە و ناونیشانی شەقامی ئاشکرا پێش ناردن دەسڕدرێنەوە، بەڵام هەموو زانیارییە کەسییەکان ناناسێتەوە. بۆیە ناو، ناونیشان، زانیاریی پەیوەندی، ژمارەی هەژمار، وردەکاریی داواکاری، وشەی نهێنی یان زانیاریی پارەدان مەنووسە. دابینکەری دەرەکی AI دەقە نێردراوەکان بە پێی مەرج و ماوەی هەڵگرتنی خۆی پرۆسێس دەکات. ShopEasy زانیاریی هەژمار، ناونیشانی کڕیار، داواکاری یان پارەدان زیاد ناکات. ئەنجامەکانی گەڕان لە بەرهەمە چالاکە ڕاستەقینەکانی بنکەدراوە وەردەگیرێن و ئەگەر AI بەردەست نەبوو، گەڕانی ئاسایی کار دەکات.<% } else if(locale==='ar'){ %>عند تفعيل الذكاء الاصطناعي وإعداده على الخادم، يمكن لـ ShopEasy توسيع عبارات البحث وتشغيل مساعد التسوق. يُرسل نص البحث (حتى 80 حرفًا) ولغة الواجهة إلى مزود الذكاء الاصطناعي الخارجي. ويتلقى مساعد التسوق أيضًا سؤال العميل (حتى 500 حرف) وما يصل إلى 12 حقلًا عامًا للمنتجات: الاسم والوصف وسعر البيع الحالي بعملة المتجر والكمية المتاحة للبيع بعد الحجوزات ومعرّف المنتج. تُزال عناوين البريد الواضحة وأرقام الهواتف والقيم الشبيهة بـ IBAN وعناوين الشوارع التي يمكن التعرف عليها قبل الإرسال، لكن لا يمكن اكتشاف كل البيانات الشخصية تلقائيًا. لذلك لا تكتب أسماء أو عناوين أو معلومات اتصال أو أرقام حسابات أو تفاصيل طلبات أو كلمات مرور أو بيانات دفع. يعالج مزود الذكاء الاصطناعي الخارجي النص المرسل وفق شروطه وفترة الاحتفاظ الخاصة به. لا يضيف ShopEasy حسابات العملاء أو عناوينهم أو طلباتهم أو بيانات الدفع. تأتي نتائج البحث من المنتجات النشطة الفعلية في قاعدة البيانات، ويظل البحث العادي متاحًا عند تعذر الذكاء الاصطناعي.<% } else if(locale==='fr'){ %>Lorsque l’IA est activée et configurée sur le serveur, ShopEasy peut enrichir les termes de recherche et proposer un assistant d’achat. L’enrichissement transmet le texte recherché (80 caractères au maximum) et la langue de l’interface au fournisseur externe d’IA. L’assistant reçoit également la question du client (500 caractères au maximum) ainsi que 12 champs publics au maximum : nom et description du produit, prix actuel dans la devise de la boutique, stock disponible après réservations et identifiant public du produit. Les adresses e-mail, numéros de téléphone, valeurs ressemblant à un IBAN et adresses postales facilement reconnaissables sont retirés avant l’envoi, mais les données personnelles ne peuvent pas toutes être détectées automatiquement. Ne transmettez jamais de noms, adresses, coordonnées, numéros de compte, détails de commandes, mots de passe ou informations de paiement. Le fournisseur externe traite le texte envoyé selon ses propres conditions et durées de conservation. ShopEasy ne lui transmet pas les comptes clients, adresses, commandes ou données de paiement. Les résultats proviennent des produits actifs de la base de données ; la recherche classique reste disponible si l’IA est indisponible.<% } else { %>When enabled and configured on the server, ShopEasy can expand search phrases and power the shopping assistant. Search expansion sends the search text (up to 80 characters) and interface locale to the external AI provider. The shopping assistant also receives the customer's question (up to 500 characters) and up to 12 public product fields: name, description, current selling price in the store currency, sellable stock after reservations and product slug. Obvious email addresses, phone numbers, IBAN-like values and recognizable street addresses are removed before sending, but not all personal information can be detected automatically. Never enter names, addresses, contact details, account numbers, order details, passwords or payment data. The external AI provider processes submitted text under its own terms and retention policy. ShopEasy does not add customer accounts, addresses, orders or payment details. Search results come from real active products in your database; normal search remains available if AI is unavailable.<% } %> Put AI_BASE_URL, AI_MODEL and AI_API_KEY in server environment secrets, never in the browser, HTML, or this form.</p>
    </div>
    <div class="form-section" id="optional-storefront-features"><span class="eyebrow">OPTIONAL STOREFRONT FEATURES</span><h2>Switch optional features on or off</h2>
      <input type="hidden" name="optionalFeaturesSubmitted" value="1">
      <p class="field-note">Disable a feature for this store without deleting customer data or removing the underlying code. Existing saved wishlists and stories remain stored and can be shown again if re-enabled. Product search, checkout, and order history always remain available.</p>
      <label class="checkbox-inline"><input type="checkbox" name="featureStoriesEnabled" <%= featureStoriesEnabled?'checked':'' %>> Show Stories to customers</label>
      <label class="checkbox-inline"><input type="checkbox" name="featureWishlistEnabled" <%= featureWishlistEnabled?'checked':'' %>> Enable wishlist and saved-product buttons</label>
      <label class="checkbox-inline"><input type="checkbox" name="featureAutocompleteEnabled" <%= featureAutocompleteEnabled?'checked':'' %>> Offer product search suggestions (normal search always works)</label>
      <label class="checkbox-inline"><input type="checkbox" name="featureRelatedProductsEnabled" <%= featureRelatedProductsEnabled?'checked':'' %>> Show related products on product pages</label>
      <p class="field-note">AI has a separate switch above and also requires the server operator to configure the provider safely. The toggles do not add third-party services, cost, or analytics.</p>
    </div>
    <div class="form-section" id="customer-policies"><span class="eyebrow">07 · CUSTOMER POLICIES</span><h2>Provide policy text per language</h2>
      <p class="field-note" data-profile-copy="simplified_cod" <%= simplified?'':'hidden' %>>In the simplified profile, only English customer terms are needed to open COD checkout. Privacy, shipping and returns text can be added later. Any text you publish should match your real business practices and local requirements.</p><p class="field-note" data-profile-copy="standard" <%= simplified?'hidden':'' %>><% if(locale==='nl'){ %>Engelse beleidsteksten zijn vereist om de winkel volledig te kunnen activeren. Nederlandse, Sorani- en Arabische vertalingen zijn optioneel. Als een vertaling ontbreekt, krijgen klanten duidelijk te zien dat de Engelse versie wordt getoond. Gebruik geen automatische vertaling die niet door een persoon is nagelezen als definitieve juridische tekst.<% } else if(locale==='ckb'){ %>بۆ تەواوکردنی پشکنینی دەستپێکردنی فرۆشگا، دەقی ئینگلیزی پێویستە. وەرگێڕانی سۆرانی، عەرەبی و هۆڵەندی ئارەزوومەندانەن. ئەگەر وەرگێڕانێک نەبێت، بە ڕوونی بە کڕیار دەگوترێت کە وەشانی ئینگلیزی پیشان دەدرێت. دەقی یاساییی بە وەرگێڕانی ئۆتۆماتیکیی بێ پێداچوونەوە وەک دەقی کۆتایی بەکارمەهێنە.<% } else if(locale==='ar'){ %>النصوص الإنجليزية للسياسات مطلوبة لاستكمال فحص جاهزية المتجر. الترجمات إلى الهولندية والسورانية والعربية اختيارية. إذا لم تتوفر ترجمة، فسيظهر للعميل إشعار واضح بأن النسخة الإنجليزية معروضة. لا تستخدم ترجمة آلية غير مراجعة كنص قانوني نهائي.<% } else { %>English policy text is required for the full store launch check. Dutch, Sorani and Arabic translations are optional. If a translation is missing, customers are clearly told that the English version is shown. Do not use an unreviewed machine translation as final legal text.<% } %></p>
      <% policyLocales.forEach(locale=>{ %>
        <details class="form-options" <%= locale.code==='en'?'open':'' %> dir="<%= locale.dir %>">
          <summary><strong><%= locale.label %></strong><span data-policy-summary="standard" <%= locale.code==='en'&&!simplified?'':'hidden' %>>Required for launch</span><span data-policy-summary="simplified_cod" <%= locale.code==='en'&&simplified?'':'hidden' %>>Terms required; other English policies optional</span><span data-policy-summary="translations" <%= locale.code==='en'?'hidden':'' %>>Optional translation; review locally</span></summary>
          <div class="form-options-content">
            <% policyDefs.forEach(def=>{ const name=locale.code==='en'?def.base:def.base+(locale.code==='ckb'?'Ckb':locale.code==='nl'?'Nl':locale.code==='fr'?'Fr':'Ar'); %>
              <% const policyRequired=locale.code==='en'&&(simplified?def.key==='terms':true); const policyMin=locale.code==='en'?(simplified&&def.key==='terms'?20:40):0; %><label><%= def.label %> <% if(locale.code==='en'){ %><span data-profile-required-indicator="standard" <%= simplified?'hidden':'' %>>*</span><% if(def.key==='terms'){ %><span data-profile-required-indicator="simplified_cod" <%= simplified?'':'hidden' %>>*</span><% } %><% } %><textarea name="<%= name %>" maxlength="<%= def.max %>" rows="<%= def.key==='returns'?7:9 %>" dir="<%= locale.dir %>" placeholder="<%= locale.code==='en'?'Write the approved text for this store and market.':locale.code==='nl'?'Vul de goedgekeurde tekst voor deze winkel en markt in.':'Add a complete, reviewed translation. Leave empty when you do not need this translation yet.' %>"><%= policies?.[def.key]?.[locale.code]||'' %></textarea><% if(locale.code==='en'){ %><span class="field-note" data-policy-note="standard" <%= simplified?'hidden':'' %>>At least 40 characters.</span><span class="field-note" data-policy-note="simplified_cod" <%= simplified?'':'hidden' %>><%= def.key==='terms'?'At least 20 characters.':'Optional in the simplified setup.' %></span><% } else { %><span class="field-note">Optional translation; leave empty if not needed yet.</span><% } %></label>
            <% }) %>
          </div>
        </details>
      <% }) %>
    </div>
    <div class="settings-save-dock" data-settings-save-dock>
      <div class="settings-save-copy"><strong data-save-state>All changes saved</strong><span data-save-help>Edit any field, then select Save settings. You can save a draft before checkout is ready.</span></div>
      <button type="submit" class="btn btn-mint settings-save-button" data-save-button>Save settings</button>
    </div>
  </form>
  <div class="panel setup-status"><div class="panel-head"><div><span class="eyebrow">CURRENT STORE CONFIGURATION</span><h2>Store setup summary</h2><p class="muted">A snapshot of the settings currently saved for this store.</p></div></div>
    <div class="integration"><span>ShopEasy version</span><strong data-release-version="2.8.95">Build 2.8.95</strong></div>
    <div class="integration"><span>Enabled interface languages</span><strong><%= (uiEnabledLocales||[]).map(code=>(uiLocaleOptions||[]).find(option=>option.code===code)?.label||code).join(' · ') %> · Default: <%= (uiLocaleOptions||[]).find(option=>option.code===uiDefaultLocale)?.label||uiDefaultLocale %></strong></div>
    <div class="integration"><span>Store currency</span><strong><%= currency %></strong></div>
    <div class="integration"><span>Delivery fee per order</span><strong><%= formatPrice(shippingFeeCents,currency) %></strong></div>
    <div class="integration"><span>Configured delivery countries</span><strong><%= (launch?.deliveryCountries||[]).join(', ')||'Not configured' %></strong></div>
    <div class="integration"><span>Optional password-reset email</span><strong><%= emailEnabled?'Email provider connected':'Not configured (optional)' %></strong></div>
    <div class="integration"><span>Tax-inclusive pricing</span><strong><%= pricesIncludeTax?'Confirmed by manager':(simplified?'Optional in simplified setup':'Not confirmed') %></strong></div>
    <div class="integration"><span>Sellable products</span><strong><%= sellableProductCount %></strong></div>
    <div class="integration"><span>Payment method</span><strong>Cash on delivery<%= bankTransferReady?' · Bank transfer':'' %><%= paymentStatus?.checkoutCardEnabled?' · Card (Mollie)':'' %></strong></div>
    <div class="integration"><span><%= simplified?'Basic contact + customer terms':'Business identity + English policies' %></span><strong><%= storeReady?'Complete':'Incomplete' %></strong></div>
    <p class="muted">This summary reports saved ShopEasy settings. It does not certify tax, legal compliance or delivery coverage. Verify the rules for every destination you serve.</p>
  </div>
</section>
<script src="/js/admin-settings-ux.js?v=2027-r25" defer></script>
<%- include('../partials/footer',{managerWorkspaceShell:user?.role==='manager'}) %>
