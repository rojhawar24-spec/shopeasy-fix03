<%- include('../partials/header',{title:'Stories'}) %><%- include('../partials/admin-nav') %>
<section class="container page-head admin-head"><%- include('../partials/back-button', { fallback: '/admin' }) %><div><span class="eyebrow">CONTENT</span><h1>Stories</h1><p>Publish short updates that expire automatically.</p></div><a class="btn btn-dark" href="/admin/stories/new">+ Add story</a></section>
<section class="container section"><% if(typeof error !== 'undefined' && error){ %><div class="alert" role="alert"><%= error %></div><% } %><div class="panel table-wrap" role="region" aria-label="Stories table. Scroll horizontally if needed." tabindex="0"><table><thead><tr><th>Story</th><th>Published</th><th>Expires</th><th>Status</th><th></th></tr></thead><tbody><% stories.forEach(s=>{ %><tr><td><div class="table-product table-story"><img src="<%= safeImageUrl(s.image_url,'/assets/story.svg') %>" data-fallback-src="/assets/story.svg" alt="<%= s.title %>" width="80" height="60" loading="lazy" decoding="async"><div><strong data-no-translate><%= s.title %></strong><span><%= s.product_name||'Store story' %></span></div></div></td><td><%= formatDateTimeDisplay(s.published_at,storeTimeZone) %></td><td><%= formatDateTimeDisplay(s.expires_at,storeTimeZone) %></td><td><span class="status <%= s.active?'':'off' %>"><%= s.active?'Active':'Hidden' %></span></td><td class="table-actions"><div class="table-action-group"><a class="btn btn-light btn-small" href="/admin/stories/<%= s.id %>/edit">Edit</a><form method="post" action="/admin/stories/delete" data-confirm="Delete this story?"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= s.id %>"><button type="submit" class="btn btn-danger btn-small">Delete</button></form></div></td></tr><% }) %></tbody></table></div></section>
<%- include('../partials/footer',{managerWorkspaceShell:user?.role==='manager'}) %>