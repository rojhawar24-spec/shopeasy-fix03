<%- include('../partials/header',{title:story?.id?'Edit story':'Add story'}) %><%- include('../partials/admin-nav') %>
<section class="container page-head admin-head"><%- include('../partials/back-button', { fallback: '/admin/stories' }) %><div><span class="eyebrow">CONTENT</span><h1><%= story?.id?'Edit story':'Add story' %></h1><p>Stories automatically disappear after their expiration time. Times use the store timezone.</p></div></section>
<section class="container story-studio"><form class="panel form-stack story-studio-form" data-story-studio method="post" action="/admin/stories/save" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrf %>"><% if(story?.id){ %><input type="hidden" name="id" value="<%= story.id %>"><% } %><% if(error){ %><div class="alert" role="alert"><%= error %></div><% } %><div class="story-studio-section"><span class="eyebrow">01 / CONTENT</span><h2>Tell your story</h2></div><label>Title *<input name="title" required maxlength="120" value="<%= story?.title||'' %>"></label><label>Text<textarea name="body" maxlength="1000" rows="5"><%= story?.body||'' %></textarea></label><div class="story-studio-section"><span class="eyebrow">02 / SCHEDULE</span><h2>Choose when to publish</h2></div><div class="form-two"><label>Publish at *<input type="datetime-local" name="publishedAt" required value="<%= story?.published_at?formatDateTimeLocal(story.published_at,storeTimeZone): '' %>"></label><label>Expire at *<input type="datetime-local" name="expiresAt" required value="<%= story?.expires_at?formatDateTimeLocal(story.expires_at,storeTimeZone): '' %>"></label></div>
<% if(story?.product_id){ %><% const currentInList = products.some(p => Number(p.id) === Number(story.product_id)); %><% if(!currentInList){ %><div class="alert alert-warning" role="alert">This story is attached to product #<%= story.product_id %> which is <strong>inactive</strong> (not shown in shop). Set the product to "Live" from Products before saving, or choose another product below.</div><% } %><% } %>
<div class="story-studio-section"><span class="eyebrow">03 / OPTIONAL LINK</span><h2>Connect to your shop</h2></div><label>Attach product<select name="productId" id="storyProductSelect"><option value="">No product</option><% products.forEach(p=>{ %><option value="<%= p.id %>" <%= String(story?.product_id||'')===String(p.id)?'selected':'' %>><%= p.name %><%= p.__inactive ? ' — (inactive)' : '' %></option><% }) %></select><span class="field-note">Choose a product OR enter a custom link below — not both. If a product is attached, the Link URL is ignored.</span></label>
<label>Link URL<input name="linkUrl" id="storyLinkInput" maxlength="500" placeholder="/shop" value="<%= story?.link_url||'' %>"><span class="field-note">Only used when no product is attached. Example: <code>/shop</code>, <code>/stories</code>, or a full https URL.</span></label>
<div class="story-studio-section"><span class="eyebrow">04 / MEDIA</span><h2>Add your own photo</h2></div><label class="story-studio-upload"><svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8" cy="8" r="1.5"/><path d="m3 17 5-5 4 4 3-3 6 6"/></svg><strong>Select photo</strong><span>JPG, PNG or WebP · up to 2 MiB</span><input type="file" name="image" accept="image/jpeg,image/png,image/webp" data-studio-file><span data-studio-filename role="status"></span></label><details class="story-studio-url"><summary>Use an existing image URL instead</summary><label>Image URL<input name="imageUrl" maxlength="500" value="<%= story?.image_url||'' %>"></label></details><div class="story-studio-section"><span class="eyebrow">05 / VISIBILITY</span><h2>Publication status</h2></div><label class="checkbox-inline"><input type="checkbox" name="active" <%= story ? story.active?'checked':'' : 'checked' %>> Show on storefront during publication window</label><div class="story-studio-save"><a class="btn btn-light" href="/admin/stories">Cancel</a><button type="submit" class="btn btn-dark">Save story</button></div></form><aside class="story-studio-preview"><div class="story-studio-preview-head"><h2>Live preview</h2><span>Customer view</span></div><div class="story-studio-phone"><img data-studio-photo src="<%= safeImageUrl(story?.image_url,'/assets/story.svg') %>" alt="" width="360" height="640"><div class="story-studio-preview-shade"></div><div class="story-studio-preview-progress"><span></span></div><div class="story-studio-preview-copy"><span>SHOP UPDATES</span><h3 data-studio-title data-no-translate><%= story?.title||'Your story title' %></h3><p data-studio-body data-no-translate><%= story?.body||'Your story text appears here.' %></p></div></div><p class="field-note">Preview only. Customers see your story after you save it and its publication time begins.</p></aside></section>
<%- include('../partials/footer',{managerWorkspaceShell:user?.role==='manager'}) %>