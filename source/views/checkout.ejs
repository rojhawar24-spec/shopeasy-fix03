<%- include('partials/header',{title:'Checkout'}) %>
<%- include('partials/purchase-journey',{journeyStage:'checkout'}) %>
<section class="container page-head checkout-head checkout-head-v5"><%- include('partials/back-button', { fallback: '/cart' }) %><div><span class="eyebrow"><%= customerText(locale==='nl'?'VEILIG AFREKENEN':locale==='fr'?'COMMANDE SÉCURISÉE':locale==='ckb'?'داواکردنی پارێزراو':locale==='ar'?'إتمام الطلب بأمان':'SECURE CHECKOUT') %></span><h1><%= customerText(locale==='nl'?'Je bestelling afronden.':locale==='fr'?'Finalisez votre commande.':locale==='ckb'?'داواکارییەکەت تەواو بکە.':locale==='ar'?'أكمل طلبك.':'Complete your order.') %></h1><p><%= customerText(locale==='nl'?'Vul je contact- en leveringsgegevens in, kies een betaalwijze en controleer je totaal.':locale==='fr'?'Indiquez vos coordonnées et votre adresse, puis choisissez un moyen de paiement.':locale==='ckb'?'زانیاری پەیوەندی و گەیاندن بنووسە، شێوازی پارەدان هەڵبژێرە و کۆی گشتی بپشکنە.':locale==='ar'?'أدخل بيانات الاتصال والتوصيل، واختر طريقة الدفع وراجع الإجمالي.':'Enter your contact and delivery details, select a payment method, and review the total.') %></p></div></section>
<% if(typeof securityNotice!=='undefined' && securityNotice){ %><section class="container"><div class="alert" role="status"><%= customerText("Your security check expired. No order was submitted by that expired form. This page has a fresh security token; review your details and submit only once.") %></div></section><% } %>
<section class="container checkout-layout checkout-layout-v5" aria-label="<%= customerText("Checkout and order summary") %>">
<form class="panel form-stack checkout-form-v5" method="post" action="/checkout" data-submit-once data-auto-price="<%= pricingRulesActive&&!demoCheckoutOnly&&storeReady?'1':'0' %>">
  <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="idempotencyKey" value="<%= idempotencyKey %>"><input type="hidden" name="pricingQuoteId" value="<%= quoteId||'' %>"><% if(guestAccessToken){ %><input type="hidden" name="guestAccessToken" value="<%= guestAccessToken %>"><% } %>
  <% if(error){ %><div class="alert" role="alert"><%= customerText(error) %><% if(typeof checkoutRecoveryUrl !== 'undefined' && checkoutRecoveryUrl){ %> <a href="<%= checkoutRecoveryUrl %>"><%= customerText("Check the status of the earlier order") %></a><% } %></div><% } %><% if(quoteMessage){ %><div class="success-alert" role="status"><%= customerText(quoteMessage) %></div><% } %>
  <div class="checkout-note"><span class="security-icon">✓</span><div><strong><%= customerText("Order and delivery details") %></strong><p><%= customerText("We use these details to process your order and arrange delivery. Choose one of the payment methods available below.") %></p></div></div>
  <h2 class="checkout-section-title"><%= customerText(locale==='nl'?'1. Contactgegevens':locale==='fr'?'1. Coordonnées':locale==='ckb'?'١. زانیاری پەیوەندی':locale==='ar'?'١. بيانات الاتصال':'1. Contact details') %></h2>
  <label><%= customerText("Email address *") %><input type="email" name="customerEmail" required maxlength="120" autocomplete="email" placeholder="<%= customerText("Enter your email address") %>" value="<%= customerEmail||user?.email||'' %>" aria-describedby="email-note"><span id="email-note" class="field-note"><%= customerText("Used to identify your order if you contact the store.") %></span></label>
  <label><%= customerText("Phone number *") %><input name="customerPhone" required maxlength="32" autocomplete="tel" inputmode="tel" enterkeyhint="next" placeholder="<%= customerText("International number") %>" value="<%= checkoutForm?.customerPhone||'' %>"><span class="field-note"><%= customerText("Include the full international number with country calling code.") %></span></label>
  <div class="checkout-price-note" aria-live="polite"><strong><%= customerText(locale==='nl'?'Prijsinformatie':'Price information') %></strong><span><% if(summary.taxConfigured&&summary.taxRateBps!==null){ %><%= customerText(locale==='nl'?'Het door de winkel ingestelde belastingtarief van ':'A store-configured tax rate of ') %><%= (summary.taxRateBps/100).toFixed(2) %>% <%= customerText(locale==='nl'?'is van toepassing op deze bestemming. ':'applies to this destination. ') %><%= customerText(summary.taxIncluded?(locale==='nl'?'De belasting is inbegrepen in de door de winkel ingevoerde prijzen.':'Tax is extracted from the prices entered by the store.'):(locale==='nl'?'De belasting wordt bij het totaal van de bestelling opgeteld.':'Tax is added to the order total.')) %> <%= customerText(locale==='nl'?'Dit is de instelling van de winkel en geen bevestiging van wettelijke naleving.':'This is the store\'s configuration, not a legal-compliance confirmation.') %><% } else if(summary.taxConfigured&&summary.taxNeedsDestination){ %><%= customerText(locale==='nl'?'De winkel heeft belastingregels ingesteld. Vul het volledige land, de stad en (indien beschikbaar) de postcode van de levering in om de regel voor jouw bestemming te berekenen.':'The store has tax rules configured. Enter a complete delivery country, city and postal code (when available) to calculate the rule for your destination.') %><% } else { %><%= customerText(locale==='nl'?'Er wordt alleen belasting berekend als de winkel een overeenkomstige regionale regel heeft ingesteld. Prijzen die inclusief belasting zijn aangeduid, bewijzen niet dat het juiste belastingtarief of de juiste behandeling is toegepast.':'No tax amount is calculated unless this store has configured a matching regional rule. Prices marked as tax-inclusive do not prove that the correct tax rate or treatment has been applied.') %><% } %></span></div>
  <h2 class="checkout-section-title"><%= customerText(locale==='nl'?'2. Leveringsadres':locale==='fr'?'2. Livraison':locale==='ckb'?'٢. ناونیشانی گەیاندن':locale==='ar'?'٢. عنوان التوصيل':'2. Delivery address') %></h2>
  <div class="form-two"><label><%= customerText("Full name *") %><input name="shippingName" required maxlength="120" autocomplete="name" value="<%= checkoutForm?.shippingName||'' %>"></label><label><%= customerText("Postal code") %><input name="shippingPostalCode" maxlength="20" autocomplete="postal-code" enterkeyhint="next" value="<%= checkoutForm?.shippingPostalCode||'' %>"><span class="field-note"><%= customerText(locale==='ar' ? 'الرمز البريدي اختياري إذا لم يكن مستخدمًا في وجهتك؛ أضفه إذا كان متاحًا.' : locale==='ckb' ? 'کۆدی پۆستەڵ ئەگەر لە شوێنی گەیاندنت پێویست نەبێت، دەتوانیت بەجێی بهێڵیت؛ ئەگەر هەتە دایبنێ.' : 'Optional when your delivery destination does not use postal codes; add it if available.') %></span></label></div>
  <label><%= customerText("Street address *") %><input name="shippingAddress" required maxlength="200" autocomplete="street-address" value="<%= checkoutForm?.shippingAddress||'' %>"></label>
  <div class="form-two checkout-address-row"><label><%= customerText("City / town *") %><input name="shippingCity" required maxlength="100" autocomplete="address-level2" value="<%= checkoutForm?.shippingCity||'' %>"></label><label class="checkout-country-field"><%= customerText("Country / region *") %><select name="shippingCountry" required autocomplete="country-name" <%= !Array.isArray(deliveryCountries)||deliveryCountries.length===0?'disabled':'' %>><option value="" <%= !checkoutForm?.shippingCountry&&(deliveryCountries||[]).length!==1?'selected':'' %> disabled><%= customerText("Choose your delivery country") %></option><% (Array.isArray(deliveryCountries)?deliveryCountries:[]).forEach(country=>{ %><option value="<%= country %>" <%= checkoutForm?.shippingCountry===country||(!checkoutForm?.shippingCountry&&deliveryCountries.length===1)?'selected':'' %>><%= country %></option><% }) %></select><% if(!Array.isArray(deliveryCountries)||deliveryCountries.length===0){ %><span class="field-note" role="status"><%= customerText("This store is still getting ready and cannot take orders yet. Please check back soon.") %></span><% } else { %><span class="field-note"><%= customerText("Choose a country from the countries listed by this store. Orders to other countries cannot be placed.") %></span><% } %></label></div>
  <label><%= customerText("Order note ") %><span class="field-note"><%= customerText("Optional · max 500 characters") %></span><textarea name="customerNote" maxlength="500" rows="4" placeholder="<%= customerText("Delivery note or another useful detail") %>"><%= checkoutForm?.customerNote||'' %></textarea></label>
  <h2 class="checkout-section-title checkout-payment-title"><%= customerText(locale==='nl'?'3. Betaalmethode':locale==='fr'?'3. Moyen de paiement':locale==='ckb'?'٣. شێوازی پارەدان':locale==='ar'?'٣. طريقة الدفع':'3. Payment method') %></h2>
  <fieldset class="payment-method-options" aria-labelledby="payment-method-heading" aria-describedby="payment-security-note">
    <legend id="payment-method-heading"><%= customerText("Payment method") %></legend>
    <label class="payment-choice <%= !checkoutForm?.paymentMethod||checkoutForm.paymentMethod==='cash_on_delivery'?'is-default':'' %>">
      <input type="radio" name="paymentMethod" value="cash_on_delivery" <%= !checkoutForm?.paymentMethod||checkoutForm.paymentMethod==='cash_on_delivery'?'checked':'' %> required>
      <span class="payment-choice-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><rect x="3.5" y="6" width="17" height="13.5" rx="2.5" stroke="currentColor" stroke-width="1.7"/><path d="M3.8 9.5h16.4M7 15h3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></span>
      <span class="payment-choice-copy"><strong id="payment-method-title"><%= customerText("Cash on delivery") %></strong><span><%= customerText("Pay in cash when your order is delivered. No card is needed.") %></span></span>
      <span class="payment-choice-brand">COD</span>
    </label>
    <% if(giftCardsEnabled){ %>
      <label class="payment-choice <%= checkoutForm?.paymentMethod==='gift_card'?'is-default':'' %>">
        <input type="radio" name="paymentMethod" value="gift_card" <%= checkoutForm?.paymentMethod==='gift_card'?'checked':'' %>>
        <span class="payment-choice-icon" aria-hidden="true">🎁</span>
        <span class="payment-choice-copy"><strong><%= customerText("Gift card — full balance") %></strong><span><%= customerText("Pay the entire order using a valid gift card. Partial payments are not supported.") %></span></span>
      </label>
      <label for="gift-card-code"><%= customerText("Gift card code (only when choosing gift card)") %><input id="gift-card-code" type="text" name="giftCardCode" maxlength="60" autocomplete="off" pattern="SEGC-[a-fA-F0-9]{48}" spellcheck="false" placeholder="SEGC-…"></label>
    <% } %>
    <% if(bankTransferEnabled){ %>
      <label class="payment-choice <%= checkoutForm?.paymentMethod==='bank_transfer'?'is-default':'' %>">
        <input type="radio" name="paymentMethod" value="bank_transfer" <%= checkoutForm?.paymentMethod==='bank_transfer'?'checked':'' %> required>
        <span class="payment-choice-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M3 9h18M5 9v9m4-9v9m6-9v9m4-9v9M3 20h18M12 3 3 7h18L12 3Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        <span class="payment-choice-copy"><strong><%= customerText(locale==='nl'?'Bankoverschrijving':locale==='ckb'?'گواستنەوەی بانکی':locale==='ar'?'تحويل مصرفي':'Bank transfer') %></strong><span><%= customerText(locale==='nl'?'Je ontvangt na het bestellen de bankgegevens en een unieke betalingsreferentie. De bestelling blijft onbetaald totdat de winkel je overschrijving controleert.':locale==='ckb'?'دوای داواکاری زانیاری بانکی و ژمارەی تایبەتی پارەدان وەردەگریت. داواکارییەکە تا پشتڕاستکردنەوەی گواستنەوەکەت پارەدراو نابێت.':locale==='ar'?'ستتلقى بيانات البنك ومرجع دفع فريدًا بعد الطلب. يظل الطلب غير مدفوع حتى يتحقق المتجر من التحويل.':'After ordering, you receive the bank details and a unique payment reference. The order stays unpaid until the store verifies your transfer.') %></span></span>
        <span class="payment-choice-brand">BANK</span>
      </label>
    <% } %>
    <% if(checkoutCardEnabled){ %>
      <label class="payment-choice <%= checkoutForm?.paymentMethod==='card'?'is-default':'' %>">
        <input type="radio" name="paymentMethod" value="card" <%= checkoutForm?.paymentMethod==='card'?'checked':'' %> required>
        <span class="payment-choice-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="14" rx="2.4" stroke="currentColor" stroke-width="1.7"/><path d="M3.5 9.5h17M7 15h4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></span>
        <span class="payment-choice-copy"><strong><%= customerText("Credit or debit card") %></strong><span><%= customerText("Continue to Mollie’s secure hosted checkout. Your card details are entered with the payment provider, not in ShopEasy.") %></span></span>
        <span class="payment-choice-brand" aria-label="<%= customerText("Secure payment provider") %>">Mollie</span>
      </label>
      <p class="payment-security-note" id="payment-security-note"><span aria-hidden="true">✓</span> <%= customerText(locale==='nl'?'Kaartbetaling verloopt bij Mollie. ShopEasy bewaart geen kaartnummer of veiligheidscode.':locale==='fr'?'Paiement sécurisé chez Mollie. ShopEasy ne conserve pas vos numéros de carte.':locale==='ckb'?'پارەدانی کارتی لە Mollie ئەنجام دەدرێت؛ ShopEasy ژمارەی کارت پاشەکەوت ناکات.':locale==='ar'?'الدفع بالبطاقة يتم عبر Mollie؛ لا يحفظ ShopEasy بيانات البطاقة.':'Secure provider checkout · ShopEasy does not collect or store your card number or security code. Card availability depends on the store’s approved payment setup.') %></p>
    <% } else { %>
      <p class="payment-security-note" id="payment-security-note"><%= customerText("Online card payment is not enabled for this store. ") %><%= customerText(bankTransferEnabled?'Bank transfer and cash on delivery remain available.':'Cash on delivery remains available.') %><%= customerText(" The store manager must complete provider onboarding and configuration before card checkout can appear.") %></p>
    <% } %>
  </fieldset>
  <label class="checkbox-inline"><input type="checkbox" name="termsAccepted" required><%= customerText(" I have read and accept the ") %><a href="/terms" target="_blank" rel="noopener noreferrer"><%= customerText("store terms") %></a>.</label><% if(termsFallback){ %><div class="alert" role="note"><%= customerText("The store has not supplied a reviewed terms translation for your chosen language. The terms page will show the English version and identify it as a fallback. Read it before placing an order.") %></div><% } %>
  <% if(typeof managerTestCheckout!=="undefined" && managerTestCheckout){ %><p class="tip-box" role="status">Test store: use fictional contact details only. Test orders are saved and reserve stock. No shipment or payment.</p><% } %><% if(demoCheckoutOnly && quoteReady){ %><p class="tip-box" role="status">Demo: delivery and tax reviewed. No order or payment has been created.</p><a class="btn btn-light btn-wide" href="/checkout">Review another delivery address</a><% } else if(!storeReady){ %><button type="submit" class="btn btn-dark btn-wide" disabled><%= customerText("This store cannot accept orders yet") %></button><p class="micro-copy"><%= customerText("This store is still getting ready and cannot take orders yet. Please check back soon.") %></p><% } else { %><button type="submit" class="btn btn-mint btn-wide checkout-place-order"><span class="checkout-place-label" data-final-label="<%= customerText(locale==='nl'?'Bestelling met betalingsverplichting':locale==='ckb'?'داواکردن بە پابەندی پارەدانەوە':locale==='ar'?'الطلب مع الالتزام بالدفع':locale==='fr'?'Commande avec obligation de paiement':'Order with obligation to pay') %>"><%= customerText((demoCheckoutOnly||pricingRulesActive)&&!quoteReady?'Review delivery & tax →':(locale==='nl'?'Bestelling met betalingsverplichting':locale==='ckb'?'داواکردن بە پابەندی پارەدانەوە':locale==='ar'?'الطلب مع الالتزام بالدفع':locale==='fr'?'Commande avec obligation de paiement':'Order with obligation to pay')) %></span><strong class="checkout-place-total"><%= formatPrice(summary.total,currency) %><%= customerText(pricingRulesActive&&!quoteReady?' · estimate':'') %></strong></button><% if(!pricingRulesActive||quoteReady){ %><p class="micro-copy checkout-payment-obligation"><%= customerText("By continuing, you confirm the order and any payment obligation. Card payments continue on the provider’s secure payment page; cash-on-delivery orders are paid when delivered.") %></p><% } %><p class="micro-copy" data-checkout-estimate><%= customerText(pricingRulesActive&&!quoteReady?'Review the destination-specific delivery fee, configured tax rate and final amount on the next step. No order is placed until you confirm that amount.':(checkoutForm?.paymentMethod==='card'?'You will leave ShopEasy to complete the card payment with the provider. Your order is not marked paid until the provider confirms it.':checkoutForm?.paymentMethod==='bank_transfer'?'ShopEasy will show the bank details and a unique payment reference after the order is placed. The store will verify the incoming transfer before marking the order as paid.':'The store will review your order and arrange delivery. Please pay in cash when your order arrives.')) %></p><% } %>
<p class="micro-copy" id="checkout-price-status" role="status" aria-live="polite"></p></form>
<section class="summary checkout-summary-v5" aria-labelledby="checkout-summary-title"><div class="summary-head checkout-summary-heading"><span id="checkout-summary-title"><%= customerText("Your order") %></span><span class="checkout-item-count"><%= summary.items.reduce((count,item)=>count+Number(item.quantity||0),0) %><%= customerText(" items") %></span></div><div class="checkout-summary-products"><% summary.items.forEach(i=>{ %><div class="checkout-summary-item"><img src="<%= safeImageUrl(i.product.image_url) %>" data-fallback-src="/assets/product-placeholder.svg" alt="" width="52" height="64" loading="lazy" decoding="async"><div class="checkout-summary-item-copy"><strong data-no-translate><%= i.product.name %></strong><span><% if(i.variant){ %><span translate="no" data-no-translate><%= i.variant.option_name %>: <%= i.variant.option_value %><% if(i.variant.option_value_2){ %> · <%= i.variant.option_name_2 %>: <%= i.variant.option_value_2 %><% } %></span> · <% } %><%= customerText("Quantity ") %><%= i.quantity %><% if(i.automaticDiscountPercent>0){ %> · -<%= i.automaticDiscountPercent %>%<% } %></span></div><strong class="checkout-summary-item-price"><%= formatPrice(i.total,currency) %></strong></div><% }) %></div><div class="rule"></div><div class="summary-row"><span><%= customerText("Items subtotal") %></span><strong><%= formatPrice(summary.subtotalBeforeAutomaticDiscount,currency) %></strong></div><% if(summary.automaticDiscount>0){ %><div class="summary-row"><span><%= customerText("Automatic item discounts") %></span><strong>-<%= formatPrice(summary.automaticDiscount,currency) %></strong></div><% } %><% if(summary.discount>0){ %><div class="summary-row"><span><%= customerText("Coupon") %></span><strong>-<%= formatPrice(summary.discount,currency) %></strong></div><% } %><div class="summary-row" data-checkout-shipping data-label="<%= customerText("Shipping") %>"><span><%= customerText("Shipping") %><%= customerText(summary.pricingRulesActive&&!quoteReady?' · estimate':'') %></span><strong><%= summary.shipping===0?'Free':formatPrice(summary.shipping,currency) %></strong></div><div class="summary-row" data-checkout-tax data-included="<%= customerText("Tax included") %>" data-added="<%= customerText("Tax added") %>" <%= summary.taxRateBps===null||!summary.taxConfigured?'hidden':'' %>><span><%= customerText(summary.taxIncluded?'Tax included':'Tax added') %> (<%= (Number(summary.taxRateBps||0)/100).toFixed(2) %>%)</span><strong><%= formatPrice(summary.taxCents,currency) %></strong></div><% if(summary.taxConfigured&&summary.taxNeedsDestination){ %><p class="field-note" data-checkout-estimate><%= customerText("Tax rate will be selected after the delivery destination is entered.") %></p><% } else if(!summary.taxConfigured){ %><p class="field-note"><%= customerText("No regional tax rule is configured. ShopEasy has not calculated tax for this amount.") %></p><% } %><% if(summary.bundleDiscount>0){ %><div class="summary-row"><span><%= customerText("Bundle saving") %></span><strong>− <%= formatPrice(summary.bundleDiscount,currency) %></strong></div><% } %><div class="summary-row total"><span><%= customerText("Total") %><%= customerText(summary.pricingRulesActive&&!quoteReady?' · estimate':'') %></span><strong><%= formatPrice(summary.total,currency) %></strong></div><% if(summary.pricingRulesActive&&!quoteReady){ %><p class="field-note" data-checkout-estimate><%= customerText("The estimate uses the standard delivery fee until the destination is reviewed.") %></p><% } %></section>
</section>
<script src="/js/checkout-auto-price-v1.js" defer></script>
<%- include('partials/footer') %>