 };const t=labels[locale]||labels.en;const links=['/order-lookup','/faq','/shipping-returns','/imprint']; %>
<section class="container page-head"><span class="eyebrow"><%= t.eyebrow %></span><h1><%= t.title %></h1><p><%= t.desc %></p></section>
<section class="container section contact-layout"><div class="panel contact-primary"><span class="eyebrow"><%= t.mini %></span><h2><%= t.heading %></h2>
 <% if(supportEmail){ %><div class="contact-method"><strong><%= customerText("Email") %></strong><a href="mailto:<%= supportEmail %>"><%= supportEmail %></a></div><% } %>
 <% if(businessPhone){ %><div class="contact-method"><strong><%= t.phone %></strong><a href="tel:<%= encodeURIComponent(businessPhone) %>"><%= businessPhone %></a></div><% } %>
 <% if(businessAddress){ %><div class="contact-method"><strong><%= t.address %></strong><address><%= businessAddress %></address></div><% } %>
 <% if(!supportEmail&&!businessPhone&&!businessAddress){ %><div class="alert" role="note"><%= t.empty %></div><% } %>
 <p class="field-note"><%= t.privacy %></p>
 </div><section class="panel contact-help" aria-labelledby="contact-quick-help"><span class="eyebrow"><%= t.help %></span><h2 id="contact-quick-help"><%= t.helpTitle %></h2><p><%= t.helpText %></p><div class="contact-shortcuts"><% links.forEach((href,index)=>{ %><a href="<%= href %>"><%= t.links[index] %> <span aria-hidden="true">↗</span></a><% }); %></div></section></section>
