<%- include('partials/header',{title:'Forgot your password?'}) %>
<section class="auth-wrap"><div class="auth-card"><%- include('partials/back-button', { fallback: next ? `/login?next=${encodeURIComponent(next)}` : '/login' }) %><span class="eyebrow"><%= customerText("ACCOUNT SECURITY") %></span><h1><%= customerText("Forgot your password?") %></h1><p class="muted"><%= customerText("Enter the email address for your account. For privacy, we show the same message whether or not the account exists.") %></p>
<% if(sent){ %><div class="auth-next-step" role="status"><%= customerText("If an account exists and recovery email is configured, a six-digit verification code may have been sent. It expires after 10 minutes and allows up to five attempts. Check your inbox and spam folder. For security, wait 60 seconds before requesting another code.") %></div><% } %>
<% if(error){ %><div class="alert" role="alert"><%= customerText(error) %></div><% } %>
<form class="form-stack" method="post" action="/forgot-password"><input type="hidden" name="next" value="<%= typeof next !== 'undefined' ? next : '/account' %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="send"><label><%= customerText("Email address") %><input type="email" name="email" autocomplete="email" required maxlength="120" placeholder="<%= customerText("Enter your email address") %>" value="<%= email||'' %>"></label><button type="submit" class="btn btn-dark btn-wide"><%= customerText("Send verification code") %></button></form>
<% if(sent){ %><hr><h2><%= customerText("Enter the code") %></h2><p class="muted"><%= customerText("Use the six-digit code from the email. You can request another code above.") %></p><form class="form-stack" method="post" action="/forgot-password"><input type="hidden" name="next" value="<%= typeof next !== 'undefined' ? next : '/account' %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="reset"><input type="hidden" name="email" value="<%= email||'' %>"><label><%= customerText("Verification code") %><input type="text" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" minlength="6" maxlength="6" required placeholder="123456"></label><label><%= customerText("New password") %><input type="password" name="password" minlength="15" maxlength="200" autocomplete="new-password" required><span class="field-note"><%= customerText("Use 15–200 characters. Avoid common or repeated passwords.") %></span></label><label><%= customerText("Confirm new password") %><input type="password" name="confirmPassword" minlength="15" maxlength="200" autocomplete="new-password" required></label><button type="submit" class="btn btn-mint btn-wide"><%= customerText("Reset password") %></button></form><% } %>
<p class="switch-auth"><a href="<%= next ? `/login?next=${encodeURIComponent(next)}` : '/login' %>"><%= customerText("Back to sign in") %></a></p></div></section><%- include('partials/footer') %>
