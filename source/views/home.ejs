<%- include('partials/header',{title:'Home',description:heroDescription}) %>
<div class="container"><% if(newsletterNotice){ %><p role="<%= newsletterNotice==='check-email'?'status':'alert' %>" class="engagement-notice"><%= pageText(newsletterNotice==='check-email' ? (locale==='nl'?'Controleer je e-mail en bevestig je inschrijving.':locale==='ckb'?'ئیمەیڵەکەت بپشکنە و بەشداریکردنەکەت پشتڕاست بکەرەوە.':locale==='ar'?'تحقق من بريدك الإلكتروني وأكد الاشتراك.':'Check your inbox to confirm your subscription.') : newsletterNotice==='invalid' ? (locale==='nl'?'Vul een geldig e-mailadres in.':locale==='ckb'?'ئیمەیڵێکی دروست بنووسە.':locale==='ar'?'أدخل بريدًا إلكترونيًا صالحًا.':'Enter a valid email address.') : (locale==='nl'?'Inschrijven via e-mail is tijdelijk niet beschikbaar.':locale==='ckb'?'بەشداری بە ئیمەیڵ ئێستا بەردەست نییە.':locale==='ar'?'خدمة الاشتراك غير متاحة حالياً.':'Email signup is temporarily unavailable.')) %></p><% } %><% if(added){ %><div class="cart-added-success" role="status" aria-live="polite"><span class="cart-added-icon" aria-hidden="true">✓</span><div><strong><%= pageText("Added to your bag") %></strong><p><%= pageText("Your item is in the bag. You can keep shopping or review your bag when you're ready.") %></p></div><div class="cart-added-actions"><a class="btn btn-dark btn-small" href="/cart"><%= pageText("View bag") %></a><a class="btn btn-light btn-small" href="/shop"><%= pageText("Continue shopping") %></a></div></div><% } %></div>
<section class="v17-home-hero container" aria-labelledby="homepage-title">
  <div class="v17-home-copy">
    <span class="v17-kicker"><span class="v17-kicker-mark" aria-hidden="true"></span><span data-no-translate><%= heroEyebrow %></span></span>
    <h1 id="homepage-title" data-no-translate><span><%= heroTitle %></span> <em><%= heroAccent %></em></h1>
    <p class="v17-home-description" data-no-translate><%= heroDescription %></p>
    <div class="v17-home-actions">
      <a class="v17-button v17-button-primary" href="/shop"><%= pageText(locale === 'ar' ? 'تصفّح المنتجات' : locale === 'ckb' ? 'بینینی بەرهەمەکان' : 'Shop the collection') %><span aria-hidden="true">↗</span></a>
      <a class="v17-text-action" href="#featured"><%= pageText(locale === 'ar' ? 'اكتشف المنتجات' : locale === 'ckb' ? 'بەرهەمەکان ببینە' : locale === 'nl' ? 'Bekijk producten' : 'Discover products') %><span aria-hidden="true">↓</span></a>
    </div>
    <div class="v17-assurances" role="group" aria-label="<%= pageText('Store benefits') %>">
      <span><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m4 10 4 4 8-8"/></svg><%= pageText(locale==='ar'?'أسعار واضحة':locale==='ckb'?'نرخی ڕوون':'Clear prices') %></span>
      <span><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 6h14v10H3zM6 6V4h8v2M6 10h8"/></svg><%= pageText(locale==='ar'?'الدفع عند الاستلام':locale==='ckb'?'پارەدان لە کاتی گەیاندن':'Cash on delivery') %></span>
      <span><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10a7 7 0 1 0 2-5M3 3v4h4M10 6v4l3 2"/></svg><%= pageText(locale==='ar'?'طلب سهل':locale==='ckb'?'داواکاریی ئاسان':'An easy order') %></span>
    </div>
  </div>
  <div class="v17-home-visual" role="group" aria-label="<%= pageText('Store catalogue spotlight') %>">
    <% if(heroImage){ %>
      <div class="v17-custom-hero-image">
        <img src="<%= safeImageUrl(heroImage) %>" data-fallback-src="/assets/product-placeholder.svg" alt="<%= pageText(locale==='ckb'?'وێنەی تایبەتی فرۆشگا':locale==='ar'?'الصورة الرئيسية للمتجر':locale==='nl'?'Afbeelding van de winkel':'Storefront image') %>" width="1200" height="1200" fetchpriority="high" decoding="async">
        <span class="v17-image-caption"><span class="v17-image-caption-dot"></span><%= pageText(locale==='ar'?'اختيار من المتجر':locale==='ckb'?'هەڵبژاردەی فرۆشگا':'A selection from the store') %></span>
      </div>
    <% } else if(heroProduct){ %>
      <a class="v17-spotlight-card" href="/product/<%= encodeURIComponent(heroProduct.slug) %>" aria-label="<%= heroProduct.name %>">
        <div class="v17-spotlight-image-wrap">
          <img class="v17-spotlight-image" src="<%= safeImageUrl(heroProduct.image_url) %>" data-fallback-src="/assets/product-placeholder.svg" alt="<%= heroProduct.name %>" width="1000" height="1100" fetchpriority="high" decoding="async">
          <span class="v17-spotlight-label"><span class="v17-image-caption-dot"></span><%= pageText(locale==='ar'?'من منتجات المتجر':locale==='ckb'?'لە بەرهەمەکانی فرۆشگا':'From your catalogue') %></span>
        </div>
        <div class="v17-spotlight-details">
          <div class="v17-spotlight-copy"><span class="v17-mini-label" data-no-translate><%= heroProduct.category_name || pageText(locale==='ar'?'اختيار المتجر':locale==='ckb'?'بەرهەم':'Store pick') %></span><h2 data-no-translate><%= heroProduct.name %></h2><% if(heroProduct.short_description){ %><p data-no-translate><%= heroProduct.short_description %></p><% } %></div>
          <div class="v17-spotlight-purchase"><strong><%= formatPrice(effectivePrice(heroProduct),currency) %></strong><span class="v17-round-arrow" aria-hidden="true">↗</span></div>
        </div>
      </a>
    <% } else { %>
      <div class="v17-empty-spotlight">
        <div class="v17-empty-art" aria-hidden="true"><span class="v17-art-orbit"></span><span class="v17-art-box v17-art-box-back"></span><span class="v17-art-box v17-art-box-front"></span><span class="v17-art-line"></span></div>
        <div class="v17-empty-copy"><span class="v17-mini-label"><%= pageText(products.length ? 'Discover our collection' : locale==='ar'?'مرحبًا بك في متجرنا':locale==='ckb'?'بەخێربێیت بۆ فرۆشگاکەمان':locale==='nl'?'Welkom in onze winkel':'Welcome to our shop') %></span><h2><%= pageText(products.length ? 'Find your next favourite.' : locale==='ar'?'تشكيلة جديدة قريبًا.':locale==='ckb'?'بەرهەمی نوێ بەم زووانە.':locale==='nl'?'Er komt iets moois aan.':'Something good is on its way.') %></h2><p><%= pageText(products.length ? 'Explore our products and choose what works for you.' : locale==='ar'?'نجهّز تشكيلتنا. عد قريبًا أو تواصل معنا للمساعدة.':locale==='ckb'?'بەرهەمەکانمان ئامادە دەکەین. بەم زووانە سەردانمان بکەوە یان پەیوەندیمان پێوە بکە.':locale==='nl'?'We bereiden ons assortiment voor. Kom binnenkort terug of neem contact met ons op.':'Our collection is being prepared. Please visit again soon or contact us for help.') %></p><a href="/shop" class="v17-text-action"><%= pageText(locale==='ar'?'تصفّح المتجر':locale==='ckb'?'بینینی فرۆشگا':locale==='nl'?'Bekijk de winkel':'Browse the shop') %><span aria-hidden="true">↗</span></a></div>
      </div>
    <% } %>
    <div class="v17-visual-index" aria-hidden="true"><span>01</span><span></span><span><%= pageText("SHOP EASY") %></span></div>
  </div>
</section>
<% if (categories && categories.length) { %>
<section class="container section-tight"><div class="section-head"><div><span class="eyebrow"><%= pageText(locale === 'ar' ? 'تصفّح بسهولة' : locale === 'ckb' ? 'بە ئاسانی بگەڕێ' : locale === 'nl' ? 'BEKIJK CATEGORIEËN' : 'BROWSE CATEGORIES') %></span><h2><%= pageText(locale === 'ar' ? 'تصفّح حسب الفئة' : locale === 'ckb' ? 'بەپێی پۆل بگەڕێ' : locale === 'nl' ? 'Winkelen per categorie' : 'Shop by category') %></h2></div><a class="text-link" href="/shop"><%= pageText(locale === 'ar' ? 'عرض الكل ←' : locale === 'ckb' ? 'هەمووی ببینە ←' : locale === 'nl' ? 'Alles bekijken →' : 'View all →') %></a></div><div class="category-grid"><% categories.filter(c=>!c.parent_id).slice(0,6).forEach((c,index)=>{ %><a class="category-card category-<%= index+1 %>" href="/category/<%= encodeURIComponent(c.slug) %>"><div class="category-card-media"><img src="<%= c.image_url ? safeImageUrl(c.image_url) : '/assets/category-placeholder.svg' %>" data-fallback-src="/assets/category-placeholder.svg" alt="" aria-hidden="true" width="900" height="600" loading="lazy" decoding="async"></div><div class="category-card-overlay"><span class="category-index" aria-hidden="true">0<%= index+1 %></span><strong data-no-translate><%= c.name %></strong><span><%= Number(c.child_count||0) ? (locale === 'ckb' ? `${Number(c.child_count)} ژێرپۆل` : locale === 'ar' ? `${Number(c.child_count)} فئة فرعية` : `${Number(c.child_count)} ${pageText(Number(c.child_count)===1?'subcategory':'subcategories')}`) : (locale === 'ckb' ? `${Number(c.product_count||0)} بەرهەم` : locale === 'ar' ? `${Number(c.product_count||0)} منتج` : `${Number(c.product_count||0)} ${pageText(Number(c.product_count||0)===1?'product':'products')}`) %> · <%= pageText(locale === 'ckb' ? 'بگەڕێ ←' : locale === 'ar' ? 'استكشف ←' : pageText('Explore →')) %></span></div></a><% }) %></div></section>
<% } %>
<section id="featured" class="container section"><div class="section-head"><div><span class="eyebrow"><%= pageText(hasFeaturedProducts ? (locale === 'ckb' ? 'بەرهەمە دیاریکراوەکان' : locale === 'ar' ? 'اختياراتنا' : locale === 'nl' ? 'UITGELICHT' : 'FEATURED') : (locale === 'ckb' ? 'تازەترین بەرهەمەکان' : locale === 'ar' ? 'أحدث المنتجات' : 'LATEST IN STORE')) %></span><h2><%= pageText(hasFeaturedProducts ? (locale === 'ckb' ? 'بەرهەمە دیاریکراوەکان' : locale === 'ar' ? 'منتجات مميزة' : locale === 'nl' ? 'Uitgelichte producten' : 'Featured products') : (locale === 'ckb' ? 'بەرهەمە نوێیەکان' : locale === 'ar' ? 'أحدث المنتجات' : 'Latest products')) %></h2></div><a class="text-link" href="/shop"><%= pageText(locale === 'ar' ? 'جميع المنتجات ←' : locale === 'nl' ? 'Alle producten →' : 'All products →') %></a></div><div class="product-grid product-grid-signature"><% if (!products.length) { %><div class="home-empty-state"><h3><%= pageText("Our collection is coming soon") %></h3><p><%= pageText("Have a question? We are here to help.") %></p><a class="text-link" href="/contact"><%= pageText("Contact us") %> →</a></div><% } %><% products.forEach(p=>{ %><%- include('partials/product-card',{p:p}) %><% }) %></div></section>
<section class="container trust-row trust-row-four" aria-label="<%= pageText(locale==='ckb'?'زانیاریی کڕین':locale==='ar'?'معلومات التسوق':locale==='nl'?'Winkelen':'Shopping information') %>">
  <div><span class="trust-icon" aria-hidden="true">⌕</span><strong><%= pageText(locale==='ckb'?'گەڕانی ئاسان':locale==='ar'?'اكتشاف سهل':locale==='nl'?'Eenvoudig zoeken':'Easy discovery') %></strong><span><%= pageText(locale==='ckb'?'بەپێی ناو یان پۆل بگەڕێ.':locale==='ar'?'ابحث بالاسم أو تصفّح الفئات.':locale==='nl'?'Zoek op naam of bekijk de categorieën.':'Search by name or browse categories.') %></span></div>
  <div><span class="trust-icon" aria-hidden="true">✓</span><strong><%= pageText(locale==='ckb'?'نرخی ڕوون':locale==='ar'?'أسعار واضحة':locale==='nl'?'Duidelijke prijzen':'Clear pricing') %></strong><span><%= pageText(locale==='ckb'?'پێش داواکردن نرخەکە ببینە.':locale==='ar'?'راجع السعر قبل الطلب.':locale==='nl'?'Bekijk de prijs voordat je bestelt.':'Review the price before ordering.') %></span></div>
  <div><span class="trust-icon" aria-hidden="true">▣</span><strong><%= pageText(locale==='ckb'?'پارەدان لە کاتی گەیاندن':locale==='ar'?'الدفع عند الاستلام':locale==='nl'?'Betalen bij levering':'Cash on delivery') %></strong><span><%= pageText(locale==='ckb'?'کاتێک داواکارییەکەت گەیشت پارە بدە.':locale==='ar'?'ادفع عند وصول طلبك.':locale==='nl'?'Betaal wanneer je bestelling aankomt.':'Pay when your order arrives.') %></span></div>
  <a class="trust-item" href="/shipping-returns"><span class="trust-icon" aria-hidden="true">↺</span><strong><%= pageText(locale==='ckb'?'سیاسەتی ڕوون':locale==='ar'?'سياسات واضحة':locale==='nl'?'Duidelijke voorwaarden':'Clear policies') %></strong><span><%= pageText(locale==='ckb'?'زانیاری گەیاندن و گەڕاندنەوە بخوێنەوە.':locale==='ar'?'راجع معلومات الشحن والإرجاع.':locale==='nl'?'Lees de informatie over verzending en retouren.':'Read shipping and return details before ordering.') %></span></a>
</section>
<% if (newProducts && newProducts.length) { %>
<section id="new-arrivals" class="container section new-arrivals-section"><div class="section-head"><div><span class="eyebrow"><%= pageText(locale === 'ckb' ? 'تازە زیادکراوەکان' : locale === 'ar' ? 'أُضيفت حديثًا' : locale === 'nl' ? 'NIEUW TOEGEVOEGD' : 'JUST ADDED') %></span><h2><%= pageText(locale === 'ckb' ? 'بەرهەمی نوێ لە فرۆشگا' : locale === 'ar' ? 'أحدث المنتجات' : locale === 'nl' ? 'Nieuw in de winkel' : 'New in the shop') %></h2></div><a class="text-link" href="/shop?sort=newest"><%= pageText(locale === 'ckb' ? 'هەموو بەرهەمەکان ←' : locale === 'ar' ? 'كل المنتجات ←' : locale === 'nl' ? 'Bekijk alle producten →' : 'See all products →') %></a></div><div class="product-grid product-grid-signature"><% newProducts.forEach(p=>{ %><%- include('partials/product-card',{p:p}) %><% }) %></div></section>
<% } %>

<% if (aiEnabled) { %><section class="container section ai-card"><div><span class="eyebrow"><%= pageText("OPTIONAL AI") %></span><h2><%= pageText(locale==='nl'?'Hulp nodig bij het kiezen?':locale==='ckb'?'یارمەتی بۆ هەڵبژاردن؟':locale==='ar'?'هل تحتاج إلى مساعدة في الاختيار؟':'A little help choosing?') %></h2><p><%= pageText(locale==='nl'?'Stel een korte productvraag aan de winkelassistent.':locale==='ckb'?'پرسیارێکی کورت دەربارەی بەرهەمەکان بکە.':locale==='ar'?'اطرح سؤالًا قصيرًا عن منتجات المتجر.':'Ask a quick question about products in this store.') %></p></div><div class="ai-form"><label for="ai-input"><%= pageText(locale==='nl'?'Je vraag':locale==='ckb'?'پرسیارەکەت':locale==='ar'?'سؤالك':'Your question') %></label><div class="ai-input-row"><input id="ai-input" maxlength="500" placeholder="<%= pageText(locale==='nl'?'Wat is handig voor dagelijks woon-werkverkeer?':locale==='ckb'?'کام بەرهەم بۆ بەکارهێنانی ڕۆژانە باشە؟':locale==='ar'?'ما المنتج المناسب للاستخدام اليومي؟':'What works well for daily travel?') %>"><button type="button" class="btn btn-dark" data-ai-ask><%= pageText(locale==='nl'?'Vraag':locale==='ckb'?'بپرسە':locale==='ar'?'اسأل':'Ask') %></button></div><p class="field-note"><%= pageText(locale==='nl'?'Je vraag en maximaal 12 openbare productgegevens (naam, omschrijving, actuele verkoopprijs met winkelvaluta, verkoopbare voorraad na reserveringen en productslug) worden naar de ingestelde AI-provider gestuurd. Duidelijke e-mailadressen, telefoonnummers, IBAN-achtige waarden en herkenbare straatadressen worden verwijderd, maar niet alle persoonlijke gegevens kunnen automatisch worden herkend. Deel hier daarom nooit namen, adressen, contactgegevens, rekeningnummers, bestelgegevens, wachtwoorden of betaalgegevens. De externe AI-provider verwerkt de verzonden tekst volgens zijn eigen voorwaarden en bewaartermijn.':locale==='ckb'?'پرسیارەکەت و زۆرترین ١٢ زانیاریی گشتیی بەرهەم (ناو، وەسف، نرخی فرۆشتنی ئێستا بە دراوی فرۆشگا، بڕی فرۆشتنی بەردەست دوای لەبەرگرتنەوە و بەستەری بەرهەم) بۆ دابینکەری AI دەنێردرێن. ئیمەیڵی ئاشکرا، ژمارەی تەلەفۆن، IBAN ـی هاوشێوە و ناونیشانی شەقام کە بە ئاشکرایی بناسرێتەوە دەسڕدرێنەوە، بەڵام هەموو زانیارییە کەسییەکان ناناسێتەوە. ناو، ناونیشان، زانیاریی پەیوەندی، ژمارەی هەژمار، وردەکاریی داواکاری، وشەی نهێنی یان زانیاریی پارەدان مەنووسە. دابینکەری دەرەکی AI دەقە نێردراوەکان بە پێی مەرج و ماوەی هەڵگرتنی خۆی پرۆسێس دەکات.':locale==='ar'?'يُرسل سؤالك وما يصل إلى 12 حقلًا عامًا للمنتجات (الاسم والوصف وسعر البيع الحالي بعملة المتجر والكمية المتاحة للبيع بعد الحجوزات ومعرّف المنتج) إلى مزود الذكاء الاصطناعي المُعدّ. تُزال عناوين البريد الواضحة وأرقام الهواتف والقيم الشبيهة بـ IBAN وعناوين الشوارع التي يمكن التعرف عليها قبل الإرسال، لكن لا يمكن اكتشاف كل البيانات الشخصية تلقائيًا. لا تكتب أسماء أو عناوين أو معلومات اتصال أو أرقام حسابات أو تفاصيل طلبات أو كلمات مرور أو بيانات دفع. يعالج مزود الذكاء الاصطناعي الخارجي النص المرسل وفق شروطه وفترة الاحتفاظ الخاصة به.':'Your question and up to 12 public product fields (name, description, current selling price in the store currency, sellable stock after reservations and product slug) are sent to the configured AI provider. Obvious email addresses, phone numbers, IBAN-like values and recognizable street addresses are removed, but not all personal information can be detected automatically. Never enter names, addresses, contact details, account numbers, order details, passwords or payment data. The external AI provider processes submitted text under its own terms and retention policy.') %></p><div id="ai-answer" class="ai-answer" aria-live="polite"></div></div></section><% } %>
<%- include('partials/footer') %>