<%- include('partials/header',{title:mode==='register'?'Create account':'Sign in'}) %>
<section class="auth-wrap" aria-labelledby="auth-title"><div class="auth-card"><nav class="auth-tabs" aria-label="<%= pageText('Account access') %>"><a href="<%= next ? `/login?next=${encodeURIComponent(next)}` : '/login' %>" <% if(mode==='login'){ %>aria-current="page"<% } %>><%= pageText("Sign in") %></a><a href="<%= next ? `/register?next=${encodeURIComponent(next)}` : '/register' %>" <% if(mode==='register'){ %>aria-current="page"<% } %>><%= pageText("Create account") %></a></nav><span class="eyebrow"><%= pageText(mode==='register'?'NEW CUSTOMER':'WELCOME BACK') %></span><h1 id="auth-title"><%= pageText(mode==='register'?'Create your account':'Welcome back') %></h1><p class="muted"><%= pageText(mode==='register'?'Join ShopEasy to track orders and check out faster.':'Sign in to your ShopEasy account.') %></p><% if(typeof passwordReset !== 'undefined' && passwordReset){ %><div class="success-alert" role="status"><%= pageText("Your password has been reset. Sign in with your new password.") %></div><% } %><% if(typeof emailVerified !== 'undefined' && emailVerified){ %><div class="success-alert" role="status"><%= pageText("Your email address has been verified. You can sign in now.") %></div><% } %><% if(typeof signInCancelled !== 'undefined' && signInCancelled){ %><div class="success-alert" role="status"><%= pageText("Sign-in was cancelled. Enter your credentials whenever you are ready to try again.") %></div><% } %><% if(error){ %><div class="alert" id="auth-error" role="alert" tabindex="-1" data-auth-error><%= pageText(error) %></div><% } %><% if(typeof notice !== 'undefined' && notice){ %><div class="auth-next-step" role="status"><%= pageText(notice) %></div><% } %><% if(mode==='register'){ %><form class="form-stack" method="post" action="/register"><input type="hidden" name="next" value="<%= next||'/account' %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><label><%= pageText("Full name") %><input type="text" name="fullName" required maxlength="120" autocomplete="name" placeholder="<%= pageText('Enter your full name') %>" value="<%= fullName||'' %>"></label><label><%= pageText("Email address") %><input type="email" name="email" required maxlength="120" autocomplete="email" autocapitalize="none" spellcheck="false" placeholder="<%= pageText('Enter your email address') %>" value="<%= email||'' %>"></label><label><%= pageText("Password") %><input type="password" name="password" required minlength="15" maxlength="200" autocomplete="new-password" placeholder="<%= pageText('Create a password') %>"><span class="field-note"><%= pageText("Use 15–200 characters. Avoid common or repeated passwords.") %></span></label><label><%= pageText("Confirm password") %><input type="password" name="confirmPassword" required minlength="15" maxlength="200" autocomplete="new-password" placeholder="<%= pageText('Re-enter your password') %>"></label><label class="checkbox-inline auth-terms"><input type="checkbox" name="termsAccepted" required><span><%= pageText("I agree to the ") %><a href="/terms" target="_blank" rel="noopener"><%= pageText("Terms & Conditions") %></a><%= pageText(" and ") %><a href="/privacy" target="_blank" rel="noopener"><%= pageText("Privacy Policy") %></a><%= pageText(".") %></span></label><button type="submit" class="btn btn-dark btn-wide"><%= pageText("Create account") %></button></form><p class="switch-auth"><%= pageText("Already have an account? ") %><a href="<%= next ? `/login?next=${encodeURIComponent(next)}` : '/login' %>"><%= pageText("Sign in") %></a></p><% } else { %><form class="form-stack" method="post" action="/login"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="next" value="<%= next %>"><label><%= pageText("Email address") %><input type="email" name="email" required maxlength="120" autocomplete="username" autocapitalize="none" spellcheck="false" placeholder="<%= pageText('Enter your email address') %>" value="<%= email||'' %>"></label><label><%= pageText("Password") %><input type="password" name="password" required maxlength="200" id="login-password" autocomplete="current-password" placeholder="<%= pageText('Enter your password') %>"></label><div class="auth-help"><button type="button" class="auth-password-toggle" data-password-toggle data-labels="<%= JSON.stringify({show:pageText('Show password'),hide:pageText('Hide password')}) %>" aria-controls="login-password" aria-pressed="false" hidden><%= pageText("Show password") %></button><a class="text-link" href="<%= next ? `/forgot-password?next=${encodeURIComponent(next)}` : '/forgot-password' %>"><%= pageText("Forgot password?") %></a></div><button type="submit" class="btn btn-dark btn-wide"><%= pageText("Sign in") %></button></form><p class="switch-auth"><%= pageText("Don\u2019t have an account yet? ") %><a href="<%= next ? `/register?next=${encodeURIComponent(next)}` : '/register' %>"><%= pageText("Create an account") %></a></p><div class="rule"></div><details><summary><%= pageText("Need an email verification message?") %></summary><form class="form-stack" method="post" action="/verify-email/resend"><input type="hidden" name="_csrf" value="<%= csrf %>"><label><%= pageText("Email address") %><input type="email" name="email" required maxlength="120" autocomplete="username" autocapitalize="none" spellcheck="false" value="<%= email||'' %>"></label><button type="submit" class="btn btn-dark"><%= pageText("Resend verification") %></button></form></details><% } %><p class="auth-browse"><a href="/shop"><%= pageText("Continue shopping") %> <span aria-hidden="true"><%= pageText("\u2192") %></span></a></p></div></section>
<%- include('partials/footer') %>
