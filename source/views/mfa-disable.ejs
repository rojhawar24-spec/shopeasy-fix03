<%- include('partials/header',{title:title||'Disable authenticator'}) %>
<section class="auth-wrap">
  <div class="auth-card">
    <span class="eyebrow"><%= customerText("MANAGER SECURITY") %></span>
    <h1><%= customerText("Reset two-factor authentication") %></h1>
    <p class="muted"><%= customerText("Manager accounts cannot remain without MFA. This action turns off the current enrollment, revokes all sessions and requires a fresh authenticator setup the next time you sign in.") %></p>
    <% if(email){ %><p><strong><%= customerText("Account:") %></strong> <%= email %></p><% } %>
    <% if(error){ %><div class="alert" role="alert"><%= customerText(error) %></div><% } %>
    <form class="form-stack" method="post" action="/mfa/disable">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label for="password"><%= customerText("Current password") %></label>
      <input id="password" name="password" type="password" autocomplete="current-password" maxlength="200" required>
      <label for="code"><%= customerText("Current authenticator code or unused recovery code") %></label>
      <input id="code" name="code" type="text" autocomplete="one-time-code" maxlength="64" required>
      <button type="submit" class="btn btn-dark btn-wide"><%= customerText("Reset MFA and revoke sessions") %></button>
    </form>
    <p><a class="text-link" href="/admin"><%= customerText("Cancel and return to the dashboard") %></a></p>
  </div>
</section>
<%- include('partials/footer') %>
