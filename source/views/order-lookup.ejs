<%- include('partials/header',{title:'Track an order'}) %>
<section class="container page-head order-lookup-head"><%- include('partials/back-button', { fallback: '/' }) %><div><span class="eyebrow"><%= customerText("ORDER SUPPORT") %></span><h1><%= customerText("Track an order") %></h1><p><%= customerText("Enter your order number and checkout email. Sign in for an account order. For a guest order, use the checkout browser or your saved private access code.") %></p></div></section>
<section class="container section"><div class="panel"><div class="panel-heading-v5"><div><span class="eyebrow"><%= customerText("ORDER LOOKUP") %></span><h2><%= customerText("Check the latest update") %></h2><p class="muted"><%= customerText("Order details require proof of access as well as matching order and email details.") %></p></div></div>
<% if(typeof securityNotice!=='undefined' && securityNotice){ %><div class="alert" role="status"><%= customerText("Your security check expired. The lookup was not submitted. Enter your details again on this secure form.") %></div><% } %>
<form method="post" action="/order-lookup" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><label><%= customerText("Order number") %><input name="orderNumber" inputmode="numeric" pattern="[0-9]{1,12}" required maxlength="12" value="<%= typeof lookupOrderNumber!=='undefined'?lookupOrderNumber:'' %>"></label><label><%= customerText("Email address") %><input type="email" name="email" autocomplete="email" required maxlength="120"></label><label><%= customerText("Guest order access code (if saved)") %><input type="password" name="guestAccessToken" autocomplete="off" maxlength="200" spellcheck="false" autocapitalize="none" aria-describedby="guest-access-help"></label><p class="field-note" id="guest-access-help"><%= customerText("Leave this blank when using the browser where you placed the guest order. Keep access codes private.") %></p><button class="btn btn-dark" type="submit"><%= customerText("Find order") %></button></form>
<% if(error){ %><div class="alert" role="alert"><%= customerText(error) %></div><% } %><% if(typeof returnRequested!=='undefined' && returnRequested){ %><div class="success-alert" role="status"><%= customerText("Your return request was sent to the store for review.") %></div><% } %>
<% if(order){ const statusNames={pending:'Received',paid:'Payment recorded',processing:'Preparing',shipped:'Shipped',completed:'Delivered',cancelled:'Cancelled'}; const deliveryText=order.status==='completed'?'Delivered':order.status==='cancelled'?'Not available':'A delivery date has not yet been confirmed by the store or carrier.'; %>
<div class="rule"></div><h2><%= customerText("Order #") %><%= order.id %></h2><p><strong><%= customerText("Status:") %></strong> <%= statusNames[order.status]||order.status %></p><p><strong><%= customerText("Delivery:") %></strong> <%= deliveryText %></p><h3><%= customerText("Items") %></h3><ul><% order.items.forEach(item=>{ %><li><span translate="no" data-no-translate><%= item.product_name %><% if(item.variant_value){ %> — <%= item.variant_name %>: <%= item.variant_value %><% } %><% if(item.variant_value_2){ %> · <%= item.variant_name_2 %>: <%= item.variant_value_2 %><% } %></span> × <%= item.quantity %></li><% }) %></ul><p><strong><%= customerText("Total:") %></strong> <%= formatPrice(order.total_cents,order.currency) %></p>
<% if(order.payment_provider==='bank_transfer'&&(typeof bankTransferInfo!=='undefined' && bankTransferInfo)&&order.status==='pending'){ %><div class="tip-box"><strong><%= customerText(locale==='nl'?'Bankgegevens voor je overschrijving':locale==='ckb'?'زانیاریی بانکی بۆ گواستنەوەکەت':locale==='ar'?'بيانات التحويل المصرفي':'Bank transfer details') %></strong><p><%= bankTransferInfo.bankName %> · <%= bankTransferInfo.accountHolder %></p><p><strong><%= customerText(locale==='nl'?'IBAN / rekeningnummer':locale==='ckb'?'IBAN / ژمارەی هەژمار':locale==='ar'?'IBAN / رقم الحساب':'IBAN / account') %>:</strong> <code><%= bankTransferInfo.account %></code></p><% if(bankTransferInfo.bic){ %><p><strong>BIC/SWIFT:</strong> <code><%= bankTransferInfo.bic %></code></p><% } %><p><strong><%= customerText(locale==='nl'?'Betalingsreferentie':locale==='ckb'?'ژمارەی تایبەتی پارەدان':locale==='ar'?'مرجع الدفع':'Payment reference') %>:</strong> <code><%= bankTransferInfo.reference %></code></p><p><strong><%= customerText(locale==='nl'?'Bedrag':locale==='ckb'?'بڕی پارە':locale==='ar'?'المبلغ':'Amount') %>:</strong> <%= formatPrice(order.total_cents,order.currency) %></p><% if(bankTransferInfo.instructions){ %><p><%= bankTransferInfo.instructions %></p><% } %><p class="field-note"><%= customerText(locale==='nl'?'Je bestelling blijft onbetaald totdat de winkel de overschrijving heeft gecontroleerd.':locale==='ckb'?'داواکارییەکەت تا پشتڕاستکردنەوەی گواستنەوەکە لەلایەن فرۆشگا پارەدراو نابێت.':locale==='ar'?'يبقى طلبك غير مدفوع حتى يتحقق المتجر من وصول التحويل.':'Your order stays unpaid until the store verifies the incoming transfer.') %></p></div><% } %>
<% if(order.returnable){ %><div class="rule"></div><h3><%= customerText("Request a return") %></h3><form method="post" action="/order/<%= order.id %>/return-request" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="email" value="<%= lookupEmail||'' %>"><label><%= customerText("Item") %><select name="orderItemId" required><% order.items.forEach(item=>{ %><option value="<%= item.id %>" translate="no" data-no-translate><%= item.product_name %><% if(item.variant_value){ %> — <%= item.variant_name %>: <%= item.variant_value %><% } %><% if(item.variant_value_2){ %> · <%= item.variant_name_2 %>: <%= item.variant_value_2 %><% } %> — <%= customerText(locale==='nl'?'gekocht':'purchased') %> <%= item.quantity %></option><% }) %></select></label><label><%= customerText("Quantity") %><input type="number" name="quantity" min="1" max="99" value="1" required></label><label><%= customerText("Request type") %><select name="requestType" required><option value="return"><%= customerText("Return") %></option><option value="exchange"><%= customerText("Exchange") %></option><option value="refund"><%= customerText("Refund review") %></option></select></label><label><%= customerText("Reason") %><select name="reasonCode" required><option value="damaged"><%= customerText("Damaged item") %></option><option value="wrong_item"><%= customerText("Wrong item received") %></option><option value="not_as_described"><%= customerText("Not as described") %></option><option value="changed_mind"><%= customerText("Changed my mind") %></option><option value="other"><%= customerText("Other") %></option></select></label><label><%= customerText("Additional details (optional)") %><textarea name="note" maxlength="800" rows="3"></textarea></label><button class="btn btn-dark" type="submit"><%= customerText("Send return request") %></button></form><% } %>
<% } %></div></section><%- include('partials/footer') %>
