<%- include('partials/header',{title:`Order #${order.id}`}) %>
<%
const directCancellationAllowed=typeof canCancelOpenOrder==='function'&&canCancelOpenOrder(order);
const cancellationRequestAllowed=typeof canRequestOrderCancellation==='function'&&canRequestOrderCancellation(order);
const cancellationRequestPending=typeof hasPendingCancellationRequest==='function'&&hasPendingCancellationRequest(order);
const cancellationNoticeKey=['requested','already-requested'].includes(cancelResult)&&!cancellationRequestPending||cancelResult==='cancelled'&&order.status!=='cancelled'?'changed':cancelResult;
const statusLabels={
  fr:{pending:'En attente de confirmation',processing:'Acceptée · en préparation',shipped:'Expédiée · en livraison',completed:'Livrée',cancelled:'Annulée',paid:'Payée'},
  en:{pending:'Waiting for confirmation',processing:'Accepted · preparing',shipped:'Shipped · out for delivery',completed:'Delivered',cancelled:'Cancelled',paid:'Paid'},
  ckb:{pending:'چاوەڕوانی پشتڕاستکردنەوە',processing:'پەسەندکرا · ئامادە دەکرێت',shipped:'نێردراوە · لە ڕێگای گەیاندندایە',completed:'گەیێندراوە',cancelled:'هەڵوەشێنراوەتەوە',paid:'پارە دراوە'},
  ar:{pending:'بانتظار التأكيد',processing:'تم القبول · قيد التجهيز',shipped:'تم الشحن · في طريق التوصيل',completed:'تم التسليم',cancelled:'ملغى',paid:'مدفوع'},
  nl:{pending:'Wacht op bevestiging',processing:'Geaccepteerd · wordt klaargemaakt',shipped:'Verzonden · onderweg',completed:'Geleverd',cancelled:'Geannuleerd',paid:'Betaald'}
};
const stateText=statusLabels[locale]||statusLabels.en;
const statusFlow=order.status==='paid'?['paid','processing','shipped','completed']:['pending','processing','shipped','completed'];
const statusIndex=Math.max(0,statusFlow.indexOf(order.status));
const providerPendingCopy={"en":"Card payment is still awaiting confirmation. Check the current payment status or contact the store before trying again.","nl":"Je kaartbetaling wacht nog op bevestiging. Controleer de huidige betaalstatus of neem contact op met de winkel voordat je het opnieuw probeert.","fr":"Le paiement par carte attend encore une confirmation. Vérifiez son statut actuel ou contactez la boutique avant de réessayer.","ar":"لا يزال الدفع بالبطاقة بانتظار التأكيد. تحقق من حالة الدفع الحالية أو اتصل بالمتجر قبل المحاولة مرة أخرى.","ckb":"پارەدانی کارت هێشتا چاوەڕوانی پشتڕاستکردنەوەیە. پێش هەوڵدانەوە دۆخی ئێستای پارەدان بپشکنە یان پەیوەندی بە فرۆشگا بکە."};
const cancelMessages={
  'provider-pending':providerPendingCopy[locale]||providerPendingCopy.en,
  cancelled:locale==='ckb'?'داواکارییەکە هەڵوەشێنرایەوە.':locale==='ar'?'تم إلغاء الطلب.':locale==='nl'?'Je bestelling is geannuleerd. Je kunt verder winkelen.':'Your order was cancelled. You can return to shopping.',
  requested:locale==='ckb'?'داواکاریی هەڵوەشاندنەوە نێردرا؛ فرۆشگا پێداچوونەوەی بۆ دەکات.':locale==='ar'?'تم إرسال طلب الإلغاء إلى المتجر للمراجعة.':locale==='nl'?'Je annuleringsverzoek is naar de winkel gestuurd ter beoordeling.':'Your cancellation request was sent to the store for review.',
  'already-requested':locale==='ckb'?'داواکارییەکەت پێشتر نێردراوە.':locale==='ar'?'تم إرسال طلب الإلغاء من قبل.':locale==='nl'?'Je hebt al een annulering aangevraagd.':'You have already requested cancellation.',
  unavailable:locale==='ckb'?'ئەم داواکارییە لەم قۆناغەدا ناتوانرێت هەڵبوەشێنرێتەوە.':locale==='ar'?'لا يمكن إلغاء هذا الطلب في مرحلته الحالية.':locale==='nl'?'Deze bestelling kan in de huidige status niet worden geannuleerd.':'This order cannot be cancelled in its current state.',
  'reason-required':locale==='ckb'?'تکایە هۆکار بنووسە.':locale==='ar'?'يرجى إدخال سبب طلب الإلغاء.':locale==='nl'?'Vermeld een reden voordat je annulering aanvraagt.':'Enter a reason before requesting cancellation.',
  changed:locale==='ckb'?'دۆخی داواکاری گۆڕاوە. پەڕەکە نوێ بکەرەوە.':locale==='ar'?'تغيرت حالة الطلب. حدّث الصفحة.':locale==='nl'?'De status van je bestelling is gewijzigd. Vernieuw de pagina en controleer de actuele status.':'The order status changed. Refresh and check the current status.'
};
%>
<% if(typeof securityNotice!=='undefined' && securityNotice){ %><section class="container"><div class="alert" role="status"><%= customerText(locale==='nl'?'Je beveiligingscontrole is verlopen. Er is geen wijziging aan de bestelling verzonden. Controleer de huidige bestelstatus voordat je een nieuw verzoek indient.':'Your security check expired. No order update was submitted. Review the current order status before sending another request.') %></div></section><% } %>
<section class="container page-head order-page-head">
  <%- include('partials/back-button', { fallback: '/account' }) %>
  <div class="order-head-line"><div><span class="eyebrow"><%= customerText("ORDER") %></span><h1>#<%= order.id %></h1></div><button type="button" class="btn btn-light" data-print-order><%= customerText("Print / save PDF") %></button></div>
  <div class="order-current-state"><span class="status status-<%= order.status %>"><%= stateText[order.status]||order.status %></span><time datetime="<%= order.created_at %>" title="<%= formatDateTimeDisplay(order.created_at,storeTimeZone) %>"><%= formatRelativeTime(order.created_at) %></time></div>
</section>

<% if(cancellationNoticeKey && cancelMessages[cancellationNoticeKey]){ %><section class="container"><div class="<%= cancellationNoticeKey==='cancelled'?'success-alert':'alert' %> order-notice" role="status"><%= customerText(cancelMessages[cancellationNoticeKey]) %></div></section><% } %>

<section class="container order-status-panel">
  <% if(order.status==='cancelled'){ %><div class="cancelled-state"><span class="state-icon">!</span><div><strong><%= customerText("Order cancelled") %></strong><p><%= customerText("The order will not be delivered.") %></p></div></div><% } else { %>
    <div class="status-panel-title"><div><span class="eyebrow"><%= customerText("ORDER PROGRESS") %></span><h2><%= customerText("Track your order") %></h2></div><strong><%= stateText[order.status]||order.status %></strong></div>
    <div class="order-timeline" role="group" aria-label="<%= customerText("Order progress") %>">
      <% statusFlow.forEach((state,idx)=>{ const done=idx<=statusIndex; %><div class="timeline-step <%= done?'done':'' %> <%= idx===statusIndex?'current':'' %>"><span class="timeline-dot"><%= idx<statusIndex?'✓':idx+1 %></span><div><strong><%= customerText(stateText[state]) %></strong><small><%= customerText(state==='paid'?'Payment received; awaiting store confirmation.':state==='pending'?'Order received':state==='processing'?'Store is preparing it':state==='shipped'?'Delivery is on the way':'Order completed') %></small></div></div><% if(idx<statusFlow.length-1){ %><span class="timeline-line <%= idx<statusIndex?'done':'' %>" aria-hidden="true"></span><% } %><% }) %>
    </div>
  <% } %>
</section>

<section class="container order-layout order-layout-v5">
  <div class="order-main-stack">
    <div class="panel order-items-card"><div class="panel-heading-v5"><div><span class="eyebrow"><%= customerText("ORDER CONTENTS") %></span><h2><%= customerText("Items") %></h2></div><span><%= order.items.length %><%= customerText(" item") %><%= customerText(order.items.length===1?'':'s') %></span></div>
      <div class="order-items-v5"><% order.items.forEach(i=>{ %><div class="order-product-row"><div class="order-product-thumb"><img src="<%= safeImageUrl(i.image_url||'/assets/product-placeholder.svg') %>" data-fallback-src="/assets/product-placeholder.svg" alt="" width="120" height="140" loading="lazy" decoding="async"></div><div class="order-product-info"><strong data-no-translate><%= i.product_name %></strong><% if(i.variant_value){ %><span><%= i.variant_name %>: <%= i.variant_value %><% if(i.variant_value_2){ %> · <%= i.variant_name_2 %>: <%= i.variant_value_2 %><% } %></span><% } %><small><%= customerText("Quantity × ") %><%= i.quantity %></small></div><strong class="order-product-price"><%= formatPrice(i.total_cents,order.currency) %></strong></div><% }) %></div>
      <div class="order-total-box"><div><span><%= customerText("Items subtotal") %></span><strong><%= formatPrice(order.subtotal_cents,order.currency) %></strong></div><% if(order.automatic_discount_cents>0){ %><div><span><%= customerText("Automatic product discounts") %></span><strong>-<%= formatPrice(order.automatic_discount_cents,order.currency) %></strong></div><% } %><% if(order.discount_cents>0){ %><div><span><%= customerText("Coupon discount") %></span><strong>-<%= formatPrice(order.discount_cents,order.currency) %></strong></div><% } %><div><span><%= customerText("Delivery fee") %></span><strong><%= order.shipping_cents===0?'Free':formatPrice(order.shipping_cents,order.currency) %></strong></div><% if(order.tax_rate_bps!==null&&order.tax_rate_bps!==undefined){ %><div><span><%= customerText(order.tax_included?(locale==='nl'?'Belasting inbegrepen in de prijzen':locale==='ckb'?'باژ لە نرخەکاندا هەژمار کراوە':locale==='ar'?'الضريبة مشمولة في الأسعار':'Tax included in prices'):(locale==='nl'?'Belasting toegevoegd':locale==='ckb'?'باژ زیاد کراوە':locale==='ar'?'تمت إضافة الضريبة':'Tax added')) %> (<%= (Number(order.tax_rate_bps)/100).toFixed(2) %>%)</span><strong><%= formatPrice(order.tax_cents||0,order.currency) %></strong></div><% } else { %><p class="field-note"><%= customerText("No regional tax rule was recorded for this order; this is not a tax-compliance confirmation.") %></p><% } %><div class="grand-total"><span><%= customerText("Total") %></span><strong><%= formatPrice(order.total_cents,order.currency) %></strong></div></div>
    </div>
  </div>

  <div class="order-side-stack">
    <div class="panel order-info-card"><div class="panel-heading-v5"><div><span class="eyebrow"><%= customerText("DELIVERY") %></span><h2><%= customerText("Delivery details") %></h2></div></div><div class="delivery-person"><span class="person-avatar"><%= (order.shipping_name||'?').slice(0,1).toUpperCase() %></span><div><strong><%= order.shipping_name %></strong><span><%= customerText("Delivery address") %></span></div></div><p class="address-block"><%= order.shipping_address %><br><%= order.shipping_postal_code %> <%= order.shipping_city %><br><%= order.shipping_country %></p><div class="payment-chip"><span><%= customerText(locale==='nl'?'Betaalmethode':locale==='ckb'?'شێوازی پارەدان':locale==='ar'?'طريقة الدفع':'Payment method') %></span><strong><%= customerText(order.payment_provider==='cash_on_delivery'?(locale==='nl'?'Contant bij levering':'Cash on delivery'):order.payment_provider==='bank_transfer'?(locale==='nl'?'Bankoverschrijving':locale==='ckb'?'گواستنەوەی بانکی':locale==='ar'?'تحويل مصرفي':'Bank transfer'):order.payment_provider==='mollie'?'Card payment':order.payment_provider==='gift_card'?'Gift card':'Payment method') %></strong></div><% if(order.payment_provider==='bank_transfer'&&(typeof bankTransferInfo!=='undefined' && bankTransferInfo)&&order.status==='pending'){ %><div class="tip-box"><strong><%= customerText(locale==='nl'?'Betaal per bankoverschrijving':locale==='ckb'?'پارەدان بە گواستنەوەی بانکی':locale==='ar'?'الدفع بالتحويل المصرفي':'Pay by bank transfer') %></strong><p><%= bankTransferInfo.bankName %> · <%= bankTransferInfo.accountHolder %></p><p><strong><%= customerText(locale==='nl'?'Rekening':'Account') %>:</strong> <code><%= bankTransferInfo.account %></code></p><% if(bankTransferInfo.bic){ %><p><strong>BIC/SWIFT:</strong> <code><%= bankTransferInfo.bic %></code></p><% } %><p><strong><%= customerText(locale==='nl'?'Referentie':'Reference') %>:</strong> <code><%= bankTransferInfo.reference %></code></p><p><strong><%= formatPrice(order.total_cents,order.currency) %></strong></p><% if(bankTransferInfo.instructions){ %><p><%= bankTransferInfo.instructions %></p><% } %><p class="field-note"><%= customerText(locale==='nl'?'Je bestelling blijft onbetaald totdat de winkel de ontvangst controleert.':'Your order remains unpaid until the store verifies the incoming transfer.') %></p></div><% } %><% if(order.customer_note){ %><div class="customer-note"><span><%= customerText("Order note") %></span><p><%= order.customer_note %></p></div><% } %></div>

    <div class="panel order-action-card">
      <% if((cancellationRequestAllowed||cancellationRequestPending)&&order.status==='pending'&&order.payment_provider==='bank_transfer'){ %><span class="eyebrow"><%= customerText("CHANGES") %></span><h2><%= customerText("Request cancellation") %></h2><% if(cancellationRequestPending){ %><div class="alert" role="status"><%= customerText("Your cancellation request is waiting for the store's decision. Do not send another bank transfer while the request is being reviewed.") %></div><p><strong><%= customerText("Reason:") %></strong> <%= order.cancellation_request_reason %></p><% } else { %><p><%= customerText("Bank transfers can arrive after they are sent. To avoid releasing reserved stock while a payment may still be in transit, the store must review your cancellation request.") %></p><form method="post" action="/account/order/<%= order.id %>/cancel" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><label><%= customerText("Reason *") %><textarea name="reason" required maxlength="500" rows="3" placeholder="<%= customerText("Explain why you need to cancel this bank-transfer order.") %>"></textarea></label><button class="btn btn-light" type="submit"><%= customerText("Request cancellation") %></button></form><% } %>
      <% } else if(directCancellationAllowed){ %><span class="eyebrow"><%= customerText("CHANGES") %></span><h2><%= customerText("Need to cancel?") %></h2><p><%= customerText("You may cancel while the store is still reviewing the order.") %></p><form method="post" action="/account/order/<%= order.id %>/cancel" class="form-stack" data-confirm="<%= customerText("Cancel this order?") %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><label><%= customerText("Reason (optional)") %><textarea name="reason" maxlength="500" rows="3" placeholder="<%= customerText("I no longer need this item.") %>"></textarea></label><button class="btn btn-light" type="submit"><%= customerText("Cancel order") %></button></form>
      <% } else if(cancellationRequestAllowed||cancellationRequestPending){ %><span class="eyebrow"><%= customerText("CHANGES") %></span><h2><%= customerText(locale==='nl'?'Annulering aanvragen':locale==='ckb'?'داوای هەڵوەشاندنەوە':'Request cancellation') %></h2><% if(cancellationRequestPending){ %><div class="alert" role="status"><%= customerText(locale==='nl'?'Je annuleringsverzoek wacht op beoordeling door de winkel.':locale==='ckb'?'داواکاریی هەڵوەشاندنەوەکەت چاوەڕوانی پێداچوونەوەی فرۆشگایە.':"Your cancellation request is waiting for the store's decision.") %></div><p><strong><%= customerText(locale==='nl'?'Reden':locale==='ckb'?'هۆکار':'Reason') %>:</strong> <%= order.cancellation_request_reason %></p><% } else { %><p><%= customerText(locale==='nl'?'De winkel heeft je bestelling aanvaard. Je kunt vóór verzending een annulering aanvragen.':locale==='ckb'?'فرۆشگا داواکارییەکەت پەسەند کردووە. پێش ناردنی کاڵا دەتوانیت داوای هەڵوەشاندنەوە بکەیت.':'The store accepted your order. You can request cancellation before it ships.') %></p><form method="post" action="/account/order/<%= order.id %>/cancel" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><label><%= customerText(locale==='nl'?'Reden *':locale==='ckb'?'هۆکار *':'Reason *') %><textarea name="reason" required maxlength="500" rows="3" placeholder="<%= locale==='nl'?'Leg uit waarom je wilt annuleren.':locale==='ckb'?'هۆکاری داوای هەڵوەشاندنەوە بنووسە.':'Explain why you need to cancel.' %>"></textarea></label><button class="btn btn-light" type="submit"><%= customerText(locale==='nl'?'Annulering aanvragen':locale==='ckb'?'داوای هەڵوەشاندنەوە':'Request cancellation') %></button></form><% } %>
      <% } else if(order.status==='pending'&&order.payment_provider==='mollie'){ %><span class="eyebrow"><%= customerText('PAYMENT') %></span><h2><%= customerText('Payment status') %></h2><p><%= providerPendingCopy[locale]||providerPendingCopy.en %></p>
      <% } else if(order.status==='paid'||order.status==='processing'){ %><span class="eyebrow"><%= customerText('PAYMENT') %></span><h2><%= customerText(locale==='nl'?'Betaald · wijziging nodig?':locale==='ckb'?'پارە دراوە · پێویستت بە گۆڕانکارییە؟':locale==='ar'?'مدفوع · هل تحتاج إلى تغيير؟':'Payment received') %></h2><p><%= customerText(locale==='nl'?'Deze bestelling is al betaald. ShopEasy voert geen automatische terugbetaling uit via een annuleringsverzoek. Neem vóór verzending contact op met de winkel; na levering kun je via deze pagina een retour- of terugbetalingsverzoek indienen.':locale==='ckb'?'پارەی ئەم داواکارییە وەرگیراوە. ShopEasy بە داواکاریی هەڵوەشاندنەوە پارە بە ئۆتۆماتیکی ناگەڕێنێتەوە. پێش ناردنی کاڵا پەیوەندی بە فرۆشگا بکە؛ دوای گەیاندن دەتوانیت داواکاریی گەڕاندنەوە بنێریت.':locale==='ar'?'تم استلام الدفع. لا ينفذ ShopEasy استردادًا تلقائيًا عبر طلب الإلغاء. اتصل بالمتجر قبل الشحن؛ وبعد التسليم يمكنك تقديم طلب إرجاع أو استرداد من هذه الصفحة.':'Payment has been received. ShopEasy does not automatically refund paid orders through a cancellation request. Contact the store before shipment; after delivery, you can submit a return or refund request from this page.') %></p>
      <% } else if(order.status==='shipped'){ %><span class="eyebrow"><%= customerText("DELIVERY") %></span><h2><%= customerText("Delivery in progress") %></h2><p><%= customerText("Your order is already out for delivery. Contact the store using the contact details on its policy page.") %></p><a class="btn btn-light" href="/shipping-returns"><%= customerText("Shipping & returns") %></a>
      <% } else if(order.status==='completed'){ %><span class="eyebrow"><%= customerText("AFTER DELIVERY") %></span><h2><%= customerText("Need a return?") %></h2><p><%= customerText("This order is marked delivered. Use the returns policy to ask for a return or refund.") %></p><a class="btn btn-light" href="/shipping-returns"><%= customerText("Shipping & returns") %></a>
      <% } else { %><span class="eyebrow"><%= customerText("ORDER") %></span><h2><%= customerText("Order closed") %></h2><p><%= customerText("This order is no longer editable.") %></p><% } %>
    </div>
  </div>
</section>
<% if((orderHistory||[]).length){ %><section class="container section"><div class="panel"><div class="panel-heading-v5"><div><span class="eyebrow"><%= customerText("ORDER HISTORY") %></span><h2><%= customerText(locale==='ckb'?'مێژووی داواکاری':locale==='ar'?'سجل الطلب':'Order status history') %></h2><p class="muted"><%= customerText(locale==='ckb'?'هەر گۆڕانکارییەک لە دۆخی داواکاری لێرە پیشان دەدرێت.':locale==='ar'?'يظهر هنا كل تغيير في حالة الطلب.':'Every recorded status change appears here, including cancellation.') %></p></div></div><ol class="form-stack order-history-list"><% orderHistory.forEach(event=>{ %><li><div><strong><%= stateText[event.to_status]||event.to_status %></strong><small class="muted"><time datetime="<%= event.created_at %>" title="<%= formatDateTimeDisplay(event.created_at,storeTimeZone) %>"><%= formatDateTimeDisplay(event.created_at,storeTimeZone) %></time></small><% if(event.note){ %><p class="muted"><%= event.note %></p><% } %></div></li><% }) %></ol></div></section><% } %>

<%
const returnCopy={
  en:{title:'Returns, exchanges & refunds',intro:'Send a request for the items you bought. The store will review it; no money is transferred automatically.',requested:'Requested · waiting for review',approved:'Approved · follow the store instructions',rejected:'Request declined',item_received:'Item received by store',exchange_sent:'Replacement sent',refund_recorded:'Refund recorded by store',completed:'Exchange completed',cancelled:'Request cancelled',request:'Start a request',item:'Item',quantity:'Quantity',type:'Request type',reason:'Why are you requesting this?',return:'Return an item',exchange:'Exchange an item',refund:'Refund review',submit:'Send request',restock:'Return/refund amount is not paid automatically. This page records the store’s decision.'},
  ckb:{title:'گەڕاندنەوە، ئاڵوگۆڕ و گەڕاندنەوەی پارە',intro:'داواکارییەک بۆ کاڵاکەت بنێرە. فرۆشگا پێداچوونەوەی بۆ دەکات؛ پارە بە ئۆتۆماتیکی ناگەڕێندرێتەوە.',requested:'نێردرا · چاوەڕوانی پێداچوونەوە',approved:'پەسەندکرا · ڕێنمایی فرۆشگا ببینە',rejected:'داواکارییەکە ڕەت کرایەوە',item_received:'کاڵاکە گەیشتە فرۆشگا',exchange_sent:'کاڵای جێگرەوە نێردرا',refund_recorded:'گەڕاندنەوەی پارە تۆمار کرا',completed:'ئاڵوگۆڕ تەواو بوو',cancelled:'داواکارییەکە هەڵوەشێنرایەوە',request:'دروستکردنی داواکاری',item:'کاڵا',quantity:'ژمارە',type:'جۆری داواکاری',reason:'هۆکاری داواکاری',return:'گەڕاندنەوەی کاڵا',exchange:'ئاڵوگۆڕی کاڵا',refund:'پێداچوونەوەی گەڕاندنەوەی پارە',submit:'ناردنی داواکاری',restock:'پارە بە ئۆتۆماتیکی ناگەڕێندرێتەوە؛ بڕیار و تۆماری فرۆشگا لێرە پیشان دەدرێت.'},
  ar:{title:'الإرجاع والاستبدال واسترداد الأموال',intro:'أرسل طلبًا بشأن المنتجات التي اشتريتها. سيراجع المتجر الطلب؛ لا يتم تحويل الأموال تلقائيًا.',requested:'تم الطلب · بانتظار المراجعة',approved:'تمت الموافقة · اتبع تعليمات المتجر',rejected:'تم رفض الطلب',item_received:'استلم المتجر المنتج',exchange_sent:'تم إرسال البديل',refund_recorded:'تم تسجيل الاسترداد',completed:'اكتمل الاستبدال',cancelled:'تم إلغاء الطلب',request:'إنشاء طلب',item:'المنتج',quantity:'الكمية',type:'نوع الطلب',reason:'سبب الطلب',return:'إرجاع منتج',exchange:'استبدال منتج',refund:'مراجعة استرداد',submit:'إرسال الطلب',restock:'لا يتم تحويل الأموال تلقائيًا؛ تعرض هذه الصفحة قرار المتجر وسجله.'},
  nl:{title:'Retouren, omruilingen en terugbetalingen',intro:'Dien een verzoek in voor de artikelen die je hebt gekocht. De winkel beoordeelt je verzoek; er wordt niet automatisch geld overgemaakt.',requested:'Aangevraagd · wacht op beoordeling',approved:'Goedgekeurd · volg de instructies van de winkel',rejected:'Verzoek afgewezen',item_received:'Artikel ontvangen door de winkel',exchange_sent:'Vervangend artikel verzonden',refund_recorded:'Terugbetaling geregistreerd door de winkel',completed:'Omruiling afgerond',cancelled:'Verzoek geannuleerd',request:'Een verzoek indienen',item:'Artikel',quantity:'Aantal',type:'Soort verzoek',reason:'Waarom dien je dit verzoek in?',return:'Artikel retourneren',exchange:'Artikel omruilen',refund:'Terugbetaling laten beoordelen',submit:'Verzoek verzenden',restock:'Een retour- of terugbetalingsbedrag wordt niet automatisch uitbetaald. Op deze pagina wordt de beslissing van de winkel geregistreerd.'}
};
const returnText=returnCopy[locale]||returnCopy.en;
const returnErrorText=typeof returnError==='string'?returnError:'';
%>
<section class="container section">
  <div class="panel">
    <div class="panel-heading-v5"><div><span class="eyebrow"><%= customerText("AFTER-SALES") %></span><h2><%= returnText.title %></h2><p class="muted"><%= returnText.intro %></p></div></div>
    <% if(returnErrorText){ %><div class="alert" role="alert"><%= customerText(returnErrorText) %></div><% } %>
    <% if(typeof returnResult!=='undefined'&&returnResult==='requested'){ %><div class="success-alert" role="status"><%= customerText(locale==='ckb'?'داواکارییەکەت بۆ پێداچوونەوە نێردرا.':locale==='ar'?'تم إرسال طلبك إلى المتجر للمراجعة.':locale==='nl'?'Je verzoek is ter beoordeling naar de winkel gestuurd.':'Your request was sent to the store for review.') %></div><% } %>
    <% if((returns||[]).length){ %><div class="table-wrap" role="region" aria-label="<%= customerText("Return requests table") %>" tabindex="0"><table><thead><tr><th><%= customerText("Request") %></th><th><%= customerText("Item") %></th><th><%= customerText("Quantity") %></th><th><%= customerText("Status") %></th><th><%= customerText("Refund recorded") %></th><th><%= customerText("Updated") %></th></tr></thead><tbody><% returns.forEach(r=>{ const statusCopy=returnText[r.status]||r.status; %><tr><td>#<%= r.id %> · <%= r.request_type %></td><td data-no-translate><%= r.product_name %><% if(r.variant_value){ %><small class="order-variant"><%= r.variant_name %>: <%= r.variant_value %><% if(r.variant_value_2){ %> · <%= r.variant_name_2 %>: <%= r.variant_value_2 %><% } %></small><% } %></td><td><%= r.quantity %></td><td><span class="status status-<%= r.status %>"><%= statusCopy %></span><% if(r.manager_note){ %><small class="muted"><%= r.manager_note %></small><% } %></td><td><%= r.refund_recorded_at?formatPrice(r.refund_amount_cents,order.currency):'—' %></td><td><time datetime="<%= r.updated_at %>" title="<%= formatDateTimeDisplay(r.updated_at,storeTimeZone) %>"><%= formatRelativeTime(r.updated_at) %></time></td></tr><% }) %></tbody></table></div><% } else { %><p class="muted"><%= customerText("No return or refund requests have been made for this order.") %></p><% } %>
    <% if(order.status==='completed'){ %><div class="rule"></div><h3><%= returnText.request %></h3><form method="post" action="/order/<%= order.id %>/return-request" class="form-stack" data-confirm="<%= customerText("Send this after-sales request to the store?") %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><label><%= returnText.item %><select name="orderItemId" required><option value=""><%= customerText("Choose an item") %></option><% order.items.forEach(item=>{ %><option value="<%= item.id %>"><%= item.product_name %><% if(item.variant_value){ %> · <%= item.variant_name %>: <%= item.variant_value %><% if(item.variant_value_2){ %> · <%= item.variant_name_2 %>: <%= item.variant_value_2 %><% } %><% } %> · <%= customerText(locale==='nl'?'gekocht':'purchased') %> <%= item.quantity %></option><% }) %></select></label><label><%= returnText.quantity %><input type="number" name="quantity" min="1" max="99" step="1" value="1" required></label><label><%= returnText.type %><select name="requestType" required><option value="return"><%= returnText.return %></option><option value="exchange"><%= returnText.exchange %></option><option value="refund"><%= returnText.refund %></option></select></label><label><%= returnText.reason %><select name="reasonCode" required><option value="damaged"><%= customerText("Damaged item") %></option><option value="wrong_item"><%= customerText("Wrong item received") %></option><option value="not_as_described"><%= customerText("Not as described") %></option><option value="changed_mind"><%= customerText("Changed my mind") %></option><option value="other"><%= customerText("Other") %></option></select></label><label><%= customerText("Additional details (optional)") %><textarea name="note" maxlength="800" rows="4"></textarea></label><p class="muted"><%= returnText.restock %></p><button class="btn btn-dark" type="submit"><%= returnText.submit %></button></form><% } else { %><p class="muted"><%= customerText("Return requests become available when the store marks the order delivered.") %></p><% } %>
  </div>
</section>
<%- include('partials/footer') %>
