<% if(typeof added!=='undefined'&&added&&Number(cartCount)>0){ %>
<aside class="cart-added-success cart-confirmation" data-cart-confirmation aria-label="<%= customerText('Added to your bag') %>">
  <div class="cart-confirmation-top"><span class="cart-confirmation-icon" aria-hidden="true"><svg class="bag-success-art" viewBox="0 0 96 96" width="82" height="82" fill="none" aria-hidden="true"><circle class="bag-success-halo" cx="48" cy="48" r="34" fill="currentColor" opacity=".08"/><g class="bag-success-bag" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round"><path d="M29 36h38l4 38H25l4-38Z" fill="currentColor" fill-opacity=".09"/><path d="M39 37V29a9 9 0 0 1 18 0v8"/></g><g class="bag-success-seal"><circle cx="67" cy="66" r="15" fill="#287659" stroke="white" stroke-width="2.5"/><path class="bag-success-check" d="m60 66 5 5 9-10" pathLength="1" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></g><g class="bag-success-sparks" stroke="currentColor" stroke-width="2.3" stroke-linecap="round"><path d="M17 25v10m-5-5h10M77 19v12m-6-6h12M81 43l5-3"/></g></svg></span><div class="cart-confirmation-copy" role="status" aria-live="polite"><strong><%= customerText('Added to your bag') %></strong><p><%= cartCount %> <%= customerText('in your bag') %></p></div><button type="button" class="cart-confirmation-close" data-cart-confirmation-close hidden aria-label="<%= customerText('Close') %>"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div>
  <div class="cart-confirmation-actions"><a class="cart-confirmation-continue" href="/shop" data-cart-confirmation-continue><%= customerText('Continue shopping') %></a><a class="cart-confirmation-view" href="/cart"><%= customerText('View bag') %><span aria-hidden="true">→</span></a></div>
</aside><% } %>
