<% if(typeof added!=='undefined'&&added&&Number(cartCount)>0){ %>
<aside class="cart-added-success cart-confirmation" data-cart-confirmation aria-label="<%= customerText('Added to your bag') %>">
  <div class="cart-confirmation-top"><span class="cart-confirmation-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="23" height="23" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 8h14l1 13H4L5 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2m-6 7 2 2 4-4"/></svg></span><div class="cart-confirmation-copy" role="status" aria-live="polite"><strong><%= customerText('Added to your bag') %></strong><p><%= cartCount %> <%= customerText(locale==='nl'?'in je winkelmand':locale==='fr'?'dans votre panier':locale==='ckb'?'لە سەبەتەکەتدا':locale==='ar'?'في حقيبتك':'in your bag') %></p></div><button type="button" class="cart-confirmation-close" data-cart-confirmation-close hidden aria-label="<%= customerText('Close') %>"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div>
  <div class="cart-confirmation-actions"><a class="cart-confirmation-continue" href="/shop" data-cart-confirmation-continue><%= customerText('Continue shopping') %></a><a class="cart-confirmation-view" href="/cart"><%= customerText('View bag') %><span aria-hidden="true">→</span></a></div>
</aside><% } %>
