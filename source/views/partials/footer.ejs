<% if(locale==='fr'){ %><script src="/js/i18n-fr.js?v=2027-fr.fix03" defer></script><% } else if(locale==='ar'){ %><script src="/js/i18n-ar.js?v=2.8.95-r28.fix03" defer></script><% } else if(locale==='ckb'){ %><script src="/js/i18n-ckb.js?v=2.8.95-r28.fix03" defer></script><% } else if(locale==='nl'){ %><script src="/js/i18n-nl.js?v=2.8.95-r28.fix03" defer></script><% } %>
