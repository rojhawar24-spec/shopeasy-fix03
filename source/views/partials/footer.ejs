<% if(typeof managerWorkspaceShell!=='undefined' && managerWorkspaceShell){ %></div><!-- /.admin-workspace-content --><% } %>
<% if(!isAdminRoute && appearance.recentlyViewed){ %>
<section class="container recently-viewed" data-recently-viewed hidden aria-label="<%= footerText('Recently viewed products') %>">
 <div class="section-heading"><div><span class="eyebrow"><%= footerText('EXPLORE AGAIN') %></span><h2><%= footerText('Recently viewed') %></h2></div></div>
 <div class="recent-items" data-recent-items></div>
</section>
<% } %>
</main>
<% if(isAdminRoute){ %><div class="manager-quiet-footer" role="contentinfo"><span>ShopEasy Manager</span><span>Use <a href="/admin/products">Products</a> to manage the catalogue or <a href="/">View shop</a> to check the public design.</span></div><% } else { %><footer class="site-footer"><div class="container footer-grid">
  <div class="footer-brand"><strong translate="no" data-no-translate><%= storeName %></strong><p><%= footerText(checkoutCardEnabled?'Clear prices and payment options at checkout.':'Clear prices and available payment methods at checkout.') %></p></div>
  <div class="footer-link-column"><span class="footer-title"><%= footerText('Shop') %></span><a href="/shop"><%= footerText('All products') %></a><% if(featureStoriesEnabled){ %><a href="/stories"><%= footerText('Stories') %></a><% } %><% if(featureWishlistEnabled){ %><a href="/wishlist"><%= footerText('Wishlist') %></a><% } %><a href="/cart"><%= footerText('Cart') %></a></div>
  <div class="footer-link-column"><span class="footer-title"><%= footerText('Information') %></span><a href="/privacy"><%= footerText('Privacy') %></a><a href="/cookies"><%= footerText('Cookies') %></a><a href="/terms"><%= footerText('Terms') %></a><a href="/shipping-returns"><%= footerText('Shipping & returns') %></a><a href="/withdrawal-form"><%= footerText("Withdrawal form") %></a><a href="/imprint"><%= footerText("Business information") %></a><a href="/faq"><%= footerText('FAQ') %></a><a href="/contact"><%= footerText('Contact') %></a><a href="/order-lookup"><%= footerText('Track an order') %></a><a href="/account"><%= footerText('Account') %></a></div>
  <% if(supportEmail||businessPhone||legalName||enterpriseNumber||businessAddress||vatNumber){ %><div class="footer-business-column"><span class="footer-title"><%= footerText('Contact & business details') %></span>
    <% if(supportEmail){ %><div class="footer-detail"><span><%= footerText('Email') %></span><a href="mailto:<%= supportEmail %>"><%= supportEmail %></a></div><% } %>
    <% if(businessPhone){ %><div class="footer-detail"><span><%= footerText('Phone') %></span><a href="tel:<%= encodeURIComponent(businessPhone) %>"><%= businessPhone %></a></div><% } %>
    <% if(legalName){ %><div class="footer-detail"><span><%= footerText('Business name') %></span><strong translate="no" data-no-translate><%= legalName %></strong></div><% } %>
    <% if(enterpriseNumber){ %><div class="footer-detail"><span><%= footerText('Registration / licence') %></span><strong><%= enterpriseNumber %></strong></div><% } %>
    <% if(businessAddress){ %><div class="footer-detail"><span><%= footerText('Business address') %></span><strong translate="no" data-no-translate><%= businessAddress %></strong></div><% } %>
    <% if(vatNumber){ %><div class="footer-detail"><span><%= locale==='fr'?'Numéro de TVA':locale==='nl'?'Btw-nummer':locale==='ckb'?'ژمارەی باج':locale==='ar'?'الرقم الضريبي':'Tax / VAT number' %></span><strong><%= vatNumber %></strong></div><% } %>
  </div><% } %>
</div><div class="container footer-bottom"><span>© <%= new Date().getFullYear() %> <span translate="no" data-no-translate><%= legalName || storeName %></span>. <%= footerText("All rights reserved.") %></span><% if(licenseInfo?.licensedTo){ %><span>Licensed to: <span translate="no" data-no-translate><%= licenseInfo.licensedTo %></span></span><% } %><button type="button" class="footer-cookie-open" data-cookie-open><%= footerText("Cookie settings") %></button><span><%= footerText('Payment options shown at checkout.') %></span><span class="language-pill footer-language"><%= locale==='ckb'?'کوردی (سۆرانی)':locale==='kmr'?'کوردی (بادینی)':locale==='ar'?'العربية':locale==='en'?'EN':locale.toUpperCase() %></span></div></footer><% } %>

<% if(!isAdminRoute && appearance.cartDrawer){ %>
<dialog class="shop-dialog cart-preview-dialog" data-cart-drawer aria-labelledby="cart-preview-title">
 <div class="cart-preview-header"><div><span class="eyebrow"><%= footerText('YOUR BAG') %></span><h2 id="cart-preview-title"><%= footerText('Cart preview') %></h2></div><button type="button" class="shop-dialog-close" data-cart-drawer-close aria-label="<%= footerText('Close cart preview') %>">×</button></div>
 <p data-cart-drawer-message role="status" aria-live="polite"><%= footerText('Loading cart…') %></p>
 <ul class="cart-preview-list" data-cart-drawer-items></ul>
 <strong class="cart-preview-total" data-cart-drawer-total></strong>
 <div class="cart-preview-actions"><a href="/cart" class="btn btn-light"><%= footerText('View bag') %></a><a href="/checkout" class="btn btn-dark" data-cart-drawer-checkout hidden><%= footerText('Checkout') %></a></div>
</dialog>
<% } %>
<% if(!isAdminRoute && appearance.countrySuggestion && availableUiLocales.length>1){ %>
<section class="language-suggestion" data-language-suggestion hidden aria-labelledby="language-suggestion-title">
 <div><strong id="language-suggestion-title"><%= footerText('Language and region suggestion') %></strong><p data-language-suggestion-description><%= footerText('Based only on your browser settings. Choose a language if you want. Confirm your real delivery country and prices at checkout.') %></p><p data-country-suggestion hidden></p></div>
 <form action="/language" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="returnTo" value="<%= returnTo %>"><label for="language-suggestion-select" class="sr-only"><%= footerText('Language') %></label><select id="language-suggestion-select" name="language"><% uiLocaleOptions.filter(item=>availableUiLocales.includes(item.code)).forEach(option=>{ %><option value="<%= option.code %>" <%= locale===option.code?'selected':'' %>><%= option.nativeLabel %></option><% }) %></select><button type="submit" class="btn btn-dark"><%= footerText('Apply') %></button></form>
 <button type="button" data-language-suggestion-dismiss class="btn btn-light" aria-label="<%= footerText('Dismiss language suggestion') %>"><%= footerText('Not now') %></button>
</section><% } %>
<% if(!isAdminRoute && appearance.quickView){ %>
<dialog class="shop-dialog quick-view-dialog" data-quick-dialog aria-labelledby="quick-view-title">
 <button class="shop-dialog-close" type="button" data-quick-close aria-label="<%= footerText('Close product preview') %>">×</button>
 <div class="quick-view-content"><img data-quick-photo data-fallback-src="/assets/product-placeholder.svg" src="/assets/product-placeholder.svg" alt="" width="500" height="600" decoding="async"><div class="quick-view-info">
 <span class="eyebrow" data-quick-category data-no-translate></span><h2 id="quick-view-title" data-quick-title data-no-translate><%= footerText('Product preview') %></h2><strong class="quick-view-price" data-quick-price data-no-translate></strong><p data-quick-stock role="status"></p>
 <p class="field-note"><%= footerText('Review sizes, variants, availability and shipping on the full product page.') %></p><a class="btn btn-dark" data-quick-link href="/shop"><%= footerText('View full product →') %></a>
 </div></div>
</dialog>
<% } %>
<% if(!isAdminRoute && appearance.compare){ %>
<section class="compare-tray" data-compare-tray hidden aria-label="<%= footerText('Products selected for comparison') %>">
 <div><strong><%= footerText('Compare products · ') %><span data-compare-count>0</span>/3</strong><div class="compare-list" data-compare-list></div><p data-compare-note aria-live="polite"></p></div>
 <button type="button" class="btn btn-dark" data-compare-open><%= footerText('Compare selection') %></button>
</section>
<dialog class="shop-dialog compare-dialog" data-compare-dialog aria-labelledby="compare-dialog-title">
 <div class="compare-dialog-head"><h2 id="compare-dialog-title"><%= footerText('Compare your selection') %></h2><button type="button" class="shop-dialog-close" data-compare-close aria-label="<%= footerText('Close comparison') %>">×</button></div>
 <p><%= footerText('Compare displayed prices and open each product for current stock, delivery and complete specifications.') %></p>
 <div class="compare-columns" data-compare-columns></div>
</dialog>
<% } %>

<% if(!isAdminRoute){ %>
<section class="cookie-consent-banner" data-cookie-banner hidden aria-labelledby="cookie-consent-title" aria-describedby="cookie-consent-description" role="region" data-storage-unavailable="<%= footerText("Browser storage is unavailable, so this choice cannot be saved and this notice will return after refresh.") %>">
  <div class="cookie-consent-content">
    <div class="cookie-consent-copy">
      <span class="eyebrow"><%= footerText("PRIVACY CHOICES") %></span>
      <h2 id="cookie-consent-title"><%= footerText("Cookie choices") %></h2>
      <p id="cookie-consent-description"><%= footerText('Necessary storage supports your account, basket and security. Analytics and marketing stay off by default.') %></p>
      <div class="cookie-consent-links">
        <a href="/cookies"><%= footerText("Read the cookie policy") %></a>
        <button type="button" class="cookie-consent-customize-link" data-cookie-customize><%= footerText("Customize") %></button>
      </div>
      <p class="cookie-banner-status" data-cookie-banner-status role="status" aria-live="polite" hidden></p>
    </div>
    <div class="cookie-consent-actions" role="group" aria-label="<%= footerText('Cookie choice actions') %>">
      <button type="button" class="btn btn-light" data-cookie-reject><%= footerText("Reject optional") %></button>
      <button type="button" class="btn btn-light" data-cookie-accept><%= footerText("Accept all") %></button>
    </div>
  </div>
</section>
<div class="cookie-preferences-overlay" data-cookie-preferences hidden>
  <section class="cookie-preferences-dialog" role="dialog" aria-modal="true" aria-labelledby="cookie-preferences-title" tabindex="-1">
    <div class="cookie-preferences-heading"><div><span class="eyebrow"><%= footerText("PRIVACY SETTINGS") %></span><h2 id="cookie-preferences-title"><%= footerText("Cookie preferences") %></h2></div><button type="button" class="cookie-close" data-cookie-close aria-label="<%= footerText("Close preferences") %>">×</button></div>
    <p><%= footerText("Necessary storage is always on. Your choice is saved on this device for 180 days. No analytics or advertising scripts are loaded in this release.") %></p>
    <div class="cookie-preference-list">
      <div class="cookie-preference-row"><div><strong><%= footerText("Necessary") %></strong><p><%= footerText("Required for sessions, security and order handling.") %></p></div><span class="cookie-always-on"><%= footerText("Always on") %></span></div>
      <label class="cookie-preference-row" for="cookie-analytics"><span><strong><%= footerText("Analytics") %></strong><small><%= footerText("Usage measurement to improve the service.") %></small></span><input type="checkbox" id="cookie-analytics" data-cookie-analytics></label>
      <label class="cookie-preference-row" for="cookie-marketing"><span><strong><%= footerText("Marketing") %></strong><small><%= footerText("Advertising cookies and campaign measurement.") %></small></span><input type="checkbox" id="cookie-marketing" data-cookie-marketing></label>
    </div>
    <p class="cookie-preferences-status" data-cookie-preferences-status role="status" aria-live="polite"></p>
    <button type="button" class="cookie-reset-choice" data-cookie-reset><%= footerText("Ask for my choice again") %></button>
    <div class="cookie-preferences-actions"><button type="button" class="btn btn-light" data-cookie-close><%= footerText("Cancel") %></button><button type="button" class="btn btn-light" data-cookie-reject><%= footerText("Reject optional") %></button><button type="button" class="btn btn-dark" data-cookie-save><%= footerText("Save choices") %></button></div>
  </section>
</div>
<% } %>

<% if(!isAdminRoute && !isCheckoutRoute){ %><nav class="mobile-bottom-nav" aria-label="<%= footerText('Mobile navigation') %>">
  <a href="/" class="<%= path==='/'?'active':'' %>"><span class="mobile-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="m3 10 9-7 9 7M5.5 9v12h13V9M9.5 21v-6h5v6"/></svg></span><span class="mobile-nav-label"><%= footerText('Home') %></span></a>
  <a href="/shop" class="<%= (path.startsWith('/shop')||path.startsWith('/category/'))?'active':'' %>"><span class="mobile-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M9 4v5m6-5v5"/></svg></span><span class="mobile-nav-label"><%= footerText('Shop') %></span></a>
