  <a href="/cart" class="<%= path.startsWith('/cart')?'active':'' %>"><span class="mobile-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M5 8h14l-1.2 12H6.2L5 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg><b><%= cartCount %></b></span><span class="mobile-nav-label"><%= footerText('Cart') %></span></a>
