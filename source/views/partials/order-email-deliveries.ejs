<%
const deliveries=typeof emailDeliveries!=='undefined'&&Array.isArray(emailDeliveries)?emailDeliveries:[];
const emailCopy={
 en:{title:'Order emails',intro:'Review recorded sending attempts. “Sent” means the provider accepted the message, not confirmed inbox delivery.',event:'Event',status:'Status',attempts:'Attempts',error:'Last error code',actions:'Actions',empty:'No order email attempts have been recorded.',pending:'In progress',failed:'Failed',sent:'Sent / provider accepted',retry:'Retry email',check:'Check delivery before retrying',guidance:'Check this message in the Resend dashboard. Confirm “not sent” only when you have verified that no message was accepted. Never guess after a timeout. Reconciliation records your check; it does not send an email.',outcome:'Verified provider outcome',choose:'Choose the verified outcome',markedSent:'Message was accepted by the provider',notSent:'Confirmed not sent',reference:'Provider message ID (if available)',confirmed:'I checked the provider records for this exact sending attempt.',reconcile:'Record provider outcome',noticeSent:'The email was accepted by the provider.',noticeRetry:'This attempt cannot be retried now. Check its status and any required reconciliation.',noticeReconciled:'The provider outcome was recorded. No email was sent by this action.',noticeError:'The email action could not be completed. Review the current status before trying again.'},
 nl:{title:'Bestelmails',intro:'Bekijk de geregistreerde verzendpogingen. “Verzonden” betekent dat de provider het bericht heeft geaccepteerd; ontvangst in de inbox is niet bevestigd.',event:'Gebeurtenis',status:'Status',attempts:'Pogingen',error:'Laatste foutcode',actions:'Acties',empty:'Er zijn nog geen verzendpogingen voor bestelmails geregistreerd.',pending:'Wordt verwerkt',failed:'Mislukt',sent:'Verzonden / geaccepteerd door provider',retry:'E-mail opnieuw proberen',check:'Controleer de bezorging vóór een nieuwe poging',guidance:'Controleer dit bericht in het Resend-dashboard. Kies alleen “niet verzonden” als je hebt vastgesteld dat geen bericht is geaccepteerd. Gok nooit na een time-out. Deze actie registreert je controle en verstuurt geen e-mail.',outcome:'Gecontroleerde uitkomst bij de provider',choose:'Kies de gecontroleerde uitkomst',markedSent:'De provider heeft het bericht geaccepteerd',notSent:'Bevestigd niet verzonden',reference:'Bericht-ID van de provider (indien beschikbaar)',confirmed:'Ik heb de providergegevens voor precies deze verzendpoging gecontroleerd.',reconcile:'Uitkomst bij provider vastleggen',noticeSent:'De provider heeft de e-mail geaccepteerd.',noticeRetry:'Deze poging kan nu niet worden herhaald. Controleer de status en de eventueel vereiste providercontrole.',noticeReconciled:'De uitkomst bij de provider is vastgelegd. Deze actie heeft geen e-mail verstuurd.',noticeError:'De e-mailactie kon niet worden voltooid. Controleer de huidige status voordat je het opnieuw probeert.'},
 fr:{title:'E-mails de commande',intro:'Consultez les tentatives enregistrées. « Envoyé » signifie que le prestataire a accepté le message, sans confirmer sa réception dans la boîte de messagerie.',event:'Événement',status:'Statut',attempts:'Tentatives',error:'Dernier code d’erreur',actions:'Actions',empty:'Aucune tentative d’envoi d’e-mail de commande n’a été enregistrée.',pending:'En cours',failed:'Échec',sent:'Envoyé / accepté par le prestataire',retry:'Réessayer l’envoi',check:'Vérifier l’envoi avant de réessayer',guidance:'Vérifiez ce message dans le tableau de bord Resend. Confirmez « non envoyé » uniquement après avoir vérifié qu’aucun message n’a été accepté. Ne supposez jamais le résultat après un délai dépassé. Cette action enregistre votre vérification et n’envoie aucun e-mail.',outcome:'Résultat vérifié chez le prestataire',choose:'Choisissez le résultat vérifié',markedSent:'Le prestataire a accepté le message',notSent:'Non-envoi confirmé',reference:'Identifiant du message chez le prestataire (si disponible)',confirmed:'J’ai vérifié les données du prestataire pour cette tentative précise.',reconcile:'Enregistrer le résultat',noticeSent:'Le prestataire a accepté l’e-mail.',noticeRetry:'Cette tentative ne peut pas être relancée maintenant. Vérifiez son statut et toute vérification du prestataire requise.',noticeReconciled:'Le résultat du prestataire a été enregistré. Cette action n’a envoyé aucun e-mail.',noticeError:'L’action sur l’e-mail n’a pas abouti. Vérifiez le statut actuel avant de réessayer.'},
 ar:{title:'رسائل الطلب',intro:'راجع محاولات الإرسال المسجلة. تعني «أُرسلت» أن المزود قبل الرسالة، وليس تأكيد وصولها إلى صندوق البريد.',event:'الحدث',status:'الحالة',attempts:'المحاولات',error:'رمز الخطأ الأخير',actions:'الإجراءات',empty:'لم تُسجل محاولات لإرسال رسائل هذا الطلب.',pending:'قيد التنفيذ',failed:'فشلت',sent:'أُرسلت / قبلها المزود',retry:'إعادة محاولة إرسال البريد',check:'تحقق من الإرسال قبل المحاولة مجددًا',guidance:'تحقق من هذه الرسالة في لوحة Resend. لا تؤكد «لم تُرسل» إلا بعد التحقق من عدم قبول أي رسالة. لا تخمّن أبدًا بعد انتهاء المهلة. يسجل هذا الإجراء تحققك ولا يرسل بريدًا إلكترونيًا.',outcome:'النتيجة المتحقق منها لدى المزود',choose:'اختر النتيجة المتحقق منها',markedSent:'قبل المزود الرسالة',notSent:'تأكد عدم الإرسال',reference:'معرّف الرسالة لدى المزود (إن توفر)',confirmed:'تحققت من سجلات المزود لمحاولة الإرسال هذه تحديدًا.',reconcile:'تسجيل نتيجة المزود',noticeSent:'قبل المزود البريد الإلكتروني.',noticeRetry:'لا يمكن إعادة هذه المحاولة الآن. تحقق من حالتها ومن أي تحقق مطلوب لدى المزود.',noticeReconciled:'سُجلت نتيجة المزود. لم يرسل هذا الإجراء أي بريد إلكتروني.',noticeError:'تعذر إكمال إجراء البريد. راجع الحالة الحالية قبل المحاولة مجددًا.'},
 ckb:{title:'ئیمەیڵەکانی داواکاری',intro:'هەوڵە تۆمارکراوەکانی ناردن ببینە. «نێردراوە» واتە دابینکەر نامەکەی قبوڵ کردووە، نەک پشتڕاستکردنەوەی گەیشتن بە سندوقی ئیمەیڵ.',event:'ڕووداو',status:'دۆخ',attempts:'هەوڵەکان',error:'دوایین کۆدی هەڵە',actions:'کردارەکان',empty:'هیچ هەوڵێکی ناردنی ئیمەیڵ بۆ ئەم داواکارییە تۆمار نەکراوە.',pending:'لە جێبەجێکردندایە',failed:'سەرکەوتوو نەبوو',sent:'نێردراوە / دابینکەر قبوڵی کردووە',retry:'دووبارە هەوڵی ناردنی ئیمەیڵ بدە',check:'پێش هەوڵدانەوە ناردنەکە بپشکنە',guidance:'ئەم نامەیە لە داشبۆردی Resend بپشکنە. تەنها کاتێک «نەنێردراوە» پشتڕاست بکەرەوە کە دڵنیایت هیچ نامەیەک قبوڵ نەکراوە. دوای تێپەڕبوونی کات هەرگیز پێشبینی مەکە. ئەم کردارە پشکنینەکەت تۆمار دەکات و ئیمەیڵ نانێرێت.',outcome:'ئەنجامی پشتڕاستکراوەی دابینکەر',choose:'ئەنجامی پشتڕاستکراوە هەڵبژێرە',markedSent:'دابینکەر نامەکەی قبوڵ کردووە',notSent:'نەناردن پشتڕاست کراوەتەوە',reference:'ناسنامەی نامە لای دابینکەر (ئەگەر بەردەستە)',confirmed:'تۆمارەکانی دابینکەرم بۆ ئەم هەوڵە دیاریکراوەی ناردن پشکنیوە.',reconcile:'ئەنجامی دابینکەر تۆمار بکە',noticeSent:'دابینکەر ئیمەیڵەکەی قبوڵ کردووە.',noticeRetry:'ئەم هەوڵە ئێستا دووبارە ناکرێتەوە. دۆخەکەی و پشکنینی پێویستی دابینکەر بپشکنە.',noticeReconciled:'ئەنجامی دابینکەر تۆمار کرا. ئەم کردارە هیچ ئیمەیڵێکی نەنارد.',noticeError:'کرداری ئیمەیڵ تەواو نەبوو. پێش هەوڵدانەوە دۆخی ئێستا بپشکنە.'}
};
const emailUi=emailCopy[locale]||emailCopy.en;
const emailNoticeKeys={sent:'noticeSent','retry-unavailable':'noticeRetry',reconciled:'noticeReconciled',error:'noticeError'};
const emailNotice=typeof emailResult==='string'&&Object.hasOwn(emailNoticeKeys,emailResult)?emailUi[emailNoticeKeys[emailResult]]:'';
const canManageOrderEmail=typeof user!=='undefined'&&user?.role==='manager';
%>
<section class="container section" aria-labelledby="order-email-title" translate="no" data-no-translate>
  <div class="panel">
    <h2 id="order-email-title"><%= emailUi.title %></h2>
    <p class="field-note"><%= emailUi.intro %></p>
    <% if(emailNotice){ %><div class="alert" role="status"><%= emailNotice %></div><% } %>
    <% if(!deliveries.length){ %><p class="muted"><%= emailUi.empty %></p><% } else { %>
      <div class="table-wrap" role="region" aria-label="<%= emailUi.title %>" tabindex="0"><table>
        <thead><tr><th><%= emailUi.event %></th><th><%= emailUi.status %></th><th><%= emailUi.attempts %></th><th><%= emailUi.error %></th><th><%= emailUi.actions %></th></tr></thead>
        <tbody><% deliveries.forEach((delivery,index)=>{ const reconciliationId=`email-reconciliation-${index}`; %><tr>
          <td><code><%= delivery.event_key||delivery.event_type %></code><% if(delivery.provider_message_id){ %><div class="field-note"><%= emailUi.reference %>: <code><%= delivery.provider_message_id %></code></div><% } %></td>
          <td><%= delivery.status==='sending'?emailUi.pending:(emailUi[delivery.status]||delivery.status) %></td>
          <td><%= Number(delivery.attempt_count)||0 %></td>
          <td><code><%= delivery.error_code||'—' %></code></td>
          <td><% if(canManageOrderEmail&&delivery.status!=='sent'){ %>
            <form method="post" action="/admin/orders/<%= order.id %>/email/retry" class="form-stack">
              <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="eventKey" value="<%= delivery.event_key %>">
              <button class="btn btn-light btn-small" type="submit" <% if(delivery.needs_reconciliation){ %>disabled aria-describedby="<%= reconciliationId %>"<% } %>><%= emailUi.retry %></button>
            </form>
            <% if(delivery.needs_reconciliation){ %>
              <details><summary><%= emailUi.check %></summary><p class="field-note" id="<%= reconciliationId %>"><%= emailUi.guidance %></p>
                <form method="post" action="/admin/orders/<%= order.id %>/email/reconcile" class="form-stack">
                  <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="eventKey" value="<%= delivery.event_key %>">
                  <input type="hidden" name="expectedGeneration" value="<%= Number(delivery.generation)||0 %>" required><input type="hidden" name="expectedAttemptCount" value="<%= Number(delivery.attempt_count)||0 %>" required>
                  <label><%= emailUi.outcome %><select name="outcome" required><option value=""><%= emailUi.choose %></option><option value="sent"><%= emailUi.markedSent %></option><option value="not-sent"><%= emailUi.notSent %></option></select></label>
                  <label><%= emailUi.reference %><input name="providerMessageId" maxlength="200" autocomplete="off"></label>
                  <label class="checkbox-inline"><input type="checkbox" name="providerChecked" value="yes" required><%= emailUi.confirmed %></label>
                  <button class="btn btn-light btn-small" type="submit"><%= emailUi.reconcile %></button>
                </form>
              </details>
            <% } %>
          <% } %></td>
        </tr><% }) %></tbody>
      </table></div>
    <% } %>
  </div>
</section>
