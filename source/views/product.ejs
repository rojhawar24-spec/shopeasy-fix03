<%- include('partials/header',{title:product.name}) %>
<% const actualGallery=Array.isArray(images)?images:[]; const demoMediaEnabled=typeof process!=='undefined'&&process.env.VERCEL_ENV==='preview'; const demoImageIds={'essential-oversized-t-shirt':[8532638,8532611],'wireless-headphones-x20':[30428610,9371408],'graphite-smartphone':[1334603,8533741]}; const demoPhotoIds=demoMediaEnabled&&actualGallery.length<3?(demoImageIds[product.slug]||[]):[]; const originalGallery=actualGallery.length?actualGallery:(product.image_url?[{image_url:product.image_url,is_primary:1,alt_text:product.name}]:[]); const demoGallery=demoPhotoIds.map(id=>({image_url:'https://images.pexels.com/photos/'+id+'/pexels-photo-'+id+'.jpeg?auto=compress&cs=tinysrgb&w=1000',alt_text:'DEMO — sample stock photo (not the actual product)',is_primary:0,demo:true})); const productImagesForPage=[...originalGallery,...demoGallery]; const primaryProductImage=productImagesForPage.find(image=>Number(image.is_primary)===1)||productImagesForPage[0]||null; const productVariantsForPage=Array.isArray(variants)?variants:[]; const selectedVariantForPage=productVariantsForPage.find(variant=>Number(variant.id)===Number(selectedVariantId))||null; const optionOneName=productVariantsForPage[0]?.option_name||'Option'; const optionTwoName=productVariantsForPage[0]?.option_name_2||''; const variantClientData=JSON.stringify(productVariantsForPage.map(variant=>({id:Number(variant.id),value:String(variant.option_value||''),value2:String(variant.option_value_2||''),sku:String(variant.sku||''),stock:Number(variant.available_stock)||0,imageUrl:safeImageUrl(variant.image_url,'')}))); %>
<div class="container product-return-navigation"><%- include('partials/back-button',{fallback:'/shop'}) %></div>
<section class="container product-detail product-detail-v5 product-detail-refined product-detail-studio"<% if(appearance.recentlyViewed){ %> data-recent-product data-recent-url="/product/<%= encodeURIComponent(product.slug) %>" data-recent-name="<%= product.name %>" data-recent-price="<%= formatPrice(app.locals.effectivePrice(product),currency) %>" data-recent-image="<%= safeImageUrl(product.image_url) %>"<% } %>>
  <%- include('partials/cart-confirmation') %>
  <% if(cartError){ %><div class="alert cart-action-error" role="alert" aria-live="assertive"><% if(cartError==='option'){ %><%= customerText("Choose an available option before adding this product to your bag.") %><% } else if(cartError==='quantity'){ %><%= customerText("You can add up to 99 of the same product option. Check the quantity and try again.") %><% } else if(cartError==='stock'){ %><%= customerText("Stock changed before we could add this item. Please review current availability.") %><% } else { %><%= customerText("This product is no longer available. Please browse the shop for current products.") %><% } %></div><% } %>
  <div class="product-media-column">
    <nav class="breadcrumbs" aria-label="<%= customerText("Breadcrumb") %>"><a href="/"><%= customerText("Home") %></a><span aria-hidden="true">/</span><a href="/shop"><%= customerText("Shop") %></a><% if(product.category_slug){ %><span aria-hidden="true">/</span><a href="/category/<%= encodeURIComponent(product.category_slug) %>" translate="no" data-no-translate><%= product.category_name || product.category_slug %></a><% } %><span aria-hidden="true">/</span><span aria-current="page" data-no-translate><%= product.name %></span></nav>
    
    <div class="product-media-gallery" data-product-gallery><% if(demoGallery.length){ %><p class="demo-media-notice" role="note">DEMO PREVIEW · <%= ({nl:"Extra foto’s zijn voorbeeldfoto’s, niet de echte producten.",fr:"Les photos supplémentaires sont des exemples, pas les produits réels.",ar:"الصور الإضافية أمثلة وليست صور المنتجات الفعلية.",ckb:"وێنە زیادەکان نموونەن، نەک وێنەی بەرهەمی ڕاستەقینە."})[locale]||"Additional images are sample stock photos, not the actual product." %></p><% } %>
      <div class="product-visual product-visual-v5 product-visual-v6<%= /clothing|apparel|fashion|kleding|vêtements|ملابس|جلوبەرگ/i.test(String(product.category_slug||"")+" "+String(product.category_name||"")) ? " product-visual-clothing" : "" %>">
        <img src="<%= safeImageUrl(primaryProductImage?.image_url||product.image_url) %>" data-fallback-src="/assets/product-placeholder.svg" alt="<%= product.name %>" translate="no" data-no-translate width="800" height="1000" fetchpriority="high" decoding="async" data-product-main-image data-base-image-url="<%= safeImageUrl(primaryProductImage?.image_url||product.image_url) %>" data-base-image-alt="<%= product.name %>" translate="no" data-no-translate>
        <a class="product-photo-expand" href="<%= safeImageUrl(primaryProductImage?.image_url||product.image_url) %>" target="_blank" rel="noopener noreferrer" data-product-photo-expand><span aria-hidden="true">⌕</span><span><%= customerText(locale==='nl'?'Vergroten':locale==='fr'?'Agrandir':locale==='ckb'?'گەورەکردنەوە':locale==='ar'?'تكبير':'View larger') %></span></a>
      </div>
      <dialog class="product-photo-dialog" data-product-photo-dialog aria-label="<%= locale==='nl'?'Productfoto groter':locale==='fr'?'Photo du produit':locale==='ckb'?'وێنەی گەورەی بەرهەم':locale==='ar'?'صورة المنتج المكبرة':'Enlarged product image' %>"><div class="product-photo-dialog-inner"><button type="button" data-product-photo-close class="product-photo-close"><%= customerText(locale==='nl'?'Sluiten':locale==='fr'?'Fermer':locale==='ckb'?'داخستن':locale==='ar'?'إغلاق':'Close') %> <span aria-hidden="true">×</span></button><img src="<%= safeImageUrl(primaryProductImage?.image_url||product.image_url) %>" data-product-photo-large data-fallback-src="/assets/product-placeholder.svg" alt="<%= product.name %>" translate="no" data-no-translate width="1000" height="1000" decoding="async"></div></dialog>
      <% if(productImagesForPage.length>1){ %>
        <div class="product-gallery-thumbnails" role="group" aria-label="<%= customerText("Product photos") %>">
          <% productImagesForPage.forEach((image,index)=>{ %><button type="button" class="product-gallery-thumbnail <%= image.image_url===(primaryProductImage?.image_url||product.image_url)?'is-active':'' %>" data-gallery-image data-image-url="<%= safeImageUrl(image.image_url) %>" data-image-alt="<%= image.alt_text||product.name %>" <% if(image.demo){ %>data-demo-photo<% } %> aria-label="View product photo <%= index+1 %>" aria-pressed="<%= image.image_url===(primaryProductImage?.image_url||product.image_url)?'true':'false' %>"><img src="<%= safeImageUrl(image.image_url) %>" data-fallback-src="/assets/product-placeholder.svg" alt="" width="100" height="120" loading="lazy" decoding="async"><% if(image.demo){ %><span class="demo-thumbnail-label">DEMO</span><% } %></button><% }) %>
        </div>
      <% } %>
    </div>
  </div>

  <div class="product-copy product-copy-v5 product-copy-v6">
    <div class="product-intro">
      <% if(product.category_name){ %><span class="eyebrow" translate="no" data-no-translate><%= product.category_name %></span><% } else { %><span class="eyebrow"><%= customerText("PRODUCT") %></span><% } %>
      <h1 data-no-translate><%= product.name %></h1>
      <% if(product.short_description){ %><p class="lead" data-no-translate><%= product.short_description %></p><% } %>
    </div>

    <% if(isManager && managerProduct){ const hasProductHistory=Number(managerProduct.order_item_count||0)>0; const hasProductReservations=Number(managerProduct.reserved_inventory_total||0)>0; const canPermanentlyDelete=!hasProductHistory&&!hasProductReservations; %>
      <section class="manager-product-actions" aria-label="<%= customerText("Product management") %>">
        <div class="manager-product-actions-copy"><strong><%= customerText("Products") %></strong><span><%= customerText("Manage product details, prices, availability and what customers can see.") %></span></div>
        <div class="manager-product-action-buttons">
          <a class="btn btn-light btn-small" href="/admin/products/<%= product.id %>/edit"><%= customerText("Edit") %></a>
          <form method="post" action="/admin/products/archive" data-confirm="<%= customerText("Archive this product? It will be hidden from the shop but kept for historic orders.") %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= product.id %>"><button type="submit" class="btn btn-light btn-small" <% if(hasProductReservations){ %>disabled aria-disabled="true" title="<%= customerText('Finish or cancel active orders first.') %>"<% } %>><%= customerText("Archive") %></button></form>
          <form method="post" action="/admin/products/delete" data-confirm="<%= customerText("Permanently delete this product? This cannot be undone. Products with order history must be retained.") %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= product.id %>"><button type="submit" class="btn btn-danger btn-small" <% if(!canPermanentlyDelete){ %>disabled aria-disabled="true" title="<%= customerText(hasProductHistory?'Order history must be kept.':'Reserved stock must be released first.') %>"<% } %>><%= customerText("Delete permanently") %></button></form>
        </div>
        <% if(!canPermanentlyDelete){ %><p class="manager-product-action-note"><%= customerText(hasProductHistory?'This product has order history and cannot be permanently deleted. Keep it archived to preserve the records.':'This product has reserved units. Finish or cancel the active order first.') %></p><% } %>
      </section>
    <% } %>

    <div class="product-price-block">
      <div class="detail-price">
        <span><%= formatPrice(app.locals.effectivePrice(product),currency) %></span>
        <% if(app.locals.effectivePrice(product)<product.price_cents){ %><del><%= formatPrice(product.price_cents,currency) %></del><span class="discount">-<%= app.locals.discountPercent(product) %>%</span><% } %>
      </div>
      <div class="stock-line stock-line-v5" data-product-stock-line><span class="dot <%= product.available_stock>0?'ok':'bad' %>" data-product-stock-dot></span><strong data-product-stock-label><%= customerText(product.available_stock>0?(variants.length?'Choose options':'In stock'):'Sold out') %></strong><span data-product-stock-count><%= product.available_stock>0?`${product.available_stock} available in total`:'Currently unavailable' %></span></div>
    </div>

    <% if(product.description){ %>
      <section class="product-info-section">
        <h2><%= customerText("About this product") %></h2>
        <p class="detail-description" data-no-translate><%= product.description %></p>
      </section>
    <% } %>

    <form method="post" action="/cart/add" class="buy-box buy-box-v5 buy-box-v6 purchase-configurator <%= variants.length?'has-variants':'' %>" data-product-variant-form data-variant-map="<%= variantClientData %>">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input type="hidden" name="productId" value="<%= product.id %>">
      <% if(variants.length){ %>
        <input type="hidden" name="variantId" value="<%= selectedVariantId||'' %>" data-selected-variant-id>
        <fieldset class="product-option-field" <% if(product.available_stock<=0){ %>aria-disabled="true" disabled<% } %>>
          <legend><span class="field-label configurator-title"><%= customerText(locale==='nl'?'Kies je uitvoering':locale==='fr'?'Choisissez vos options':locale==='ckb'?'هەڵبژاردنەکانت دیاری بکە':locale==='ar'?'اختر خياراتك':'Select your options') %></span></legend>
          <div class="product-attribute-select"><label for="product-option-one" class="configurator-option-label"><span translate="no" data-no-translate><%= optionOneName %></span><span class="configurator-selected" data-option-selected aria-live="polite"></span></label><select id="product-option-one" name="variantValue" required data-option-one-select><option value="" translate="no" data-no-translate><%= customerText("Choose ") %><%= optionOneName %></option><% [...new Set(variants.map(variant=>String(variant.option_value)))].forEach(value=>{ const available=variants.some(variant=>String(variant.option_value)===value&&Number(variant.available_stock)>0); %><option value="<%= value %>" translate="no" data-no-translate <%= selectedVariantForPage&&selectedVariantForPage.option_value===value?'selected':'' %> <%= available?'':'disabled' %>><%= value %><%= customerText(available?'':' · Sold out') %></option><% }) %></select></div>
          <% if(optionTwoName){ %>
            <div class="product-attribute-select"><label for="product-option-two" class="configurator-option-label"><span translate="no" data-no-translate><%= optionTwoName %></span><span class="configurator-selected" data-option-selected aria-live="polite"></span></label><select id="product-option-two" name="variantValue2" required data-option-two-select data-choice-placeholder="<%= customerText('Choose ') %><%= optionTwoName %>"><option value="" translate="no" data-no-translate><%= customerText("Choose ") %><%= optionTwoName %></option><% [...new Set(variants.filter(variant=>!selectedVariantForPage||variant.option_value===selectedVariantForPage.option_value).map(variant=>String(variant.option_value_2)))].forEach(value=>{ const available=variants.some(variant=>String(variant.option_value)===String(selectedVariantForPage?.option_value||'')&&String(variant.option_value_2)===value&&Number(variant.available_stock)>0); %><option value="<%= value %>" translate="no" data-no-translate <%= selectedVariantForPage&&selectedVariantForPage.option_value_2===value?'selected':'' %> <%= selectedVariantForPage&&!available?'disabled':'' %>><%= value %><%= customerText(selectedVariantForPage&&!available?' · Sold out':'') %></option><% }) %></select></div>
          <% } %>
          <span class="field-note configurator-feedback" id="product-option-note" data-variant-option-note role="status" aria-live="polite"><%= customerText('Select each option to check its own SKU and stock.') %></span>
        </fieldset>
      <% } %>
      <div class="configurator-purchase-row"><div class="quantity-field"><label class="field-label" for="product-quantity"><%= customerText("Quantity") %></label><div class="product-quantity-stepper"><button type="button" data-product-qty-step="-1" aria-label="<%= customerText('Decrease quantity') %>" hidden>−</button><input id="product-quantity" type="number" name="quantity" min="1" max="<%= Math.max(1,Math.min(99,product.available_stock)) %>" value="1" required inputmode="numeric" data-product-quantity data-aggregate-stock="<%= product.available_stock %>" <%= product.available_stock<=0?'disabled':'' %>><button type="button" data-product-qty-step="1" aria-label="<%= customerText('Increase quantity') %>" hidden>+</button></div></div>
      <div class="buy-actions-v5">
        <button type="submit" class="btn btn-dark btn-v5-buy configurator-buy" data-variant-submit <%= product.available_stock<=0?'disabled':'' %>><%= customerText(product.available_stock<=0?'Sold out':variants.length&&!selectedVariantForPage?'Choose options':'Add to cart') %><svg class="product-buy-icon" viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 8h14l1 13H4L5 8Z"/><path d="M9 9V6a3 3 0 0 1 6 0v3"/></svg></button>
        <% if(isLoggedIn && featureWishlistEnabled){ %><button type="button" class="icon-btn wishlist-toggle product-wishlist product-wishlist-v5 <%= wishlistIds.has(product.id)?'saved':'' %>" data-wishlist-toggle data-product-id="<%= product.id %>" data-product-name="<%= product.name %>" aria-label="<%= wishlistIds.has(product.id)?'Remove':'Add' %> <%= product.name %> to wishlist" aria-pressed="<%= wishlistIds.has(product.id)?'true':'false' %>"><%= customerText(wishlistIds.has(product.id)?'♥':'♡') %></button><% } %>
      </div></div>
    </form>

    <section class="product-purchase-facts" aria-label="<%= customerText("Ordering information") %>">
      <div class="purchase-fact purchase-fact-shipping"><span class="purchase-fact-icon" aria-hidden="true">↗</span><div><strong><%= customerText(locale==='nl'?'Bezorgkosten':'Delivery cost') %></strong><small><% if(shippingDisplay?.rulesConfigured&&!shippingDisplay?.rulesValid){ %><%= customerText(locale==='nl'?'De bezorgkosten voor jouw locatie zijn momenteel niet beschikbaar. Neem contact op met de winkel voordat je bestelt.':'Delivery pricing for your location is not currently available. Contact the store before ordering.') %><% } else if(shippingDisplay?.hasDestinationRules){ %><%= customerText(locale==='nl'?'Berekend voor jouw bezorgadres en getoond voordat je de bestelling bevestigt.':'Calculated for your delivery location and shown before you confirm the order.') %><% } else if(Number(shippingDisplay?.feeCents||0)===0){ %><%= customerText(locale==='nl'?'Deze winkel heeft momenteel gratis bezorging ingesteld.':'Free delivery is currently configured by this store.') %><% } else { %><%= customerText(locale==='nl'?'Ingestelde standaardkost: ':'Configured standard fee: ') %><%= formatPrice(shippingDisplay.feeCents,currency) %>. <%= customerText(locale==='nl'?'Een eventuele regionale afwijking wordt bij het afrekenen bevestigd.':'Any regional override is confirmed at checkout.') %><% } %></small></div></div>
      <div class="purchase-fact"><span class="purchase-fact-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M3 7.5h18v12H3z"/><path d="M3 10.5h18M7 15.5h3"/></svg></span><div><strong><%= customerText(locale==='nl'?'Betaalmogelijkheden':locale==='fr'?'Moyens de paiement':locale==='ckb'?'ڕێگاکانی پارەدان':locale==='ar'?'طرق الدفع':'Payment options') %></strong><small><%= customerText(locale==='nl'?'Bekijk de beschikbare methodes bij het afrekenen.':locale==='fr'?'Consultez les modes disponibles à la caisse.':'See available methods at checkout.') %></small></div></div>
      <div class="purchase-fact"><span class="purchase-fact-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M12 3 19 6v5c0 5-3 8-7 10-4-2-7-5-7-10V6z"/><path d="m9 12 2 2 4-4"/></svg></span><div><strong><%= customerText("Availability checked") %></strong><small><%= customerText("Stock is checked again before checkout.") %></small></div></div>
      <a class="purchase-fact" href="/shipping-returns"><span class="purchase-fact-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M4 7h12v10H4z"/><path d="M16 10h3l2 3v4h-5zM7.5 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM18 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/></svg></span><div><strong><%= customerText("Delivery & returns") %></strong><small><%= customerText("Read the store’s delivery and return policies.") %></small></div><span class="purchase-fact-arrow" aria-hidden="true">↗</span></a>
    </section>
  </div>
</section>
<% if(appearance.stockAlerts && Number(product.available_stock||0)===0){ %>
<section class="panel engagement-panel container" aria-labelledby="stock-alert-title"><h2 id="stock-alert-title"><%= customerText(locale==='nl'?'Een melding bij nieuwe voorraad':locale==='ckb'?'ئاگادارکردنەوەی بەردەستبوون':locale==='ar'?'تنبيه عند توفر المنتج':'Email me when available') %></h2>
<p><%= customerText("No message is sent until you confirm your email. One alert per request.") %></p>
<% if(alertNotice==='check-email'){ %><p role="status"><%= customerText("Check your inbox to confirm the stock alert.") %></p><% } else if(alertNotice==='unavailable'){ %><p role="alert"><%= customerText("Email alerts are not configured yet.") %></p><% } else if(alertNotice==='invalid'){ %><p role="alert"><%= customerText("Enter a valid email address.") %></p><% } %>
<form method="post" action="/stock-alerts/request" class="engagement-inline-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="productId" value="<%= product.id %>"><label for="stock-alert-email"><%= customerText("Email address") %></label><input type="email" id="stock-alert-email" name="email" autocomplete="email" maxlength="254" required><button type="submit" class="btn btn-dark"><%= customerText("Notify me") %></button></form>
</section><% } %>
<% if(appearance.reviews){ %>
<section class="container section reviews-panel" id="reviews" aria-labelledby="reviews-title"><div class="section-head"><div><span class="eyebrow"><%= customerText("VERIFIED PURCHASES") %></span><h2 id="reviews-title"><%= customerText(locale==='nl'?'Beoordelingen':locale==='ckb'?'هەڵسەنگاندنەکان':locale==='ar'?'التقييمات':'Customer reviews') %></h2></div><strong><%= reviewStats.count ? `${reviewStats.average.toFixed(1)} / 5 · ${reviewStats.count}` : 'No published reviews yet' %></strong></div>
<% if(reviewNotice==='pending'){ %><p role="status" class="success-alert"><%= customerText("Review received. It will appear after moderation.") %></p><% } else if(reviewNotice==='not-eligible'){ %><p role="alert"><%= customerText("Reviews are only available after a completed order on your account. Please check your rating and text.") %></p><% } %>
<div class="review-grid"><% reviews.forEach(review=>{ %><article class="panel review-card"><span aria-label="<%= review.rating %> out of 5 stars"><%= '★'.repeat(review.rating) %><%= '☆'.repeat(5-review.rating) %></span><h3 data-no-translate><%= review.title %></h3><p data-no-translate><%= review.body %></p><small><%= customerText("Verified purchase · ") %><%= customerText(locale==='nl'?'Geverifieerde koper':locale==='ckb'?'کڕیاری پشتڕاستکراو':locale==='ar'?'مشتري موثّق':'Verified buyer') %> · <%= review.created_at %></small></article><% }) %></div>
<% if(canReview){ %><form method="post" action="/products/<%= product.id %>/reviews" class="panel form-stack engagement-review-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><h3><%= customerText("Review your purchase") %></h3><label for="review-rating"><%= customerText("Rating") %></label><select name="rating" id="review-rating" required><option value=""><%= customerText("Choose a rating") %></option><% for(let n=5;n>=1;n--){ %><option value="<%= n %>"><%= n %> / 5</option><% } %></select><label for="review-title"><%= customerText("Review title") %></label><input name="title" id="review-title" required minlength="3" maxlength="100"><label for="review-body"><%= customerText("Your review") %></label><textarea name="body" id="review-body" rows="4" required minlength="15" maxlength="2000"></textarea><button class="btn btn-dark" type="submit"><%= customerText("Submit for approval") %></button></form><% } %>
</section>
<% } %>
<% const visibleArrivals=(typeof newArrivalPreview!=='undefined'&&Array.isArray(newArrivalPreview)?newArrivalPreview:[]).filter(p=>p&&p.slug&&p.name).slice(0,8); if(visibleArrivals.length){ %>
<aside class="container product-mini-arrivals arrival-studio<%= visibleArrivals.length>1?' arrival-loop':'' %>" aria-labelledby="arrival-studio-title">
  <div class="mini-arrivals-heading"><div><span class="mini-arrivals-tag"><%= customerText('NEW') %></span><h2 id="arrival-studio-title"><%= customerText('New in the shop') %></h2></div><div class="arrival-studio-actions"><a href="/shop?sort=newest"><%= customerText('View all') %><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></a><% if(visibleArrivals.length>1){ %><label class="arrival-studio-pause"><input type="checkbox" aria-label="<%= customerText('Pause animation') %>"><svg class="arrival-pause-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9 5v14M15 5v14"/></svg><svg class="arrival-play-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 11 7-11 7Z"/></svg></label><% } %></div></div>
  <div class="arrival-studio-viewport" dir="ltr"><div class="arrival-studio-track"><% for(let copy=0;copy<(visibleArrivals.length>1?2:1);copy++){ %><div class="arrival-studio-group" dir="<%= ['ckb','kmr','ar'].includes(locale)?'rtl':'ltr' %>" <% if(copy){ %>aria-hidden="true" data-arrival-copy<% } %>><% visibleArrivals.forEach(p=>{ %><a class="arrival-studio-card" href="/product/<%= encodeURIComponent(p.slug) %>" <% if(copy){ %>tabindex="-1"<% } %>><img src="<%= safeImageUrl(p.image_url) %>" data-fallback-src="/assets/product-placeholder.svg" alt="" width="80" height="80" loading="eager" decoding="async"><span><strong data-no-translate><%= p.name %></strong><small><%= formatPrice(app.locals.effectivePrice(p),currency) %></small></span></a><% }) %></div><% } %></div></div>
</aside><% } %>
<% if(featureRelatedProductsEnabled&&Array.isArray(relatedProducts)&&relatedProducts.length){ %>
<section class="container section related-products-section" aria-labelledby="related-products-title">
  <div class="section-head related-products-heading"><div><span class="eyebrow"><%= customerText("KEEP EXPLORING") %></span><h2 id="related-products-title"><%= customerText("You may also like") %></h2><p><%= customerText("Discover more from this shop.") %></p></div><a class="btn btn-light btn-small" href="/shop"><%= customerText("View all products ") %><span aria-hidden="true">→</span></a></div>
  <div class="product-grid shop-grid product-grid-signature related-products-grid"><% relatedProducts.forEach(p=>{ %><%- include('partials/product-card',{p:p}) %><% }) %></div>
</section>
<% } %>
<% if(appearance.stickyPurchase && Number(product.available_stock||0)>0){ %><div class="product-mobile-purchase"><button type="button" data-purchase-focus><%= customerText(locale==='nl'?'Kies opties en voeg toe':locale==='ckb'?'هەڵبژێرە و زیاد بکە':locale==='ar'?'اختر وأضف للسلة':'Choose options & add to bag') %> · <%= formatPrice(app.locals.effectivePrice(product),currency) %></button></div><% } %>
<%- include('partials/footer') %>
