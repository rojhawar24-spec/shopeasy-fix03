<%- include('partials/header',{title:typeof categoryInfo !== 'undefined' && categoryInfo && categoryInfo.name ? categoryInfo.name : 'Shop'}) %>
<%
const _categoryInfo = typeof categoryInfo !== 'undefined' && categoryInfo ? categoryInfo : null;
const _categoryPath = typeof categoryPath !== 'undefined' && Array.isArray(categoryPath) ? categoryPath : [];
const _childCategories = typeof childCategories !== 'undefined' && Array.isArray(childCategories) ? childCategories : [];
const shopFilterState = { category: category||'', search: search||'', sort: sort||'', minPrice: minPrice||'', maxPrice: maxPrice||'', stock: inStockOnly?'1':'' };
const shopFrench = {
  'Added to your bag': 'Ajouté au panier',
  "Your item is in the bag. You can keep shopping or review your bag when you're ready.": 'Votre article est dans le panier. Vous pouvez continuer vos achats ou consulter votre panier.',
  'View bag': 'Voir le panier',
  'Continue shopping': 'Continuer les achats',
  'Choose an available option before adding this product to your bag.': 'Choisissez une option disponible avant d’ajouter ce produit au panier.',
  'You can add up to 99 of the same product option. Check the quantity and try again.': 'Vous pouvez ajouter au maximum 99 unités de la même option. Vérifiez la quantité.',
  'Stock changed before we could add this item. Please review current availability.': 'Le stock a changé. Vérifiez la disponibilité actuelle.',
  'This product is no longer available. Please browse the shop for current products.': 'Ce produit n’est plus disponible. Consultez les autres produits.',
  'Category': 'Catégorie', 'Category path':'Chemin des catégories',
  'All categories': 'Toutes les catégories',
  'Sort': 'Trier',
  'Featured': 'À la une',
  'Newest': 'Nouveautés',
  'Price: low to high': 'Prix : croissant',
  'Price: high to low': 'Prix : décroissant',
  'Name: A–Z': 'Nom : A–Z',
  'No products found.': 'Aucun produit trouvé.',
  'Try fewer words, another category or a different sort order.': 'Essayez moins de mots, une autre catégorie ou un autre tri.',
  'Reset shop': 'Réinitialiser la boutique',
  'All': 'Tous',
  'Page': 'Page',
  '← Previous': '← Précédent',
  'Next →': 'Suivant →',
  'Filter products': 'Filtrer les produits',
  'Remove sorting': 'Supprimer le tri',
  'Remove minimum price': 'Supprimer le prix minimum',
  'Remove maximum price': 'Supprimer le prix maximum',
  'Your security check expired. No change was submitted. Please use the fresh form on this page.': 'Votre contrôle de sécurité a expiré. Aucune modification n’a été envoyée. Utilisez le formulaire actualisé.',
  'e.g. clothing, homeware, accessories': 'ex. vêtements, maison, accessoires',
  'Any': 'Tous'
};
const shopText = value => customerText(value);
function shopFilterUrlWithout(excluded) {
  const params = new URLSearchParams();
  for (const [key,value] of Object.entries(shopFilterState)) if (key!==excluded && value) params.set(key,value);
  const query = params.toString();
  return query ? `/shop?${query}` : '/shop';
}
%>
<section class="container page-head shop-page-intro shop-editorial-intro"><div><span class="eyebrow"><%= customerText(_categoryInfo ? (locale === 'ckb' ? 'پۆل' : locale === 'ar' ? 'الفئة' : locale === 'nl' ? 'CATEGORIE' : locale === 'fr' ? 'CATÉGORIE' : locale === 'kmr' ? 'پۆل' : 'CATEGORY') : (locale === 'ckb' ? 'کۆمەڵەی بەرهەم' : locale === 'ar' ? 'المجموعة' : locale === 'nl' ? 'COLLECTIE' : locale === 'fr' ? 'COLLECTION' : locale === 'kmr' ? 'کۆمەڵە' : 'COLLECTION')) %></span><h1 data-no-translate><%= _categoryInfo?.name || (locale === 'ckb' ? 'هەموو بەرهەمەکان ببینە.' : locale === 'ar' ? 'تسوّق جميع المنتجات.' : locale === 'nl' ? 'Ontdek de collectie' : locale === 'fr' ? 'Découvrez la collection' : locale === 'kmr' ? 'هەمی بەرهەمان ببینە' : 'Explore the collection') %></h1><p data-no-translate><%= _categoryInfo?.description || (locale === 'ckb' ? 'بەپێی ناو و وەسف بگەڕێ، پۆلەکان ببینە و بەپێی نرخ یان نوێترین بەرهەمەکان ڕیزبەندی بکە.' : locale === 'ar' ? 'ابحث بالاسم أو الوصف، وتصفّح الفئات ورتّب حسب السعر أو الأحدث.' : locale === 'nl' ? 'Ontdek, vergelijk en vind jouw favoriete producten.' : locale === 'fr' ? 'Explorez, comparez et trouvez vos produits préférés.' : locale === 'kmr' ? 'لە بەرهەمان بگەڕێ و یێن دڵێ خۆ هەلبژێرە.' : 'Find your favourites. Explore, compare and shop at your own pace.') %></p><% if(_categoryInfo && _categoryPath.length>1){ %><nav class="category-breadcrumbs" aria-label="<%= shopText('Category path') %>"><% _categoryPath.slice(0,-1).forEach((crumb,index)=>{ %><a href="/category/<%= encodeURIComponent(crumb.slug) %>"><%= crumb.name %></a><span aria-hidden="true">›</span><% }) %><strong data-no-translate><%= _categoryInfo.name %></strong></nav><% } %></div></section>

<% if(_categoryInfo && _childCategories.length){ %>
<section class="container home-category-section category-context" aria-labelledby="subcategory-title">
  <div class="home-category-heading"><h2 id="subcategory-title"><%= shopText('Subcategories') %></h2><a href="/shop" class="home-category-all"><%= shopText('All categories') %> <span aria-hidden="true">→</span></a></div>
  <div class="home-category-rail" role="list">
    <% _childCategories.forEach(child=>{ %>
      <div class="home-category-entry" role="listitem"><a class="home-category-tile" href="/category/<%= encodeURIComponent(child.slug) %>">
        <div class="home-category-photo"><img src="<%= child.image_url ? safeImageUrl(child.image_url) : '/assets/category-placeholder.svg' %>" data-fallback-src="/assets/category-placeholder.svg" alt="" width="360" height="360" loading="lazy" decoding="async"></div>
        <span class="home-category-name" data-no-translate><%= child.name %></span>
        <small><%= ({nl:'Producten',fr:'Produits',ckb:'بەرهەم',ar:'المنتجات',kmr:'بەرهەم'})[locale]||'Products' %>: <%= Number(child.product_count||0) %></small>
      </a></div>
    <% }) %>
  </div>
</section>
<% } %>
<section class="container section shop-section shop-editorial shop-filter-refined">
  <%- include('partials/cart-confirmation') %>
  <% if(cartError){ %><div class="alert cart-action-error" role="alert" aria-live="assertive"><% if(cartError==='option'){ %><%= shopText('Choose an available option before adding this product to your bag.') %><% } else if(cartError==='quantity'){ %><%= shopText('You can add up to 99 of the same product option. Check the quantity and try again.') %><% } else if(cartError==='stock'){ %><%= shopText('Stock changed before we could add this item. Please review current availability.') %><% } else { %><%= shopText('This product is no longer available. Please browse the shop for current products.') %><% } %></div><% } %>
  <div class="shop-filter-mobile-bar shop-filter-toolbar" data-shop-filter-mobile-bar>
    <button type="button" class="shop-filter-toggle" aria-controls="shop-filter-form" aria-expanded="true" data-shop-filter-toggle>
      <span aria-hidden="true" class="shop-filter-symbol"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/><circle cx="9" cy="6" r="2" fill="currentColor"/><circle cx="15" cy="12" r="2" fill="currentColor"/><circle cx="10" cy="18" r="2" fill="currentColor"/></svg></span>
      <span><%= customerText("Filters") %></span>
      <% const activeFilterCount=[Boolean(category),Boolean(search),Boolean(minPrice),Boolean(maxPrice),Boolean(inStockOnly),Boolean(sort&&sort!=='featured')].filter(Boolean).length; %>
      <% if(activeFilterCount){ %><span class="shop-filter-count"><%= activeFilterCount %></span><% } %>
      <span class="shop-filter-chevron" aria-hidden="true">⌄</span>
    </button>
    <span class="shop-mobile-result-count"><strong><%= resultCount %></strong> <%= customerText(locale==='nl'?'producten':locale==='fr'?'produits':locale==='ckb'?'بەرهەم':locale==='ar'?'منتج':'products') %></span><div class="shop-toolbar-sort"><div class="shop-sort-control"><label for="sort-filter"><%= shopText('Sort') %></label><select id="sort-filter" name="sort" form="shop-sort-form"><option value="featured" <%= sort==='featured'||!sort?'selected':'' %>><%= shopText('Featured') %></option><option value="newest" <%= sort==='newest'?'selected':'' %>><%= shopText('Newest') %></option><option value="price_low" <%= sort==='price_low'?'selected':'' %>><%= shopText('Price: low to high') %></option><option value="price_high" <%= sort==='price_high'?'selected':'' %>><%= shopText('Price: high to low') %></option><option value="name" <%= sort==='name'?'selected':'' %>><%= shopText('Name: A–Z') %></option></select></div><button type="submit" form="shop-sort-form" class="shop-sort-submit" aria-label="<%= shopText('Sort') %>"><span aria-hidden="true">→</span></button></div>
    </div><form id="shop-sort-form" method="get" action="/shop"><% for(const [key,value] of Object.entries(shopFilterState)){ if(key!=='sort'&&value){ %><input type="hidden" name="<%= key %>" value="<%= value %>"><% }} %></form>
<div class="shop-filter-overlay" data-filter-overlay hidden></div>
  <form id="shop-filter-form" class="shop-controls" method="get" action="/shop" aria-labelledby="shop-filter-title"><input type="hidden" name="sort" value="<%= sort||'featured' %>">
    <div class="shop-filters-heading"><h2 id="shop-filter-title"><%= customerText("Refine selection") %></h2><a class="shop-reset-link" href="<%= _categoryInfo?'/category/'+encodeURIComponent(_categoryInfo.slug):'/shop' %>"><%= customerText("Reset") %></a><button type="button" class="shop-filter-close" data-filter-close aria-label="<%= customerText("Close filters") %>"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div><div class="shop-filter-fields">
    <% const categoryChildren=new Map(); categories.forEach(c=>{const key=c.parent_id?Number(c.parent_id):0;if(!categoryChildren.has(key))categoryChildren.set(key,[]);categoryChildren.get(key).push(c);}); function shopCategoryOptions(parentId,depth,seen=new Set()){if(depth>80)return '';return (categoryChildren.get(parentId)||[]).map(c=>{const id=Number(c.id);if(seen.has(id))return '';const nextSeen=new Set(seen);nextSeen.add(id);return `<option data-no-translate value="${escapeHtml(c.slug)}" ${category===c.slug?'selected':''}>${'— '.repeat(depth)}${escapeHtml(c.name)}</option>`+shopCategoryOptions(id,depth+1,nextSeen);}).join('');} %><div class="filter-block"><label for="category-filter"><%= shopText('Category') %></label><% if(categories.length>8){ %><input type="search" data-filter-category-search placeholder="<%= customerText("Search categories") %>" aria-label="<%= customerText('Search categories') %>" maxlength="80" autocomplete="off"><% } %><select id="category-filter" name="category"><option value=""><%= shopText('All categories') %></option><%- shopCategoryOptions(0,0) %></select></div>

    <div class="filter-search"><label for="shop-search"><%= customerText("Search products") %></label><div class="inline-search"><span class="filter-input-icon" aria-hidden="true"><%- include('partials/ui-icon',{iconName:'search'}) %></span><input id="shop-search" name="search" value="<%= search %>" maxlength="80" placeholder="<%= shopText('e.g. clothing, homeware, accessories') %>"></div><% if(aiEnabled){ %><small class="search-ai-disclosure"><%= customerText(locale==='fr'?'Lors de la recherche, l’IA peut proposer des synonymes. Seuls les termes de recherche sont envoyés au service d’IA configuré ; les résultats proviennent uniquement de votre catalogue actif.':locale==='nl'?'Bij verzenden kan AI je zoekterm uitbreiden met synoniemen. Alleen zoekwoorden worden naar de ingestelde AI-dienst gestuurd; resultaten komen altijd uit je eigen actieve catalogus.':locale==='ckb'?'کاتێک گەڕان دەنێریت، AI دەتوانێت وشە هاوواتاکان زیاد بکات. تەنها وشەی گەڕان بۆ AI دەنێردرێت و ئەنجامەکان هەمیشە لە کاڵاکانی چالاکی فرۆشگاکەتن.':locale==='ar'?'عند إرسال البحث، قد يوسّع الذكاء الاصطناعي العبارة بمرادفات. تتم مشاركة كلمات البحث فقط، وتأتي النتائج دائمًا من كتالوج متجرك النشط.':'When submitted, AI may expand your query with synonyms. Only search terms are sent to the configured AI service; results always come from your active catalog.') %></small><% } %></div>
    <fieldset class="shop-price-range"><legend><%= customerText("Price range") %></legend><div class="shop-price-fields"><div class="filter-block"><label for="min-price-filter"><%= customerText("Min") %></label><input id="min-price-filter" name="minPrice" type="number" inputmode="decimal" min="0" step="<%= typeof priceFilterStep !== 'undefined' ? priceFilterStep : 'any' %>" value="<%= minPrice||'' %>" placeholder="0"></div>
    <div class="filter-block"><label for="max-price-filter"><%= customerText("Max") %></label><input id="max-price-filter" name="maxPrice" type="number" inputmode="decimal" min="0" step="<%= typeof priceFilterStep !== 'undefined' ? priceFilterStep : 'any' %>" value="<%= maxPrice||'' %>" placeholder="<%= shopText('Any') %>"></div></div></fieldset>
    <label class="filter-stock shop-stock-switch"><input type="checkbox" name="stock" value="1" <%= inStockOnly?'checked':'' %>> <%= customerText("In-stock products only") %></label>
    </div><div class="shop-filter-actions"><button type="submit" class="btn btn-dark"><%= customerText("Show results") %></button></div>
  </form>
  <div class="shop-results">
    <h2 class="sr-only"><%= locale==='nl'?'Producten':locale==='fr'?'Produits':locale==='ckb'?'بەرهەمەکان':locale==='ar'?'المنتجات':'Products' %></h2>
  <% if(priceRangeInvalid){ %><div class="alert" role="alert"><%= customerText(locale==='nl'?'Controleer de minimum- en maximumprijs. Gebruik bedragen die passen bij de winkelvaluta en zorg dat het maximum niet lager is dan het minimum. De prijsfilter is niet toegepast.':locale==='fr'?'Vérifiez les prix minimum et maximum. Respectez les décimales de la devise et assurez-vous que le maximum n’est pas inférieur au minimum. Aucun filtre de prix n’a été appliqué.':locale==='ckb'?'نرخی کەمترین و زۆرترین بپشکنە. ژمارەی خانە دەهەمییەکان دەبێت لەگەڵ دراوی فرۆشگا بگونجێت و نرخی زۆرترین لە کەمترین کەمتر نەبێت. پاڵاوتنی نرخ جێبەجێ نەکرا.':locale==='ar'?'تحقّق من الحدّ الأدنى والأقصى للسعر. استخدم عدد المنازل العشرية المناسب لعملة المتجر وتأكد أن الحدّ الأقصى ليس أقلّ من الحدّ الأدنى. لم يُطبّق فلتر السعر.':'Check the minimum and maximum prices. Use the correct decimal precision for the store currency, and make sure the maximum is not below the minimum. No price filter was applied.') %></div><% } %>
  <% if(typeof aiSearchUsed !== 'undefined' && aiSearchUsed){ %><div class="tip-box" role="status"><%= customerText(locale==='fr'?'L’IA a élargi la recherche. Les résultats affichent uniquement des produits actifs de cette boutique.':locale==='nl'?'AI heeft je zoekterm uitgebreid. Je ziet alleen echte, actieve producten uit deze winkel.':locale==='ckb'?'AI وشەی گەڕانەکەت فراوان کرد. تەنها بەرهەمی ڕاستەقینە و چالاکەکانی ئەم فرۆشگایە دەبینیت.':locale==='ar'?'وسّع الذكاء الاصطناعي عبارة البحث. النتائج تعرض منتجات نشطة وحقيقية من هذا المتجر فقط.':'AI expanded your search. Results show real active products from this store only.') %></div><% } %>
  <% if(typeof securityNotice!=='undefined' && securityNotice){ %><div class="alert" role="status"><%= shopText('Your security check expired. No change was submitted. Please use the fresh form on this page.') %></div><% } %>
  <% if(appearance.filterChips && (category||search||minPrice||maxPrice||inStockOnly||(sort&&sort!=='featured'))){ %>
  <nav class="active-filter-bar" aria-label="<%= locale==='nl'?'Actieve filters':locale==='fr'?'Filtres actifs':locale==='ckb'?'پاڵاوتنە چالاکەکان':locale==='ar'?'الفلاتر النشطة':'Active filters' %>">
    <strong class="active-filter-title"><%= customerText("Active filters") %></strong>
    <div class="active-filter-list">
      <% if(category){ const selectedCategory=categories.find(item=>item.slug===category); %><a href="<%= shopFilterUrlWithout('category') %>" aria-label="<%= locale==='nl'?'Categorie verwijderen:':locale==='fr'?'Supprimer la catégorie :':'Remove category:' %> <%= selectedCategory?.name||category %>"><%= selectedCategory?.name||category %><span aria-hidden="true"> ×</span></a><% } %>
      <% if(search){ %><a href="<%= shopFilterUrlWithout('search') %>" aria-label="<%= locale==='nl'?'Zoekterm verwijderen:':locale==='fr'?'Supprimer la recherche :':'Remove search:' %> <%= search %>"><%= customerText(locale==='nl'?'Zoeken:':locale==='fr'?'Recherche:':'Search:') %> <%= search %><span aria-hidden="true"> ×</span></a><% } %>
      <% if(sort&&sort!=='featured'){ %><a href="<%= shopFilterUrlWithout('sort') %>" aria-label="<%= shopText('Remove sorting') %>"><%= customerText(locale==='nl'?'Sorteren:':locale==='fr'?'Tri :':'Sort:') %> <%= shopText({newest:'Newest',price_low:'Price: low to high',price_high:'Price: high to low',name:'Name: A–Z'}[sort]||sort) %><span aria-hidden="true"> ×</span></a><% } %>
      <% if(minPrice){ %><a href="<%= shopFilterUrlWithout('minPrice') %>" aria-label="<%= shopText('Remove minimum price') %>"><%= customerText(locale==='nl'?'Minimum:':'Min:') %> <%= minPrice %><span aria-hidden="true"> ×</span></a><% } %>
      <% if(maxPrice){ %><a href="<%= shopFilterUrlWithout('maxPrice') %>" aria-label="<%= shopText('Remove maximum price') %>"><%= customerText(locale==='nl'?'Maximum:':'Max:') %> <%= maxPrice %><span aria-hidden="true"> ×</span></a><% } %>
      <% if(inStockOnly){ %><a href="<%= shopFilterUrlWithout('stock') %>" aria-label="<%= customerText("Remove in-stock filter") %>"><%= customerText(locale==='nl'?'Op voorraad':locale==='fr'?'En stock':'In stock') %><span aria-hidden="true"> ×</span></a><% } %>
    </div>
    <a class="active-filter-clear" href="<%= _categoryInfo?'/category/'+encodeURIComponent(_categoryInfo.slug):'/shop' %>"><%= customerText(locale==='nl'?'Alles wissen':locale==='fr'?'Tout effacer':locale==='ckb'?'هەموو بسڕەوە':locale==='ar'?'مسح الكل':'Clear all') %></a>
  </nav>
  <% } %>
  <% const rootCategories=categories.filter(c=>!c.parent_id); const visibleCategories=rootCategories.slice(); const selectedCategory=categories.find(c=>c.slug===category); if(selectedCategory&&!visibleCategories.some(c=>c.slug===category))visibleCategories.push(selectedCategory); function categoryFilterHref(slug){const params=new URLSearchParams();for(const [key,value] of Object.entries(shopFilterState))if(key!=='category'&&value)params.set(key,value);if(slug)params.set('category',slug);return '/shop'+(params.size?'?'+params.toString():'');} %>
<div class="shop-toolbar shop-category-toolbar">
  <div class="shop-category-rail"><div class="chips" role="group" aria-label="<%= shopText('Category') %>">
    <a class="chip <%= !category?'active':'' %>" href="<%= categoryFilterHref('') %>" <% if(!category){ %>aria-current="true"<% } %>><%= shopText('All') %></a>
    <% visibleCategories.forEach(c=>{ %><a class="chip <%= category===c.slug?'active':'' %>" href="<%= categoryFilterHref(c.slug) %>" <% if(category===c.slug){ %>aria-current="true"<% } %>><span data-no-translate><%= c.name %></span></a><% }) %>
  </div>
  <% if(categories.length>visibleCategories.length){ %><details class="shop-category-more"><summary><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg><span><%= shopText('All categories') %></span><span aria-hidden="true">⌄</span></summary><div class="shop-category-more-panel"><% categories.forEach(c=>{ %><a href="<%= categoryFilterHref(c.slug) %>" <% if(category===c.slug){ %>aria-current="true"<% } %>><span data-no-translate><%= c.name %></span><span aria-hidden="true">↗</span></a><% }) %></div></details><% } %></div>
  <span class="toolbar-note shop-total-count"><strong><%= resultCount %></strong> <%= customerText(locale==='nl'?'producten':locale==='fr'?'produits':locale==='ckb'?'بەرهەم':locale==='ar'?'منتج':'products') %></span>
</div>
  <% if(!products.length){ %><div class="empty"><span class="empty-icon">⌕</span><h2><%= shopText('No products found.') %></h2><p><%= shopText('Try fewer words, another category or a different sort order.') %></p><a class="btn btn-dark" href="/shop"><%= shopText('Reset shop') %></a></div><% } else { %>
  <div class="product-grid shop-grid product-grid-signature editorial-product-grid"><% products.forEach(p=>{ %><%- include('partials/product-card',{p:p}) %><% }) %></div>
  <% if(hasPrev||hasNext){ %><div class="pagination"><% if(hasPrev){ %><a class="btn btn-light btn-small" href="<%= _categoryInfo?'/category/'+encodeURIComponent(_categoryInfo.slug):'/shop' %>?page=<%= page-1 %><%= category?'&category='+encodeURIComponent(category):'' %><%= search?'&search='+encodeURIComponent(search):'' %><%= sort?'&sort='+encodeURIComponent(sort):'' %><%= minPrice?'&minPrice='+encodeURIComponent(minPrice):'' %><%= maxPrice?'&maxPrice='+encodeURIComponent(maxPrice):'' %><%= inStockOnly?'&stock=1':'' %>"><%= shopText('← Previous') %></a><% } else { %><span></span><% } %><span><%= customerText("Page ") %><strong><%= page %></strong></span><% if(hasNext){ %><a class="btn btn-dark btn-small" href="<%= _categoryInfo?'/category/'+encodeURIComponent(_categoryInfo.slug):'/shop' %>?page=<%= page+1 %><%= category?'&category='+encodeURIComponent(category):'' %><%= search?'&search='+encodeURIComponent(search):'' %><%= sort?'&sort='+encodeURIComponent(sort):'' %><%= minPrice?'&minPrice='+encodeURIComponent(minPrice):'' %><%= maxPrice?'&maxPrice='+encodeURIComponent(maxPrice):'' %><%= inStockOnly?'&stock=1':'' %>"><%= shopText('Next →') %></a><% } else { %><span></span><% } %></div><% } %>
  <% } %>
  </div>
</section>
<%- include('partials/footer') %>
