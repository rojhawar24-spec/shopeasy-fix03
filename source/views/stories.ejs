<%- include('partials/header',{title:'Stories'}) %>
<section class="container page-head stories-page-head">
  <%- include('partials/back-button', { fallback: '/' }) %>
  <div class="stories-heading-copy"><span class="eyebrow"><%= customerText(stories.length ? 'LIVE NOW' : 'STORE UPDATES') %></span><h1><%= customerText("Stories") %></h1><p><%= customerText("New arrivals, helpful updates and store announcements in one place.") %></p></div>
</section>
<section class="container section story-grid"><% stories.forEach((s,index)=>{ %><button type="button" class="story-card story-open-card" data-story-open data-story-index="<%= index %>" data-story-title="<%= s.title %>" data-story-body="<%= s.body %>" data-story-image="<%= safeImageUrl(s.image_url,'/assets/story.svg') %>" data-story-product-url="<%= s.product_slug ? '/product/'+encodeURIComponent(s.product_slug) : '' %>" data-story-product-id="<%= s.product_id||'' %>" data-story-product-stock="<%= Number(s.product_available_stock||0) %>" data-story-product-variants="<%= Number(s.product_variant_count||0) %>" data-story-link-url="<%= s.product_slug ? '' : safeStoryHref(s.link_url) %>" data-story-expiry="<%= formatDateTimeDisplay(s.expires_at,storeTimeZone).split(',')[0] %>"><img src="<%= safeImageUrl(s.image_url,'/assets/story.svg') %>" data-fallback-src="/assets/story.svg" alt="<%= s.title %>" width="800" height="600" loading="lazy" decoding="async"><span class="story-card-body"><span class="muted"><%= formatDateTimeDisplay(s.expires_at,storeTimeZone).split(',')[0] %></span><strong data-no-translate><%= s.title %></strong><span data-no-translate><%= s.body %></span><span class="story-card-cta"><%= customerText("Open story · Shop →") %></span></span></button><% }) %></section>
<% if(!stories.length){ %><section class="container stories-empty-state" aria-labelledby="stories-empty-title"><div class="stories-empty-art" aria-hidden="true"><span></span><span></span><span></span><b>↗</b></div><div class="stories-empty-copy"><span class="eyebrow"><%= customerText("NOTHING NEW JUST YET") %></span><h2 id="stories-empty-title"><%= customerText("No stories published right now") %></h2><p><%= customerText("Check back for new arrivals and store updates. In the meantime, explore the products available today.") %></p><a class="btn btn-dark" href="/shop"><%= customerText("Browse products ") %><span aria-hidden="true">→</span></a></div></section><% } %>
<%- include('partials/story-viewer') %>
<%- include('partials/footer') %>