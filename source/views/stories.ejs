<%- include('partials/header',{title:'Stories'}) %>
<% const previewStories = typeof process!=='undefined'&&process.env.VERCEL_ENV==='preview'; const sampleStories = previewStories ? [{title:'Everyday essentials',body:'DEMO · Sample fashion photography for testing the story viewer.',photo:8532638},{title:'Sound in focus',body:'DEMO · Sample audio photography for testing the story viewer.',photo:9371408},{title:'Modern technology',body:'DEMO · Sample technology photography for testing the story viewer.',photo:1334603}].map(s=>({title:s.title,body:s.body,image_url:'https://images.pexels.com/photos/'+s.photo+'/pexels-photo-'+s.photo+'.jpeg?auto=compress&cs=tinysrgb&w=1000',expires_at:new Date(Date.now()+86400000).toISOString(),link_url:'/shop'})) : []; const displayStories=[...stories,...sampleStories]; %>

<section class="container page-head stories-page-head">
  <%- include('partials/back-button', { fallback: '/' }) %>
  <div class="stories-heading-copy"><span class="eyebrow"><%= customerText(displayStories.length ? 'LIVE NOW' : 'STORE UPDATES') %></span><h1><%= customerText("Stories") %></h1><p><%= customerText("New arrivals, helpful updates and store announcements in one place.") %></p></div>
</section>
<% if(sampleStories.length){ %><p class="container demo-media-notice" role="note">DEMO PREVIEW · Sample stories are for design testing only.</p><% } %>
<% if(displayStories.length){ const first=displayStories[0]; %>
<section class="container story-cinema" data-story-cinema aria-label="<%= customerText('Stories') %>">
  <div class="story-cinema-stage">
    <img data-cinema-photo src="<%= safeImageUrl(first.image_url,'/assets/story.svg') %>" alt="<%= first.title %>" width="900" height="1200" fetchpriority="high" decoding="async">
    <div class="story-cinema-shade"></div>
    <div class="story-cinema-top"><div class="story-cinema-progress" aria-hidden="true"><span data-cinema-progress></span></div><div class="story-cinema-controls"><span data-cinema-count>1 / <%= displayStories.length %></span><button type="button" data-cinema-pause aria-label="<%= customerText('Pause animation') %>" aria-pressed="false"><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path class="cinema-pause-icon" d="M7 5h4v14H7zm6 0h4v14h-4z"/><path class="cinema-play-icon" d="m8 5 12 7-12 7z"/></svg></button></div></div>
    <div class="story-cinema-copy"><span class="story-cinema-kicker"><%= customerText('Store updates') %></span><h2 data-cinema-title data-no-translate><%= first.title %></h2><p data-cinema-body data-no-translate><%= first.body %></p><button type="button" class="story-cinema-open" data-cinema-open><%= customerText('Open story') %> <span aria-hidden="true">↗</span></button></div>
    <div class="story-cinema-nav"><button type="button" data-cinema-prev aria-label="<%= customerText('Previous story') %>">‹</button><button type="button" data-cinema-next aria-label="<%= customerText('Next story') %>">›</button></div>
  </div>
  <div class="story-cinema-side"><h2><%= customerText('All stories') %></h2><section class="story-grid story-cinema-list" aria-label="<%= customerText('All stories') %>"><% displayStories.forEach((s,index)=>{ %><button type="button" class="story-card story-open-card" data-story-open data-story-index="<%= index %>" data-story-title="<%= s.title %>" data-story-body="<%= s.body %>" data-story-image="<%= safeImageUrl(s.image_url,'/assets/story.svg') %>" data-story-product-url="<%= s.product_slug ? '/product/'+encodeURIComponent(s.product_slug) : '' %>" data-story-product-id="<%= s.product_id||'' %>" data-story-product-stock="<%= Number(s.product_available_stock||0) %>" data-story-product-variants="<%= Number(s.product_variant_count||0) %>" data-story-link-url="<%= s.product_slug ? '' : safeStoryHref(s.link_url) %>" data-story-expiry="<%= formatDateTimeDisplay(s.expires_at,storeTimeZone).split(',')[0] %>"><img src="<%= safeImageUrl(s.image_url,'/assets/story.svg') %>" data-fallback-src="/assets/story.svg" alt="<%= s.title %>" width="800" height="600" loading="lazy" decoding="async"><span class="story-card-body"><span class="muted"><%= formatDateTimeDisplay(s.expires_at,storeTimeZone).split(',')[0] %></span><strong data-no-translate><%= s.title %></strong><span data-no-translate><%= s.body %></span><span class="story-card-cta"><%= customerText("Open story · Shop →") %></span></span></button><% }) %></section></div></section><% } %>
<% if(!displayStories.length){ %><section class="container stories-empty-state" aria-labelledby="stories-empty-title"><div class="stories-empty-art" aria-hidden="true"><span></span><span></span><span></span><b>↗</b></div><div class="stories-empty-copy"><span class="eyebrow"><%= customerText("NOTHING NEW JUST YET") %></span><h2 id="stories-empty-title"><%= customerText("No stories published right now") %></h2><p><%= customerText("Check back for new arrivals and store updates. In the meantime, explore the products available today.") %></p><a class="btn btn-dark" href="/shop"><%= customerText("Browse products ") %><span aria-hidden="true">→</span></a></div></section><% } %>
<%- include('partials/story-viewer') %>
<%- include('partials/footer') %>