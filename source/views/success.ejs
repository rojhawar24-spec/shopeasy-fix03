const cancellationRequestPending=typeof hasPendingCancellationRequest==='function'&&hasPendingCancellationRequest(order);
const cancellationNoticeKey=['requested','already-requested'].includes(cancelResult)&&!cancellationRequestPending||cancelResult==='cancelled'&&order.status!=='cancelled'?'changed':cancelResult;
const currentState={
  en:{pending:'Waiting for confirmation',paid:'Payment recorded',processing:'Accepted · preparing',shipped:'Shipped · out for delivery',completed:'Delivered',cancelled:'Cancelled'},
